{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(magick *)",
      "mcp__Groundlane__web_search",
      "mcp__Groundlane__web_fetch",
      "mcp__Groundlane__web_extract",
      "mcp__Groundlane__web_content",
      "mcp__Groundlane__web_map",
      "mcp__Groundlane__web_news",
      "mcp__Groundlane__parse",
      "mcp__Groundlane__paper_lookup",
      "mcp__Groundlane__paper_search",
      "mcp__claude_ai_Groundlane__web_search",
      "mcp__claude_ai_Groundlane__web_fetch",
      "mcp__claude_ai_Groundlane__web_extract",
      "mcp__claude_ai_Groundlane__web_content",
      "mcp__claude_ai_Groundlane__web_map",
      "mcp__claude_ai_Groundlane__web_news",
      "mcp__claude_ai_Groundlane__parse",
      "mcp__claude_ai_Groundlane__paper_lookup",
      "mcp__claude_ai_Groundlane__paper_search"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/cloud-setup.sh"
          },
          {
            "type": "command",
            "command": "node scripts/session-start.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm verify 2>&1 | tail -10"
          }
        ]
      }
    ]
  }
}
