{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(magick *)",
      "mcp__web-fetch__*",
      "mcp__stealth-fetch__*",
      "mcp__claude-in-chrome__*",
      "mcp__claude_ai_Exa__*",
      "mcp__claude_ai_Figma__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__claude_ai_Notion__*",
      "mcp__claude_ai_Tavily__*",
      "mcp__claude_ai_cloudflare__*",
      "mcp__claude_ai_firecrawl__*",
      "mcp__claude_ai_jina__*",
      "mcp__claude_ai_linkup__*",
      "mcp__offernow__*",
      "mcp__playwright__*",
      "mcp__plugin_context7_context7__*",
      "mcp__hackmd__*",
      "mcp__gdrive__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-start.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm verify 2>&1 | tail -10"
          }
        ]
      }
    ]
  }
}
