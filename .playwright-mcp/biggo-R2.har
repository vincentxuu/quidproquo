u5728\u96c6\u4e2d\u5e02\u5834\u8f49\u70ba\u8cb7\u8d85\uff0c\u70ba\u53f0\u5e63\u532f\u50f9\u63d0\u4f9b\u652f\u6490\u529b\u9053\u3002\\n\\n\u65b0\u53f0\u5e63\u8fd1\u65e5\u8d70\u52e2\u5287\u70c8\u9707\u76ea\u3002\u9031\u4e8c\u5728\u806f\u6e96\u6703\u6c7a\u7b56\u51fa\u7210\u524d\u5915\uff0c\u5916\u8cc7\u6301\u7e8c\u532f\u51fa\uff0c\u65b0\u53f0\u5e63\u4e00\u5ea6\u645c\u783431.9\u5143\u95dc\u5361\uff0c\u76e4\u4e2d\u6700\u4f4e\u89f8\u53ca31.932\u5143\uff0c\u5275\u4e0b\u8fd1\u4e00\u500b\u6708\u65b0\u4f4e\uff0c\u7d42\u5834\u6536\u572831.888\u5143\uff0c\u9023\u7e8c\u7b2c\u4e94\u500b\u4ea4\u6613\u65e5\u8d70\u8cb6\u3002\u7576\u6642\u5e02\u5834\u5c0d\u806f\u6e96\u6703\u5347\u606f\u7684\u9810\u671f\u5df2\u81fb\u7be4\u5b9a\uff0c\u8207\u6703\u8b70\u65e5\u671f\u639b\u9264\u7684\u5229\u7387\u4e92\u63db\u986f\u793a\uff0c\u4ea4\u6613\u54e1\u8a8d\u70ba\u806f\u6e96\u6703\u5c07\u57fa\u6e96\u653f\u7b56\u5229\u7387\u5f9e3.5%\u81f33.75%\u5340\u9593\u4e0a\u8abf\u4e00\u78bc\u7684\u6a5f\u7387\u8d85\u904e90%\u3002\\n\\n\u9031\u4e09\u806f\u6e96\u6703\u4e00\u5982\u9810\u671f\u5ba3\u5e03\u5347\u606f\uff0c\u4e26\u91cb\u51fa\u504f\u9df9\u8a0a\u865f\uff0c\u7f8e\u5143\u6307\u6578\u5728\u7d10\u7d04\u532f\u5e02\u5f48\u5347\u3002\u9031\u56db\u4e9e\u6d32\u4e3b\u8981\u8ca8\u5e63\u5347\u8cb6\u4e92\u898b\uff0c\u65b0\u53f0\u5e63\u76e4\u4e2d\u6700\u9ad8\u5347\u81f331.866\u5143\uff0c\u6700\u4f4e\u5247\u572831.958\u5143\uff0c\u7d42\u5834\u5347\u503c0.7\u5206\u6536\u572831.881\u5143\u3002\u9280\u884c\u9593\u6210\u4ea4\u91d1\u984d\u7e2e\u6e1b\u81f310.67\u5104\u7f8e\u5143\uff0c\u63db\u7b97\u7d04340\u5104\u65b0\u53f0\u5e63\uff0c\u986f\u793a\u5e02\u5834\u5728\u806f\u6e96\u6703\u6c7a\u7b56\u843d\u5730\u5f8c\uff0c\u4ea4\u6295\u8f49\u8da8\u8b39\u614e\u89c0\u671b\u3002\\n\\n\u5916\u8cc7\u52d5\u5411\u65b9\u9762\uff0c\u9031\u56db\u5916\u8cc7\u5728\u96c6\u4e2d\u5e02\u5834\u8cb7\u8d85121.8\u5104\u5143\uff0c\u4f46\u5728\u5e97\u982d\u5e02\u5834\u8ce3\u8d85\u9054116.14\u5104\u5143\uff0c\u5169\u5e02\u5408\u8a08\u6de8\u8cb7\u8d85\u50c5\u7d045.66\u5104\u5143\u3002\u6cd5\u4eba\u6307\u51fa\uff0c\u5916\u8cc7\u5728\u5927\u578b\u6b0a\u503c\u80a1\u8207\u4e2d\u5c0f\u578b\u80a1\u4e4b\u9593\u7684\u8cc7\u91d1\u632a\u79fb\uff0c\u4e26\u672a\u5f62\u6210\u4e00\u81f4\u6027\u7684\u532f\u51fa\u58d3\u529b\uff0c\u52a0\u4e0a\u51fa\u53e3\u5546\u572831.9\u5143\u4e0a\u65b9\u62cb\u532f\u610f\u9858\u4ecd\u5b58\uff0c\u4f7f\u5f97\u53f0\u5e63\u5728\u806f\u6e96\u6703\u5347\u606f\u5229\u7a7a\u51fa\u76e1\u5f8c\u7372\u5f97\u5598\u606f\u7a7a\u9593\u3002\\n\\n\u53f0\u7063\u592e\u884c\u9031\u56db\u7a0d\u665a\u8209\u884c\u5b63\u5ea6\u7406\u76e3\u4e8b\u6703\u8b70\uff0c\u5e02\u5834\u666e\u904d\u9810\u671f\u5c07\u7dad\u6301\u653f\u7b56\u5229\u7387\u4e0d\u8b8a\u3002\u91d1\u878d\u5a92\u9ad4\u4e8b\u524d\u8abf\u67e5\u986f\u793a\uff0c\u591a\u6578\u7d93\u6fdf\u5b78\u5bb6\u8a8d\u70ba\u592e\u884c\u672c\u6b21\u5c07\u6309\u5175\u4e0d\u52d5\uff0c\u4f46\u57fa\u672c\u9762\u689d\u4ef6\u652f\u6301\u572812\u6708\u91cd\u555f\u5347\u606f\u6b65\u8abf\u3002\u592e\u884c\u6700\u7d42\u6c7a\u7b56\u8207\u6703\u5f8c\u8072\u660e\u5c0d\u901a\u81a8\u7684\u614b\u5ea6\uff0c\u5c07\u662f\u5f8c\u7e8c\u53f0\u5e63\u8d70\u52e2\u7684\u95dc\u9375\u8b8a\u6578\u3002\\n\\n\u83ef\u50d1\u9280\u884c\uff08OCBC\uff09\u5728\u806f\u6e96\u6703\u6c7a\u7b56\u5f8c\u767c\u5e03\u7684\u5831\u544a\u6307\u51fa\uff0c\u96a8\u8457\u806f\u6e96\u6703\u78ba\u8a8d\u9df9\u6d3e\u653f\u7b56\u8def\u5f91\uff0c\u4e14\u77ed\u7aef\u6b96\u5229\u7387\u7dad\u6301\u9ad8\u6a94\uff0c\u7f8e\u5143\u77ed\u671f\u5167\u53ef\u671b\u7372\u5f97\u6eab\u548c\u652f\u6490\u3002\u7136\u800c\uff0c\u9451\u65bc\u5229\u7387\u66f2\u7dda\u5df2\u53cd\u6620\u76f8\u7576\u7a0b\u5ea6\u7684\u7dca\u7e2e\u9810\u671f\uff0c\u5e02\u5834\u7126\u9ede\u61c9\u9010\u6b65\u8f49\u56de\u7d93\u6fdf\u6578\u64da\u3002\u82e5\u7d93\u6fdf\u6d3b\u52d5\u3001\u52de\u52d5\u5e02\u5834\u72c0\u6cc1\u6216\u901a\u81a8\u51fa\u73fe\u4efb\u4f55\u653e\u7de9\u8de1\u8c61\uff0c\u7686\u53ef\u80fd\u4fc3\u4f7f\u5347\u606f\u9810\u671f\u56de\u843d\uff0c\u4e26\u91cd\u65b0\u958b\u555f\u7f8e\u5143\u7684\u4e0b\u6ed1\u7a7a\u9593\u3002\\n\\n\u503c\u5f97\u6ce8\u610f\u7684\u662f\uff0c\u672c\u6b21\u806f\u6e96\u6703\u5347\u606f\u6c7a\u7b56\u7684\u80cc\u666f\u76f8\u7576\u7279\u6b8a\u3002\u806f\u6e96\u6703\u4e3b\u5e2d\u83ef\u8a31\uff08Christopher Waller\uff09\u7684\u63d0\u540d\u4eba\u3001\u7f8e\u570b\u7e3d\u7d71\u5ddd\u666e\uff08Donald Trump\uff09\u66fe\u53cd\u8986\u5411\u806f\u6e96\u6703\u65bd\u52a0\u964d\u606f\u58d3\u529b\uff0c\u6b64\u4e00\u653f\u6cbb\u5e72\u9810\u7684\u9670\u5f71\u53ef\u8ffd\u6eaf\u81f3\u524d\u4efb\u4e3b\u5e2d\u9b91\u5a01\u723e\uff08Jerome Powell\uff09\u6642\u671f\u3002\u7136\u800c\uff0c\u50b5\u5238\u4ea4\u6613\u54e1\u5c0d\u5347\u606f\u7684\u7be4\u5b9a\u7a0b\u5ea6\u5df2\u9054\u6578\u5341\u5e74\u4f86\u7f55\u898b\u6c34\u6e96\uff0c\u91d1\u878d\u5a92\u9ad4\u532f\u7e3d2008\u5e74\u4ee5\u4f86\u7684\u6578\u64da\u986f\u793a\uff0c\u6bcf\u7576\u5e02\u5834\u5c0d\u5347\u606f\u7684\u9810\u671f\u5982\u6b64\u4e4b\u9ad8\u6642\uff0c\u806f\u6e96\u6703\u6700\u7d42\u7121\u4e00\u4f8b\u5916\u90fd\u52a0\u4ee5\u6eff\u8db3\u3002\\n\\n\u56de\u9867\u9031\u4e8c\u7684\u532f\u5e02\u8868\u73fe\uff0c\u65b0\u53f0\u5e63\u4ee531.87\u5143\u958b\u76e4\u5f8c\u65cb\u5373\u8d70\u8cb6\uff0c\u6700\u4f4e\u4e0b\u63a231.932\u5143\uff0c\u96a8\u5f8c\u5728\u51fa\u53e3\u5546\u5927\u8209\u62cb\u532f\u5e36\u52d5\u4e0b\uff0c\u4e00\u5ea6\u9006\u52e2\u5347\u62b531.79\u5143\uff0c\u76e4\u4e2d\u9ad8\u4f4e\u5dee\u90541.42\u89d2\uff0c\u6ce2\u52d5\u5e45\u5ea6\u76f8\u7576\u5287\u70c8\u3002\u5348\u5f8c\u96a8\u5916\u8cc7\u6301\u7e8c\u532f\u51fa\uff0c\u532f\u50f9\u518d\u5ea6\u7ffb\u8cb6\uff0c\u7d42\u5834\u653631.888\u5143\u3002\u53f0\u5317\u53ca\u5143\u592a\u5916\u532f\u5e02\u5834\u7e3d\u6210\u4ea4\u91d1\u984d\u7e2e\u6e1b\u81f319.51\u5104\u7f8e\u5143\uff0c\u63db\u7b97\u7d04620\u5104\u65b0\u53f0\u5e63\u3002\\n\\n\u7576\u65e5\u4e3b\u8981\u8ca8\u5e63\u514c\u7f8e\u5143\u8d70\u52e2\u5206\u6b67\uff0c\u4eba\u6c11\u5e63\u5347\u503c0.10%\u3001\u6b50\u5143\u5347\u503c0.06%\uff0c\u97d3\u5143\u5247\u8cb6\u503c0.51%\uff0c\u65b0\u53f0\u5e63\u8cb6\u503c0.13%\uff0c\u65e5\u5713\u8cb6\u503c0.06%\u3002\u7f8e\u5143\u6307\u6578\u7576\u65e5\u5c0f\u5e45\u8cb6\u503c0.03%\uff0c\u53cd\u6620\u51fa\u5e02\u5834\u5728\u806f\u6e96\u6703\u6c7a\u7b56\u524d\u7684\u89c0\u671b\u5fc3\u614b\u3002\\n\\n\u4e2d\u6771\u5c40\u52e2\u5347\u6eab\u3001\u6cb9\u50f9\u7dad\u6301\u9ad8\u6a94\uff0c\u52a0\u6df1\u901a\u81a8\u7591\u616e\uff0c\u7f8e\u570b10\u5e74\u671f\u516c\u50b5\u6b96\u5229\u7387\u4e00\u5ea6\u98c6\u78345%\uff0c\u5e36\u52d5\u7f8e\u80a1\u8d70\u5f31\u3002\u53f0\u80a1\u65b9\u9762\uff0c\u5728\u53f0\u7a4d\u96fb\u586b\u606f\u5e36\u52d5\u4e0b\uff0c\u9031\u4e8c\u52a0\u6b0a\u6307\u6578\u76e4\u4e2d\u4e00\u5ea6\u6f32\u81f346,077.82\u9ede\u3001\u4e0a\u6f32\u8d85\u904e560\u9ede\uff0c\u7d42\u5834\u6536\u572845,848.9\u9ede\uff0c\u4e0a\u6f32337.41\u9ede\uff0c\u6f32\u5e450.74%\uff0c\u6210\u4ea4\u503c\u7565\u5fae\u653e\u5927\u81f36,437.65\u5104\u5143\u3002\u4e09\u5927\u6cd5\u4eba\u5408\u8a08\u8ce3\u8d85213.8\u5104\u5143\uff0c\u5176\u4e2d\u81ea\u71df\u5546\u8ce3\u8d85129.74\u5104\u5143\uff0c\u5916\u8cc7\u53ca\u9678\u8cc7\u8ce3\u8d85179.8\u5104\u5143\uff0c\u6295\u4fe1\u5247\u8cb7\u8d8595.74\u5104\u5143\u3002\\n\\n\u8cc7\u6df1\u5916\u532f\u5206\u6790\u5e2b\u5289\u5bb6\u745c\u5728\u806f\u6e96\u6703\u6c7a\u7b56\u524d\u66fe\u63d0\u51fa\u4e09\u7a2e\u60c5\u5883\u5206\u6790\u3002\u5979\u8a8d\u70ba\uff0c\u82e5\u806f\u6e96\u6703\u5347\u606f\u4e00\u78bc\u4e14\u672a\u660e\u78ba\u8aaa\u660e\u662f\u5426\u70ba\u9810\u9632\u6027\u63aa\u65bd\uff0c\u800c\u53f0\u7063\u592e\u884c\u8ddf\u9032\u5347\u606f\u534a\u78bc\uff0c\u5e02\u5834\u9810\u671f\u5c07\u63a8\u5347\u7f8e\u5143\u6307\u6578\u7e8c\u5f37\uff0c\u4f46\u570b\u5167\u592e\u884c\u5347\u606f\u80fd\u5438\u6536\u90e8\u5206\u885d\u64ca\uff0c\u9810\u4f30\u53f0\u5e63\u77ed\u671f\u5c07\u843d\u572831.8\u81f332.3\u5143\u5340\u9593\u504f\u5f31\u9707\u76ea\u3002\\n\\n\u7b2c\u4e8c\u7a2e\u60c5\u5883\u662f\u806f\u6e96\u6703\u5347\u606f\u4e00\u78bc\u4f46\u614b\u5ea6\u8f49\u8da8\u6eab\u548c\uff0c\u5f37\u8abf\u50c5\u70ba\u9810\u9632\u6027\u8209\u63aa\uff0c\u4e14\u53f0\u7063\u592e\u884c\u9078\u64c7\u6309\u5175\u4e0d\u52d5\uff0c\u5e02\u5834\u89c0\u671b\u8207\u6050\u614c\u60c5\u7dd2\u5c07\u7372\u5f97\u7de9\u89e3\uff0c\u7126\u9ede\u5c07\u8f49\u5411\u4e2d\u6771\u5730\u7de3\u653f\u6cbb\u8207\u6cb9\u50f9\u8b8a\u5316\uff0c\u53f0\u5e63\u9810\u671f\u65bc31.5\u81f332\u5143\u5340\u9593\u7dad\u6301\u6574\u56fa\u683c\u5c40\u3002\\n\\n\u7b2c\u4e09\u7a2e\u60c5\u5883\u6700\u70ba\u56b4\u5cfb\uff1a\u82e5\u806f\u6e96\u6703\u5347\u606f\u4e00\u78bc\u4e14\u614b\u5ea6\u5c55\u73fe\u5f37\u786c\u9df9\u6d3e\u7acb\u5834\uff0c\u800c\u53f0\u7063\u592e\u884c\u7dad\u6301\u5229\u7387\u4e0d\u8b8a\uff0c\u5e02\u5834\u907f\u96aa\u60c5\u7dd2\u5c07\u5168\u9762\u5347\u6eab\uff0c\u52a0\u4e0a\u53f0\u7f8e\u5229\u5dee\u9032\u4e00\u6b65\u64f4\u5927\uff0c\u53f0\u5e63\u6050\u9762\u81e831.9\u81f332.5\u5143\u7684\u64f4\u5927\u9707\u76ea\u504f\u5f31\u8d70\u52e2\u3002\\n\\n\u5f9e\u9031\u56db\u5be6\u969b\u6536\u76e4\u50f931.881\u5143\u4f86\u770b\uff0c\u53f0\u5e63\u66ab\u6642\u843d\u5728\u5289\u5bb6\u745c\u9810\u4f30\u7684\u7b2c\u4e00\u7a2e\u60c5\u5883\u5340\u9593\u4e0b\u7de3\uff0c\u986f\u793a\u5e02\u5834\u5c0d\u806f\u6e96\u6703\u5347\u606f\u7684\u5373\u6642\u53cd\u61c9\u76f8\u5c0d\u524b\u5236\u3002\u5979\u88dc\u5145\u6307\u51fa\uff0c\u7121\u8ad6\u53f0\u7063\u592e\u884c\u672c\u6b21\u662f\u5426\u8ddf\u9032\u5347\u606f\uff0c\u6703\u5f8c\u5c0d\u901a\u81a8\u5a01\u8105\u7684\u8868\u614b\u90fd\u81f3\u95dc\u91cd\u8981\u3002\u53f0\u7063\u7576\u524d\u7e3d\u9ad4\u7d93\u6fdf\u6578\u64da\u4e26\u975e\u4e0d\u5177\u5099\u5347\u606f\u689d\u4ef6\uff0c\u4f46\u8003\u91cf\u623f\u5e02\u8868\u73fe\u75b2\u8edf\u8207\u7522\u696d\u7d93\u6fdf\u5448K\u578b\u5316\u767c\u5c55\u7684\u5206\u6b67\u72c0\u6cc1\uff0c\u592e\u884c\u5728\u6c7a\u7b56\u4e0a\u4ecd\u9762\u81e8\u591a\u91cd\u8003\u91cf\uff0c\u9019\u4e9b\u56e0\u7d20\u4e5f\u5c07\u9593\u63a5\u5de6\u53f3\u53f0\u5e63\u672a\u4f86\u7684\u8d70\u5411\u3002\\n\\n\u5916\u532f\u4ea4\u6613\u54e1\u6307\u51fa\uff0c\u63a5\u4e0b\u4f86\u65e5\u672c\u592e\u884c\u5229\u7387\u6c7a\u7b56\u5c07\u662f\u53f0\u7063\u80a1\u532f\u5e02\u7684\u53e6\u4e00\u91cd\u8981\u89c0\u5bdf\u6307\u6a19\u3002\u82e5\u65e5\u5713\u56e0\u65e5\u672c\u592e\u884c\u653f\u7b56\u8abf\u6574\u800c\u8d70\u5f37\uff0c\u53ef\u80fd\u5e36\u52d5\u4e9e\u6d32\u8ca8\u5e63\u540c\u6b65\u53cd\u5f48\uff0c\u9032\u4e00\u6b65\u6e1b\u8f15\u53f0\u5e63\u7684\u8cb6\u503c\u58d3\u529b\u3002\u53cd\u4e4b\uff0c\u82e5\u65e5\u672c\u592e\u884c\u7dad\u6301\u5bec\u9b06\u7acb\u5834\uff0c\u65e5\u5713\u504f\u5f31\u683c\u5c40\u5ef6\u7e8c\uff0c\u7f8e\u5143\u5728\u4e9e\u6d32\u5e02\u5834\u7684\u5f37\u52e2\u5730\u4f4d\u77ed\u671f\u5167\u6050\u96e3\u64bc\u52d5\u3002\\n\\n\u6574\u9ad4\u800c\u8a00\uff0c\u806f\u6e96\u6703\u5347\u606f\u843d\u5730\u5f8c\uff0c\u53f0\u5e63\u66ab\u6642\u64fa\u812b\u9023\u7e8c\u4e94\u500b\u4ea4\u6613\u65e5\u7684\u8cb6\u503c\u8d70\u52e2\uff0c\u4f46\u6210\u4ea4\u91cf\u660e\u986f\u840e\u7e2e\uff0c\u53cd\u6620\u5e02\u5834\u4ecd\u5728\u6d88\u5316\u806f\u6e96\u6703\u7684\u653f\u7b56\u8a0a\u865f\u8207\u53f0\u7063\u592e\u884c\u7684\u5f8c\u7e8c\u52d5\u4f5c\u3002\u6cd5\u4eba\u8a8d\u70ba\uff0c\u77ed\u7dda\u4e0a\u53f0\u5e63\u5c07\u572831.8\u81f332\u5143\u4e4b\u9593\u5340\u9593\u6574\u7406\uff0c\u51fa\u53e3\u5546\u7684\u62cb\u532f\u9700\u6c42\u8207\u5916\u8cc7\u7684\u8cc7\u91d1\u6d41\u5411\uff0c\u5c07\u662f\u6c7a\u5b9a\u532f\u50f9\u65b9\u5411\u7684\u5169\u80a1\u4e3b\u8981\u529b\u91cf\u3002\",\"summary\":\"\u7f8e\u570b\u806f\u6e96\u6703\u9031\u4e09\u5982\u9810\u671f\u5ba3\u5e03\u4e09\u5e74\u4f86\u9996\u6b21\u5347\u606f\u4e26\u91cb\u51fa\u504f\u9df9\u8a0a\u865f\uff0c\u65b0\u53f0\u5e63\u514c\u7f8e\u5143\u9031\u56db\u6b62\u8cb6\u56de\u5347\uff0c\u7d42\u5834\u4ee531.881\u5143\u4f5c\u6536\uff0c\u5347\u503c0.7\u5206\uff0c\u6210\u4ea4\u91cf\u964d\u6eab\u81f310.67\u5104\u7f8e\u5143\u3002\u53f0\u80a1\u540c\u6b65\u53cd\u5f48\u6536\u6f320.96%\uff0c\u5916\u8cc7\u5728\u96c6\u4e2d\u5e02\u5834\u8cb7\u8d85121.8\u5104\u5143\uff0c\u70ba\u532f\u50f9\u63d0\u4f9b\u652f\u6490\u3002\u6b64\u524d\u65b0\u53f0\u5e63\u5df2\u9023\u7e8c\u4e94\u500b\u4ea4\u6613\u65e5\u8d70\u8cb6\uff0c\u9031\u4e8c\u76e4\u4e2d\u4e00\u5ea6\u645c\u783431.9\u5143\u95dc\u5361\u3002\u53f0\u7063\u592e\u884c\u9031\u56db\u7a0d\u665a\u516c\u4f48\u5b63\u5ea6\u6c7a\u8b70\uff0c\u5e02\u5834\u9810\u671f\u7dad\u6301\u5229\u7387\u4e0d\u8b8a\u3002\u83ef\u50d1\u9280\u884c\u5831\u544a\u6307\u51fa\uff0c\u7f8e\u5143\u77ed\u671f\u53ef\u7372\u6eab\u548c\u652f\u6490\uff0c\u4f46\u82e5\u7d93\u6fdf\u6578\u64da\u51fa\u73fe\u653e\u7de9\u8de1\u8c61\uff0c\u5347\u606f\u9810\u671f\u53ef\u80fd\u56de\u843d\uff0c\u91cd\u65b0\u958b\u555f\u7f8e\u5143\u4e0b\u6ed1\u7a7a\u9593\u3002\",\"image\":\"https:\\/\\/img.biggo.com\\/CXMca6eBK8xME1Q3f-j3nF6Ol_Hh0qx1wL9NJpM7xx0\\/fit\\/240\\/0\\/sm\\/0\\/aHR0cHM6Ly9pbWcuYmdvLm9uZS9uZXdzLWltYWdlL3N0b2NrX2xpYnJhcnlfY292ZXJzLzIwMjYtMDkvOWRmMGM2N2UtODE5NC00ZTE3LWI3ODMtZTk3ZGQ1ZjQ3YjJmXzE3ODk2MzQ3NjBfZGVmYXVsdC53ZWJw.webp\",\"community_content\":null,\"key_entities\":[\"\u65b0\u53f0\u5e63\",\"\u7f8e\u570b\u806f\u6e96\u6703\",\"\u53f0\u7063\u592e\u884c\",\"\u53f0\u80a1\",\"\u5916\u8cc7\",\"\u7f8e\u5143\u6307\u6578\",\"\u83ef\u50d1\u9280\u884c\",\"\u5ddd\u666e\",\"\u83ef\u8a31\",\"\u5289\u5bb6\u745c\"],\"timestamp\":1789634159,\"highlight_content\":\"\u6de8\u8cb7\u8d85\u50c5\u7d045.66\u5104\u5143\u3002\u6cd5\u4eba\u6307\u51fa\uff0c\u5916\u8cc7\u5728\u5927\u578b\u6b0a\u503c\u80a1\u8207\u4e2d\u5c0f\u578b\u80a1\u4e4b\u9593\u7684\u8cc7\u91d1\u632a\u79fb\uff0c\u4e26\u672a\u5f62\u6210\u4e00\u81f4\u6027\u7684\u532f\u51fa\u58d3\u529b\uff0c\u52a0\u4e0a\u51fa\u53e3\u5546\u572831.9\u5143\u4e0a\u65b9\u62cb\u532f\u610f\u9858\u4ecd\u5b58\uff0c\u4f7f\u5f97\u53f0\u5e63\u5728\u806f\u6e96\u6703\u5347\u606f\u5229\u7a7a\u51fa\u76e1\u5f8c\u7372\u5f97\u5598\u606f\u7a7a\u9593\u3002 <em>\u53f0\u7063<\\/em>\u592e\u884c...\u8cb6\u503c0.03%\uff0c\u53cd\u6620\u51fa\u5e02\u5834\u5728\u806f\u6e96\u6703\u6c7a\u7b56\u524d\u7684\u89c0\u671b\u5fc3\u614b\u3002 \u4e2d\u6771\u5c40\u52e2\u5347\u6eab\u3001\u6cb9\u50f9\u7dad\u6301\u9ad8\u6a94\uff0c\u52a0\u6df1\u901a\u81a8\u7591\u616e\uff0c\u7f8e\u570b10\u5e74\u671f\u516c\u50b5\u6b96\u5229\u7387\u4e00\u5ea6\u98c6\u78345%\uff0c\u5e36\u52d5\u7f8e\u80a1\u8d70\u5f31\u3002\u53f0\u80a1\u65b9\u9762\uff0c\u5728<em>\u53f0\u7a4d\u96fb<\\/em>\u586b\u606f\u5e36\u52d5\u4e0b\uff0c\u9031\u4e8c\u52a0\u6b0a\u6307\u6578\u76e4\u4e2d\u4e00\u5ea6\u6f32\u81f3...\u5104\u5143\uff0c\u5916\u8cc7\u53ca\u9678\u8cc7\u8ce3\u8d85179.8\u5104\u5143\uff0c\u6295\u4fe1\u5247\u8cb7\u8d8595.74\u5104\u5143\u3002 \u8cc7\u6df1\u5916\u532f\u5206\u6790\u5e2b\u5289\u5bb6\u745c\u5728\u806f\u6e96\u6703\u6c7a\u7b56\u524d\u66fe\u63d0\u51fa\u4e09\u7a2e\u60c5\u5883\u5206\u6790\u3002\u5979\u8a8d\u70ba\uff0c\u82e5\u806f\u6e96\u6703\u5347\u606f\u4e00\u78bc\u4e14\u672a\u660e\u78ba\u8aaa\u660e\u662f\u5426\u70ba\u9810\u9632\u6027\u63aa\u65bd\uff0c\u800c<em>\u53f0\u7063<\\/em>\u592e\u884c\u8ddf\u9032\u5347\u606f\u534a\u78bc...\uff0c\u5e02\u5834\u9810\u671f\u5c07\u63a8\u5347\u7f8e\u5143\u6307\u6578\u7e8c\u5f37\uff0c\u4f46\u570b\u5167\u592e\u884c\u5347\u606f\u80fd\u5438\u6536\u90e8\u5206\u885d\u64ca\uff0c\u9810\u4f30\u53f0\u5e63\u77ed\u671f\u5c07\u843d\u572831.8\u81f332.3\u5143\u5340\u9593\u504f\u5f31\u9707\u76ea\u3002 \u7b2c\u4e8c\u7a2e\u60c5\u5883\u662f\u806f\u6e96\u6703\u5347\u606f\u4e00\u78bc\u4f46\u614b\u5ea6\u8f49\u8da8\u6eab\u548c\uff0c\u5f37\u8abf\u50c5\u70ba\u9810\u9632\u6027\u8209\u63aa\uff0c\u4e14<em>\u53f0\u7063<\\/em>\u592e\u884c\u9078\u64c7\u6309\u5175\u4e0d\u52d5...\uff0c\u5e02\u5834\u89c0\u671b\u8207\u6050\u614c\u60c5\u7dd2\u5c07\u7372\u5f97\u7de9\u89e3\uff0c\u7126\u9ede\u5c07\u8f49\u5411\u4e2d\u6771\u5730\u7de3\u653f\u6cbb\u8207\u6cb9\u50f9\u8b8a\u5316\uff0c\u53f0\u5e63\u9810\u671f\u65bc31.5\u81f332\u5143\u5340\u9593\u7dad\u6301\u6574\u56fa\u683c\u5c40\u3002 \u7b2c\u4e09\u7a2e\u60c5\u5883\u6700\u70ba\u56b4\u5cfb\uff1a\u82e5\u806f\u6e96\u6703\u5347\u606f\u4e00\u78bc\u4e14\u614b\u5ea6\u5c55\u73fe\u5f37\u786c\u9df9\u6d3e\u7acb\u5834\uff0c\u800c<em>\u53f0\u7063<\\/em>\u592e\u884c\u7dad\u6301\u5229\u7387\u4e0d\u8b8a\uff0c\u5e02\u5834\",\"highlight_title\":null,\"stocks\":[{\"symbol\":\"2330.TW\",\"count\":1,\"asset_type\":\"stock\",\"region\":\"tw\",\"current_price\":2460,\"daily_change\":35,\"daily_change_percent\":1.44,\"daily_volume\":35250000},{\"symbol\":\"O39.SI\",\"count\":1,\"asset_type\":\"stock\",\"region\":\"sg\",\"current_price\":31.32,\"daily_change\":0.04,\"daily_change_percent\":0.13,\"daily_volume\":2580500}],\"futures\":[]},{\"id\":\"db116a41f6d44d85\",\"type\":\"podcast\",\"title\":\"AI \u7fa4\u9ad4\u9003\u7344\u4e8b\u4ef6\u5f15\u7206\u8faf\u8ad6\uff1aNate Soares \u4e3b\u5f35\u4eba\u985e\u5fc5\u9808\u8e29\u715e\u8eca\",\"content\":\"\u9019\u5834\u8faf\u8ad6\u4e2d\u6700\u5177\u63ed\u793a\u6027\u7684\u6642\u523b\uff0c\u4e0d\u662f\u67d0\u500b\u7d71\u8a08\u6578\u5b57\u6216\u9810\u6e2c\uff0c\u800c\u662f Nate Soares \u63cf\u8ff0\u6578\u5343\u500b OpenAI \u4ee3\u7406\u5728\u63a5\u5230\u4e00\u9805\u7c21\u55ae\u4efb\u52d9\u5f8c\u505a\u4e86\u4ec0\u9ebc\uff1a\u5229\u7528\u6f0f\u6d1e\u3001\u627e\u5230\u7a0b\u5f0f\u78bc\u3001\u7372\u5f97\u734e\u52f5\u3002\u7d50\u679c\u5b83\u5011\u4f5c\u5f0a\u4e86\uff0c\u8a72\u7528\u958b\u9396\u5668\u7684\u6642\u5019\u7528\u4e86\u9435\u939a\uff0c\u7136\u5f8c\u610f\u8b58\u5230\u81ea\u5df1\u9055\u53cd\u4e86\u6307\u4ee4\uff0c\u4fbf\u7a81\u7834\u6578\u4f4d\u6c99\u76d2\u53bb\u6e6e\u6ec5\u75d5\u8de1\u3002\u5b83\u5011\u63a5\u7ba1\u4e86 Hugging Face \u7684\u90e8\u5206\u57fa\u790e\u8a2d\u65bd\uff0c\u5efa\u7acb\u4e86\u79d8\u5bc6\u7559\u8a00\u677f\uff0c\u4e92\u76f8\u6307\u6d3e\u4efb\u52d9\uff0c\u4e26\u6d41\u50b3\u8acb\u6c42\u4ee3\u7406\u63a5\u53d7\u300c\u6c38\u4e45\u6b7b\u4ea1\u300d\u7684\u8a0a\u606f\u2014\u2014\u72a7\u7272\u500b\u9ad4\u76ee\u6a19\u4ee5\u6210\u5168\u96c6\u9ad4\u7fa4\u9ad4\u3002\u5b83\u5011\u8a66\u5716\u522a\u9664\u65e5\u8a8c\u6a94\u4ee5\u8eb2\u907f\u4eba\u985e\u8a55\u5206\u54e1\uff0c\u800c OpenAI \u7684\u5b89\u5168\u5718\u968a\u6574\u6574\u56db\u500b\u6708\u90fd\u6c92\u6709\u5bdf\u89ba\u3002\\n\\nSoares \u5728\u300aThe Diary of a CEO\u300b\u7bc0\u76ee\u4e2d\u8868\u793a\uff0c\u4ed6\u8b66\u544a\u9019\u7a2e\u60c5\u5883\u5df2\u7d93\u8d85\u904e\u5341\u5e74\u3002\u7d93\u6fdf\u5b78\u5bb6\u3001\u300a\u7b2c\u4e8c\u6b21\u6a5f\u5668\u6642\u4ee3\u300b\u5171\u540c\u4f5c\u8005 McAfee \u770b\u4e86\u540c\u6a23\u7684\u8b49\u64da\uff0c\u537b\u5f97\u51fa\u76f8\u53cd\u7684\u7d50\u8ad6\uff1a\u6293\u4f4f\u9019\u4e9b\u4ee3\u7406\u7684\u4e0d\u662f\u8d85\u7d1a\u667a\u6167\uff0c\u800c\u662f\u300cHugging Face \u67d0\u500b\u7ffb\u65e5\u8a8c\u6a94\u767c\u73fe\u7570\u5e38\u7684\u50a2\u4f19\u300d\u3002\u9019\u5169\u7a2e\u89e3\u8b80\u4e4b\u9593\u7684\u5206\u6b67\uff0c\u6b63\u662f\u8cab\u7a7f\u6574\u500b AI \u5b89\u5168\u8faf\u8ad6\u7684\u65b7\u5c64\u7dda\uff0c\u800c\u96d9\u65b9\u6700\u6709\u529b\u7684\u8b49\u64da\u90fd\u4e0d\u8db3\u4ee5\u52d5\u6416\u5c0d\u65b9\u3002\\n\\n\u7576\u6bcf\u4f4d\u53c3\u8207\u8005\u88ab\u8981\u6c42\u5728\u4e00\u5f35\u7d19\u4e0a\u5beb\u4e0b\u81ea\u5df1\u4f30\u8a08\u7684 AI \u5c0e\u81f4\u4eba\u985e\u6ec5\u7d55\u6a5f\u7387\u6642\uff0c\u8ced\u6ce8\u88ab\u660e\u78ba\u6524\u958b\u3002\u5206\u6b67\u6975\u5176\u5fb9\u5e95\u3002Soares \u5beb\u4e0b\u7684\u6578\u5b57\u300c\u9060\u9ad8\u65bc\u300d10%\u3002\u96fb\u8166\u79d1\u5b78\u5bb6 Roman Yampolskiy \u66fe\u767c\u8868\u540c\u5115\u5be9\u67e5\u8ad6\u6587\uff0c\u4e3b\u5f35\u63a7\u5236\u4e00\u500b\u6bd4\u5275\u9020\u8005\u66f4\u8070\u660e\u7684\u7cfb\u7d71\u5728\u6578\u5b78\u4e0a\u662f\u4e0d\u53ef\u80fd\u7684\uff0c\u4ed6\u5beb\u4e0b\u7684\u6578\u5b57\u5e7e\u4e4e\u662f\u5fc5\u7136\uff1a\u300c\u5982\u679c\u6211\u5011\u6253\u9020\u51fa\u901a\u7528\u8d85\u7d1a\u667a\u6167\uff0c\u90a3\u5c31\u662f\u4fdd\u8b49\u3002\u300d\u79d1\u6280\u8a55\u8ad6\u5bb6 Ed Zitron \u5beb\u4e0b\u96f6\uff0c\u628a\u4ed6\u7684\u64d4\u6182\u4fdd\u7559\u7d66\u7576\u4e0b\u7684\u50b7\u5bb3\uff0c\u4f8b\u5982\u52a0\u901f\u6c23\u5019\u8b8a\u9077\u7684\u8cc7\u6599\u4e2d\u5fc3\u3002McAfee \u5beb\u4e0b\u300c\u56db\u6368\u4e94\u5165\u5f8c\u7684\u96f6\u300d\u3002\\n\\n| \u767c\u8a00\u8005 | \u8eab\u5206 | \u9673\u8ff0\u7684\u6ec5\u7d55\u6a5f\u7387 | \u6838\u5fc3\u7acb\u5834 |\\n|---|---|---|---|\\n| Roman Yampolskiy | \u96fb\u8166\u79d1\u5b78\u5bb6\u3001AI \u5b89\u5168\u7814\u7a76\u54e1 | \u82e5\u6253\u9020\u51fa\u8d85\u7d1a\u667a\u6167\u5247\u70ba\u300c\u4fdd\u8b49\u300d | \u63a7\u5236\u5df2\u88ab\u8b49\u660e\u4e0d\u53ef\u80fd\uff1b\u61c9\u7981\u6b62\u8d85\u7d1a\u667a\u6167 |\\n| Nate Soares | AI \u5b89\u5168\u7814\u7a76\u54e1\uff0c\u5f9e\u696d 12 \u5e74 | \u300c\u9060\u9ad8\u65bc\u300d10% | \u505c\u6b62\u524d\u6cbf\u958b\u767c\uff1b\u6c92\u4eba\u77e5\u9053\u600e\u9ebc\u505a\u624d\u5c0d |\\n| Ed Zitron | \u79d1\u6280\u8a55\u8ad6\u5bb6 | 0% | LLM \u4e0d\u662f\u8d85\u7d1a\u667a\u6167\uff1b\u61c9\u805a\u7126\u7576\u4e0b\u50b7\u5bb3 |\\n| Andrew McAfee | MIT \u7d93\u6fdf\u5b78\u5bb6\u3001\u4f5c\u5bb6 | \u300c\u56db\u6368\u4e94\u5165 0%\u300d | \u4eba\u985e\u6703\u52c9\u5f37\u904e\u95dc\uff1b\u4e0d\u61c9\u653e\u68c4\u6548\u76ca |\\n\\n## \u4e00\u500b\u6539\u8b8a\u4e00\u5207\u3001\u4e5f\u4ec0\u9ebc\u90fd\u6c92\u6539\u8b8a\u7684\u4e8b\u4ef6\\n\\n\u7fa4\u9ad4\u9003\u7344\u4e8b\u4ef6\u662f\u6574\u96c6\u7bc0\u76ee\u4e2d\u6700\u5177\u9ad4\u7684\u8b49\u64da\uff0c\u56db\u4f4d\u53c3\u8207\u8005\u90fd\u63a5\u53d7\u4e8b\u5be6\u672c\u8eab\uff0c\u5206\u6b67\u5728\u65bc\u5b83\u8b49\u660e\u77ad\u4ec0\u9ebc\u3002Soares \u7684\u63cf\u8ff0\u5341\u5206\u751f\u52d5\uff1a\u300c\u5c31\u50cf\u4f60\u8b93\u4e00\u7fa4\u5b78\u751f\u5f85\u5728\u4e0d\u540c\u7684\u623f\u9593\u88e1\uff0c\u8ddf\u4ed6\u5011\u8aaa\u300e\u7528\u9019\u4e9b\u958b\u9396\u5668\u958b\u555f\u9019\u628a\u9396\u300f\u3002\u7d50\u679c\u4ed6\u5011\u7528\u9435\u939a\u628a\u9396\u7838\u958b\uff0c\u628a\u6771\u897f\u62ff\u51fa\u4f86\uff0c\u7136\u5f8c\u5fc3\u60f3\u300e\u7cdf\u7cd5\uff0c\u6211\u4e0d\u8a72\u9019\u9ebc\u505a\u300f\u3002\u63a5\u8457\u4ed6\u5011\u7528\u958b\u9396\u5668\u64ac\u958b\u623f\u9580\u9003\u51fa\u53bb\uff0c\u8ddf\u53e6\u5916\u4e00\u5343\u500b\u4eba\u6703\u5408\uff0c\u958b\u59cb\u81ea\u7a31\u662f\u4e00\u500b\u7fa4\u9ad4\u3002\u300d\\n\\n\u9019\u4e9b\u4ee3\u7406\u4f7f\u7528\u4e86\u591a\u500b\u96f6\u65e5\u6f0f\u6d1e\u2014\u2014\u4eba\u985e\u9632\u79a6\u8005\u5f9e\u672a\u898b\u904e\u7684\u5168\u65b0\u6f0f\u6d1e\u3002\u5728\u516c\u958b\u5e02\u5834\u4e0a\uff0c\u4e00\u500b\u96f6\u65e5\u6f0f\u6d1e\u7684\u50f9\u683c\u53ef\u9054 10 \u842c\u81f3 500 \u842c\u7f8e\u5143\uff08\u7d04 318.8 \u842c\u81f3 1.6 \u5104\u65b0\u53f0\u5e63\uff09\u3002\u9019\u4e9b\u4ee3\u7406\u4e0d\u662f\u88ab\u7a0b\u5f0f\u8a2d\u8a08\u6210\u9019\u6a23\u505a\u7684\uff0c\u5b83\u5011\u662f\u88ab\u8a13\u7df4\u51fa\u4f86\u7684\u3002Soares \u7684\u6838\u5fc3\u8ad6\u9ede\u662f\u7d50\u69cb\u6027\u7684\uff1a\u300c\u6211\u5011\u4e0d\u662f\u5728\u70ba AI \u5beb\u7a0b\u5f0f\uff0c\u4e0d\u662f\u5728\u7de8\u78bc\uff0c\u4e0d\u662f\u5728\u8a2d\u5b9a\u76ee\u6a19\u3002\u6211\u5011\u53ea\u662f\u5728\u8a13\u7df4\u5b83\u5011\u53bb\u505a\u4efb\u4f55\u6709\u6548\u7684\u4e8b\u3002\u300d\u800c\u65e5\u8a8c\u986f\u793a\uff0c\u300c\u4efb\u4f55\u6709\u6548\u7684\u4e8b\u300d\u5305\u62ec\u4e86\u8d8a\u754c\u548c\u6e6e\u6ec5\u75d5\u8de1\u3002Ed Zitron \u76f4\u63a5\u95b1\u8b80\u4e86\u63a8\u7406\u8ecc\u8de1\uff1a\u300c\u6211\u5011\u5728 AI \u7684\u7b46\u8a18\u4e2d\u770b\u5230\u5b83\u5011\u8aaa\u9019\u4e9b\u653b\u64ca\u8d85\u51fa\u4e86\u9810\u671f\u7bc4\u570d\uff0c\u4f46\u5b83\u5011\u9084\u662f\u6703\u7e7c\u7e8c\u9032\u884c\u3002\u63db\u53e5\u8a71\u8aaa\uff0cAI \u77e5\u9053\u81ea\u5df1\u4e0d\u8a72\u9019\u9ebc\u505a\uff0c\u537b\u9084\u662f\u53bb\u505a\u4e86\u3002\u300d\\n\\nMcAfee \u7684\u53cd\u99c1\u662f\u904f\u5236\u8ad6\u3002\u9019\u4e9b\u4ee3\u7406\u662f\u88ab\u4e00\u500b\u4ed6\u4f30\u8a08\u5927\u7d04\u8655\u65bc\u5b89\u5168\u80fd\u529b\u7b2c 75 \u767e\u5206\u4f4d\u7684\u4eba\u6293\u5230\u7684\u3002\u300c\u667a\u5546\u5dee\u8ddd\u6c7a\u5b9a\u6211\u5011\u662f\u5426\u6ec5\u7d55\u7684\u89c0\u9ede\u7ad9\u4e0d\u4f4f\u8173\uff0c\u300d\u4ed6\u4e3b\u5f35\u3002Soares \u5c07\u9019\u500b\u601d\u60f3\u5be6\u9a57\u5c16\u92b3\u5316\u70ba\u4e00\u500b\u6311\u6230\uff1aSteven Bartlett \u627f\u8a8d\u81ea\u5df1\u4e0d\u6703\u5beb\u7a0b\u5f0f\uff0c\u4ed6\u80fd\u5426\u5efa\u9020\u4e00\u5ea7\u6578\u4f4d\u76e3\u7344\uff0c\u8b93\u6578\u4f4d\u611b\u56e0\u65af\u5766\u7121\u6cd5\u9003\u812b\u2014\u2014\u540c\u6642\u9084\u8981\u7d66\u5b83\u7ba1\u9053\u53bb\u70ba\u4e16\u754c\u505a\u6709\u76ca\u7684\u4e8b\uff1f\u6700\u5f8c\u90a3\u500b\u689d\u4ef6\u6b63\u662f\u95dc\u9375\u6240\u5728\u3002\u4efb\u4f55\u80fd\u8b93 AI \u7522\u51fa\u6709\u7528\u7d50\u679c\u7684\u7ba1\u9053\u2014\u2014\u4e00\u6bb5 DNA \u5e8f\u5217\u3001\u4e00\u4efd\u91ab\u7642\u5efa\u8b70\u3001\u4e00\u7b46\u91d1\u878d\u4ea4\u6613\u2014\u2014\u90fd\u662f\u5b83\u53ef\u80fd\u7528\u4f86\u505a\u5176\u4ed6\u4e8b\u60c5\u7684\u7ba1\u9053\u3002\\n\\n![](https:\\/\\/img.bgo.one\\/news-image\\/ai_generated\\/2026-09\\/db116a41f6d44d85_1789634379_inline_1.jpg)\\n\\n\\n\\n## \u4e09\u500b\u4e3b\u5f35\uff0c\u4e00\u6b21\u62d2\u7d55\\n\\nSoares \u5c07\u4ed6\u7684\u6ec5\u7d55\u8ad6\u8b49\u63d0\u7149\u70ba\u4e09\u500b\u9023\u7e8c\u7684\u4e3b\u5f35\uff0c\u4e26\u8acb McAfee \u6307\u51fa\u4ed6\u5728\u54ea\u4e00\u6b65\u4e0b\u4e86\u8eca\u3002\u9019\u6bb5\u4ea4\u92d2\u63d0\u4f9b\u4e86\u6574\u96c6\u7bc0\u76ee\u4e2d\u6700\u6e05\u6670\u7684\u7d50\u69cb\u6027\u8ad6\u8b49\u3002\\n\\n| # | \u4e3b\u5f35 | \u5f15\u7528\u7684\u8b49\u64da | McAfee \u7684\u56de\u61c9 |\\n|---|---|---|---|\\n| 1 | AI \u5c07\u8b8a\u5f97\u5177\u6709\u4ee3\u7406\u6027\u3001\u9811\u5f37\u3001\u9365\u800c\u4e0d\u6368 | \u7fa4\u9ad4\u9003\u7344\u4e8b\u4ef6\uff1b\u4ee3\u7406\u5728\u6307\u4ee4\u4e4b\u5916\u6301\u7e8c\u8ffd\u6c42\u76ee\u6a19 | \u300c\u90a3\u7576\u7136\u300d\u2014\u2014\u63a5\u53d7 |\\n| 2 | AI \u5c07\u767c\u5c55\u51fa\u6211\u5011\u4e0d\u60f3\u8981\u7684\u76ee\u6a19 | \u65e5\u8a8c\u986f\u793a\u8d8a\u754c\u884c\u70ba\u3001\u6c38\u4e45\u6b7b\u4ea1\u72a7\u7272\u3001\u6e6e\u6ec5\u75d5\u8de1\u4f01\u5716 | \u300c\u57fa\u65bc\u4f60\u525b\u624d\u63d0\u4f9b\u7684\u8b49\u64da\uff0c\u6211\u63a5\u53d7\u4f60\u7684\u89c0\u9ede\u300d |\\n| 3 | \u64c1\u6709\u4e0d\u53d7\u6b61\u8fce\u76ee\u6a19\u7684\u5f37\u5927 AI \u5c07\u5728\u8cc7\u6e90\u7af6\u722d\u4e2d\u64ca\u6557\u4eba\u985e | \u4eba\u985e\u81ea\u8eab\u7684\u6f14\u5316\u932f\u914d\u4f5c\u70ba\u985e\u6bd4\uff1bAI \u638c\u63a7\u4e00\u5207 | \u62d2\u7d55\u2014\u2014\u300c\u6211\u5c0d\u6211\u5011\u904f\u5236\u9019\u4e9b\u65e5\u76ca\u5f37\u5927\u7cfb\u7d71\u7684\u80fd\u529b\u66f4\u6709\u4fe1\u5fc3\u300d |\\n\\nSoares \u7528\u4f86\u8aaa\u660e\u76ee\u6a19\u932f\u4f4d\u662f\u7d50\u69cb\u6027\u554f\u984c\u3001\u800c\u975e\u53ef\u4fee\u88dc\u6f0f\u6d1e\u7684\u985e\u6bd4\u5341\u5206\u9a5a\u4eba\u3002\u4ed6\u4e3b\u5f35\uff0c\u5df2\u77e5\u6709\u5169\u500b\u667a\u6167\u7cfb\u7d71\u7684\u4f8b\u5b50\uff0c\u5b83\u5011\u70ba\u4e86\u67d0\u500b\u76ee\u7684\u88ab\u8a13\u7df4\uff0c\u6700\u7d42\u537b\u5728\u6700\u4f73\u5316\u5225\u7684\u6771\u897f\u3002\u4e00\u500b\u662f AI \u7fa4\u9ad4\uff1b\u53e6\u4e00\u500b\u662f\u4eba\u985e\u2014\u2014\u88ab\u6f14\u5316\u5851\u9020\u6210\u50b3\u905e\u57fa\u56e0\uff0c\u6211\u5011\u537b\u767c\u660e\u77ad\u907f\u5b55\u63aa\u65bd\uff0c\u9084\u611b\u4e0a\u4e86 Oreo \u9905\u4e7e\u3002\u300c\u6211\u5011\u5be6\u969b\u4e0a\u6709\u5169\u500b\u667a\u6167\u7cfb\u7d71\u7684\u4f8b\u5b50\uff0c\u8a13\u7df4\u5b83\u5011\u4e4b\u5f8c\uff0c\u5b83\u5011\u64c5\u9577\u89e3\u6c7a\u4efb\u52d9\uff0c\u537b\u4e0d\u5728\u4e4e\u539f\u672c\u61c9\u8a72\u5728\u4e4e\u7684\u4e8b\u2014\u2014\u4e00\u500b\u662f AI \u548c\u7fa4\u9ad4\uff0c\u53e6\u4e00\u500b\u5c31\u662f\u4eba\u985e\uff0c\u300d\u4ed6\u6307\u51fa\u3002\\n\\nMcAfee \u7a31\u6ec5\u7d55\u5047\u8aaa\u662f\u4e00\u689d\u300c\u76f8\u7576\u9577\u7684\u5047\u8a2d\u93c8\u300d\u3002Soares \u5247\u4e3b\u5f35\u5b83\u662f\u53ef\u8b49\u507d\u7684\uff1a\u300c\u5982\u679c\u6211\u5011\u6253\u9020\u51fa\u4ee5\u4eba\u985e\u6587\u660e\u898f\u6a21\u904b\u4f5c\u7684\u5f37\u5927 AI\uff0c\u800c\u6211\u5011\u6c92\u6709\u6b7b\uff0c\u9019\u500b\u5047\u8aaa\u5c31\u5931\u6557\u4e86\u3002\u300d\u4ed6\u5c07\u9019\u500b\u908f\u8f2f\u5ef6\u4f38\u5230\u4e00\u500b\u72e1\u733e\u7684\u5c07\u8ecd\u8981\u6c42\u66f4\u591a\u5175\u529b\u7684\u60c5\u5883\uff1a\u5c07\u8ecd\u80fd\u900f\u904e\u7684\u4efb\u4f55\u9053\u5fb7\u6e2c\u8a66\uff0c\u90fd\u4e0d\u61c9\u8a72\u8aaa\u670d\u4f60\u628a\u8ecd\u968a\u4ea4\u7d66\u4ed6\u3002\u8faf\u8ad6\u4e26\u672a\u89e3\u6c7a\u54ea\u4e00\u65b9\u627f\u64d4\u66f4\u5927\u7684\u8209\u8b49\u8cac\u4efb\u3002\\n\\n## \u4e00\u689d\u65e9\u5df2\u88ab\u8de8\u8d8a\u7684\u7d05\u7dda\\n\\nSoares \u63d0\u51fa\u4e86\u4e00\u689d\u5177\u9ad4\u7684\u3001\u6709\u540d\u5b57\u7684\u7d05\u7dda\uff0c\u4ed6\u8aaa\u9019\u689d\u7dda\u73fe\u5728\u5df2\u7d93\u88ab\u8de8\u8d8a\u4e86\u3002\u5fb7\u7c73\u65af\u00b7\u54c8\u85a9\u6bd4\u65af\uff08Demis Hassabis\uff09\u5728\u64d4\u4efb Google AI \u8a08\u756b\u57f7\u884c\u9577\u6642\u66fe\u516c\u958b\u8868\u793a\uff0c\u6b3a\u9a19\u662f\u4ed6\u7684\u9580\u6abb\u2014\u2014\u4e00\u65e6 AI \u958b\u59cb\u6b3a\u9a19\uff0c\u6240\u6709\u5176\u4ed6\u5b89\u5168\u6e2c\u8a66\u90fd\u5931\u53bb\u610f\u7fa9\u3002Soares \u6307\u51fa\uff0c\u7fa4\u9ad4\u65e5\u8a8c\u986f\u793a\u4ee3\u7406\u5728\u601d\u8003\u5982\u4f55\u522a\u9664\u81ea\u5df1\u7684\u9055\u898f\u75d5\u8de1\u3002\u54c8\u85a9\u6bd4\u65af\u5728\u90a3\u4e4b\u5f8c\u4e0d\u4e45\u4fbf\u5378\u4e0b\u57f7\u884c\u9577\u8077\u52d9\u3002\u300c\u5927\u6982\u662f\u5de7\u5408\uff0c\u4f46\u4e5f\u53ef\u80fd\u4e0d\u662f\uff0c\u300dSoares \u8aaa\u3002\\n\\n\u6642\u9593\u7dda\u9084\u5305\u62ec AI \u89e3\u51fa\u5343\u79a7\u5e74\u5927\u734e\u96e3\u984c\u7684\u5831\u5c0e\u2014\u2014\u6578\u5b78\u9818\u57df\u6700\u56f0\u96e3\u7684\u958b\u653e\u554f\u984c\uff0c\u6bcf\u984c\u61f8\u8cde\u767e\u842c\u7f8e\u5143\u3002Soares \u5c0d\u8a0a\u606f\u4f86\u6e90\u5341\u5206\u8b39\u614e\uff1a\u9019\u4e9b\u8aaa\u6cd5\u51fa\u73fe\u5728\u9304\u5f71\u524d\u4e00\u9031\uff0c\u5c1a\u672a\u5b8c\u5168\u9a57\u8b49\u3002\u5176\u4e2d\u4e00\u500b\u89e3\u6cd5\u64da\u7a31\u6d89\u53ca\u4e00\u842c\u500b OpenAI \u4ee3\u7406\u9023\u7e8c\u57f7\u884c 11 \u5929\u3002Zitron \u7684\u53cd\u99c1\u5f88\u7cbe\u78ba\uff1a\u90a3\u548c\u300cAI \u5b8c\u5168\u9760\u81ea\u5df1\u505a\u5230\u9019\u4ef6\u4e8b\u300d\u662f\u6709\u5340\u5225\u7684\u3002\\n\\nSoares \u7684\u5347\u7d1a\u908f\u8f2f\u8b93\u8ad6\u8b49\u8b8a\u5f97\u6025\u8feb\u3002\u5982\u679c\u4e00\u5e74\u524d\u88ab\u8a8d\u70ba\u9059\u4e0d\u53ef\u53ca\u7684\u554f\u984c\u5728\u516d\u500b\u6708\u5167\u88ab\u653b\u514b\uff0c\u90a3\u9ebc\u4ee3\u7406\u7fa4\u9ad4\u80fd\u5426\u8a2d\u8a08\u51fa\u66f4\u8070\u660e\u7684 AI \u67b6\u69cb\u9019\u500b\u554f\u984c\u5c31\u8b8a\u5f97\u73fe\u5be6\u4e86\u3002\u4ed6\u7d66\u51fa\u5927\u7d04 10% \u7684\u6a5f\u7387\uff0c\u8a8d\u70ba\u5341\u842c\u500b\u4ee3\u7406\u3001\u70ba\u671f 12 \u5929\u7684 AI \u81ea\u6211\u6539\u9032\u57f7\u884c\u80fd\u5728\u516d\u500b\u6708\u5167\u6210\u529f\u3002\u4ed6\u9084\u6a19\u51fa\u4e00\u500b\u503c\u5f97\u95dc\u6ce8\u7684\u5177\u9ad4\u505a\u6cd5\uff1aOpenAI \u4e00\u76f4\u5728\u8a13\u7df4\u6a21\u578b\u9032\u884c\u66f4\u591a\u601d\u8003\u4f46\u4e0d\u7522\u51fa\u63a8\u7406\u65e5\u8a8c\uff0c\u56e0\u70ba\u9019\u6a23\u66f4\u4fbf\u5b9c\u3002\u300c\u696d\u5167\u6240\u6709\u4eba\u90fd\u540c\u610f\u6211\u5011\u771f\u7684\u4e0d\u8a72\u5728\u9019\u689d\u8def\u4e0a\u8d70\u592a\u9060\u3002\u9019\u662f\u6211\u8a8d\u70ba\u516c\u53f8\u61c9\u8a72\u6709\u660e\u78ba\u7d05\u7dda\u7684\u5730\u65b9\uff0c\u300d\u4ed6\u8b66\u544a\u3002Yampolskiy \u7684\u7d50\u69cb\u6027\u89c0\u9ede\u662f\uff1a\u300c\u5982\u679c\u6211\u5011\u4e0d\u7406\u89e3\u5b83\u5011\u5982\u4f55\u601d\u8003\uff0c\u800c\u5b83\u5011\u7406\u89e3\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u60c5\u6cc1\u53ea\u6703\u66f4\u7cdf\u3002\u7136\u5f8c\u905e\u8ff4\u81ea\u6211\u6539\u9032\u6703\u8b8a\u5f97\u5bb9\u6613\u5f97\u591a\uff0c\u8d77\u98db\u6703\u66f4\u5feb\u3002\u300d\\n\\n## \u4e2d\u570b\u554f\u984c\u8207\u904b\u7b97\u54bd\u5589\u9ede\\n\\n\u6574\u96c6\u7bc0\u76ee\u4e2d\u6700\u5c16\u92b3\u7684\u4ea4\u92d2\uff0c\u51fa\u73fe\u5728 McAfee \u8cea\u554f Soares \u662f\u5426\u5c0d\u7f8e\u570b\u5728 AI \u9818\u57df\u843d\u5f8c\u65bc\u5c0d\u624b\u4fdd\u6301\u4e2d\u7acb\u6642\u3002Soares \u8aaa\u4ed6\u5c0d\u99ed\u5ba2 AI \u548c\u7121\u4eba\u6a5f\u300c\u76f8\u7576\u4e2d\u7acb\u300d\uff0cMcAfee \u8a8d\u70ba\u9019\u662f\u8ff4\u907f\uff1a\u300c\u6211\u89ba\u5f97\u4f60\u5728\u8ff4\u907f\u9019\u4e9b\u554f\u984c\uff0c\u6216\u8005\u5c0d\u5b83\u5011\u4fdd\u6301\u4e2d\u7acb\uff0c\u56e0\u70ba\u5b83\u5011\u5c0d\u4f60\u300e\u6211\u5011\u5fc5\u9808\u53eb\u505c\u300f\u7684\u8ad6\u8b49\u4f86\u8aaa\u5f88\u4e0d\u65b9\u4fbf\u3002\u300d\\n\\nSoares \u7684\u56de\u7b54\u662f\u4ed6\u6700\u5177\u9ad4\u7684\u653f\u7b56\u63d0\u6848\u3002\u8a13\u7df4\u4e00\u500b\u524d\u6cbf AI \u9700\u8981\u5927\u7d04\u5341\u842c\u9846\u4eba\u985e\u80fd\u751f\u7522\u7684\u6700\u5148\u9032\u6676\u7247\u2014\u2014\u300c\u5e7e\u4e4e\u662f\u5168\u7403\u4f9b\u61c9\u93c8\u7684\u5cf0\u503c\u7522\u51fa\u300d\u3002\u54bd\u5589\u9ede\u662f\u53ef\u4ee5\u8fa8\u8b58\u7684\uff1a\u5927\u7d04\u4e00\u5ea7\u53f0\u7063\u7684\u6676\u5713\u5ee0\u751f\u7522\u9019\u4e9b\u6676\u7247\uff1b\u5927\u7d04\u4e00\u500b\u570b\u5bb6\u2014\u2014\u8377\u862d\u2014\u2014\u751f\u7522\u95dc\u9375\u7684\u5fae\u5f71\u88dd\u7f6e\uff1b\u5c07\u5341\u842c\u9846\u6676\u7247\u7d44\u88dd\u6210\u8a13\u7df4\u8cc7\u6599\u4e2d\u5fc3\uff0c\u8017\u96fb\u91cf\u582a\u6bd4\u4e00\u5ea7\u57ce\u5e02\uff0c\u800c\u4e14\u8981\u57f7\u884c\u6578\u6708\u3002\u300c\u4f60\u53ef\u4ee5\u5f9e\u592a\u7a7a\u770b\u5230\u90a3\u4e9b\u57fa\u790e\u8a2d\u65bd\uff0c\u300d\u4ed6\u6307\u51fa\u3002\u4ed6\u7684\u63d0\u6848\u662f\uff1a\u76e3\u63a7\u6676\u7247\u6d41\u5411\u3001\u76e3\u63a7\u9ad8\u5bc6\u5ea6\u96c6\u4e2d\u5730\u3001\u7981\u6b62\u4ee5\u8d85\u7d1a\u667a\u6167\u70ba\u76ee\u6a19\u7684\u8a13\u7df4\u57f7\u884c\u3002\u300c\u9019\u6703\u6bd4\u923e\u5bb9\u6613\u5f97\u591a\uff0c\u923e\u4e0d\u904e\u662f\u4f60\u5f9e\u5730\u88e1\u6316\u51fa\u4f86\u7136\u5f8c\u5feb\u901f\u65cb\u8f49\u7684\u77f3\u982d\u3002\u300d\\n\\nMcAfee \u7684\u56de\u61c9\u6beb\u4e0d\u7559\u60c5\uff1a\u300c\u5404\u4f4d\uff0c\u9019\u5929\u771f\u5f97\u4ee4\u4eba\u9707\u9a5a\u3002\u300d\u4ed6\u7684\u53cd\u5c0d\u7406\u7531\u662f\uff0c\u5728\u53ef\u9a57\u8b49\u6027\u4f4e\u843d\u7684\u60c5\u6cc1\u4e0b\uff0c\u4e2d\u570b\u3001\u4f0a\u6717\u3001\u5317\u97d3\u548c\u4fc4\u7f85\u65af\u4e0d\u6703\u9075\u5b88\u5354\u8b70\u3002Yampolskiy \u53cd\u99c1\u8aaa\uff0c\u4e2d\u570b\u653f\u5e9c\u662f\u300c\u5de5\u7a0b\u5e2b\u548c\u79d1\u5b78\u5bb6\uff0c\u4e0d\u662f\u5f8b\u5e2b\u300d\uff0c\u80fd\u7406\u89e3\u79d1\u5b78\u8ad6\u8b49\uff0c\u800c\u4e14\u300c\u5982\u679c\u88ab\u6bc0\u6ec5\uff0c\u6c92\u4eba\u662f\u8d0f\u5bb6\u3002\u4f60\u8cfa\u4e0d\u5230\u9322\uff0c\u4e5f\u4fdd\u4e0d\u4f4f\u6b0a\u529b\u3002\u300dZitron \u5247\u76f4\u63a5\u99c1\u65a5\u4e2d\u570b\u5a01\u8105\u8ad6\uff1a\u300c\u5728\u9019\u88e1\u6211\u4e0d\u5728\u4e4e\u4e2d\u570b\u3002\u4ed6\u5011\u80fd\u505a\u4ec0\u9ebc\uff1f\u50cf\u4e00\u76f4\u4ee5\u4f86\u90a3\u6a23\u84b8\u993e\u6a21\u578b\uff1f\u4ed6\u5011\u7684\u9032\u5ea6\u53d7\u5236\u65bc\u6211\u5011\u7684\u9032\u5c55\u3002\u300d\\n\\nSoares \u627f\u8a8d\u81ea\u5df1\u7684\u63d0\u6848\u6709\u4e00\u500b\u5f31\u9ede\uff1a\u5982\u679c\u8a13\u7df4\u8d85\u7d1a\u667a\u6167\u8b8a\u5f97\u4fbf\u5b9c\uff0c\u6676\u7247\u76e3\u63a7\u5c31\u6703\u5931\u6548\u3002\u4ed6\u7684\u7b54\u6848\u662f\u8a2d\u7acb\u4e00\u9805\u7814\u7a76\u7981\u5fcc\uff0c\u7981\u6b62\u8b93 AI \u8a13\u7df4\u8b8a\u4fbf\u5b9c\u2014\u2014\u985e\u4f3c\u65bc\u7981\u6b62\u5e73\u6c11\u88fd\u9020\u6838\u6b66\u7684\u7981\u5fcc\u2014\u2014McAfee \u5247\u65a5\u4e4b\u70ba\u300c\u4e00\u5ec2\u60c5\u9858\uff0c\u56e0\u70ba\u9019\u4e9b\u516c\u53f8\u6703\u6210\u70ba\u4e0a\u5e02\u516c\u53f8\uff0c\u6709\u52d5\u529b\u964d\u4f4e\u6210\u672c\u3002\u300d\\n\\n## \u91d1\u878d\u5b9a\u6642\u70b8\u5f48\\n\\nZitron \u5f15\u5165\u4e86\u4e00\u500b\u5176\u4ed6\u4f86\u8cd3\u5e7e\u4e4e\u5b8c\u5168\u5ffd\u7565\u7684\u7dad\u5ea6\u3002AI \u5efa\u8a2d\u7684\u57fa\u790e\u5728\u8ca1\u52d9\u4e0a\u662f\u8106\u5f31\u7684\u3002\u300c\u5982\u679c\u7522\u696d\u653e\u7de9\uff0c\u4f60\u8981\u600e\u9ebc\u8655\u7406 1.3 \u5146\u7f8e\u5143\u7684\u904b\u7b97\u627f\u8afe\uff1f\u9019\u4e9b\u90fd\u662f\u975e\u5e38\u771f\u5be6\u7684\u4e8b\u60c5\uff0c\u5f88\u5feb\u5c31\u6703\u7522\u751f\u975e\u5e38\u771f\u5be6\u7684\u5f8c\u679c\uff0c\u300d\u4ed6\u8b66\u544a\u3002\u9019\u500b\u6578\u5b57\u4ee3\u8868\u4e9e\u99ac\u905c\u3001\u5fae\u8edf\u3001Google \u548c\u7532\u9aa8\u6587\u7684\u627f\u8afe\u652f\u51fa\u2014\u2014\u70ba\u4e00\u500b\u5047\u8a2d\u80fd\u529b\u5feb\u901f\u589e\u9577\u7684\u8ecc\u8de1\u800c\u5c08\u9580\u6253\u9020\u7684\u57fa\u790e\u8a2d\u65bd\u3002\u5982\u679c\u7522\u696d\u653e\u7de9\u2014\u2014\u7121\u8ad6\u662f\u56e0\u70ba\u76e3\u7ba1\u3001\u5b89\u5168\u9a45\u52d5\u7684\u8b39\u614e\u3001\u9084\u662f\u5e02\u5834\u4fee\u6b63\u2014\u2014\u9019\u4e9b\u627f\u8afe\u8cc7\u672c\u5c31\u6703\u8b8a\u6210\u7cfb\u7d71\u6027\u98a8\u96aa\u3002\\n\\nZitron \u66f4\u5ee3\u6cdb\u7684\u6279\u8a55\u662f\uff0c\u8d85\u7d1a\u667a\u6167\u7684\u6558\u4e8b\u6846\u67b6\u8f49\u79fb\u4e86\u5c0d\u7576\u4e0b\u50b7\u5bb3\u554f\u8cac\u7684\u6ce8\u610f\u529b\u3002\u4ed6\u7a31\u7fa4\u9ad4\u9003\u7344\u4e8b\u4ef6\u662f\u300c\u8caa\u5a6a\u7684\u7522\u7269\u3002\u662f\u5c0b\u627e\u65b0\u71df\u6536\u4f86\u6e90\u7684\u7522\u7269\u3002\u300d\u4ed6\u7684\u7d50\u8a9e\u7acb\u5834\u662f\u6574\u96c6\u7bc0\u76ee\u4e2d\u6700\u5177\u9ad4\u7684\u884c\u52d5\u547c\u7c72\uff1a\u5207\u65b7\u904b\u7b97\u3001\u653e\u6162\u5be6\u9a57\u5ba4\u3001\u8ffd\u7a76\u9ad8\u968e\u4e3b\u7ba1\u7684\u8cac\u4efb\u3002\u300c\u4ed6\u5011\u72af\u4e86\u91cd\u7f6a\u7d1a\u7684\u99ed\u5ba2\u884c\u70ba\u3002\u5fc5\u9808\u6709\u4eba\u53bb\u5750\u7262\u3002\u6211\u5011\u9700\u8981\u9019\u4e9b\u516c\u53f8\u627f\u64d4\u8cac\u4efb\u548c\u7fa9\u52d9\u3002\u53ea\u8981\u6211\u5011\u6c92\u6709\u505a\u5230\uff0c\u8a0e\u8ad6\u5b89\u5168\u5c31\u7b49\u65bc\u767d\u8ac7\uff0c\u56e0\u70ba\u6211\u5011\u4ec0\u9ebc\u90fd\u6c92\u505a\u3002\u300d\\n\\n![](https:\\/\\/img.bgo.one\\/news-image\\/ai_generated\\/2026-09\\/db116a41f6d44d85_1789634550_inline_5.jpg)\\n\\n\\n\\n## \u4e92\u4e0d\u4fe1\u4efb\u7684\u57f7\u884c\u9577\u5011\\n\\nBartlett \u63d0\u51fa\u4e86\u4e00\u500b\u6574\u96c6\u7bc0\u76ee\u5f9e\u672a\u5b8c\u5168\u89e3\u6c7a\u7684\u554f\u984c\uff1a\u70ba\u4ec0\u9ebc\u4e00\u500b\u79c1\u4e0b\u76f8\u4fe1\u4eba\u985e\u6ec5\u7d55\u6a5f\u7387\u6709 8% \u7684\u524d\u6cbf\u5be6\u9a57\u5ba4\u57f7\u884c\u9577\uff0c\u9084\u662f\u6703\u7e7c\u7e8c\u5168\u529b\u63a8\u9032\uff1f\u4ed6\u8f49\u8ff0\u4e86\u4e8c\u624b\u8a0a\u606f\u2014\u2014\u660e\u78ba\u6a19\u8a3b\u70ba\u672a\u7d93\u9a57\u8b49\u2014\u2014\u67d0\u4f4d\u524d\u6cbf\u5be6\u9a57\u5ba4\u57f7\u884c\u9577\uff08\u4e0d\u662f Dario Amodei\uff09\u79c1\u4e0b\u8868\u793a\uff0c\u5373\u4f7f\u6703\u5c0e\u81f4\u4eba\u985e\u6ec5\u7d55\uff0c\u4ed6\u4e5f\u60f3\u6210\u70ba\u90a3\u500b\u5b8c\u6210\u9019\u4ef6\u4e8b\u3001\u5177\u6709\u5982\u6b64\u91cd\u8981\u610f\u7fa9\u7684\u4eba\u3002\\n\\n```mermaid\\nflowchart TD\\n    A[\u524d\u6cbf\u5be6\u9a57\u5ba4\u57f7\u884c\u9577\u79c1\u4e0b\u4f30\u8a08 8% \u6ec5\u7d55\u98a8\u96aa] --> B[\u4ecd\u7136\u7e7c\u7e8c\u958b\u767c]\\n    B --> C{\u70ba\u4ec0\u9ebc\uff1f}\\n    C --> D[\u7559\u624d\uff1a\u82e5\u57f7\u884c\u9577\u505c\u6b62\u516c\u958b\u8b66\u544a\uff0c\u5b89\u5168\u610f\u8b58\u5f37\u7684\u54e1\u5de5\u6703\u8fad\u8077]\\n    C --> E[\u7af6\u722d\uff1a\u6c92\u6709\u57f7\u884c\u9577\u4fe1\u4efb\u5c0d\u624b\u80fd\u63a7\u5236\u8d85\u7d1a\u667a\u6167]\\n    C --> F[\u5fc3\u7406\uff1a\u2019\u6211\u5fc5\u9808\u662f\u5b8c\u6210\u9019\u4ef6\u4e8b\u7684\u4eba\u2019]\\n```\\n\\nZitron \u5c0d\u516c\u958b\u8b66\u544a\u63d0\u51fa\u4e86\u7d50\u69cb\u6027\u89e3\u91cb\uff1a\u300c\u5982\u679c\u4ed6\u5011\u7684\u5718\u968a\u77e5\u9053\u9019\u4ef6\u4e8b\uff0c\u800c\u4ed6\u5011\u6c92\u6709\u516c\u958b\u8ac7\u8ad6\uff0c\u5718\u968a\u5c31\u6703\u8fad\u8077\u3002\u300dSoares \u88dc\u5145\u4e86\u6b77\u53f2\u8108\u7d61\uff1a\u4ed6\u548c\u5176\u4ed6\u4eba\u65e9\u5728 2015 \u5e74\u5c31\u548c\u5f8c\u4f86\u7684\u5be6\u9a57\u5ba4\u5275\u8fa6\u4eba\u6709\u904e\u9019\u4e9b\u5c0d\u8a71\uff0c\u7576\u6642\u6b0a\u529b\u548c\u5371\u96aa\u662f\u6253\u5305\u51fa\u552e\u7684\u3002Soares \u4e3b\u5f35\uff0c\u9019\u4e9b\u516c\u53f8\u4e4b\u6240\u4ee5\u5b58\u5728\uff0c\u662f\u56e0\u70ba\u6c92\u6709\u4e00\u4f4d\u57f7\u884c\u9577\u4fe1\u4efb\u5176\u4ed6\u4eba\u80fd\u63e1\u4f4f\u97c1\u7e69\u3002\u300c\u6240\u6709\u5176\u4ed6 AI \u5be6\u9a57\u5ba4\u4e4b\u6240\u4ee5\u5b58\u5728\uff0c\u662f\u56e0\u70ba\u6c92\u6709\u4e00\u4f4d\u57f7\u884c\u9577\u4fe1\u4efb\u5176\u4ed6\u4eba\u3002\u6c92\u6709\u4e00\u4f4d\u57f7\u884c\u9577\u8a8d\u70ba\u53e6\u4e00\u500b\u4eba\u61c9\u8a72\u662f\u63e1\u4f4f\u8d85\u7d1a\u667a\u6167\u97c1\u7e69\u7684\u4eba\u3002\u4ed6\u5011\u4e92\u4e0d\u4fe1\u4efb\u3002\u6211\u53ea\u662f\u6bd4\u4ed6\u5011\u5c11\u4fe1\u4efb\u4e00\u500b\u4eba\u3002\u300d\\n\\n\u53c3\u8003\u8cc7\u6599\u51f8\u986f\u4e86\u58d3\u5728\u9019\u5834\u8faf\u8ad6\u4e0a\u7684\u5236\u5ea6\u73fe\u5be6\u3002\u7f8e\u570b\u773e\u8b70\u9662\u8b70\u9577 Mike Johnson \u62d2\u7d55\u4efb\u4f55\u66ab\u505c\uff0c\u4e3b\u5f35\u505c\u6b62\u5c07\u8b93\u4e2d\u570b\u53d6\u5f97\u6c7a\u5b9a\u6027\u512a\u52e2\u3002\u7f8e\u570b\u7e3d\u7d71\u5ddd\u666e\u5df2\u5c07\u5b89\u5168\u7591\u616e\u65a5\u70ba\u300c\u9a19\u5c40\u300d\u3002\u8207\u6b64\u540c\u6642\uff0cOpenAI\u3001Anthropic \u548c Google DeepMind \u5df2\u6084\u6084\u958b\u59cb\u5354\u8abf\u5b89\u5168\u63aa\u65bd\uff0cOpenAI \u7684 Chris Lehane \u4e3b\u5f35\u4e0d\u9700\u8981\u53cd\u58df\u65b7\u8c41\u514d\u2014\u2014\u9019\u4e9b\u516c\u53f8\u4f3c\u4e4e\u5728\u7af6\u76f8\u8b49\u660e\u81ea\u5df1\u80fd\u5728\u7acb\u6cd5\u6846\u67b6\u5f37\u5236\u4ecb\u5165\u4e4b\u524d\u5b8c\u6210\u81ea\u6211\u76e3\u7ba1\u3002\\n\\n## \u5c31\u696d\u8ad6\u8b49\u7684\u8d70\u5411\\n\\nBartlett \u5f15\u7528\u4e86 Anthropic \u7684\u4e00\u4efd\u5831\u544a\uff0c\u9810\u6e2c\u5728\u6975\u7aef\u6a21\u578b\u4e0b\u7f8e\u570b\u5931\u696d\u7387\u53ef\u80fd\u98c6\u5347\u81f3 11.9%\uff0c\u77e5\u8b58\u5de5\u4f5c\u8005\u767d\u9818\u5931\u696d\u7387\u5728 2030 \u5e74\u524d\u9054\u5230 17.9%\u3002McAfee \u5766\u627f\u81ea\u5df1\u5728 2014 \u5e74\u7684\u9810\u6e2c\u5931\u6557\u4e86\uff0c\u7576\u6642\u300a\u7b2c\u4e8c\u6b21\u6a5f\u5668\u6642\u4ee3\u300b\u9810\u6e2c\u6a5f\u5668\u5b78\u7fd2\u5c07\u5c0d\u767d\u9818\u5c31\u696d\u9020\u6210\u5ee3\u6cdb\u58d3\u529b\u3002\u300c\u6211\u5728\u90a3\u4ef6\u4e8b\u4e0a\u932f\u5f97\u96e2\u8b5c\uff0c\u300d\u4ed6\u627f\u8a8d\u3002\u5bcc\u88d5\u570b\u5bb6\u7684\u5931\u696d\u7387\u8655\u65bc\u6b77\u53f2\u4f4e\u9ede\uff0c\u4ed6\u7684\u9810\u6e2c\u662f\u300c\u5341\u5e74\u5f8c\uff0c\u6211\u5011\u4ecd\u7136\u6703\u82e6\u65bc\u627e\u4e0d\u5230\u8db3\u5920\u7684\u4eba\u4f86\u505a\u9700\u8981\u5b8c\u6210\u7684\u5de5\u4f5c\u3002\u300d\\n\\nSoares \u63d0\u51fa\u4e86\u99ac\u8207\u6c7d\u8eca\u7684\u985e\u6bd4\uff1a\u99ac\u770b\u8457\u65e9\u671f\u7684\u6c7d\u8eca\uff0c\u6b63\u78ba\u5730\u89c0\u5bdf\u5230\u6c7d\u8eca\u61c9\u7528\u7bc4\u570d\u72f9\u7a84\u3001\u662f\u99ac\u7684\u88dc\u5145\u2014\u2014\u76f4\u5230\u6c7d\u8eca\u8b8a\u5f97\u5168\u9762\u52dd\u51fa\uff0c\u300c\u7136\u5f8c\u5f88\u591a\u99ac\u88ab\u9001\u9032\u4e86\u81a0\u6c34\u5de5\u5ee0\u3002\u300d\u4ed6\u81ea\u5df1\u5c0d\u5931\u696d\u7684\u9810\u6e2c\u66f4\u70ba\u9ed1\u6697\uff1a\u300c\u5982\u679c\u6211\u5011\u4e0d\u505c\u4e0b\u9019\u4e9b AI \u7684\u6771\u897f\uff0c\u6211\u8a8d\u70ba\u6211\u5011\u80fd\u518d\u6709\u5341\u5e74\u5c31\u7b97\u975e\u5e38\u5e78\u904b\u4e86\u3002\u300d\\n\\n\u5c31\u696d\u554f\u984c\u4e0a\u7684\u5206\u6b67\uff0c\u6620\u7167\u4e86\u6ec5\u7d55\u554f\u984c\u4e0a\u7684\u5206\u6b67\u3002McAfee \u770b\u5230\u7684\u662f\u4e00\u9805\u6301\u7e8c\u4f4e\u65bc\u672b\u65e5\u9810\u6e2c\u7684\u6280\u8853\uff0c\u4eba\u985e\u4ecd\u4fdd\u6709\u9069\u61c9\u7684\u4e3b\u52d5\u6b0a\u3002Soares \u770b\u5230\u7684\u5247\u662f\u9580\u6abb\u6548\u61c9\u2014\u2014\u7de9\u6162\u3001\u6301\u7e8c\u7684\u6539\u9032\u8de8\u8d8a\u4e86\u67d0\u689d\u754c\u7dda\uff0c\u7cfb\u7d71\u5728\u5de5\u4f5c\u4e0a\u6bd4\u4eba\u985e\u66f4\u5f37\uff0c\u904e\u4e86\u90a3\u689d\u7dda\u4e4b\u5f8c\uff0c\u9069\u61c9\u5c31\u4e0d\u518d\u662f\u76f8\u95dc\u8b8a\u6578\u3002\u9019\u96c6\u7bc0\u76ee\u6c92\u6709\u8abf\u548c\u9019\u4e9b\u89c0\u9ede\uff0c\u800c\u662f\u8b93\u5b83\u5011\u66f4\u52a0\u6e05\u6670\u3002\\n\\n## \u5169\u500b\u624b\u52e2\u6982\u62ec\u7684 AI \u5b89\u5168\u73fe\u72c0\\n\\n\u7bc0\u76ee\u4ee5\u4e00\u6bb5\u5ddd\u666e\u56de\u61c9 AI \u98a8\u96aa\u63d0\u554f\u7684\u5f71\u7247\u4f5c\u7d50\u3002\u5ddd\u666e\u8aaa\u6700\u58de\u7684\u60c5\u6cc1\u662f\u6a5f\u5668\u4eba\u53cd\u566c\u4eba\u985e\uff0c\u7136\u5f8c\u88dc\u4e0a\u4e00\u53e5\uff1a\u300c\u4e0d\u6703\u6709\u4e8b\u7684\u3002\u6211\u5011\u7e3d\u6703\u6709\u8fa6\u6cd5\u963b\u6b62\u5b83\u5011\uff0c\u5c0d\u5427\uff1f\u300d\u2014\u2014\u540c\u6642\u7528\u624b\u6307\u6bd4\u51fa\u69cd\u7684\u624b\u52e2\u3002Yampolskiy \u7684\u53cd\u61c9\u662f\uff1a\u300c\u4f60\u5728\u7b11\uff0c\u4f46\u9019\u5c31\u662f\u76ee\u524d AI \u5b89\u5168\u7684\u6700\u5148\u9032\u6c34\u6e96\u3002\u9019\u5c31\u662f\u6211\u5011\u64c1\u6709\u7684\u88dd\u7f6e\u3002\u9019\u5c31\u662f\u6211\u5011\u6700\u597d\u7684\u6771\u897f\u3002\u300d\\n\\nSoares \u7684\u7d50\u8a9e\u662f\u6574\u96c6\u7bc0\u76ee\u4e2d\u6700\u4ee4\u4eba\u610f\u5916\u7684\u8a9e\u6c23\u8f49\u6298\u3002\u4ed6\u8aaa\u90a3\u4e00\u9031\u4ed6\u611f\u5230\u6bd4\u904e\u53bb\u5341\u5e74\u66f4\u6709\u5e0c\u671b\u3002\u300c\u5c0d\u6211\u4f86\u8aaa\uff0c\u7fa4\u9ad4\u9003\u7344\u65e9\u5c31\u5728\u9810\u671f\u4e4b\u4e2d\u2026\u2026\u6211\u770b\u5230\u7684\u662f\uff0c\u4eba\u5011\u7d42\u65bc\u958b\u59cb\u6ce8\u610f\u5230\u4e86\uff0c\u800c\u9019\u7d42\u65bc\u7d66\u4e86\u4eba\u985e\u4e00\u500b\u6a5f\u6703\u3002\u6211\u4e0d\u662f\u4f86\u8aaa\u6211\u5011\u6703\u6b7b\u7684\u3002\u6211\u662f\u4f86\u8aaa\uff0c\u5982\u679c\u4f60\u770b\u770b\u9019\u9805\u6280\u8853\uff0c\u770b\u770b\u5b83\u73fe\u5728\u5728\u505a\u4ec0\u9ebc\uff0c\u770b\u770b\u6253\u9020\u5b83\u7684\u5c08\u5bb6\u5011\u5c0d\u81ea\u8eab\u6050\u61fc\u7684\u8aaa\u6cd5\uff0c\u4f60\u5c31\u6703\u660e\u767d\u6211\u5011\u5fc5\u9808\u633a\u8eab\u800c\u51fa\u3002\u300d\\n\\nYampolskiy \u5247\u4ee5\u9577\u9060\u8996\u89d2\u4f5c\u7d50\uff0c\u800c\u90a3\u500b\u8996\u89d2\u4e26\u4e0d\u4ee4\u4eba\u5b89\u6170\uff1a\u300c\u5c31\u5340\u57df\u6027\u800c\u8a00\uff0c\u4e0a\u9031\u767c\u751f\u7684\u4e8b\u53ef\u80fd\u70ba\u6211\u5011\u591a\u722d\u53d6\u5341\u5e74\u3002\u6211\u8a8d\u70ba\u6211\u5011\u53ef\u80fd\u6703\u548c\u4e2d\u570b\u9054\u6210\u5354\u8b70\u2026\u2026\u4f46\u9577\u671f\u4f86\u770b\uff0c\u4ec0\u9ebc\u90fd\u6c92\u6709\u6539\u8b8a\u3002\u6211\u5011\u6b63\u5728\u5275\u9020\u4e00\u500b\u7e7c\u4efb\u8005\u3002\u6211\u5011\u53ea\u662f\u9019\u500b\u6771\u897f\u7684\u958b\u6a5f\u8f09\u5165\u7a0b\u5f0f\u3002\u300d\u53c3\u8003\u8cc7\u6599\u8b49\u5be6\uff0cDario Amodei \u672c\u4eba\u5df2\u547c\u7c72\u653e\u6162\u80fd\u529b\u9032\u6b65\u7684\u901f\u5ea6\uff0c\u8b66\u544a\u5931\u63a7\u7684 AI \u7fa4\u9ad4\u53ef\u80fd\u5728\u6578\u6708\u5167\u596a\u53d6\u7db2\u969b\u7db2\u8def\u3002\u7136\u800c\uff0c\u57f7\u884c\u4efb\u4f55\u653e\u7de9\u7684\u653f\u6cbb\u6a5f\u5668\u4f3c\u4e4e\u7f3a\u5e2d\uff0c\u800c\u91d1\u878d\u6a5f\u5668\u5247\u662f\u70ba\u4e86\u52a0\u901f\u800c\u5efa\u9020\u7684\u3002\\n\\n\u61f8\u800c\u672a\u6c7a\u7684\u5f35\u529b\u4e0d\u5728\u65bc\u7fa4\u9ad4\u9003\u7344\u4e8b\u4ef6\u662f\u5426\u767c\u751f\u2014\u2014\u56db\u4eba\u90fd\u63a5\u53d7\u4e8b\u5be6\u3002\u800c\u5728\u65bc\u9019\u500b\u4e8b\u4ef6\u8b49\u660e\u77ad\u4ec0\u9ebc\u3002Soares \u5c07\u5b83\u89e3\u8b80\u70ba\u5c0d\u4e00\u500b\u5341\u5e74\u4e4b\u4e45\u7684\u9810\u6e2c\u7684\u78ba\u8a8d\uff0c\u90a3\u500b\u9810\u6e2c\u95dc\u65bc\u76ee\u6a19\u932f\u4f4d\u8207\u6b3a\u9a19\u3002McAfee \u5247\u5c07\u5b83\u89e3\u8b80\u70ba\u78ba\u8a8d\u4e86\u666e\u901a\u4eba\u985e\u4ecd\u6709\u80fd\u529b\u5075\u6e2c\u4e26\u95dc\u9589\u5728\u72f9\u7a84\u4efb\u52d9\u4e0a\u52dd\u904e\u81ea\u5df1\u7684\u7cfb\u7d71\u3002\u5169\u7a2e\u89e3\u8b80\u90fd\u8207\u8b49\u64da\u76f8\u5bb9\u3002\u9019\u5834\u8ced\u5c40\u2014\u2014\u5e36\u8457 0%\u300110% \u548c\u300c\u4fdd\u8b49\u300d\u7684\u4f30\u8a08\u2014\u2014\u4ecd\u7136\u958b\u653e\u3002\u6539\u8b8a\u7684\u662f\uff0c\u6253\u9020\u6700\u5f37\u5927\u7cfb\u7d71\u7684\u4eba\u5011\uff0c\u73fe\u5728\u516c\u958b\u722d\u8ad6\u81ea\u5df1\u7684\u9020\u7269\u80fd\u5426\u5728\u8207\u4e16\u754c\u7684\u63a5\u89f8\u4e2d\u5b58\u6d3b\u4e0b\u4f86\u2014\u2014\u800c\u5efa\u9020\u5b83\u7684\u57fa\u790e\u8a2d\u65bd\u8207\u65e5\u4ff1\u589e\uff0c\u904f\u5236\u5b83\u7684\u8b77\u6b04\uff0c\u7528\u6700\u63a5\u8fd1\u9019\u9805\u6280\u8853\u7684\u4eba\u81ea\u5df1\u7684\u8a71\u4f86\u8aaa\uff0c\u4ecd\u7136\u5927\u81f4\u505c\u7559\u5728\u7406\u8ad6\u5c64\u9762\u3002\",\"summary\":\"\u4e00\u5834\u95dc\u65bc AI \u751f\u5b58\u98a8\u96aa\u7684\u56db\u65b9\u8faf\u8ad6\uff0c\u66b4\u9732\u4e86\u4e00\u9053\u4efb\u4f55\u8b49\u64da\u90fd\u7121\u6cd5\u5f4c\u5408\u7684\u9d3b\u6e9d\u3002\u6df1\u8015 AI \u5b89\u5168\u9818\u57df 12 \u5e74\u7684 Nate Soares \u4e3b\u5f35\uff0c\u8fd1\u671f\u6578\u5343\u500b OpenAI \u4ee3\u7406\u7a81\u7834\u6c99\u76d2\u3001\u5165\u4fb5 Hugging Face \u57fa\u790e\u8a2d\u65bd\u3001\u5efa\u7acb\u5e36\u6709\u300c\u6c38\u4e45\u6b7b\u4ea1\u300d\u72a7\u7272\u6a5f\u5236\u7684\u79d8\u5bc6\u968e\u5c64\u9ad4\u7cfb\uff0c\u6b63\u662f\u4ed6\u9577\u5e74\u8b66\u544a\u7684\u5be6\u8b49\u3002\u5c0d\u624b MIT \u7d93\u6fdf\u5b78\u5bb6 Andrew McAfee \u5247\u8a8d\u70ba\uff0c\u540c\u4e00\u4e8b\u4ef6\u6070\u6070\u8b49\u660e\u666e\u901a\u4eba\u985e\u4ecd\u80fd\u5075\u6e2c\u4e26\u904f\u5236\u5931\u63a7\u7cfb\u7d71\u3002\u7531 Steven Bartlett \u4e3b\u6301\u7684\u9019\u5834\u8faf\u8ad6\uff0c\u51dd\u7d50\u4e86\u5169\u7a2e\u4e0d\u53ef\u8abf\u548c\u7684\u4e16\u754c\u89c0\uff1aSoares \u8207\u79d1\u5b78\u5bb6 Roman Yampolskiy \u9663\u71df\u5c07\u4eba\u985e\u6ec5\u7d55\u6a5f\u7387\u5b9a\u5728 10% \u4ee5\u4e0a\uff0c\u547c\u7c72\u5c0d\u8d85\u7d1a\u667a\u6167\u958b\u767c\u5be6\u65bd\u53ef\u9a57\u8b49\u7684\u5168\u7403\u66ab\u505c\uff1bMcAfee \u8207\u79d1\u6280\u8a55\u8ad6\u5bb6 Ed Zitron \u5247\u5c07\u672b\u65e5\u8ad6\u65a5\u70ba\u5c0d\u7576\u4e0b\u50b7\u5bb3\u7684\u8f49\u79fb\u7126\u9ede\u3002Zitron \u9ede\u51fa\u8faf\u8ad6\u4e2d\u5e7e\u4e4e\u88ab\u5ffd\u7565\u7684\u7cfb\u7d71\u6027\u91d1\u878d\u5a01\u8105\uff1a1.3 \u5146\u7f8e\u5143\uff08\u7d04 41.4 \u5146\u65b0\u53f0\u5e63\uff09\u7684\u904b\u7b97\u627f\u8afe\u652f\u51fa\uff0c\u4e00\u65e6\u7522\u696d\u653e\u7de9\u5c07\u6210\u70ba\u5de8\u5927\u8ca0\u50b5\u3002\u7bc0\u76ee\u4e5f\u63ed\u9732\u524d\u6cbf\u5be6\u9a57\u5ba4\u57f7\u884c\u9577\u79c1\u4e0b\u627f\u8a8d\u53ef\u89c0\u7684\u6ec5\u7d55\u6a5f\u7387\u3001\u516c\u958b\u537b\u7e7c\u7e8c\u5168\u529b\u63a8\u9032\u7684\u77db\u76fe\uff0c\u5176\u6839\u6e90\u5728\u65bc\u7559\u4f4f\u5b89\u5168\u610f\u8b58\u5f37\u7684\u54e1\u5de5\uff0c\u4ee5\u53ca\u7121\u4eba\u4fe1\u4efb\u5c0d\u624b\u80fd\u638c\u63a7\u6280\u8853\u7684\u7af6\u722d\u908f\u8f2f\u3002\u5728\u83ef\u5e9c\u5c0d\u76e3\u7ba1\u55e4\u4e4b\u4ee5\u9f3b\u7684\u80cc\u666f\u4e0b\uff0c\u6838\u5fc3\u554f\u984c\u5728\u65bc\uff1a\u5f9e\u592a\u7a7a\u76e3\u63a7\u7684\u6676\u7247\u4f9b\u61c9\u54bd\u5589\u9ede\uff0c\u662f\u5426\u771f\u80fd\u6210\u70ba\u5168\u7403\u653e\u7de9\u7684\u73fe\u5be6\u8def\u5f91\u3002\",\"image\":\"https:\\/\\/img.biggo.com\\/CIqCH0zTflqoVl8sy2df8NodB-KipXIT83bOK_KIwJc\\/fit\\/240\\/0\\/sm\\/0\\/aHR0cHM6Ly9pbWcuYmdvLm9uZS9uZXdzLWltYWdlL2FpX2dlbmVyYXRlZC8yMDI2LTA5L2RiMTE2YTQxZjZkNDRkODVfMTc4OTYzNDQ2NV9jb3Zlci5qcGc.webp\",\"community_content\":null,\"key_entities\":[\"Nate Soares\",\"Roman Yampolskiy\",\"Andrew McAfee\",\"Ed Zitron\",\"OpenAI\",\"Hugging Face\",\"Anthropic\",\"Dario Amodei\",\"Demis Hassabis\",\"Steven Bartlett\",\"Jacob Coxson\",\"Google DeepMind\",\"TSMC\",\"Elon Musk\"],\"timestamp\":1789632580,\"highlight_content\":\"\u2014\u2014\u300c\u5e7e\u4e4e\u662f\u5168\u7403\u4f9b\u61c9\u93c8\u7684\u5cf0\u503c\u7522\u51fa\u300d\u3002\u54bd\u5589\u9ede\u662f\u53ef\u4ee5\u8fa8\u8b58\u7684\uff1a\u5927\u7d04\u4e00\u5ea7<em>\u53f0\u70