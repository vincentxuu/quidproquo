9\u5728\u5e73\u6fa4\u548c\u9f8d\u4ec1\u7684\u5728\u5efa\u5c08\u6848\u4e5f\u88ab\u6307\u5c07\u53d7\u5230\u6ce2\u53ca\u3002 \u64da\u97d3\u570b\u79d1\u6280\u5a92\u9ad4ETNEWS\u5831\u5c0e\uff0c\u696d\u5167\u4eba\u58eb16\u65e5\u900f\u9732\uff0c\u534a\u5c0e\u9ad4<em>\u88fd\u9020<\\/em>\u88dd\u7f6e\u95dc\u9375\u96f6\u4ef6\u7684...\u4ea4\u8ca8\u9031\u671f\u5df2\u666e\u904d\u5ef6\u9577\u4e00\u500d\u4ee5\u4e0a\u3002\u4e00\u5bb6\u6c89\u7a4d\u88dd\u7f6e<em>\u88fd\u9020<\\/em>\u5546\u7684\u9ad8\u968e\u4e3b\u7ba1\u7a31\uff0c\u904e\u53bb\u8a02\u8cfc\u96f6\u4ef6\u5f8c\u56db\u500b\u6708\u5373\u53ef\u5230\u8ca8\uff0c\u5982\u4eca\u4ea4\u671f\u5df2\u62c9\u9577\u81f3\u5341\u500b\u6708\u3002 \u66f4\u6975\u7aef\u7684\u60c5\u6cc1\u51fa\u73fe\u5728\u96f7\u5c04\u52a0\u5de5\u88dd\u7f6e\u9818\u57df\u3002\u4e00\u5bb6\u534a\u5c0e\u9ad4\u96f7\u5c04\u52a0\u5de5\u88dd\u7f6e<em>\u88fd\u9020<\\/em>\u5546\u5f9e\u65e5\u672c\u63a1\u8cfc\u95dc\u9375\u96f6\u4ef6...\u88dd\u7f6e\u5ee0\u5546\uff0c\u540c\u6a23\u672a\u80fd\u5016\u514d\u3002\u4e00\u5bb6\u5c01\u88dd\u88dd\u7f6e<em>\u88fd\u9020<\\/em>\u5546\u7684\u9ad8\u968e\u4e3b\u7ba1\u900f\u9732\uff0c\u97d3\u570b\u672c\u571f\u63a1\u8cfc\u7684\u96f6\u4ef6\u5230\u8ca8\u6642\u9593\u4ecd\u6bd4\u5e73\u6642\u9577\u7d0450%\uff0c\u539f\u672c\u56db\u500b\u6708\u7684\u4ea4\u671f\u5982\u4eca\u9700\u8981\u516d\u500b\u6708\u751a\u81f3\u66f4\u4e45\u3002 AI\u9700\u6c42\u7206\u767c\uff0c\u4e0a\u6e38\u7522\u80fd\u64f4\u5f35\u6eef\u5f8c \u96f6\u4ef6\u77ed\u7f3a\u7684\",\"highlight_title\":null,\"stocks\":[{\"symbol\":\"2330.TW\",\"count\":3,\"asset_type\":\"stock\",\"region\":\"tw\",\"current_price\":2460,\"daily_change\":35,\"daily_change_percent\":1.44,\"daily_volume\":35250000},{\"symbol\":\"000660.KS\",\"count\":2,\"asset_type\":\"stock\",\"region\":\"kr\",\"current_price\":1835000,\"daily_change\":90000,\"daily_change_percent\":5.16,\"daily_volume\":2618750},{\"symbol\":\"005930.KS\",\"count\":2,\"asset_type\":\"stock\",\"region\":\"kr\",\"current_price\":260000,\"daily_change\":7500,\"daily_change_percent\":2.97,\"daily_volume\":10494623},{\"symbol\":\"601133.SS\",\"count\":2,\"asset_type\":\"stock\",\"region\":\"cn\",\"current_price\":26,\"daily_change\":2.36,\"daily_change_percent\":9.98,\"daily_volume\":14735500},{\"symbol\":\"600030.SS\",\"count\":1,\"asset_type\":\"stock\",\"region\":\"cn\",\"current_price\":26.53,\"daily_change\":0.37,\"daily_change_percent\":1.41,\"daily_volume\":67143700}],\"futures\":[]},{\"id\":\"fb668ce5aaf17be1\",\"type\":\"podcast\",\"title\":\"\u5bae\u5ddd\u9054\u5f65\uff1a2\u5948\u7c73iPhone\u7684\u767c\u71b1\u8207\u91cd\u91cf\uff0c\u8a34\u8aaa\u786c\u9ad4\u9032\u5316\u7684\u6975\u9650\u8207AI\u4ee3\u7406\u5be6\u7528\u5316\u7684\u73fe\u5728\u9032\u884c\u5f0f\",\"content\":\"## 2\u5948\u7c73\u7684\u300c\u58fd\u53f8\u6372\u300d\u2014\u2014A20 Pro\u4ed8\u51fa\u7684\u7269\u7406\u4ee3\u50f9\\n\\n\u860b\u679c9\u6708\u767c\u8868\u6703\u516c\u4f48\u7684iPhone 18 Pro\uff0fPro Max\u6700\u5927\u8b8a\u9769\uff0c\u662f\u642d\u8f09\u53f0\u7a4d\u96fb2\u5948\u7c73\u88fd\u7a0b\u88fd\u9020\u7684A20 Pro\u6676\u7247\u3002\u91dd\u5c0d\u9019\u6b21\u88fd\u7a0b\u8f49\u63db\uff0c\u5728Rebuild.fm\u7bc0\u76ee\u4e2d\u767b\u5834\u7684\u677e\u7530\u767d\u6717\u4ee5\u58fd\u53f8\u6bd4\u55bb\u8aaa\u660e\u3002\\n\\n\u50b3\u7d71\u5e73\u9762\u96fb\u6676\u9ad4\u662f\u300c\u918b\u98ef\u4e0a\u5e73\u92ea\u9b5a\u6599\u7684\u63e1\u58fd\u53f8\u300d\u3002FinFET\u662f\u300c\u8ecd\u8266\u6372\uff08\u9b5a\u6599\u88ab\u6d77\u82d4\u5305\u8986\uff0c\u63a5\u89f8\u9762\u7a4d\u589e\u52a0\uff09\u300d\u3002\u800c2\u5948\u7c73\u7684GAA\uff08\u74b0\u7e5e\u5f0f\u9598\u6975\uff09\u5247\u662f\u300c\u58fd\u53f8\u6372\uff08\u77fd\u8207\u9b5a\u6599\u7684\u63a5\u89f8\u9762\u7a4d\u9032\u4e00\u6b65\u589e\u52a0\uff09\u300d\u3002\u4e0d\u904e\u300c\u76f4\u63a5\u505aGAA\u58fd\u53f8\u6372\u8cb4\u5f97\u5687\u4eba\u300d\u2014\u2014\u56e0\u70ba\u5de5\u7a0b\u6b65\u9a5f\u589e\u52a0\uff0c\u5c07\u96fb\u6676\u9ad4\u5806\u758a\u6210\u58fd\u53f8\u6372\u578b\u614b\u76f8\u7576\u8cbb\u5de5\u3002\\n\\n| \u5c08\u6848 | \u5167\u5bb9 |\\n|---|---|\\n| \u88fd\u7a0b | \u53f0\u7a4d\u96fb2\u5948\u7c73\uff08GAA\uff09 |\\n| CPU\u6548\u80fd | \u8f03\u524d\u4ee3 +20% |\\n| GPU\u6548\u80fd | \u8f03\u524d\u4ee3 +40% |\\n| \u795e\u7d93\u5f15\u64ce | 2\u500d\uff08\u642d\u8f092\u9846\uff09 |\\n| \u8a18\u61b6\u9ad4\u983b\u5bec | +50% |\\n| \u5145\u96fb | 50%\u96fb\u91cf15\u5206\u9418 |\\n| \u91cd\u91cf | 18 Pro Max\u8f0317 Pro +16\u516c\u514b |\\n\\n2\u5948\u7c73\u5316\u7684\u6700\u5927\u8ab2\u984c\u662f\u71b1\u5bc6\u5ea6\u4e0a\u5347\u3002\u677e\u7530\u6307\u51fa\u300c\u4e00\u7528\u96fb\u8f38\u51fa\u6548\u80fd\u5c31\u6703\u7acb\u523b\u767c\u71b1\u300d\uff0c\u4e26\u80af\u5b9a\u860b\u679c\u52a0\u5927\u5747\u71b1\u677f\u4ee5\u6539\u5584\u6301\u7e8c\u6548\u80fd\u7684\u4f5c\u6cd5\u3002\u667a\u6167\u578b\u624b\u6a5f\u6676\u7247\u767c\u63ee\u5cf0\u503c\u6548\u80fd\u7684\u6642\u9593\u50c5\u4f54\u6574\u9ad4\u768410%\u81f315%\uff0c\u72c0\u6cc1\u5dee\u7684\u8a71\uff0c\u958b\u6a5f10\u5206\u9418\u5f8c\u53ef\u80fd\u53ea\u5269\u4e00\u534a\u6548\u80fd\u3002\u5bae\u5ddd\u9054\u5f65\u4ee516 Pro\u4f7f\u7528\u8005\u8eab\u5206\u88dc\u5145\u300c\u5be6\u969b\u4e0a\u5e7e\u4e4e\u4e0d\u6703\u611f\u53d7\u5230\u964d\u983b\u300d\uff0c\u8a8d\u70ba\u9664\u4e86\u904a\u6232\u6216\u672c\u5730\u7aefAI\u4e4b\u5916\uff0c\u6548\u80fd\u63d0\u5347\u7684\u53d7\u60e0\u7bc4\u570d\u6709\u9650\u3002\\n\\n\u8702\u5de2\u5f0f\u6676\u7247\u65b0\u642d\u8f09C2\uff0c\u652f\u63f4\u6beb\u7c73\u6ce2\u3002\u4e0d\u904e\u5728\u7f8e\u570b\u50c518 Pro\u642d\u8f09\uff0cPro Max\u4e26\u672a\u914d\u5099\uff0c\u50b3\u805ePro Max\u4ecd\u4fdd\u7559\u9ad8\u901a\u6676\u7247\u3002\u5bae\u5ddd\u63d0\u53ca\u300c\u5408\u7d04\u4e0a\u52302026\u5e74\u70ba\u6b62\u5fc5\u9808\u4f7f\u7528\u9ad8\u901a\u300d\u7684\u50b3\u805e\uff0c\u5f62\u5bb9\u6536\u8cfc\u4e86\u82f1\u7279\u723e\u6578\u64da\u6a5f\u90e8\u9580\u7684\u860b\u679c\uff0c\u8655\u65bc\u300c\u60f3\u5206\u624b\u537b\u5206\u4e0d\u4e86\u300d\u7684\u72c0\u614b\u3002\\n\\n## \u53ef\u8b8a\u5149\u5708\u76f8\u6a5f\u2014\u2014\u589e\u52a0\u7269\u7406\u96f6\u4ef6\u7684\u300c\u5192\u96aa\u300d\\n\\n\u76f8\u6a5f\u5f9eF1.78\u56fa\u5b9a\u5149\u5708\uff0c\u9032\u5316\u70baF1.48\uff0f1.8\uff0f2.8\uff0f4.0\u7684\u56db\u6bb5\u53ef\u8b8a\u5149\u5708\u3002\u5c08\u696d\u6a21\u5f0f\u53ef\u624b\u52d5\u5207\u63db\uff0c\u81ea\u52d5\u6a21\u5f0f\u5247\u7531\u4f5c\u696d\u7cfb\u7d71\u6839\u64da\u4eae\u5ea6\u8207\u88ab\u651d\u4eba\u6578\u81ea\u52d5\u5224\u65b7\u3002\u8ac7\u5230\u5149\u5708\u6548\u679c\uff0c\u677e\u7530\u8209\u51fa\u661f\u8292\uff08\u5149\u7dda\u5c16\u523a\uff09\u70ba\u4f8b\uff0c\u8868\u793a\u300c\u5f9e\u6b64\u8fce\u4f86\u661f\u8292\u81ea\u7531\u6642\u4ee3\u300d\uff0c\u53e6\u4e00\u65b9\u9762\u6307\u51fa\u6563\u666f\u6548\u679c\u300c\u5728\u93e1\u982d\u53e3\u5f91\u5c0f\u7684\u624b\u6a5f\u4e0a\u7269\u7406\u4e0a\u505a\u4e0d\u51fa\u4f86\u300d\u3002\u4ed6\u80af\u5b9a\u860b\u679c\u523b\u610f\u4e0d\u5be6\u4f5cAI\u904b\u7b97\u6563\u666f\u7684\u6c7a\u5b9a\u300c\u5f88\u4e86\u4e0d\u8d77\u300d\u2014\u2014\u56e0\u70ba\u90a3\u6703\u8b93\u52a0\u88dd\u5149\u5708\u5931\u53bb\u610f\u7fa9\u3002\\n\\n\u677e\u7530\u8a55\u50f9\u300c\u7269\u7406\u53ef\u52d5\u96f6\u4ef6\u589e\u52a0\uff0c\u6545\u969c\u6a5f\u7387\u5c31\u8ddf\u8457\u63d0\u9ad8\u3002\u904e\u53bb\u4e00\u76f4\u5728\u6e1b\u5c11\u5be6\u9ad4\u6309\u9375\uff0c\u537b\u5728\u6b64\u6642\u589e\u52a0\u96f6\u4ef6\u6578\uff0c\u53ef\u8aaa\u662f\u5192\u96aa\u300d\u3002\u4ed6\u4e5f\u78ba\u8a8d\u50c5\u4e3b\u76f8\u6a5f\u914d\u5099\u5149\u5708\uff0c\u5ee3\u89d2\u8207\u671b\u9060\u93e1\u982d\u4e26\u672a\u642d\u8f09\u3002\\n\\n\u8207\u7167\u7247\u771f\u5be6\u6027\u76f8\u95dc\u7684\u65b0\u529f\u80fd\u4e5f\u5099\u53d7\u95dc\u6ce8\u3002\u65b0\u6578\u4f4dID\uff08Content ID\uff09\u7684\u6a5f\u5236\u662f\uff0c\u7576\u9032\u884cAI\u7de8\u8f2f\u6642\uff0c\u6703\u9644\u52a0\u300c\u5df2\u7528AI\u7de8\u8f2f\u300d\u7684\u4e2d\u7e7c\u8cc7\u6599\u3002Apple Reference Image\u5247\u662f\u4ee5\u611f\u6e2c\u5668\u62cd\u651d\u7684\u539f\u59cb\u756b\u7d20\u9032\u884c\u7c3d\u7f72\uff0c\u518d\u900f\u904eApple\u7684Private Cloud Compute\u9a57\u8b49\u8207\u7c3d\u7f72\u7684\u5169\u968e\u6bb5\u65b9\u5f0f\uff0c\u8b93\u5831\u7d19\u8207\u65b0\u805e\u5a92\u9ad4\u5f97\u4ee5\u9a57\u8b49\u5f71\u50cf\u662f\u5426\u906d\u5230\u7ac4\u6539\u3002\\n\\n\u50f9\u683c\u65b9\u9762\uff0c18 Pro\u70ba1,199\u7f8e\u5143\uff08\u65e5\u672c\u552e\u50f921.98\u842c\u65e5\u5713\uff0c\u7d04\u65b0\u53f0\u5e634.5\u842c\u5143\uff09\uff0cPro Max\u70ba23.98\u842c\u65e5\u5713\uff08\u7d04\u65b0\u53f0\u5e634.9\u842c\u5143\uff09\u3002\u5bae\u5ddd\u8868\u793a\u300c\u8003\u91cf\u65e5\u5713\u8cb6\u503c\u8207\u7269\u50f9\uff0c\u53ef\u8aaa\u662f\u76f8\u7576\u8cb4\u300d\uff0c\u540c\u6642\u8a73\u7d30\u89e3\u8aaaApple Upgrade Program\u3002\u6bcf\u6708\u7d0425\u7f8e\u5143\uff0c\u53ef\u9078\u64c712\u500b\u6708\u621624\u500b\u6708\u65b9\u6848\uff0c\u7e3d\u984d\u8207\u4e00\u6b21\u8cb7\u65b7\u76f8\u540c\uff0c\u300c\u57fa\u672c\u4e0a\u4e0d\u6703\u5403\u8667\u300d\u3002\u642d\u8f09M5 Ultra\u7684Mac\u6a5f\u578b\uff08120\u842c\u65e5\u5713\u8d77\u8df3\uff09\u4e5f\u9069\u7528\uff0c\u6bcf\u6708250\u7f8e\u5143\u5373\u53ef\u79df\u7528\uff0c\u4ed6\u5c07\u5176\u8207\u300cClaude Code\u7684Max\u65b9\u6848\u76f8\u540c\u50f9\u683c\u300d\u505a\u6bd4\u8f03\u3002\\n\\n## \u647a\u758a\u6a5f\u300ciPhone Duo\u300d\u2014\u2014\u521d\u4ee3\u92fc\u5f48\u7684\u5be6\u9a57\u6027\\n\\n\u767c\u8868\u6703\u5c3e\u8072\u9a5a\u559c\u4eae\u76f8\u7684iPhone Duo\uff0c\u662f1,999\u7f8e\u5143\uff08\u65e5\u672c\u552e\u50f936.48\u842c\u65e5\u5713\uff0c\u7d04\u65b0\u53f0\u5e637.5\u842c\u5143\uff09\u8d77\u8df3\u7684\u647a\u758a\u88dd\u7f6e\u3002\u677e\u7530\u5c07\u5176\u5b9a\u4f4d\u70ba\u300c\u4ee5\u92fc\u5f48\u4f86\u8aaa\u5c31\u662f\u521d\u4ee3\u92fc\u5f48\u300d\uff0c\u8aaa\u660e\u9019\u662f\u4ee5AI\u9032\u884c\u7d44\u88dd\u8a2d\u8a08\u3001\u96f6\u4ef6\u6578\u8d85\u904e100\u500b\u7684\u5be6\u9a57\u6027\u88dd\u7f6e\u3002\u767c\u8868\u5f8c\uff0cGoogle\u641c\u5c0b\u300cfoldable iPhone\u300d\u7684\u641c\u5c0b\u8da8\u52e2\u572824\u5c0f\u6642\u5167\u8f03\u524d\u4e00\u9031\u66b4\u589e2400%\u3002\\n\\n| \u7279\u5fb5 | \u5167\u5bb9 |\\n|---|---|\\n| \u986f\u793a\u5668 | \u5948\u7c73\u7d0b\u7406\u8655\u7406\uff0c\u647a\u75d5\u4e0d\u660e\u986f |\\n| \u76f8\u6a5f | \u87a2\u5e55\u4e0b\u76f8\u6a5f |\\n| \u751f\u7269\u8fa8\u8b58 | \u7121Face ID\uff0c\u63a1\u7528Touch ID |\\n| Apple Pencil | \u50c5\u652f\u63f4USB-C\u7248 |\\n| \u6676\u7247 | \u820718 Pro\u540c\u7b49\u7d1a |\\n| \u4e0a\u5e02 | 10\u670823\u65e5\u958b\u653e\u9810\u8cfc |\\n\\nUI\u65b9\u9762\uff0c\u677e\u7530\u5f9e\u5de6\u6487\u5b50\u7684\u7acb\u5834\u8868\u793a\u300c\u5411\u53f3\u7ffb\u958b\u7684\u624b\u5e33\u578b\u4e0d\u597d\u7528\u3002\u5982\u679c\u63a8\u51fa\u5de6\u53f3\u5c0d\u7a31\u7684\u5de6\u958b\u7248\u672c\uff0c\u6211\u6703\u6a02\u610f\u8cfc\u8cb7\u300d\u3002\u8ab2\u984c\u5728\u65bc\u7b2c\u4e09\u65b9App\u7684\u652f\u63f4\u3002\u5bae\u5ddd\u6307\u51fa\u300cGmail\u7b49App\u57282\u52303\u500b\u6708\u5167\u4e0d\u6703\u652f\u63f4\u3002Netflix\u9023Vision Pro\u7684App\u90fd\u6c92\u51fa\uff0c\u537b\u9858\u610f\u767b\u4e0a\u767c\u8868\u6703\u821e\u53f0\u6295\u8cc7Duo\uff0c\u9019\u9ede\u5f88\u6709\u610f\u601d\u300d\u3002Galaxy Fold 8\u5728\u65e5\u672c\u552e\u50f9\u7d0426.7\u842c\u65e5\u5713\uff08\u7d04\u65b0\u53f0\u5e635.5\u842c\u5143\uff09\u7684\u50f9\u5dee\u4e5f\u6210\u70ba\u8a71\u984c\u3002\\n\\n## AI\u4ee3\u7406\u7684\u73fe\u5728\u9032\u884c\u5f0f\u2014\u2014\u5e38\u99d0\u57f7\u884cCodex\u7684\u65e5\u5e38\\n\\nAI\u65b9\u9762\uff0cGPT-6 Astra\u300c\u7576\u5929\u300d\u5373\u53ef\u4f7f\u7528\uff0c\u677e\u7530\u5c07\u4e3b\u529b\u5f9eAnthropic\u7684200\u7f8e\u5143\u65b9\u6848\u5207\u63db\u5230OpenAI\u7684200\u7f8e\u5143\u65b9\u6848\u3002\u4ed6\u7279\u5225\u80af\u5b9a\u96fb\u8166\u64cd\u4f5c\u80fd\u529b\u300c\u89ba\u9192\u300d\uff0c\u80fd\u5728Blender\u4e2d\u751f\u62103D\u6a21\u578b\u8207\u52d5\u756b\u3002\u300c\u54c1\u8cea\u5927\u7d04\u662fPS1\u6642\u4ee3\u7684\u904e\u5834\u52d5\u756b\u300d\uff0c\u4f46\u9810\u6e2c\u300c\u5f9e\u904e\u53bb\u6848\u4f8b\u4f86\u770b\uff0c3\u5e74\u30011\u5e74\u5c31\u6703\u6301\u7e8c\u5927\u5e45\u9032\u6b65\u300d\u3002\u4ed6\u63d0\u5230\u66fe\u8981\u6c42\u5c071\u842c3000\u884c\u7684\u5de8\u578b\u6a21\u7d44\u300c\u780d\u534a\u300d\uff0cClaude\u300c\u542b\u7cca\u5176\u8fad\u300d\u5730\u8ff4\u907f\uff0cAstra\u5247\u300c\u4fd0\u843d\u5730\u5b8c\u6210\u4e86\u300d\u3002\\n\\n\u5bae\u5ddd\u7684\u4ee3\u7406\u904b\u7528\u66f4\u9032\u4e00\u6b65\u3002\u4ed6\u5728Mac\u4e0a\u5e38\u99d0\u57f7\u884cCodex\uff0c\u505c\u7528\u7761\u7720\u529f\u80fd\u4ee5\u4fbf\u5f9e\u5916\u90e8\u9023\u7dda\uff0c\u6bcf\u5929\u65e9\u4e0a8\u9ede\u5728Ticketmaster\u3001StubHub\u76e3\u63a7\u6a5f\u7968\u50f9\u683c\u8207\u6f14\u5531\u6703\u8f49\u552e\u7968\u50f9\uff0c\u7b26\u5408\u689d\u4ef6\u5c31\u50b3\u9001\u8a0a\u606f\uff0c\u4e26\u5f59\u6574\u7576\u65e5\u884c\u7a0b\u3001\u5929\u6c23\u3001\u6700\u65b0\u65b0\u805e\u50b3\u9001\u7d66\u81ea\u5df1\u3002\u300c\u80fd\u81ea\u884c\u8a2d\u5b9a\u7684\u4eba\u4ee5\u5916\uff0c\u4f8b\u5982\u8981\u8b93\u5bb6\u4eba\u4f7f\u7528\u6642\uff0c\u6bd4\u8d77Codex\u9019\u985e\u672c\u5730\u5efa\u7f6e\u578b\uff0cMuse\u9019\u985e\u96f2\u7aef\u804a\u5929\u578b\u4ee3\u7406\u61c9\u8a72\u66f4\u5bb9\u6613\u4e0a\u624b\u300d\uff0c\u4ed6\u63a8\u85a6\u4e00\u822c\u4f7f\u7528\u8005\u4f7f\u7528Meta\u7684Muse\u6216xAI\u7684Grok Bot\u3002\\n\\n\u4ee3\u78bc\u5be9\u67e5\u4e5f\u6709\u4e00\u534a\u4ea4\u7d66\u4ee3\u7406\u3002\u300c\u8b93\u4ee3\u7406\u5be9\u67e5\u81ea\u5df1\u5beb\u7684PR\uff0c\u518d\u53eb\u81ea\u5df1\u7684\u4ee3\u7406\u8655\u7406\u300e\u6709\u9019\u7a2e\u8a55\u8ad6\uff0c\u53bb\u8655\u7406\u4e00\u4e0b\u300f\uff0c\u56de\u8986\u5168\u90e8\u4ea4\u7d66\u4ee3\u7406\u300d\u3002\u4ed6\u8868\u793aAI\u64b0\u5beb\u7684\u8a55\u8ad6\u6703\u52a0\u4e0a\u660e\u78ba\u6a19\u7c64\u4ee5\u8cc7\u5340\u5225\u3002\\n\\n![](https:\\/\\/img.bgo.one\\/news-image\\/ai_generated\\/2026-09\\/fb668ce5aaf17be1_1789641578_inline_4.jpg)\\n\\n\\n\\n## \u300c\u883b\u529b\u300d\u5f9e\u6578\u5b78\u596a\u8d70\u7684\u6771\u897f\u2014\u2014AI\u8207\u5b78\u8853\u7684\u6469\u64e6\\n\\nOpenAI\u7684\u4ee3\u7406\u64da\u7a31\u4ee5\u66b4\u529b\u7834\u89e3\u65b9\u5f0f\u767c\u73fe\u4e86\u7d0d\u7dad\u2014\u65af\u6258\u514b\u65af\u65b9\u7a0b\u5f0f\uff08\u6d41\u9ad4\u63cf\u8ff0\uff0c\u7528\u65bc\u904a\u6232\u7159\u9727\u6a21\u64ec\u8207\u5929\u6c23\u9810\u5831\uff09\u7684\u767c\u6563\u554f\u984c\uff0c\u6b64\u4e8b\u5f15\u767c\u6578\u5b78\u5bb6\u53cd\u5f48\u3002\u5bae\u5ddd\u5982\u6b64\u6574\u7406\u5176\u672c\u8cea\u3002\u300c\u904e\u53bb\u7684\u505a\u6cd5\u662f\u5728\u5c0b\u627e\u6bd4\u66b4\u529b\u7834\u89e3\u66f4\u6709\u6548\u7387\u89e3\u6cd5\u7684\u904e\u7a0b\u4e2d\u767c\u73fe\u65b0\u77e5\u8b58\uff0c\u4f46\u7528AI\u883b\u529b\u786c\u5e79\u7684\u8a71\uff0c\u9019\u7a2e\u4e8b\u60c5\u5c31\u4e0d\u6703\u767c\u751f\u4e86\u300d\u3002\\n\\n\u4ed6\u9032\u4e00\u6b65\u6307\u51fa\u300c\u6709\u4e9b\u5b78\u554f\u53ea\u8981\u77e5\u9053\u7b54\u6848\u5c31\u597d\uff0c\u6709\u4e9b\u5b78\u554f\u5247\u91cd\u8996\u5c0b\u627e\u7b54\u6848\u7684\u624b\u6bb5\u662f\u5426\u6b63\u78ba\u3001\u80fd\u5426\u5f9e\u4e2d\u767c\u73fe\u65b0\u77e5\u8b58\uff0c\u50f9\u503c\u89c0\u4e0d\u540c\u300d\uff0c\u9ede\u51fa\u5de5\u7a0b\u8207\u6578\u5b78\u7684\u50f9\u503c\u89c0\u5dee\u7570\u3002\u6578\u5b78\u5bb6\u4e4b\u9593\u4e5f\u6d6e\u73fe\u4e86\u61f7\u7591ChatGPT\u662f\u5426\u5c07\u5c0d\u8a71\u7d00\u9304\u7528\u65bc\u8a13\u7df4\u7684\u300c\u6a6b\u596a\u300d\u7591\u616e\u3002\\n\\n## \u7981\u7528AI\u4ee3\u78bc\u7684\u52d5\u5411\u8207\u958b\u6e90\u7684\u7cfe\u7d50\\n\\nLinux\u7cfb\u767c\u884c\u7248\u8207GitHub\u7684\u958b\u6e90\u5c08\u6848\u4e2d\uff0c\u51fa\u73fe\u4e86\u5168\u9762\u7981\u6b62AI\u751f\u6210\u4ee3\u78bc\u8207\u8a55\u8ad6\u7684\u52d5\u5411\u3002\u5bae\u5ddd\u8868\u793a\u300c\u54c1\u8cea\u597d\u7684\u78ba\u5be6\u6709\uff0c\u4f46\u54c1\u8cea\u5dee\u7684\u4e5f\u771f\u7684\u5f88\u591a\uff0c\u6240\u4ee5\u5168\u9762\u7981\u6b62\u7684\u610f\u898b\u4e5f\u4e0d\u662f\u4e0d\u80fd\u7406\u89e3\u300d\uff0c\u5c55\u73fe\u4e86\u5177\u5e73\u8861\u611f\u7684\u89c0\u9ede\u3002\\n\\n\u540c\u6642\u96e2\u958bAnthropic\u8207OpenAI\u7684\u96c5\u5404\u5e03\u00b7\u79d1\u514b\u68ee\u8b66\u544a\u300cAI\u662f\u5371\u96aa\u7684\uff0c\u7167\u9019\u6a23\u4e0b\u53bb\u5e74\u5e95\u524d\u7db2\u969b\u7db2\u8def\u53ef\u80fd\u5168\u9762\u906d\u5230\u652f\u914d\u300d\u3002\u9054\u88e1\u5967\u00b7\u963f\u83ab\u8fea\u8207\u5c71\u59c6\u00b7\u5967\u7279\u66fc\u4e5f\u8868\u793a\u300c\u61c9\u8a72\u8b39\u614e\u63a8\u9032\u300d\u3002\u53d7\u6b64\u5f71\u97ff\uff0c9\u670815\u65e5\u5e02\u5834\u4e0aAI\u4e09\u5de8\u982d\u7f55\u898b\u7684\u806f\u5408\u8b66\u544a\u91cd\u5275\u8a18\u61b6\u9ad4\u80a1\uff0c\u8cbb\u57ce\u534a\u5c0e\u9ad4\u6307\u6578\u66b4\u8dcc\u8d85\u904e600\u9ede\u3002\u53e6\u4e00\u65b9\u9762\uff0c\u5ddd\u666e\u7e3d\u7d71\u5426\u8a8d\u66ab\u505cAI\u958b\u767c\u7684\u53ef\u80fd\u6027\uff0c\u8868\u793a\u300c\u7d55\u7121\u53ef\u80fd\u300d\uff0c\u4e26\u8b66\u544a\u7af6\u722d\u529b\u5c07\u88ab\u4e2d\u570b\u596a\u8d70\u3002\\n\\n\u5bae\u5ddd\u4ee5\u8cfd\u5c40\u7406\u8ad6\u7684\u300c\u4ee5\u7259\u9084\u7259\u300d\u7b56\u7565\u8aaa\u660e\u300c\u9019\u63a5\u8fd1\u4f0a\u9686\u00b7\u99ac\u65af\u514b1\u30012\u5e74\u524d\u8aaa\u904e\u7684\u8a71\u3002\u5be6\u969b\u4e0a\u5373\u4f7f\u8aaa\u8981\u505c\u6b62\uff0c\u4e5f\u6703\u6709\u7591\u616e\u8a8d\u70ba\u53ea\u6709\u4ed6\u81ea\u5df1\u7e7c\u7e8c\u958b\u767c\uff0c\u6240\u4ee5\u7121\u6cd5\u57f7\u884c\u300d\u3002\u677e\u7530\u5247\u8af7\u523a\u300c\u958b\u767cLLM\u7684\u4eba\u5011\uff0c\u5176\u884c\u70ba\u8207\u6c1b\u570d\u8d8a\u4f86\u8d8a\u50cfLLM\u3002\u611f\u89ba\u4ed6\u5011\u6703\u8aaa\u300e\u6211\u7576\u6642\u662f\u90a3\u6a23\u8aaa\u7684\uff0c\u4f46\u73fe\u5728\u4e0d\u4e00\u6a23\u4e86\u300f\u300d\u3002\\n\\n## \u8861\u91cfAI\u6ce1\u6cab\u7684\u5169\u500b\u6578\u5b57\u2014\u2014Anthropic\u7684IPO\u8207SpaceX\u7684\u80a1\u50f9\\n\\n\u4f5c\u70ba\u8861\u91cfAI\u6ce1\u6cab\u7e8c\u822a\u529b\u7684\u8a66\u91d1\u77f3\uff0cAnthropic\u572810\u6708\u7684IPO\u7784\u6e96\u7c4c\u8cc72\u5146\u65e5\u5713\uff08\u7d044,100\u5104\u65b0\u53f0\u5e63\uff09\u898f\u6a21\u3002\u677e\u7530\u9810\u6e2c\u300c\u9019\u985e\u8cc7\u91d1\u52df\u96c6\u53ea\u8981\u80fd\u6301\u7e8c\u8ff4\u5708\uff0cAI\u6ce1\u6cab\u5927\u6982\u5c31\u6703\u6301\u7e8c\u4e0b\u53bb\u300d\u3002\u53e6\u4e00\u65b9\u9762\uff0cOpenAI\u5ef6\u5f8cIPO\uff0c\u5c71\u59c6\u00b7\u5967\u7279\u66fc\u65b9\u9762\u8868\u793a\u5c07\u843d\u57282027\u5e74\uff0c\u8edf\u9280\u80a1\u50f9\u56e0\u6b64\u6025\u8dcc\u3002\\n\\n\u4f5c\u70ba\u5c0d\u7167\u6848\u4f8b\uff0cSpaceX\u7684IPO\u50f9\u683c135\u7f8e\u5143\uff0c\u76ee\u524d151\u7f8e\u5143\uff0c\u300c\u65e2\u4e0d\u7b97\u5927\u6210\u529f\u4e5f\u4e0d\u7b97\u5931\u6557\uff0c\u5e73\u5e73\u7a69\u7a69\u300d\u3002\u677e\u7530\u7684\u767c\u8a00\u300c\u6ce1\u6cab\u4e0d\u6301\u7e8c\u4e0b\u53bb\uff0c\u75c7\u72c0\u89e3\u958b\u5713\u9802\u7684\u4e16\u754c\u4e5f\u7121\u6cd5\u6301\u7e8c\u300d\uff0c\u7cbe\u6e96\u9ede\u51fa\u4e86AI\u7814\u7a76\u9032\u5c55\u4f9d\u8cf4\u8cc7\u672c\u5e02\u5834\u6301\u7e8c\u6027\u7684\u7d50\u69cb\u6027\u8106\u5f31\u3002\\n\\n![](https:\\/\\/img.bgo.one\\/news-image\\/ai_generated\\/2026-09\\/fb668ce5aaf17be1_1789641661_inline_7.jpg)\\n\\n\\n\\n## Pixel 11 Pro\u7684\u505c\u6eef\u8207\u300c\u5be6\u8cea100\u7f8e\u5143\u300d\u7684\u512a\u60e0\\n\\nPixel 11 Pro\u50c5\u87a2\u5e55\u4eae\u5ea6\u63d0\u5347200\u5c3c\u7279\uff0c\u677e\u7530\u8a55\u8ad6\u300c\u8207\u5176\u8aaa\u662f\u5b8c\u5168\u9ad4\u6240\u4ee5\u4e0d\u9032\u5316\uff0c\u4e0d\u5982\u8aaa\u662f\u505c\u6eef\u300d\u3002\u96d6\u7136\u65b0\u589e\u4e86Magic Capture\u3001Rambler\u3001Motion Assist\u7b49\u8edf\u9ad4\u529f\u80fd\uff0c\u4f46\u51fa\u73fe\u4ee5Magic Capture\u62cd\u651d\u7684\u7167\u7247\u6703\u88ab\u52a0\u4e0a\u300cMade with AI\u300d\u6a19\u7c64\u7684\u554f\u984c\u3002\u5bae\u5ddd\u4e0d\u6eff\u5730\u8868\u793a\uff0c\u5c074\u5f35\u5373\u6642\u7167\u7247\u8cbc\u5230X\u4e0a\u5f8c\u88ab\u52a0\u4e0a\u300cMade with AI\u300d\u6a19\u7c64\uff0c\u300c\u641e\u5f97\u597d\u50cf\u6574\u5f35\u7167\u7247\u90fd\u662fAI\u505a\u7684\u4e00\u6a23\u300d\u3002\\n\\n\u50f9\u683c\u65b9\u9762\uff0c\u4ed6\u8aaa\u660e1,099\u7f8e\u5143\u6e1b\u53bb\u9996\u65e5\u6298\u6263250\u7f8e\u5143\u3001Pixel 10 Pro\u820a\u63db\u65b0600\u7f8e\u5143\u3001Google One\u8a02\u6236200\u7f8e\u5143\u5546\u5e97\u9ede\u6578\u3001Google One 50\u7f8e\u5143\u984d\u5ea6\uff0c\u5408\u8a08\u300c\u5be6\u8cea\u7d04100\u7f8e\u5143\u5c31\u80fd\u63db\u65b0\uff0c\u9084\u5269200\u7f8e\u5143\u9ede\u6578\u300d\u3002\u5c0d\u6bd4iPhone 18 Pro\u76841,300\u7f8e\u5143\uff0c\u820a\u63db\u65b0300\u7f8e\u5143\u3001\u7a05\u91d1100\u7f8e\u5143\uff0c\u300c\u5e7e\u4e4e\u62ff\u4e0d\u56de\u4f86\u300d\u3002\\n\\n\u5bae\u5ddd\u8ac7\u5230\u4ee3\u7406\u64cd\u4f5c\u700f\u89bd\u5668\u7684\u5a01\u529b\u6642\u8868\u793a\u300c\u4f7f\u7528\u700f\u89bd\u5668\u64cd\u4f5c\u6642\uff0c\u6703\u986f\u793a\u4ee3\u7406\u76ee\u524d\u6b63\u5728\u770b\u4ec0\u9ebc\u756b\u9762\u7684\u7e2e\u5716\uff0c\u4f46\u5df2\u7d93\u5b8c\u5168\u7a81\u7834\u9a57\u8b49\u78bc\u4e4b\u985e\u7684\u9632\u8b77\u4e86\uff0c\u5f88\u5e73\u5e38\u5730\u5c31\u904e\u53bb\u4e86\u300d\uff0c\u5206\u4eab\u4e86\u50b3\u7d71\u722c\u87f2\u9632\u8b77\u6b63\u9010\u6f38\u5931\u6548\u7684\u5be6\u52d9\u89c0\u5bdf\u3002\\n\\n2\u5948\u7c73\u9019\u9805\u7269\u7406\u7a81\u7834\uff0c\u4ee5\u767c\u71b1\u3001\u91cd\u91cf\u3001\u50f9\u683c\u70ba\u4ee3\u50f9\u57282026\u5e74\u5be6\u73fe\uff0c\u786c\u9ad4\u9032\u5316\u6b63\u9762\u81e8\u8f49\u6298\u9ede\u3002iPhone Duo\u300c\u4ee5AI\u9032\u884c\u8d85\u904e100\u500b\u96f6\u4ef6\u7684\u7d44\u88dd\u8a2d\u8a08\u300d\u9019\u7a2e\u8a2d\u8a08\u624b\u6cd5\uff0c\u662fAI\u5728\u88fd\u9020\u6d41\u7a0b\u4e2d\u5bb9\u6613\u88ab\u63a5\u53d7\u7684\u5178\u578b\u4f8b\u5b50\u3002\u5c0d\u6bd4\u4e4b\u4e0b\uff0c\u5728\u76f4\u63a5\u7522\u51fa\u751f\u6210\u7269\u7684\u9818\u57df\uff0c\u6578\u5b78\u5bb6\u7684\u53cd\u5f48\u9054\u5230\u9802\u9ede\uff0c\u958b\u6e90\u793e\u7fa4\u7981\u7528AI\u4ee3\u78bc\u7684\u52d5\u5411\u6301\u7e8c\u64f4\u5927\u3002\u50f9\u503c\u7684\u91cd\u5fc3\u78ba\u5be6\u6b63\u5f9e\u7269\u7406\u6548\u80fd\u7af6\u722d\uff0c\u8f49\u5411AI\u4ee3\u7406\u7684\u5be6\u7528\u6027\u53ca\u5176\u63a5\u53d7\u5ea6\u6240\u5f15\u767c\u7684\u793e\u6703\u6469\u64e6\u3002\u5269\u4e0b\u7684\u554f\u984c\u662f\uff0cAnthropic\u7684IPO\u80fd\u5426\u8b93AI\u6ce1\u6cab\u5ef6\u7e8c\uff0c\u4ee5\u53ca\u5bae\u5ddd\u6bcf\u5929\u65e9\u4e0a8\u9ede\u5f9eCodex\u6536\u5230\u7684\u8a0a\u606f\uff0c\u662f\u5426\u6703\u6210\u70baAI\u6642\u4ee3\u65e5\u5e38\u7684\u539f\u578b\u3002\",\"summary\":\"2026\u5e749\u6708\u860b\u679c\u767c\u8868\u6703\u516c\u4f48\u7684iPhone 18 Pro\uff0c\u642d\u8f09\u53f0\u7a4d\u96fb2\u5948\u7c73\u88fd\u7a0b\uff08GAA\uff09\u7684A20 Pro\u6676\u7247\uff0cCPU\u6548\u80fd\u8f03\u524d\u4ee3\u63d0\u534720%\u3002\u7136\u800c\u4ee3\u50f9\u662f\u71b1\u5bc6\u5ea6\u4e0a\u5347\u8207\u91cd\u91cf\u589e\u52a0\uff08Pro Max\u589e\u91cd16\u516c\u514b\uff09\uff0c\u7269\u7406\u9650\u5236\u65e5\u76ca\u660e\u986f\u3002\u5de5\u7a0b\u5e2b\u5bae\u5ddd\u9054\u5f65\u5728Rebuild.fm\u7bc0\u76ee\u4e2d\u4ee5\u300c\u58fd\u53f8\u6372\u578b\u96fb\u6676\u9ad4\u300d\u6bd4\u55bb2\u5948\u7c73\u7684\u672c\u8cea\uff0c\u6307\u51fa\u667a\u6167\u578b\u624b\u6a5f\u6676\u7247\u80fd\u767c\u63ee\u5cf0\u503c\u6548\u80fd\u7684\u6642\u9593\u50c5\u4f54\u6574\u9ad4\u768410%\u81f315%\u3002\u860b\u679c\u96d6\u4ee5\u52a0\u5927\u5747\u71b1\u677f\u56e0\u61c9\uff0c\u4f46\u786c\u9ad4\u9032\u5316\u8d8a\u63a5\u8fd1\u7269\u7406\u6975\u9650\uff0c\u50f9\u683c\u3001\u91cd\u91cf\u3001\u767c\u71b1\u7684\u4ee3\u50f9\u5c31\u8d8a\u9f90\u5927\u3002\u53e6\u4e00\u65b9\u9762\uff0c\u5bae\u5ddd\u5728Mac\u4e0a\u5e38\u99d0\u57f7\u884cCodex\uff0c\u6bcf\u5929\u65e9\u4e0a8\u9ede\u81ea\u52d5\u76e3\u63a7\u6a5f\u7968\u50f9\u683c\u8207\u6f14\u5531\u6703\u8f49\u552e\u7968\u50f9\uff0c\u5df2\u5efa\u7acb\u5c07\u4e00\u534a\u4ee3\u78bc\u5be9\u67e5\u4ea4\u7d66AI\u4ee3\u7406\u7684\u958b\u767c\u6d41\u7a0b\u3002AI\u4ee3\u7406\u5728\u300c\u64cd\u4f5c\u5de5\u5177\u300d\u7684\u968e\u6bb5\u6b63\u5feb\u901f\u5be6\u7528\u5316\u3002\u5c0d\u6bd4\u4e4b\u4e0b\uff0c\u5728\u76f4\u63a5\u7522\u51fa\u751f\u6210\u7269\u7684\u9818\u57df\uff0c\u6578\u5b78\u5bb6\u7684\u53cd\u5f48\u8207\u958b\u6e90\u793e\u7fa4\u7981\u7528AI\u4ee3\u78bc\u7684\u52d5\u5411\u6b63\u5728\u64f4\u5927\u3002Anthropic\u7684IPO\uff0810\u6708\uff0c\u76ee\u6a19\u7c4c\u8cc72\u5146\u65e5\u5713\uff09\u8207OpenAI\u5ef6\u5f8cIPO\uff082027\u5e74\uff09\uff0c\u5c07\u6210\u70ba\u8861\u91cfAI\u6ce1\u6cab\u7e8c\u822a\u529b\u7684\u8a66\u91d1\u77f3\u3002\",\"image\":\"https:\\/\\/img.biggo.com\\/r1YGZMF1ovp0Ec9ME6boj2pi4-2IvPElyNDwmSpmwlw\\/fit\\/240\\/0\\/sm\\/0\\/aHR0cHM6Ly9pbWcuYmdvLm9uZS9uZXdzLWltYWdlL2FpX2dlbmVyYXRlZC8yMDI2LTA5L2ZiNjY4Y2U1YWFmMTdiZTFfMTc4OTY0MTU3Nl9jb3Zlci5qcGc.webp\",\"community_content\":null,\"key_entities\":[\"\u5bae\u5ddd\u9054\u5f66\",\"\u677e\u7530\u767d\u6717\",\"Apple\",\"iPhone 18 Pro\",\"iPhone Duo\",\"TSMC\",\"OpenAI\",\"Anthropic\",\"Codex\",\"Pixel 11 Pro\",\"SpaceX\",\"GPT-6 Astra\",\"Muse\",\"\u30b5\u30e0\u30fb\u30a2\u30eb\u30c8\u30de\u30f3\",\"\u30c0\u30ea\u30aa\u30fb\u30a2\u30e2\u30c7\u30a4\"],\"timestamp\":1789639749,\"highlight_content\":\"2\u5948\u7c73\u7684\u300c\u58fd\u53f8\u6372\u300d\u2014\u2014A20 Pro\u4ed8\u51fa\u7684\u7269\u7406\u4ee3\u50f9 \u860b\u679c9\u6708\u767c\u8868\u6703\u516c\u4f48\u7684iPhone 18 Pro\uff0fPro Max\u6700\u5927\u8b8a\u9769\uff0c\u662f\u642d\u8f09<em>\u53f0\u7a4d\u96fb<\\/em>2\u5948\u7c73\u88fd\u7a0b<em>\u88fd\u9020<\\/em>\u7684A20 Pro\u6676\u7247\u3002\u91dd\u5c0d\u9019\u6b21\u88fd\u7a0b\u8f49\u63db...\u300c\u58fd\u53f8\u6372\uff08\u77fd\u8207\u9b5a\u6599\u7684\u63a5\u89f8\u9762\u7a4d\u9032\u4e00\u6b65\u589e\u52a0\uff09\u300d\u3002\u4e0d\u904e\u300c\u76f4\u63a5\u505aGAA\u58fd\u53f8\u6372\u8cb4\u5f97\u5687\u4eba\u300d\u2014\u2014\u56e0\u70ba\u5de5\u7a0b\u6b65\u9a5f\u589e\u52a0\uff0c\u5c07\u96fb\u6676\u9ad4\u5806\u758a\u6210\u58fd\u53f8\u6372\u578b\u614b\u76f8\u7576\u8cbb\u5de5\u3002 \u5c08\u6848 \u5167\u5bb9 \u88fd\u7a0b <em>\u53f0\u7a4d\u96fb<\\/em>...\uff0c\u4ee5\u767c\u71b1\u3001\u91cd\u91cf\u3001\u50f9\u683c\u70ba\u