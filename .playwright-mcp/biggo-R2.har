e": "GET, POST, DELETE, PATCH, OPTIONS"}, {"name": "access-control-allow-origin", "value": "https://finance.biggo.com.tw"}, {"name": "content-encoding", "value": "zstd"}, {"name": "content-type", "value": "application/json; charset=utf-8"}, {"name": "date", "value": "Fri, 18 Sep 2026 06:01:44 GMT"}, {"name": "server", "value": "istio-envoy"}, {"name": "vary", "value": "Site, Origin, Accept-Encoding"}, {"name": "x-envoy-upstream-service-time", "value": "217"}], "content": {"size": -1, "mimeType": "application/json; charset=utf-8", "text": "{\"result\":true,\"data\":{\"total\":94,\"page\":1,\"size\":1000,\"sources\":[{\"source_id\":\"67b68f516953\",\"source_name\":\"Goldman Sachs: Great Investors\",\"count\":6,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/EN3DyvMc2xIUwJBPBbgnfv57qfZ_hH7JWVHolFsww0U\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL0RQUU9aVi1Gam04OFhDOVhCQTFZd2hCM0xpYVhSZmRyMFp5c0hWbDJQVFAyZlNOU2VzQm02cGs5SHdUVVVDNzNNMDV4N1prSkl1Zz1zMA.webp\",\"description\":\"The sharpest insights, timely\u00a0analysis, and out-of-consensus thinking from Goldman Sachs.\\n\\nFounded in 1869, our firm delivers world-class execution for clients across our leading Global Banking & Markets and Asset & Wealth Management businesses.\\n\\nWe aspire to be the world\u2019s most exceptional financial institution, united by our shared values of partnership, client service, integrity, and excellence. \\n\",\"follower_count\":3,\"platform_subscribers\":{\"youtube\":319000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"90728ee0ac5b\",\"source_name\":\"Theo - t3.gg\",\"count\":162,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/q_QhU1bOAYgcXSfH3klWysYOfbsEePnmRyzx-0nEYIc\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL1k2anV0NUEtZGhXUmx2N1c4MWtHeFZGUHRaR2paTjk3SWhCUDc1dUxueDJBVlY3WkVKVVVVeEJLSGxGdzlHY3dJTHhrejFFX2NMYz1zMA.webp\",\"description\":\"Software dev, AI nerd, TypeScript sympathizer, creator of T3 Chat and the T3 Stack.\\n\",\"follower_count\":9,\"platform_subscribers\":{\"youtube\":565000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"73f1ccf31ff3\",\"source_name\":\"All-In with Chamath, Jason, Sacks & Friedberg\",\"count\":87,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/NlIpY6XTDC76sZJ2J4CXP9OQh_cbQ2CCPG0jcIihH20\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL3l0Yy9BSWRyb19tdU5GTC1zS3VPUG03MlV2Ry1vZml4cXg3MEtWeVJTNDM2NS1mVHR4SF9jZz1zMA.webp\",\"description\":\"Chamath Palihapitiya, Jason Calacanis, David Sacks & David Friedberg cover all things economic, tech, political, social & poker.\\n\\nFollow the besties: \\nhttps:\\/\\/x.com\\/chamath\\nhttps:\\/\\/x.com\\/Jason\\nhttps:\\/\\/x.com\\/DavidSacks\\nhttps:\\/\\/x.com\\/friedberg\\n\\nFollow the pod: \\nhttps:\\/\\/x.com\\/theallinpod\\nhttps:\\/\\/www.instagram.com\\/theallinpod\\nhttps:\\/\\/www.tiktok.com\\/@theallinpod\\nhttps:\\/\\/www.linkedin.com\\/company\\/allinpod\\n\",\"follower_count\":14,\"platform_subscribers\":{\"youtube\":1140000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"2217e17307ed\",\"source_name\":\"\u7845\u8c37101\u64ad\u5ba2\",\"count\":32,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/XiTbiRUN8tmz7Yxq18RL3gEGUrkGvrg-N1q_q_Zc19o\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tLzhLSmZuUkllMmFiaThvMXA3enBfbUdnUlQ1VVgzUHRjUkhYX1dLUUFLTEZQWDI1bl9uZWpyYlIyd2dxR1VpbGNSVEg4SUtQbW53PXMw.webp\",\"description\":\"\u300a\u7845\u8c37101\u300b\u662f\u4e00\u6863\u5206\u4eab\u5f53\u4e0b\u6700\u65b0\u9c9c\u7684\u6280\u672f\u3001\u77e5\u8bc6\u4e0e\u601d\u60f3\u7684\u79d1\u6280\u64ad\u5ba2\uff0c\u6211\u4eec\u8fd8\u62e5\u6709\u4e00\u6863\u540c\u540d\u89c6\u9891\u8282\u76ee\u300a\u7845\u8c37101\u300b\u3002\\n\u5176\u4ed6\u8ba2\u9605\u6e20\u9053\uff1aApple podcast\uff5cSpotify\uff5c\u5c0f\u5b87\u5b99\\n\u8054\u7cfb\u6211\u4eec\uff1apodcast@sv101.net\\n\",\"follower_count\":0,\"platform_subscribers\":{\"youtube\":77700,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"256aa48e8d11\",\"source_name\":\"Post-Hoc Live\",\"count\":16,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/NxloMXNCl5AZC2B208hj3qJZr41Oxjr498PNZEc9cCU\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tLzFPWlluTWxxbVBISjlxREJ4UldhQUdLa0lPbHNDRVJqZjFRSkZlX2FOZTlrcUViSmpEMkIxNDhFV2JEcU9FWmtKdWFlMmRUMGlWUT1zMA.webp\",\"description\":\"Endpoints News. Biotech, Pharma & FDA news, delivered with full-text to your inbox. For professionals discovering, developing, and marketing biopharmaceutical drugs.\",\"follower_count\":3,\"platform_subscribers\":{\"youtube\":1820,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"697bc59e0afa\",\"source_name\":\"Bloomberg Businessweek\",\"count\":106,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/iUKGjlWy-PWv3ILSkeCkiGJmPSl8bIKvUBqoUBHghpI\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL1BYVFVSclZIUElrZzhWbWIzQXZwaGNJQmNTS0UzM2txRE9neWVVdlZMRnNEQWtFR2FtWHBhRWhFWWg5WU5FUmt2clcxQkJtQz1zMA.webp\",\"description\":\"Bloomberg Podcasts brings you the best video and audio programming from Bloomberg. Watch for news and analysis on the stories making headlines in business, technology and financial markets.\\n\",\"follower_count\":9,\"platform_subscribers\":{\"youtube\":573000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"82ba102b5008\",\"source_name\":\"The Prof G Pod\",\"count\":211,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/Qd-G8Q3Z-aKf1cT5Sl0Tcda-QWTEmBLJDLPnBikxOPw\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL1lZMmY4cExudEFoVGFNUV94RkxuNVNYaDRja0Z4bHoxeGUzaERIQm92ZGVIc05aRnJUZnNpbm5QaFAyM2psdzRLMVllajIzOGVrdz1zMA.webp\",\"description\":\"NYU Professor, best-selling author, business leader and serial entrepreneur Scott Galloway cuts through the biggest stories in tech, business, and investing with unfiltered insights, bold predictions and thoughtful advice. Podcasts include Prof G Markets with co-host Ed Elson, Prof G Conversations and Office Hours with Prof G.\\n\\n\",\"follower_count\":7,\"platform_subscribers\":{\"youtube\":820000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"065e9227d808\",\"source_name\":\"Peter Diamandis\",\"count\":54,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/7ctz_x24nJVlyR6bXzBDLS41yZ45crhRmj9eYM7j9og\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL3l0Yy9BSWRyb19sNHNSR3Y0VTFmbTZkaUVVdGxTVUUyNnAxRVFvSElsYm01d1hSQWlKZlByUm89czA.webp\",\"description\":\"Tracking the future of technology and how it impacts humanity. \\n\\nNamed by Fortune as one of the \u201cWorld\u2019s 50 Greatest Leaders,\u201d Peter H. Diamandis, MD, is a founder, investor, advisor, and best-selling author.  Join Peter on his mission to uplift humanity through technology. \\n\\nFollow Peter on X - https:\\/\\/x.com\\/PeterDiamandis \\n\",\"follower_count\":6,\"platform_subscribers\":{\"youtube\":532000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"d80422ee8031\",\"source_name\":\"The Verge\",\"count\":95,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/-6CpmwBlT27jNLqITjMsPj2B4Srv_NMLHFWXjvQC0u4\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL1pJal9kcTdiZUNrQWtodWZOcUNpZF9TaldXNG1rdjR0cUlEdHY3X0FBS3pXZGhCV0ktcnBzUlhZWEI5WDNtQjBzMHpOek50WWRRPXMw.webp\",\"description\":\"Welcome to the YouTube channel for TheVerge.com, a team of journalists that examines how technology will change life in the future. Subscribe for explainers, product reviews, technology news, and more.\\n\\nEditorial Director: Kevin McShane\\nSupervising Producers:\u00a0 Victoria Barrios, Travis Larchuk\\nVideo Director: Owen Grove\\nSenior Producer: Andrew Marino\\nEditor: Brandon Kieffer\\nSenior Audio Engineer: Erick Gomez\\nArt Director: Alex Parkin\\nEngagement: Denise Cervantes\\n\",\"follower_count\":7,\"platform_subscribers\":{\"youtube\":3520000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"ad5ca4cb9cf2\",\"source_name\":\"The Cognitive Revolution\",\"count\":100,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/GR9xZqKPKHzaLmHk6AIgN9WArFn9TPVd770_DEy6Bnw\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL0MxRVBaRXE3RGVHZXc1a0M1NGlDU2xhenBxT2NxY1JkZWdqakNWa2ZPNFZkaFZhS3lKSUMzQkRjR2dmcXI2UHloa3ZuTnFYTT1zMA.webp\",\"description\":\"The Cognitive Revolution is a podcast about AI where hosts Nathan Labenz and Erik Torenberg interview the builders on the edge of AI and explore the dramatic shift it will unlock over the next decades. \\n\\nIf you love The Cognitive Revolution, head over to Moment of Zen (https:\\/\\/www.youtube.com\\/@MomentofZenPodcast) for weekly episodes from Erik Torenberg, Dan Romero, Antonio Garcia Martinez, and a revolving slate of guests talking tech, business, and AI.\\n\",\"follower_count\":4,\"platform_subscribers\":{\"youtube\":44900,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"FPTXg5wBvbjfYyet42mD\",\"source_name\":\"Odd Lots\",\"count\":84,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/iUKGjlWy-PWv3ILSkeCkiGJmPSl8bIKvUBqoUBHghpI\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL1BYVFVSclZIUElrZzhWbWIzQXZwaGNJQmNTS0UzM2txRE9neWVVdlZMRnNEQWtFR2FtWHBhRWhFWWg5WU5FUmt2clcxQkJtQz1zMA.webp\",\"description\":\"Bloomberg Podcasts brings you the best video and audio programming from Bloomberg. Watch for news and analysis on the stories making headlines in business, technology and financial markets.\\n\",\"follower_count\":5,\"platform_subscribers\":{\"youtube\":573000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"89ae4c0d23a1\",\"source_name\":\"Y Combinator Startup Podcast\",\"count\":91,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/GLpKC2jGEkcvpL60LRSVcyCe4nkaDSbDk9jr_UOsu1g\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL2RHeUFUeDg3RnBfczFuWnZudXBVRlNuTXFiQVBaNm5xUmJ5OUVzazFtNllFNDFpQnEtOVo4aUdvSWdIVENUOVNpREJVcFAyVj1zMA.webp\",\"description\":\"All the world is changing around technology and you may contribute a line of code. What will yours be? \\n\\nSubscribe for startup advice, founder stories, and a look inside Y Combinator.\\n\\nWhat is Y Combinator?\\nWe invest $500,000 in every startup and work intensively with the founders for three months. For the life of their company, founders have access to the most powerful community in the world, essential advice, later-stage funding and programs, recruiting resources, and exclusive deals. \\n\\nVisit ycombinator.com to learn more.\\n\\n\",\"follower_count\":14,\"platform_subscribers\":{\"youtube\":2390000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"08db7cde13a8\",\"source_name\":\"a16z\",\"count\":58,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/Vuegdm8dc994_vn5zsqpxIJw98CojXQG1l3eqT_EA5I\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL2hraU83VUF0QUxyYnFPY2V3bzRDSXJiZDBqOFhEZVd0dEtrZHRpaGZYMWVtZVY0aVVNd2pJZTFLS240emQ2d1QyT093QU5EbklBPXMw.webp\",\"description\":\"a16z is a venture capital firm that invests in software eating the world. Each week, we share videos on technology trends and advice for building companies.\\n\\nThe views expressed here are those of the individual personnel quoted and are not the views of a16z or its affiliates. This content is provided for informational purposes only, and should not be relied upon as legal, business, investment, or tax advice. Furthermore, this content is not directed at nor intended for use by any investors or prospective investors and may not under any circumstances be relied upon when making a decision to invest in any a16z funds. PLEASE SEE MORE HERE: https:\\/\\/a16z.com\\/disclosures\\/\",\"follower_count\":13,\"platform_subscribers\":{\"youtube\":296000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"d748c9cb262e\",\"source_name\":\"Top Traders Unplugged\",\"count\":49,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/1Pp2FYvs987vjjG7UIwAHLJyuroi-YR1qpmb0DYOn08\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL1NGRDhnbksxSHJZSkE4LWpxT0JkMVIxZ2lFOHdlYUw1aWZhWHgwUE4zTHZBWWJnaWlXWjZlSFYtNjJ0dVU1elVOSkt0SFh1Vj1zMA.webp\",\"description\":\"Top Traders Unplugged is a podcast that brings some of the biggest names in the trading and financial world right to you. Subscribe today! http:\\/\\/toptradersunplugged.com\\/\",\"follower_count\":4,\"platform_subscribers\":{\"youtube\":39200,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"3f54a3e15942\",\"source_name\":\"The Readout Loud\",\"count\":23,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/53LQoZjuVyhss8ZSk7ZySt4A9bJw5SgTLwelyX5aXbA\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly9tZWdhcGhvbmUuaW1naXgubmV0L3BvZGNhc3RzLzI3MDBiNWMyLTZkMjYtMTFlZS04N2ViLTFmOTA5OTQzMWMxNS9pbWFnZS81MTdiYjQ5NDlkNTYwMzA1YmIzOTQ0OGVkYmIzMmQ3YS5qcGc_aXhsaWI9cmFpbHMtNC4zLjEmbWF4LXc9MzAwMCZtYXgtaD0zMDAwJmZpdD1jcm9wJmF1dG89Zm9ybWF0LGNvbXByZXNz.webp\",\"description\":\"STAT\u2019s weekly biotech podcast, breaking down the latest news, digging deep into industry goings-on, and giving you a preview of the week to come.\",\"follower_count\":2,\"platform_subscribers\":{\"youtube\":null,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"70955e977aeb\",\"source_name\":\"Dwarkesh Podcast\",\"count\":20,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/jdiOdCQz388fyXJzzNnrKToH8OOW-eqLPRW2G9Ckyw8\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL2xHLXo3c1RmaEZJVzJOZTFvWE1IdlhNWHlaU2FBMDJfSTE3Z1VlbDBHQUVqN095cHNTSFE3UEU5MVZwNGJUYnBtM1BUSUFXSmRrbz1zMA.webp\",\"description\":\"Deeply researched interviews\\n\",\"follower_count\":9,\"platform_subscribers\":{\"youtube\":1420000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"49c0de9503fb\",\"source_name\":\"20VC\",\"count\":104,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/xtfX12elN95oVery_eImWU531z0KeSj4ZdVyLgJVKNg\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL0R1M3dnN0VacDlMYUtGZlZjT3VLYkVuMHhGUHJ5aWlRZ0dROXNKOXUxMVVDT21BQWhwXzVnOXg5dzFGdXg1aWpqZnFiMENPcT1zMA.webp\",\"description\":\"20VC, hosted by Harry Stebbings, takes you inside the world of Venture Capital, Startup Funding and The Pitch. Join Harry and discover how you can attain funding for your business by listening to what the most prominent investors are directly looking for in startups, providing easily actionable tips and tricks that can be put in place to increase your chances of getting funded. The Twenty Minute VC also provides an instructional guide as to what it takes to get employed in the Venture Capital industry, with VCs giving specific advice on how to get noticed from the crowd and increasing your chances of employment. Our amazing Venture Capitalists also provide their analysis of the current technology market, providing advice and suggestions on the latest investing trends and predictions. Join us so you can see how you can get big, powerful improvements, fast.\\n\",\"follower_count\":8,\"platform_subscribers\":{\"youtube\":221000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"b45fc274b43e\",\"source_name\":\"AI Engineer\",\"count\":505,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/YDs7c3LvvuEMfxRJshUz9ZiH5_HPy1ZudF8AjM1zdwQ\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL2FqVmVtRUI4OURBT2Vtc2JmdU1ZNlpPV1hKQUFDeDNjYnR5OXoyMWplcVJLT0RhVmtEQlNSdW4xYjF4ZlFKbGpFc3ppT1dTX01nPXMw.webp\",\"description\":\"Talks, workshops, events, and training for AI Engineers. \",\"follower_count\":19,\"platform_subscribers\":{\"youtube\":640000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"e07044a5df9e\",\"source_name\":\"Capital Group\",\"count\":9,\"is_followed\":false,\"followed_at\":null,\"image_url\":null,\"description\":null,\"follower_count\":1,\"platform_subscribers\":{\"youtube\":null,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"b9e99f4d1025\",\"source_name\":\"Sequoia Capital\",\"count\":47,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/SldimwBNSCmMlAxq-7cOuPVGYnKJ_AWftzlfob48m_M\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL3VDTi1EN0t6TVFZLVRpLXhUc05Bd2lsWFZGRk1ZakVCUmp1X21YclIyMkhVWXhKWmpWWmdQX1NuYW1POUtiUG8yWE4tbkUzTy1BPXMw.webp\",\"description\":\"We help the daring build legendary companies \u2013 from idea to IPO and beyond.\",\"follower_count\":7,\"platform_subscribers\":{\"youtube\":252000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"d410ab71efcd\",\"source_name\":\"The Pragmatic Engineer\",\"count\":37,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/XTJBvN8dxg_JtrsKZLObZqH3v8qBweQh7ar1-14xWJk\\/fit\\/160\\/0\\/sm\\/0\\/aHR0cHM6Ly95dDMuZ29vZ2xldXNlcmNvbnRlbnQuY29tL3FHNV93LUxmNlN5SWdZWHozdm0zWmdwR2Utc3diaXp6WHNDTTVvYU9kbFRMOEFRelY0OFVNdDNXZ2EtZzVzZkI3TWo3cUg1cW93PXMw.webp\",\"description\":\"Interviews about software engineering, Big Tech and startups. Highly relevant for developers and engineering leaders, useful for those working in tech.\\n\\nWriting The Pragmatic Engineer Newsletter (the #1 newsletter for software engineers) and the author of The Software Engineer's Guidebook\",\"follower_count\":4,\"platform_subscribers\":{\"youtube\":537000,\"rss\":null,\"bilibili\":null}},{\"source_id\":\"8fcc6b5841ce\",\"source_name\":\"Rebuild.fm\",\"count\":14,\"is_followed\":false,\"followed_at\":null,\"image_url\":\"https:\\/\\/img.biggo.com\\/WWe_BjGgvNvy2E-zAxnJVV