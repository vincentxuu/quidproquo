aders", "value": "Authorization,Content-Type,Site,X-Fgp"}, {"name": "access-control-allow-methods", "value": "GET, POST, DELETE, PATCH, OPTIONS"}, {"name": "access-control-allow-origin", "value": "https://finance.biggo.com.tw"}, {"name": "cache-control", "value": "public, s-maxage=60"}, {"name": "content-encoding", "value": "zstd"}, {"name": "content-type", "value": "application/json; charset=utf-8"}, {"name": "date", "value": "Fri, 18 Sep 2026 06:01:28 GMT"}, {"name": "server", "value": "istio-envoy"}, {"name": "vary", "value": "Site, Origin, Accept-Encoding"}, {"name": "x-envoy-upstream-service-time", "value": "46"}], "content": {"size": -1, "mimeType": "application/json; charset=utf-8", "text": "{\"result\":true,\"data\":[{\"entity\":\"\u806f\u6e96\u6703\",\"en_entity\":\"Federal Reserve\",\"news\":[{\"id\":\"0ac4822d-bfa1-4bc9-9814-02ab0d3904bf\",\"title\":\"\u4eba\u6c11\u5e63\u4e2d\u9593\u50f9\u9023\u516b\u5347 \u96e2\u5cb8\u50f9\u78346.7\u5275\u903e\u56db\u5e74\u65b0\u9ad8\",\"summary\":\"\u4e2d\u570b\u4eba\u6c11\u9280\u884c18\u65e5\u5c07\u4eba\u6c11\u5e63\u514c\u7f8e\u5143\u4e2d\u9593\u50f9\u8abf\u5347\u81f36.7521\u5143\uff0c\u9023\u7e8c\u7b2c\u516b\u500b\u4ea4\u6613\u65e5\u4e0a\u8abf\uff0c\u52752023\u5e742\u6708\u4ee5\u4f86\u903e\u4e09\u5e74\u4e03\u500b\u6708\u65b0\u9ad8\u3002\u5728\u5cb8\u8207\u96e2\u5cb8\u4eba\u6c11\u5e63\u76e4\u4e2d\u540c\u6b65\u5347\u78346.7\u5143\u6574\u6578\u95dc\u5361\uff0c\u96e2\u5cb8\u50f9\u4e00\u5ea6\u89f8\u53ca6.6930\u5143\uff0c\u6539\u5beb\u903e\u56db\u5e74\u65b0\u9ad8\u3002\u5e02\u5834\u4eba\u58eb\u6307\u51fa\uff0c6.7\u5143\u96d6\u975e\u5b98\u65b9\u653f\u7b56\u7d05\u7dda\uff0c\u4f46\u662f\u91cd\u8981\u7684\u5fc3\u7406\u8207\u6280\u8853\u95dc\u5361\u3002\u6b64\u6ce2\u5347\u503c\u767c\u751f\u5728\u7f8e\u570b\u806f\u6e96\u6703\u555f\u52d5\u5347\u606f\u9031\u671f\u3001\u7f8e\u5143\u6307\u6578\u4ecd\u8655\u8fd1\u4e03\u9031\u9ad8\u6a94\u4e4b\u969b\uff0c\u986f\u793a\u5b98\u65b9\u6709\u610f\u5f15\u5c0e\u4eba\u6c11\u5e63\u504f\u5f37\u57f7\u884c\u3002\u5206\u6790\u8a8d\u70ba\uff0c\u5317\u4eac\u5728\u7fd2\u8fd1\u5e73\u9810\u8a089\u670824\u65e5\u8d74\u7f8e\u8207\u5ddd\u666e\u6703\u9762\u524d\u5bb9\u8a31\u4eba\u6c11\u5e63\u5347\u78346.7\u5143\uff0c\u5177\u6709\u91cb\u653e\u8ac7\u5224\u5584\u610f\u8207\u7a69\u5b9a\u8de8\u5883\u8cc7\u91d1\u9810\u671f\u7684\u96d9\u91cd\u653f\u7b56\u610f\u6db5\u3002ING\u9280\u884c\u5927\u4e2d\u83ef\u5340\u9996\u5e2d\u7d93\u6fdf\u5b78\u5bb6\u5b8b\u6797\u9810\u671f\uff0c\u4eba\u6c11\u5e63\u672a\u4f8612\u500b\u6708\u4ecd\u5c07\u7dad\u6301\u5347\u503c\u8d70\u52e2\uff0c\u60df\u901f\u5ea6\u5c07\u8f03\u4eca\u5e74\u653e\u7de9\u3002\",\"key_entities\":[\"\u4e2d\u570b\u4eba\u6c11\u9280\u884c\",\"\u4eba\u6c11\u5e63\",\"\u7f8e\u570b\u806f\u6e96\u6703\",\"\u7f8e\u5143\u6307\u6578\",\"\u7fd2\u8fd1\u5e73\",\"\u5ddd\u666e\",\"\u5728\u5cb8\u4eba\u6c11\u5e63\",\"\u96e2\u5cb8\u4eba\u6c11\u5e63\",\"ING\u9280\u884c\",\"\u5b8b\u6797\"],\"content\":\"\u4eba\u6c11\u5e63\u514c\u7f8e\u5143\u532f\u7387\u5728\u7f8e\u570b\u806f\u6e96\u6703\uff08Fed\uff09\u555f\u52d5\u5347\u606f\u9031\u671f\u4e4b\u969b\u9006\u52e2\u8d70\u5f37\uff0c\u4e2d\u570b\u4eba\u6c11\u9280\u884c\uff08\u4eba\u884c\uff0918\u65e5\u5c07\u4eba\u6c11\u5e63\u514c\u7f8e\u5143\u4e2d\u9593\u50f9\u8abf\u5347\u81f36.7521\u5143\uff0c\u8f03\u524d\u4e00\u4ea4\u6613\u65e5\u5347\u503c59\u500b\u57fa\u9ede\uff0c\u9023\u7e8c\u7b2c\u516b\u500b\u4ea4\u6613\u65e5\u4e0a\u8abf\uff0c\u7e8c\u52752023\u5e742\u67083\u65e5\u4ee5\u4f86\u7684\u903e\u4e09\u5e74\u4e03\u500b\u6708\u65b0\u9ad8\u3002\u5728\u5cb8\u8207\u96e2\u5cb8\u4eba\u6c11\u5e63\u76e4\u4e2d\u540c\u6b65\u5347\u78346.7\u5143\u6574\u6578\u95dc\u5361\uff0c\u5176\u4e2d\u96e2\u5cb8\u50f9\u4e00\u5ea6\u89f8\u53ca6.6930\u5143\uff0c\u6539\u5beb\u903e\u56db\u5e74\u4f86\u6700\u9ad8\u7d00\u9304\u3002\\n\\n\u622a\u81f318\u65e5\u4e2d\u534812\u664222\u5206\u5de6\u53f3\uff0c\u5728\u5cb8\u4eba\u6c11\u5e63\uff08CNY\uff09\u66ab\u58316.6975\u5143\uff0c\u96e2\u5cb8\u4eba\u6c11\u5e63\uff08CNH\uff09\u66ab\u58316.6958\u5143\u3002\u5e02\u5834\u4eba\u58eb\u6307\u51fa\uff0c6.7\u5143\u4e26\u975e\u4eba\u884c\u6b63\u5f0f\u8a2d\u5b9a\u7684\u653f\u7b56\u7d05\u7dda\uff0c\u4f46\u537b\u662f\u91cd\u8981\u7684\u5fc3\u7406\u8207\u6280\u8853\u95dc\u5361\uff0c\u6b64\u8655\u96c6\u4e2d\u4e86\u4f01\u696d\u7d50\u532f\u9700\u6c42\u3001\u9078\u64c7\u6b0a\u969c\u7919\u50f9\u4f4d\u4ee5\u53ca\u7a7a\u982d\u505c\u640d\u8cb7\u76e4\u3002\u4eba\u6c11\u5e63\u5728\u7f8e\u5143\u6307\u6578\u4ecd\u8655\",\"image\":\"https:\\/\\/img.biggo.com\\/3rzmnkn4HJHbJsrKibRyzPyVX7nCAmeBAzFd_7zxhy4\\/fit\\/950\\/0\\/sm\\/0\\/aHR0cHM6Ly9pbWcuYmdvLm9uZS9uZXdzLWltYWdlL3N0b2NrX2xpYnJhcnlfY292ZXJzLzIwMjYtMDkvMGFjNDgyMmQtYmZhMS00YmM5LTk4MTQtMDJhYjBkMzkwNGJmXzE3ODk3MDk4ODBfZGVmYXVsdC53ZWJw.webp\",\"highlight\":\"\u6b64\u6ce2\u5347\u503c\u767c\u751f\u5728\u7f8e\u570b<em>\u806f\u6e96\u6703<\\/em>\u555f\u52d5\u5347\u606f\u9031\u671f\u3001\u7f8e\u5143\u6307\u6578\u4ecd\u8655\u8fd1\u4e03\u9031\u9ad8\u6a94\u4e4b\u969b\uff0c\u986f\u793a\u5b98\u65b9\u6709\u610f\u5f15\u5c0e\u4eba\u6c11\u5e63\u504f\u5f37\u57f7\u884c\u3002\",\"timestamp\":1789709728,\"stocks\":[],\"futures\":[]},{\"id\":\"b847f604-183f-483f-a188-c4c60e433fc9\",\"title\":\"\u5728\u5cb8\u96e2\u5cb8\u4eba\u6c11\u5e63\u96d9\u96d9\u5347\u78346.70\u95dc\u5361 \u672c\u9031\u4e2d\u9593\u50f9\u7d2f\u8a08\u8abf\u5347222\u9ede\",\"summary\":null,\"key_entities\":[\"\u4eba\u6c11\u5e63\",\"\u7f8e\u5143\",\"\u806f\u6e96\u6703\",\"\u6771\u65b9\u91d1\u8aa0\",\"\u83ef\u798f\u8b49\u5238\",\"\u738b\u9752\",\"\u7ba1\u6fe4\",\"\u7f8e\u5143\u6307\u6578\",\"\u97d3\u570b\u592e\u884c\"],\"content\":\"\",\"image\":\"https:\\/\\/img.biggo.com\\/DKFLUcXUhTD6WSWRPD3k8a3-h3RT2YVNRTx7K0aU-_M\\/fit\\/950\\/0\\/sm\\/0\\/aHR0cHM6Ly9pbWcuYmdvLm9uZS9uZXdzLWltYWdlL2FpX2dlbmVyYXRlZC8yMDI2LTA5L2I4NDdmNjA0LTE4M2YtNDgzZi1hMTg4LWM0YzYwZTQzM2ZjOV8xNzg5NzA0NTg5X2RlZmF1bHQuanBn.webp\",\"highlight\":\"\u8207\u6b64\u540c\u6642\uff0c\u97d3\u5143\u5728<em>\u806f\u6e96\u6703<\\/em>\u5347\u606f\u5f8c\u627f\u58d3\u5927\u8dcc\uff0c\u8207\u4eba\u6c11\u5e63\u5f62\u6210\u5206\u5316\uff0c\u51f8\u986f\u4e0d\u540c\u7d93\u6fdf\u9ad4\u5728\u5f37\u7f8e\u5143\u74b0\u5883\u4e2d\u7684\u97cc\u6027\u5dee\u7570\u3002...\u5206\u6790\u5e2b\u8a8d\u70ba\uff0c<em>\u806f\u6e96\u6703<\\/em>\u5347\u606f\u5f8c\u7f8e\u5143\u6307\u6578\u885d\u9ad8\u56de\u843d\u3001\u4e2d\u9593\u50f9\u6301\u7e8c\u504f\u5f37\u8abf\u6574\u662f\u63a8\u52d5\u4eba\u6c11\u5e63\u8d70\u5f37\u7684\u4e3b\u56e0\u3002\u4eca\u5e74\u4eba\u6c11\u5e63\u5373\u671f\u532f\u7387\u7d2f\u8a08\u5347\u503c\u903e4.1%\u3002\u83ef\u798f\u8b49\u5238\u7ba1\u6fe4\u63d0\u9192\uff0c\u61c9\u7406\u6027\u770b\u5f85\u5347\u503c\u884c\u60c5\uff0c\u4eba\u6c11\u5e63\u96d9\u5411\u6ce2\u52d5\u662f\u5e38\u614b\u3002\",\"timestamp\":1789704322,\"stocks\":[],\"futures\":[]},{\"id\":\"104e551a-cb6a-44fa-8f42-1e564709a1fc\",\"title\":\"Fed\u5347\u606f\u5229\u7a7a\u51fa\u76e1 \u65b0\u53f0\u5e63\u5f37\u5f48\u5347\u783431.8\u5143\u3001\u4eba\u6c11\u5e63\u52754\u5e74\u65b0\u9ad8\",\"summary\":null,\"key_entities\":[\"\u7f8e\u570b\u806f\u6e96\u6703\",\"\u65b0\u53f0\u5e63\",\"\u4eba\u6c11\u5e63\",\"\u53f0\u7063\u592e\u884c\",\"\u65e5\u5713\",\"\u65e5\u672c\u592e\u884c\",\"\u53f0\u80a1\",\"\u7f8e\u5143\u6307\u6578\"],\"content\":\"\",\"image\":\"https:\\/\\/img.biggo.com\\/YKUn8ZBuz2EivA2swyhycjeFWjsAXArPmOr4Dd15t54\\/fit\\/950\\/0\\/sm\\/0\\/aHR0cHM6Ly9pbWcuYmdvLm9uZS9uZXdzLWltYWdlL3N0b2NrX2xpYnJhcnlfY292ZXJzLzIwMjYtMDkvMTA0ZTU1MWEtY2I2YS00NGZhLThmNDItMWU1NjQ3MDlhMWZjXzE3ODk3MDA4ODFfZGVmYXVsdC53ZWJw.webp\",\"highlight\":\"\u7f8e\u570b<em>\u806f\u6e96\u6703<\\/em>\u777d\u9055\u4e09\u5e74\u9996\u5ea6\u5347\u606f\u5f8c\uff0c\u5e02\u5834\u4ee5\u5229\u7a7a\u51fa\u76e1\u89e3\u8b80\uff0c\u7f8e\u5143\u6307\u6578\u56de\u843d\uff0c\u65b0\u53f0\u5e6318\u65e5\u65e9\u76e4\u5f37\u52e2\u5347\u783431.8\u5143\uff0c\u6700\u9ad8\u89f8\u53ca31.788\u5143\u3001\u5347\u503c\u8fd11\u89d2\uff0c\u8207\u53f0\u80a1\u5927\u6f32\u5f62\u6210\u80a1\u532f\u96d9\u6f32\u3002\",\"timestamp\":1789700733,\"stocks\":[],\"futu