      "grade": "7B",
      "stars": 3,
      "name": "Co'ver",
      "url": "https://www.thecrag.com/en/climbing/thailand/koh-tao/route/13489368165",
      "style": "Boulder",
      "length": "5m",
      "pitches": null,
      "bolts": null,
      "pitches_detail": null,
      "desc": "Sit start on the left flake. Up onto powerful crimping to hit the gritty sloper rail, then finish up the committing mantle to the easy slab. Take big pads or good spotters or both. This is the king line of Koh Tao.",
