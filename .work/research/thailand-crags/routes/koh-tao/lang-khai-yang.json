      "warnings": [],
      "subarea": "Yang Bouldering"
    },
    {
      "grade": "7A+",
      "stars": 3,
      "name": "Tantalis",
      "url": "https://www.thecrag.com/en/climbing/thailand/koh-tao/route/13044367536",
      "style": "Boulder",
      "length": "6m",
      "pitches": null,
      "bolts": null,
      "pitches_detail": null,
      "desc": "The original line set by Matt Pearson in 2010. There has been confusion as to which line is Tantalis, and has been recently confused with the FA of \"Co'ver\" by Onsight climbing in 2015. Sit start at the far left flake, big crux move traversing right between the sloping rails then up and right, around the prow. Cool mantle finish to stand up below the slab. Pad on up or step off behind onto a boulder. FA: 2010",
      "setter": "Matt Pierson",
      "warnings": [],
      "subarea": "Yang Bouldering"
    },
