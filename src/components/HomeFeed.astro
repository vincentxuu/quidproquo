---
import CategoryLinks from './CategoryLinks.astro';
import PostList from './PostList.astro';
import type { Post } from '../utils/content';
import type { Lang } from '../i18n/utils';
import { getPage, homePageHref } from '../utils/pagination';

interface Props {
  posts: Post[];
  lang: Lang;
}
const { posts, lang } = Astro.props;
const isEn = lang === 'en';
const practiceTag = 'english-video-practice';
const archiveHref = `${isEn ? '/en' : ''}/tags/${practiceTag}`;
const featured = [
  { slug: 'career/2026-10-12-dan-koe-multiple-interests-ai-skill-stack', seconds: 168, clips: 3, speaker: 'Dan Koe', title: isEn ? 'Explain what a good AI result looks like' : '說清楚你期待 AI 做出什麼成果' },
  { slug: 'ai/2026-10-07-poteto-trust-ladder-verification-first', seconds: 157, clips: 3, speaker: 'Matt Pocock × Poteto', title: isEn ? 'Follow a bilingual passage: give agents hands and eyes' : '中英段落跟讀：讓 agent 有手有眼' },
].filter(item => posts.some(post => post.id === `${item.slug}${isEn ? '-en' : ''}`));
---
<section class="practice-feature" aria-labelledby="home-practice-title">
  <div class="practice-heading">
    <h2 id="home-practice-title">{isEn ? 'English video practice' : '英文影音練習'}</h2>
    <a class="practice-archive" href={archiveHref}>{isEn ? 'All practice →' : '全部練習 →'}</a>
  </div>
  <p class="practice-flow">{isEn ? 'Listen to a real clip → answer a question → say it in your own words (bilingual captions)' : '聽真實影片原音 → 回答理解題 → 換成自己的英文說（中英對照字幕）'}</p>
  <ul class="practice-picks">
    {featured.map(item => (
      <li>
        <a class="practice-pick" href={`/posts/${item.slug}${isEn ? '-en' : ''}?practice=1#video-practice-0`}>
          <span class="practice-play" aria-hidden="true">▶</span>
          <span class="practice-text">
            <strong>{item.title}</strong>
            <span class="practice-meta">{item.speaker} · {item.clips} {isEn ? 'clips' : '個片段'} · {item.seconds} {isEn ? 'sec' : '秒'}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
<CategoryLinks posts={posts} lang={lang} />
<PostList page={getPage(posts, 1)} hrefFor={page => homePageHref(lang, page)} lang={lang} />

<style>
  .practice-feature { margin-bottom: 1.5rem; padding: 0.9rem 1rem; border-radius: 10px; background: var(--brand-50); }
  .practice-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; }
  .practice-heading h2 { margin: 0; font-size: 0.95rem; line-height: 1.4; color: var(--text-primary); }
  .practice-archive { flex-shrink: 0; font-size: 0.8rem; color: var(--brand-500); text-decoration: none; }
  .practice-archive:hover { text-decoration: underline; }
  .practice-flow { margin: 0.2rem 0 0.6rem; font-size: 0.78rem; line-height: 1.6; color: var(--text-muted); }
  .practice-picks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .practice-pick { display: flex; align-items: flex-start; gap: 0.6rem; height: 100%; box-sizing: border-box; padding: 0.6rem 0.7rem; border: 1px solid transparent; border-radius: 8px; background: var(--bg-card); color: var(--text-primary); text-decoration: none; }
  .practice-pick:hover { border-color: var(--brand-500); }
  .practice-pick:focus-visible { outline: 2px solid var(--brand-500); outline-offset: 2px; }
  .practice-play { flex-shrink: 0; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--brand-500); color: var(--bg-card); font-size: 0.6rem; }
  .practice-text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .practice-text strong { font-size: 0.88rem; font-weight: 600; line-height: 1.45; }
  .practice-meta { color: var(--text-muted); font-size: 0.72rem; line-height: 1.5; }
  @media (max-width: 540px) { .practice-picks { grid-template-columns: 1fr; } }
</style>
