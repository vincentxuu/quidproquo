---
import PostCard from './PostCard.astro';
import type { Post } from '../utils/content';
import type { Lang } from '../i18n/utils';
import { getSeriesHref } from '../utils/series';

interface Props {
  posts: Post[];
  lang: Lang;
}
const { posts, lang } = Astro.props;
const isEn = lang === 'en';
const practiceTag = 'english-video-practice';
const categoryCounts = posts.reduce((acc, post) => acc.set(post.data.category, (acc.get(post.data.category) || 0) + 1), new Map<string, number>());
const categories = [...categoryCounts].sort((a, b) => b[1] - a[1]);
const archiveHref = `${isEn ? '/en' : ''}/tags/${practiceTag}`;
const featured = [
  { slug: 'career/2026-10-12-dan-koe-multiple-interests-ai-skill-stack', seconds: 168, captions: isEn ? '3 clips · sentence-aligned captions' : '3 片段・依句意中英對照', speaker: 'Dan Koe', title: isEn ? 'Explain what a good AI result looks like' : '說清楚你期待 AI 做出什麼成果' },
  { slug: 'ai/2026-10-07-poteto-trust-ladder-verification-first', seconds: 157, captions: isEn ? '3 clips · sentence-aligned captions' : '3 片段・依句意中英對照', speaker: 'Matt Pocock × Poteto', title: isEn ? 'Follow a bilingual passage: give agents hands and eyes' : '中英段落跟讀：讓 agent 有手有眼' },
].filter(item => posts.some(post => post.id === `${item.slug}${isEn ? '-en' : ''}`));
---
<section data-home-post-filter data-lang={lang} aria-label={isEn ? 'Browse articles' : '選擇閱讀與練習文章'}>
  <section class="practice-feature" aria-labelledby="home-practice-title">
    <div class="practice-heading">
      <div>
        <p class="practice-kicker">{isEn ? 'ENGLISH VIDEO PRACTICE' : '英文影音練習'}</p>
        <h2 id="home-practice-title">{isEn ? 'Practice English with real videos' : '用真實影片練英文'}</h2>
      </div>
      <a class="practice-archive" href={archiveHref}>{isEn ? 'All practice →' : '全部練習 →'}</a>
    </div>
    <p class="practice-flow">{isEn ? '① Listen to the clip　② Answer a question　③ Say it in your own words' : '① 聽一段原音　② 回答理解題　③ 換成自己的英文說'}</p>
    <div class="practice-picks">
      {featured.map(item => (
        <a class="practice-pick" href={`/posts/${item.slug}${isEn ? '-en' : ''}?practice=1#video-practice-0`}>
          <span class="practice-meta">{item.speaker}<span>{item.seconds} {isEn ? 'sec clip' : '秒原音'}</span></span>
          <strong>{item.title}</strong>
          <span class="practice-caption-state">{item.captions}</span>
          <span class="practice-cta">{isEn ? 'Start practicing →' : '開始聽與練 →'}</span>
        </a>
      ))}
    </div>
  </section>
  <div class="filter-panel">
    <div class="filter-controls" role="group" aria-label={isEn ? 'Filter articles by category' : '依分類篩選文章'} hidden>
      <button type="button" data-home-filter="all" aria-pressed="true">{isEn ? 'All' : '全部'} <span>{posts.length}</span></button>
      {categories.map(([category, count]) => (
        <button type="button" data-home-filter={category} aria-pressed="false">{category} <span>{count}</span></button>
      ))}
    </div>
    <p class="filter-status" data-home-filter-status aria-live="polite" aria-atomic="true">{isEn ? `${posts.length} articles` : `共 ${posts.length} 篇文章`}</p>
  </div>
  <div class="post-list">
    {posts.map(post => (
      <div data-home-post data-category={post.data.category}>
        <PostCard
          slug={post.id}
          title={post.data.title}
          date={post.data.date}
          category={post.data.category}
          tags={post.data.tags}
          description={post.data.description}
          tldr={post.data.tldr}
          readingTime={post.data.readingTime}
          lang={lang}
          type={post.data.type}
          pinned={post.data.pinned}
          seriesName={post.data.series?.name}
          seriesHref={post.data.series ? getSeriesHref(post.data.series.name, lang) : undefined}
        />
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-home-post-filter]').forEach(root => {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-home-post]'));
    const controls = root.querySelector<HTMLElement>('.filter-controls');
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-home-filter]'));
    const status = root.querySelector<HTMLElement>('[data-home-filter-status]');
    const isEn = root.dataset.lang === 'en';
    const filters = new Set(buttons.map(button => button.dataset.homeFilter));
    const readFilter = () => {
      const category = new URL(window.location.href).searchParams.get('category');
      return category && filters.has(category) ? category : 'all';
    };
    const apply = (filter: string, updateUrl = false) => {
      let count = 0;
      cards.forEach(card => {
        card.hidden = filter !== 'all' && card.dataset.category !== filter;
        if (!card.hidden) count++;
      });
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.homeFilter === filter)));
      if (status) status.textContent = filter === 'all'
        ? (isEn ? `${count} articles` : `共 ${count} 篇文章`)
        : (isEn ? `${count} articles in ${filter}` : `${filter} 分類共 ${count} 篇`);
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (filter === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', filter);
        if (url.href !== window.location.href) window.history.pushState({}, '', url);
      }
    };
    buttons.forEach(button => button.addEventListener('click', () => apply(button.dataset.homeFilter || 'all', true)));
    window.addEventListener('popstate', () => apply(readFilter()));
    apply(readFilter());
    if (controls) controls.hidden = false;
  });
</script>

<style>
  .practice-feature { margin-bottom: 1.25rem; padding: 1.1rem; border: 2px solid var(--brand-500); border-radius: 10px; background: var(--bg-card); }
  .practice-heading { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .practice-kicker { margin: 0 0 0.3rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; color: var(--brand-500); }
  .practice-heading h2 { margin: 0; font-size: 1.3rem; line-height: 1.35; color: var(--text-primary); }
  .practice-archive { flex-shrink: 0; font-size: 0.8rem; color: var(--brand-500); }
  .practice-flow { margin: 0.7rem 0; font-size: 0.82rem; line-height: 1.8; color: var(--text-secondary); }
  .practice-picks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; }
  .practice-pick { display: flex; flex-direction: column; gap: 0.6rem; padding: 0.85rem; border: 1px solid var(--border); border-radius: 7px; text-decoration: none; background: var(--bg-page); color: var(--text-primary); }
  .practice-pick:hover { border-color: var(--brand-500); }
  .practice-meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.3rem; color: var(--text-muted); font-size: 0.72rem; }
  .practice-pick strong { font-size: 0.95rem; line-height: 1.5; }
  .practice-cta { margin-top: auto; font-size: 0.82rem; font-weight: 700; color: var(--brand-500); }
  @media (max-width: 540px) { .practice-picks { grid-template-columns: 1fr; } .practice-heading { align-items: flex-start; } .practice-heading h2 { font-size: 1.15rem; } }
  .filter-panel { margin-bottom: 1.25rem; }
  .filter-controls { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .filter-controls[hidden], [data-home-post][hidden] { display: none; }
  button { min-height: 36px; padding: 0.35rem 0.75rem; border: 1px solid var(--border); border-radius: 999px; background: var(--bg-card); color: var(--text-secondary); font: inherit; font-size: 0.8rem; cursor: pointer; }
  button:hover { border-color: var(--brand-500); color: var(--text-primary); }
  button[aria-pressed="true"] { border-color: var(--brand-900); background: var(--brand-900); color: var(--bg-page); }
  button span { margin-left: 0.25rem; opacity: 0.7; font-variant-numeric: tabular-nums; }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--brand-500); outline-offset: 3px; }
  .filter-status { margin: 0.6rem 0 0; color: var(--text-muted); font-size: 0.78rem; }
</style>
