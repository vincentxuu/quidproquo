---
// src/components/Icons.astro
// Usage: <Icons name="search" size={16} stroke="#555" />
//
// Geometry comes from koboyo's hand-drawn library — see src/components/icons/koboyo.ts
// for the source and licence. The markup (including the fattening pass that makes
// the light koboyo art legible at UI sizes) lives in src/components/icons/render.ts,
// shared with the rehypeNoEmoji Markdown plugin.
import type { IconName } from './icons/koboyo';
import { renderIconSvg } from './icons/render';

interface Props {
  name: IconName;
  size?: number;
  /**
   * Ink colour. Still called `stroke` so existing call sites keep working; the
   * koboyo icons are filled outlines rather than strokes, so it drives `fill`.
   */
  stroke?: string;
  class?: string;
}

const { name, size = 16, stroke = 'currentColor', class: cls } = Astro.props;
---
<Fragment set:html={renderIconSvg(name, { size, color: stroke, class: cls })} />
