---
// src/components/PostCard.astro
import type { Lang } from '../i18n/utils';
import Icons from './Icons.astro';


interface Props {
  slug: string;
  title: string;
  date: Date;
  category: string;
  tags: string[];
  description?: string;
  tldr?: string;
  readingTime?: number;
  lang?: Lang;
  type?: string;
  pinned?: boolean;
  seriesName?: string;
  seriesHref?: string;
}
const { slug, title, date, category, tags, description, tldr, readingTime, lang = 'zh-TW', type, pinned, seriesName, seriesHref } = Astro.props;
const excerpt = tldr || description || '';
const categoriesBase = lang === 'en' ? '/en/categories' : '/categories';
const tagsBase = lang === 'en' ? '/en/tags' : '/tags';
const dateStr = date.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
---
<article data-type={type}>
  {pinned && <div class="pin-bar"><Icons name="pin" size={14} /> 置頂</div>}
  <div class="meta">
    <a href={`${categoriesBase}/${category}`} class={`cat-badge cat-${category}`}>{category}</a>
    {type && <a href={`${categoriesBase}/${category}?type=${type}`} class={`type-badge type-${type}`}>{type}</a>}
    {seriesName && seriesHref && <a href={seriesHref} class="series-badge">{seriesName}</a>}
    <time datetime={date.toISOString()}>{dateStr}</time>
    {readingTime && (
      <span class="reading-time">
        <Icons name="clock" size={14} />
        {readingTime} min
      </span>
    )}
  </div>
  <h2><a href={`/posts/${slug}`}>{title}</a></h2>
  {excerpt && <p class="excerpt">{excerpt}</p>}
  {tags.length > 0 && (
    <div class="tags">
      {tags.map(tag => <a href={`${tagsBase}/${tag}`} class="tag-pill">#{tag}</a>)}
    </div>
  )}
</article>

<style>
  article {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 0.75rem;
    background: var(--bg-card);
    transition: border-color 0.15s, box-shadow 0.15s;
    cursor: pointer;
  }
  article:hover {
    border-color: var(--brand-500);
    box-shadow: var(--shadow-card-hover);
  }
  .pin-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--brand-500);
    background: var(--brand-100);
    border: 1px solid var(--brand-300);
    padding: 0.15rem 0.55rem;
    border-radius: 3px;
    margin-bottom: 0.6rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }
  .series-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.14rem 0.45rem;
    border-radius: 999px;
    background: var(--brand-50);
    color: var(--brand-700);
    border: 1px solid var(--brand-300);
    font-size: 0.68rem;
    font-weight: 700;
    text-decoration: none;
    line-height: 1.2;
  }
  .series-badge:hover {
    color: var(--brand-900);
    border-color: var(--brand-500);
  }
  time {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .reading-time {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  h2 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.2px;
    line-height: 1.3;
  }
  h2 a {
    text-decoration: none;
    color: var(--text-primary);
  }
  h2 a:hover { color: var(--brand-500); }
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .meta a, .tags a { position: relative; z-index: 2; }
  .excerpt {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    /* 保險：tldr 應該是 1-2 句，但寫長了不該撐爆卡片 */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }
  .cat-badge {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
    text-decoration: none;
  }
  .cat-daily     { background: var(--cat-daily, #059669); }
  .cat-tech      { background: var(--cat-tech, #1a1a1a); }
  .cat-ai        { background: var(--cat-ai, #6d28d9); }
  .cat-product   { background: var(--cat-product, #0369a1); }
  .cat-education { background: var(--cat-education, #b45309); }
  .cat-life      { background: var(--cat-life, #15803d); }
  .cat-marketing { background: var(--cat-marketing, #be185d); }
  .cat-travel    { background: var(--cat-travel, #c2410c); }
  .cat-climbing  { background: var(--cat-climbing, #57534e); }
  .cat-surf      { background: var(--cat-surf, #0891b2); }
  .cat-film      { background: var(--cat-film, #292524); }
  .cat-coffee    { background: var(--cat-coffee, #92400e); }
  .cat-learning  { background: var(--cat-learning, #4338ca); }
  .cat-design    { background: var(--cat-design, #7c3aed); }
  .cat-policy    { background: var(--cat-policy, #64748b); }
  .cat-investing { background: var(--cat-investing, #047857); }
  .type-badge {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--brand-500);
    border: 1px solid var(--brand-300);
    background: transparent;
    text-decoration: none;
  }
</style>
