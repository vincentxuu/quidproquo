---
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import type { Post } from '../utils/content';
import type { Lang } from '../i18n/utils';
import type { Page } from '../utils/pagination';
import { getSeriesHref } from '../utils/series';

interface Props {
  page: Page<Post>;
  hrefFor: (page: number) => string;
  lang: Lang;
  showPinned?: boolean;
}
const { page, hrefFor, lang, showPinned = true } = Astro.props;
---
{page.items.map(post => (
  <PostCard
    slug={post.id}
    title={post.data.title}
    date={post.data.date}
    category={post.data.category}
    tags={post.data.tags}
    description={post.data.description}
    tldr={post.data.tldr}
    readingTime={post.data.readingTime}
    lang={lang}
    type={post.data.type}
    pinned={showPinned && post.data.pinned}
    seriesName={post.data.series?.name}
    seriesHref={post.data.series ? getSeriesHref(post.data.series.name, lang) : undefined}
  />
))}
<Pagination current={page.current} total={page.total} hrefFor={hrefFor} lang={lang} />
