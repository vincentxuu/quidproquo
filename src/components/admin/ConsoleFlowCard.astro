---
import type { FlowCardData } from '@/lib/console/flow-selector'

interface Props {
  card: FlowCardData
}

const { card } = Astro.props

const statusColors: Record<string, string> = {
  succeeded: 'var(--success)',
  failed: 'var(--danger)',
  running: 'var(--brand-700)',
  queued: 'var(--text-secondary)',
  cancelled: 'var(--text-secondary)',
}

const statusColor = card.lastStatus ? (statusColors[card.lastStatus] ?? 'var(--text-secondary)') : 'var(--text-secondary)'
const lastRunLabel = card.lastRunAt
  ? new Date(card.lastRunAt).toLocaleString('zh-TW', { dateStyle: 'short', timeStyle: 'short' })
  : '—'
const lastStatusLabel = card.lastStatus ?? '—'
const versionLabel = card.currentVersion != null ? `v${card.currentVersion}` : '—'
const costLabel = card.estimatedCostUsd == null ? '—' : `$${card.estimatedCostUsd.toFixed(2)}`
const categoryLabel = card.category ?? 'general'

const flowHref = `/admin/console/flows/${encodeURIComponent(card.id)}`
const launchHref = `/admin/console/runs/launch?flowId=${encodeURIComponent(card.id)}`
---

<article class="flow-card">
  <a href={flowHref} class="flow-card__title">工作流程：{card.name}</a>
  <div class="flow-card__header">
    <span class="flow-card__status-wrap">
      {card.lastStatus && (
        <span class="flow-card__status" style={`color: ${statusColor}`}>{card.lastStatus}</span>
      )}
    </span>
    <a href={launchHref} class="flow-card__launch">啟動</a>
  </div>
  <div class="flow-card__meta-grid">
    <span>類別：{categoryLabel}</span>
    <span>狀態：{lastStatusLabel}</span>
    <span>版本：{versionLabel}</span>
    <span>預估費用：{costLabel}</span>
    {card.costBand && <span>費用級距：{card.costBand}</span>}
  </div>
  {card.description && <p class="flow-card__desc">{card.description}</p>}
  <span class="flow-card__meta">上次執行：{lastRunLabel}</span>
</article>

<style>
  .flow-card {
    display: grid;
    gap: 0.45rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--corner-md);
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .flow-card:hover {
    border-color: var(--brand-700);
    box-shadow: var(--shadow-hairline);
  }
  .flow-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .flow-card__meta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.75rem;
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }

  .flow-card__title {
    font-weight: 600;
    text-decoration: none;
    color: inherit;
  }

  .flow-card__status-wrap {
    display: inline-flex;
  }

  .flow-card__launch {
    font-size: var(--fs-xs);
    line-height: 1.4;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--brand-700);
    border-radius: var(--corner-pill);
    text-decoration: none;
    color: var(--brand-700);
  }

  .flow-card__launch:hover {
    background: var(--brand-50);
  }

  .flow-card__status-wrap .flow-card__status {
    font-size: var(--fs-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .flow-card__desc {
    margin: 0.35rem 0 0;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: 1.4;
  }
  .flow-card__meta {
    display: block;
    margin-top: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }
</style>
