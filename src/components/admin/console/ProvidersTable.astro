---
import type { ProviderRow } from '@/lib/console/management';

interface Props {
  rows: ProviderRow[];
}

const { rows } = Astro.props;
---

<table class="mgmt-table admin-panel">
  <thead>
    <tr>
      <th scope="col">提供者</th>
      <th scope="col">類別</th>
      <th scope="col">版本</th>
      <th scope="col">啟用</th>
      <th scope="col">健康狀態</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr data-provider-id={row.id}>
        <td>{row.displayName} <code>{row.id}</code></td>
        <td>{row.category}</td>
        <td>{row.version}</td>
        <td>{row.enabled ? '是' : '否'}</td>
        <td><span class="health-badge" data-status={row.status}>{row.status}</span></td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .mgmt-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    overflow: hidden;
  }
  .mgmt-table th,
  .mgmt-table td {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .mgmt-table th {
    color: var(--text-muted);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .mgmt-table code {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }
  .health-badge {
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--corner-pill);
    font-size: var(--fs-xs);
    text-transform: capitalize;
  }
  .health-badge[data-status='healthy'] { color: var(--success); border-color: var(--success); }
  .health-badge[data-status='degraded'] { color: var(--warning); border-color: var(--warning); }
  .health-badge[data-status='down'] { color: var(--danger); border-color: var(--danger); }
</style>
