---
import { verifySession } from '../lib/auth/session';
import Icons from '../components/Icons.astro';
import '../styles/admin-tokens.css';

export const prerender = false;

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  section: 'home' | 'sessions' | 'routines' | 'flows' | 'settings';
  breadcrumb?: BreadcrumbItem[];
}

const { title, section, breadcrumb } = Astro.props;

const session = Astro.cookies.get('session')?.value;
const isLoggedIn = session ? await verifySession(session) : false;

if (!isLoggedIn) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const currentPath = Astro.url.pathname;
const isHome = section === 'home';

type NavChild = { href: string; label: string };
type NavItem = {
  href: string; label: string; key: string; icon: string;
  children?: NavChild[];
};

const chatNavItems: NavItem[] = [
  { href: '/admin/sessions', label: 'Sessions', key: 'sessions', icon: 'activity' },
  { href: '/admin/routines', label: 'Routines', key: 'routines', icon: 'refresh-cw' },
];

const adminNavItems: NavItem[] = [
  { href: '/admin/flows',    label: 'Flows',    key: 'flows',    icon: 'workflow' },
  { href: '/admin/settings', label: 'Settings', key: 'settings', icon: 'settings', children: [
    { href: '/admin/settings/site',         label: 'Site' },
    { href: '/admin/settings/models',       label: 'Models' },
    { href: '/admin/settings/extensions',   label: 'Extensions' },
    { href: '/admin/settings/permissions',  label: 'Permissions' },
    { href: '/admin/settings/access',       label: 'Access' },
    { href: '/admin/settings/environments', label: 'Environments' },
    { href: '/admin/settings/notifications', label: 'Notifications' },
    { href: '/admin/settings/behavior',     label: 'Behavior' },
  ]},
];

const isChatSection = section === 'home' || section === 'sessions' || section === 'routines';
const defaultMode = isChatSection ? 'chat' : 'admin';

function isActive(key: string): boolean {
  if (key === 'home') return currentPath === '/admin' || currentPath === '/admin/';
  return currentPath.startsWith(`/admin/${key}`);
}

function isChildActive(href: string): boolean {
  return currentPath.startsWith(href);
}

const sectionLabels: Record<string, string> = {
  home: 'Home',
  sessions: 'Sessions',
  routines: 'Routines',
  flows: 'Flows',
  settings: 'Settings',
};
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Admin</title>
</head>
<body>
  <div class="admin-container">
    <aside class="admin-sidebar">
      <div class="sidebar-header">
        <a href="/admin" class="admin-brand" aria-label="Admin dashboard">
          <span class="brand-mark">qp</span>
          <span class="brand-text">
            <strong>quidproquo</strong>
          </span>
        </a>
        <div class="mode-toggle" id="mode-toggle">
          <button class:list={['mode-btn', { active: defaultMode === 'chat' }]} data-mode="chat" title="Chat mode" aria-label="Chat mode">
            <Icons name="list" size={14} />
          </button>
          <button class:list={['mode-btn', { active: defaultMode === 'admin' }]} data-mode="admin" title="Admin mode" aria-label="Admin mode">
            <Icons name="settings" size={14} />
          </button>
        </div>
      </div>

      <div class="sidebar-actions">
        <a href="/admin" class="new-session-btn">
          <span class="new-session-plus">+</span>
          <span>New</span>
        </a>
      </div>

      <nav class="sidebar-nav chat-nav" data-nav="chat" aria-label="Chat navigation" style={defaultMode === 'admin' ? 'display:none' : ''}>
        {chatNavItems.map(item => (
          <a
            href={item.href}
            class:list={['nav-item', { active: isActive(item.key) }]}
            aria-current={isActive(item.key) ? 'page' : undefined}
            title={item.label}
          >
            <Icons name={item.icon} size={15} />
            <span class="nav-label">{item.label}</span>
          </a>
        ))}
      </nav>

      <nav class="sidebar-nav admin-nav" data-nav="admin" aria-label="Admin navigation" style={defaultMode === 'chat' ? 'display:none' : ''}>
        {adminNavItems.map(item => item.children ? (
          <details class="nav-group" open={isActive(item.key)}>
            <summary class:list={['nav-item', { active: isActive(item.key) }]} title={item.label}>
              <Icons name={item.icon} size={15} />
              <span class="nav-label">{item.label}</span>
              <span class="nav-chevron">
                <Icons name="chevron-right" size={11} />
              </span>
            </summary>
            <div class="nav-children">
              {item.children.map(child => (
                <a
                  href={child.href}
                  class:list={['nav-child', { active: isChildActive(child.href) }]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            class:list={['nav-item', { active: isActive(item.key) }]}
            aria-current={isActive(item.key) ? 'page' : undefined}
            title={item.label}
          >
            <Icons name={item.icon} size={15} />
            <span class="nav-label">{item.label}</span>
          </a>
        ))}
      </nav>

      <div class="sidebar-recents" id="sidebar-recents" style={defaultMode === 'admin' ? 'display:none' : ''}>
        <div class="recents-header">
          <span>Recents</span>
        </div>
        <div class="recents-list" id="recents-list">
          <span class="recents-empty">載入中…</span>
        </div>
      </div>

      <div class="sidebar-footer">
        <a href="/" class="nav-item footer-item" title="回到網站">
          <Icons name="home" size={15} />
          <span class="nav-label">回到網站</span>
        </a>
        <form method="POST" action="/api/auth/logout">
          <button type="submit" class="logout-btn" title="登出">
            <Icons name="log-out" size={15} />
            <span class="nav-label">登出</span>
          </button>
        </form>
      </div>
    </aside>

    <main class:list={['admin-main', { 'home-mode': isHome }]}>
      {isHome ? (
        <div class="home-layout">
          <div class="home-greeting">
            <slot />
          </div>
        </div>
      ) : (
        <Fragment>
          <header class="admin-header">
            <details class="mobile-nav">
              <summary class="mobile-nav-trigger" aria-label="選單">
                <Icons name="list" size={18} />
                <span>選單</span>
              </summary>
              <div class="mobile-nav-panel">
                <a href="/admin" class="mobile-nav-item">
                  <span class="new-session-plus-sm">+</span>
                  New
                </a>
                {[...chatNavItems, ...adminNavItems].map(item => (
                  <a
                    href={item.href}
                    class:list={['mobile-nav-item', { active: isActive(item.key) }]}
                    aria-current={isActive(item.key) ? 'page' : undefined}
                  >
                    <Icons name={item.icon} size={16} />
                    {item.label}
                  </a>
                ))}
                <div class="mobile-nav-actions">
                  <a href="/" class="mobile-nav-item">
                    <Icons name="home" size={16} />
                    回到網站
                  </a>
                  <form method="POST" action="/api/auth/logout">
                    <button type="submit" class="mobile-nav-item mobile-nav-button">
                      <Icons name="log-out" size={16} />
                      登出
                    </button>
                  </form>
                </div>
              </div>
            </details>
            <div>
              <p class="admin-kicker">{sectionLabels[section]}</p>
              {breadcrumb && breadcrumb.length > 0 ? (
                <nav class="breadcrumb" aria-label="Breadcrumb">
                  {breadcrumb.map((crumb, i) => (
                    <span class="breadcrumb-item">
                      {i > 0 && <span class="breadcrumb-sep" aria-hidden="true">/</span>}
                      {crumb.href ? (
                        <a href={crumb.href} class="breadcrumb-link">{crumb.label}</a>
                      ) : (
                        <span aria-current="page">{crumb.label}</span>
                      )}
                    </span>
                  ))}
                </nav>
              ) : (
                <h2>{title}</h2>
              )}
            </div>
            <div class="header-actions" aria-label="Admin shortcuts">
              <a href="/admin/sessions" class="admin-icon-button" title="Sessions">
                <Icons name="activity" size={16} />
              </a>
              <a href="/admin/settings" class="admin-icon-button" title="Settings">
                <Icons name="settings" size={16} />
              </a>
            </div>
          </header>
          <div class="admin-content">
            <slot />
          </div>
        </Fragment>
      )}
    </main>
  </div>

  <script data-default-mode={defaultMode} is:inline>
    async function loadRecents() {
      try {
        const res = await fetch('/api/admin/sessions?limit=15');
        if (!res.ok) return;
        const data = await res.json();
        const list = document.getElementById('recents-list');
        if (!list) return;
        const sessions = data.sessions ?? data ?? [];
        if (!Array.isArray(sessions) || sessions.length === 0) {
          list.innerHTML = '<span class="recents-empty">尚無 Session</span>';
          return;
        }
        list.innerHTML = sessions.map((s) => {
          const label = s.name || s.instruction?.slice(0, 40) || s.id.slice(0, 8);
          const statusClass = s.status === 'running' ? 'running' : s.status === 'failed' ? 'failed' : 'done';
          return `<a href="/admin/sessions/${s.id}" class="recent-item"><span class="status-dot ${statusClass}"></span><span class="recent-label">${label}</span></a>`;
        }).join('');
      } catch { /* silent */ }
    }
    document.addEventListener('DOMContentLoaded', loadRecents);

    // Mode toggle
    function setMode(mode) {
      const chatNav = document.querySelector('[data-nav="chat"]') ;
      const adminNav = document.querySelector('[data-nav="admin"]') ;
      const recents = document.getElementById('sidebar-recents');
      const chatBtn = document.querySelector('[data-mode="chat"]');
      const adminBtn = document.querySelector('[data-mode="admin"]');
      if (!chatNav || !adminNav) return;

      if (mode === 'chat') {
        chatNav.style.display = '';
        adminNav.style.display = 'none';
        if (recents) recents.style.display = '';
        chatBtn?.classList.add('active');
        adminBtn?.classList.remove('active');
      } else {
        chatNav.style.display = 'none';
        adminNav.style.display = '';
        if (recents) recents.style.display = 'none';
        chatBtn?.classList.remove('active');
        adminBtn?.classList.add('active');
      }
      try { localStorage.setItem('admin-mode', mode); } catch {}
    }

    document.getElementById('mode-toggle')?.addEventListener('click', (e) => {
      const btn = (e.target ).closest('[data-mode]');
      if (btn) setMode(btn.dataset.mode);
    });

    const scriptEl = document.querySelector('script[data-default-mode]');
    const pageDefaultMode = scriptEl?.getAttribute('data-default-mode') || 'chat';
    const saved = (() => { try { return localStorage.getItem('admin-mode'); } catch { return null; } })();
    setMode(saved || pageDefaultMode);
  </script>
</body>
</html>

<style>
  :root {
    --sidebar-width: 240px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Noto Sans TC Local', 'PingFang TC', 'Microsoft JhengHei', Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--admin-bg);
    color: var(--admin-text);
    min-height: 100vh;
    line-height: 1.5;
  }

  a,
  button,
  select,
  input {
    font: inherit;
  }

  a:focus-visible,
  button:focus-visible,
  select:focus-visible,
  input:focus-visible {
    outline: none;
    box-shadow: var(--admin-focus);
  }

  /* ── Container ── */

  .admin-container {
    display: flex;
    min-height: 100vh;
  }

  /* ── Sidebar ── */

  .admin-sidebar {
    width: var(--sidebar-width);
    background: var(--admin-surface);
    border-right: 1px solid var(--admin-border);
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    overflow-y: auto;
    z-index: 20;
  }

  .sidebar-header {
    padding: 0.75rem 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mode-toggle {
    display: flex;
    background: var(--admin-border);
    border-radius: 6px;
    padding: 2px;
    gap: 2px;
  }

  .mode-btn {
    display: grid;
    place-items: center;
    width: 30px;
    height: 26px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--admin-text-muted);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .mode-btn:hover {
    color: var(--admin-text);
  }

  .mode-btn.active {
    background: var(--admin-surface);
    color: var(--admin-text);
    box-shadow: 0 1px 2px rgba(0,0,0,0.08);
  }

  .admin-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--admin-text);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--brand-700);
    border-radius: var(--admin-radius);
    background: var(--brand-900);
    color: var(--admin-surface);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0;
    flex-shrink: 0;
  }

  .brand-text strong {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  /* ── + New button ── */

  .sidebar-actions {
    padding: 0 0.65rem 0.5rem;
  }

  .new-session-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.55rem 0.75rem;
    border-radius: var(--admin-radius);
    background: var(--brand-900);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s, box-shadow 0.15s;
  }

  .new-session-btn:hover {
    background: var(--brand-700);
    box-shadow: 0 2px 6px rgba(26, 46, 26, 0.2);
  }

  .new-session-plus {
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1;
  }

  .new-session-plus-sm {
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1;
  }

  /* ── Nav ── */

  .sidebar-nav {
    padding: 0.25rem 0.65rem;
    border-bottom: 1px solid var(--admin-border);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 36px;
    padding: 0.35rem 0.55rem;
    border-radius: var(--admin-radius);
    color: var(--admin-text-muted);
    text-decoration: none;
    margin-bottom: 0.1rem;
    transition: background 0.12s, color 0.12s;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .nav-item:hover {
    background: var(--admin-muted);
    color: var(--brand-900);
  }

  .nav-item.active {
    background: var(--brand-100);
    color: var(--brand-900);
    font-weight: 650;
  }

  .nav-label {
    flex: 1;
  }

  .nav-chevron {
    margin-left: auto;
    opacity: 0.4;
    transition: transform 0.15s;
  }

  .nav-group {
    display: contents;
  }

  .nav-group > summary {
    list-style: none;
    cursor: pointer;
  }

  .nav-group > summary::-webkit-details-marker {
    display: none;
  }

  .nav-group[open] > summary .nav-chevron {
    transform: rotate(90deg);
  }

  .nav-children {
    display: flex;
    flex-direction: column;
    padding: 0.15rem 0 0.35rem 0;
    margin-bottom: 0.15rem;
  }

  .nav-child {
    padding: 0.3rem 0.6rem 0.3rem 2.2rem;
    font-size: 0.8rem;
    color: var(--admin-text-muted);
    text-decoration: none;
    border-radius: var(--admin-radius);
    margin: 0 0.35rem;
    transition: background 0.1s, color 0.1s;
  }

  .nav-child:hover {
    background: var(--admin-muted);
    color: var(--brand-900);
  }

  .nav-child.active {
    background: var(--brand-100);
    color: var(--brand-900);
    font-weight: 600;
  }

  /* ── Recents ── */

  .sidebar-recents {
    flex: 1;
    padding: 0.5rem 0.65rem;
    overflow-y: auto;
    min-height: 0;
  }

  .recents-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.2rem 0.3rem 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--admin-text-muted);
  }

  .recents-list {
    display: flex;
    flex-direction: column;
  }

  :global(.recents-empty) {
    font-size: 0.8rem;
    color: var(--admin-text-muted);
    padding: 0.3rem;
  }

  :global(.recent-item) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--admin-radius);
    color: var(--admin-text);
    text-decoration: none;
    font-size: 0.8rem;
    transition: background 0.1s;
    overflow: hidden;
  }

  :global(.recent-item:hover) {
    background: var(--admin-muted);
  }

  :global(.status-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--admin-text-muted);
  }

  :global(.status-dot.running) {
    background: var(--brand-500);
    box-shadow: 0 0 4px var(--brand-500);
    animation: pulse-dot 1.5s ease-in-out infinite;
  }

  :global(.status-dot.failed) {
    background: #c44;
  }

  :global(.status-dot.done) {
    background: var(--admin-border);
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  :global(.recent-label) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── Footer ── */

  .sidebar-footer {
    padding: 0.5rem 0.65rem;
    border-top: 1px solid var(--admin-border);
  }

  .footer-item {
    min-height: 34px;
    font-size: 0.82rem;
  }

  .logout-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 34px;
    padding: 0.35rem 0.55rem;
    border: none;
    border-radius: var(--admin-radius);
    background: transparent;
    color: var(--admin-text-muted);
    cursor: pointer;
    font-size: 0.82rem;
    text-align: left;
    transition: background 0.12s;
  }

  .logout-btn:hover {
    background: var(--admin-muted);
    color: var(--brand-900);
  }

  /* ── Main area ── */

  .admin-main {
    flex: 1;
    margin-left: var(--sidebar-width);
    min-height: 100vh;
    min-width: 0;
    max-width: calc(100vw - var(--sidebar-width));
    display: flex;
    flex-direction: column;
  }

  .admin-main.home-mode {
    display: flex;
    flex-direction: column;
  }

  .home-layout {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .home-greeting {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* ── Header (non-home pages) ── */

  .admin-header {
    min-height: 56px;
    padding: 0.65rem 1.5rem;
    border-bottom: 1px solid var(--admin-border);
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .admin-header h2 {
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 800;
    letter-spacing: 0;
  }

  .admin-kicker {
    margin-bottom: 0.05rem;
    color: var(--admin-text-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ── Breadcrumb ── */

  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.1rem;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .breadcrumb-sep {
    color: var(--admin-text-soft);
    font-weight: 400;
    margin: 0 0.1rem;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--admin-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .breadcrumb-link:hover {
    text-decoration: underline;
  }

  .admin-content {
    flex: 1;
    width: 100%;
    max-width: 1600px;
    min-width: 0;
    padding: 1.25rem 1.5rem 2.5rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .admin-icon-button,
  :global(.icon-button) {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius);
    background: var(--admin-surface);
    color: var(--admin-text-muted);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .admin-icon-button:hover,
  :global(.icon-button:hover) {
    border-color: var(--admin-accent);
    color: var(--brand-900);
    background: var(--brand-50);
  }

  /* ── Mobile nav ── */

  .mobile-nav {
    display: none;
    position: relative;
  }

  .mobile-nav-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 44px;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius);
    background: var(--admin-surface);
    color: var(--admin-text);
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 700;
    list-style: none;
    padding: 0.45rem 0.65rem;
  }

