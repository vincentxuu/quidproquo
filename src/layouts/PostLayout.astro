<script>
  import { initYoutubeClipLoops, disposeYoutubeClipLoops, handleYoutubeTimeLinkClick } from '../lib/youtubeClipLoop';
  import { initVideoPractice, disposeVideoPractice } from '../lib/videoPractice';
  import { initVideoGallery, disposeVideoGallery } from '../lib/videoGallery';
  import { initFlowDiagrams, disposeFlowDiagrams } from '../lib/flowDiagram';
  import { initSlideReader, disposeSlideReader } from '../lib/slideReader';
  initSlideReader();
  document.addEventListener('astro:page-load', initSlideReader);
  document.addEventListener('astro:before-swap', disposeSlideReader);
  window.addEventListener('pagehide', disposeSlideReader);
  window.addEventListener('pageshow', (event) => { if (event.persisted) initSlideReader(); });
  initFlowDiagrams();
  document.addEventListener('astro:page-load', initFlowDiagrams);
  document.addEventListener('astro:before-swap', disposeFlowDiagrams);
  window.addEventListener('pagehide', disposeFlowDiagrams);
  initVideoPractice();
  document.addEventListener('astro:page-load', initVideoPractice);
  document.addEventListener('astro:before-swap', disposeVideoPractice);
  window.addEventListener('pagehide', disposeVideoPractice);
  initVideoGallery();
  document.addEventListener('astro:page-load', initVideoGallery);
  document.addEventListener('astro:before-swap', disposeVideoGallery);
  window.addEventListener('pagehide', disposeVideoGallery);
  void initYoutubeClipLoops();
  document.addEventListener('click', handleYoutubeTimeLinkClick);
  document.addEventListener('astro:page-load', () => { void initYoutubeClipLoops(); });
  document.addEventListener('astro:before-swap', disposeYoutubeClipLoops);
  window.addEventListener('pagehide', disposeYoutubeClipLoops);

  // Dark mode toggle
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
    localStorage.setItem('theme', isDark ? 'light' : 'dark');
  });

  // Reading progress bar + scroll-to-top with percentage
  const bar = document.getElementById('progress-bar');
  const scrollBtn = document.getElementById('scroll-top');
  const scrollPct = document.getElementById('scroll-pct');
  const SCROLL_VISIBLE_THRESHOLD = 300;

  // On narrow screens the button sits on top of the text, so it shows only while the reader scrolls back up.
  const roomyCorner = window.matchMedia('(min-width: 1024px)');
  let lastScrollY = window.scrollY;
  let scrollingUp = false;

  function updateScroll() {
    const max = document.body.scrollHeight - window.innerHeight;
    if (max <= 0) return;
    const pct = Math.round((window.scrollY / max) * 100);
    if (bar) bar.style.width = `${pct}%`;
    if (scrollPct) scrollPct.textContent = `${pct}%`;
    if (Math.abs(window.scrollY - lastScrollY) > 4) { scrollingUp = window.scrollY < lastScrollY; lastScrollY = window.scrollY; }
    if (scrollBtn) {
      scrollBtn.classList.toggle('visible', window.scrollY > SCROLL_VISIBLE_THRESHOLD && (roomyCorner.matches || scrollingUp));
    }
  }

  // 記住每篇讀到哪（只增不減），列表卡片據此顯示已讀進度條（見 PostCard.astro）
  const READ_KEY = 'qpq:read-progress';
  const readPath = location.pathname.replace(/^\/en(?=\/)/, '').replace(/\/$/, '');
  const isPostPage = /^\/posts\/[^/]+$/.test(readPath);
  let readStore: Record<string, number> = {};
  let readSaved = 0;
  try {
    readStore = JSON.parse(localStorage.getItem(READ_KEY) || '{}') || {};
    readSaved = readStore[readPath] || 0;
  } catch {}

  function saveReadProgress() {
    if (!isPostPage) return;
    const max = document.body.scrollHeight - window.innerHeight;
    if (max <= 0) return;
    const pct = Math.min(100, Math.round((window.scrollY / max) * 100));
    if (pct < readSaved + 3 && pct < 100) return;
    if (pct <= readSaved) return;
    readSaved = pct;
    readStore[readPath] = pct;
    try { localStorage.setItem(READ_KEY, JSON.stringify(readStore)); } catch {}
  }

  window.addEventListener('scroll', () => { updateScroll(); saveReadProgress(); }, { passive: true });
  updateScroll();

  scrollBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
