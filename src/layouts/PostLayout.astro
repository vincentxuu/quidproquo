---
// src/layouts/PostLayout.astro
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';
import Icons from '../components/Icons.astro';
import { ChatSidebar } from '../components/Chat/ChatSidebar';
import { ChatFloating } from '../components/Chat/ChatFloating';
import '../styles/tokens.css';
import '../styles/chat.css';
import '../styles/videoPractice.css';
import '../styles/videoGallery.css';
import '../styles/flowDiagram.css';
import '../styles/diagram.css';
import '../styles/slideReader.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
  articleDate?: Date;
  articleUpdated?: Date;
  articleTags?: string[];
  articleSlug?: string;
  articleTerm?: string;
  switchHref?: string;
  hasTranslation?: boolean;
  hreflangEn?: string;
  hreflangZh?: string;
  /** 額外 body class（如 is-collection 換頁面基調） */
  bodyClass?: string;
}
const {
  title,
  description,
  lang: langProp,
  ogImage,
  articleDate,
  articleUpdated,
  articleTags,
  articleSlug,
  articleTerm,
  switchHref: switchHrefProp,
  hasTranslation,
  hreflangEn,
  hreflangZh,
  bodyClass,
} = Astro.props;
const isArticle = !!articleDate;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeHref = lang === 'en' ? '/en' : '/';
const categoriesHref = lang === 'en' ? '/en/categories' : '/categories';
const seriesHref = lang === 'en' ? '/en/series' : '/series';
const tagsHref = lang === 'en' ? '/en/tags' : '/tags';
// Post pages pass an explicit switchHref (translation pairing); other pages fall back.
const switchHref = switchHrefProp ?? t('lang.switch.href');
const switchLabel = t('lang.switch');
// Emit hreflang alternates only when a translation pair exists. x-default -> zh-TW.
const showHreflang = hasTranslation && !!hreflangEn && !!hreflangZh;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://quidproquo.cc');

// SERP titles get truncated around ~60 display columns; CJK glyphs take two.
// Drop the brand suffix rather than let it push the real title out of view.
const BRAND_SUFFIX = ' — quidproquo';
const displayWidth = (s: string) =>
  [...s].reduce((n, ch) => n + (/[　-鿿＀-￯]/.test(ch) ? 2 : 1), 0);
// 系列／標籤／分類頁傳進來的 title 已自帶品牌後綴，不要再加一次。
const pageTitle =
  title.endsWith(BRAND_SUFFIX) || displayWidth(title) + BRAND_SUFFIX.length > 60
    ? title
    : `${title}${BRAND_SUFFIX}`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <link rel="canonical" href={canonicalURL} />
  {description && <meta name="description" content={description} />}
  <meta property="og:title" content={pageTitle} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_TW'} />
  <meta property="og:type" content={isArticle ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta property="og:image:width" content="1200" />}
  {ogImage && <meta property="og:image:height" content="630" />}
  {isArticle && <meta property="article:published_time" content={articleDate!.toISOString()} />}
  {isArticle && <meta property="article:modified_time" content={(articleUpdated ?? articleDate!).toISOString()} />}
  {isArticle && <meta property="article:author" content="xiaoxu" />}
  {isArticle && articleTags?.map(tag => <meta property="article:tag" content={tag} />)}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={pageTitle} />
  {description && <meta name="twitter:description" content={description} />}
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <link rel="alternate" type="application/rss+xml" title="quidproquo RSS" href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'} />
  {showHreflang && <link rel="alternate" hreflang="en" href={hreflangEn} />}
  {showHreflang && <link rel="alternate" hreflang="zh-Hant" href={hreflangZh} />}
  {showHreflang && <link rel="alternate" hreflang="x-default" href={hreflangZh} />}
  <link rel="preload" href="/fonts/NotoSansTC-Medium.otf" as="font" type="font/otf" crossorigin />
  <slot name="head" />
  <script is:inline>
    // Apply theme before page renders to avoid flash
    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (stored === 'dark' || (!stored && prefersDark)) {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  </script>
</head>
<body class:list={{ "is-article": isArticle, ...(bodyClass ? { [bodyClass]: true } : {}) }}>
  <div class="progress-bar" id="progress-bar"></div>
  <a href="#main-content" class="skip-nav">Skip to content</a>
  <header>
    <nav>
      <a href={homeHref} class="logo">quidproquo</a>
      <a href={lang === 'en' ? '/en/daily' : '/daily'} class="nav-link">{t('nav.daily')}</a>
      <a href={lang === 'en' ? '/en/about' : '/about'} class="nav-link">{t('nav.about')}</a>
      <a href={categoriesHref} class="nav-link">{t('nav.categories')}</a>
      <a href={seriesHref} class="nav-link">{t('nav.series')}</a>
      <a href={tagsHref} class="nav-link">{t('nav.tags')}</a>
      <a href={lang === 'en' ? '/en/interview' : '/interview'} class="nav-link">{t('nav.interview')}</a>
      <a href="/english" class="nav-link">{t('nav.english')}</a>
      {lang !== 'en' && <a href="/collection" class="nav-link">{t('nav.collection')}</a>}
      <a href={lang === 'en' ? '/en/vocabulary' : '/vocabulary'} class="nav-link">{lang === 'en' ? 'Vocabulary' : '單字庫'}</a>
      <a href="/account" class="nav-link">{lang === 'en' ? 'My space' : '私人空間'}</a>
      <div class="nav-right">
        <a href={lang === 'en' ? '/en/search' : '/search'} class="nav-search-link" aria-label={t('nav.search')}>
          <Icons name="search" size={15} />
        </a>
        <button class="nav-icon-btn" id="theme-toggle" aria-label={t('nav.toggle-theme')}>
          <span class="icon-light"><Icons name="sun" size={15} /></span>
          <span class="icon-dark"><Icons name="moon" size={15} /></span>
        </button>
        <a href={switchHref} class="lang-badge">{switchLabel}</a>
      </div>
    </nav>
  </header>
  <main id="main-content">
    <slot />
  </main>
  <footer>
    <span>quidproquo.cc</span>
    <a href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'} class="rss-link" aria-label="RSS">
      <Icons name="rss" size={14} />
      <span>RSS</span>
    </a>
  </footer>

  {articleSlug
    ? <ChatSidebar client:only="react" lang={lang} page={{ slug: articleSlug, title, term: articleTerm }} />
    : <ChatFloating client:only="react" lang={lang} />
  }

  <!-- Floating scroll-to-top -->
  <button class="scroll-top" id="scroll-top" aria-label="Scroll to top">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
    <span class="scroll-pct" id="scroll-pct">0%</span>
  </button>
</body>
</html>

<style is:global>
  @font-face {
    font-family: 'Noto Sans TC Local';
    src: url('/fonts/NotoSansTC-Medium.otf') format('opentype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  /* The CJK font draws curly quotes full-width, which leaves a gap in the middle of I’m.
     These four characters come from a Latin system font instead; with none installed, text looks as before. */
  @font-face {
    font-family: 'Latin Quotes';
    src: local('Helvetica Neue'), local('Arial'), local('Roboto'), local('Segoe UI'), local('Noto Sans');
    unicode-range: U+2018-2019, U+201C-201D;
  }

  /* ── 全站 token 見 src/styles/tokens.css（單一來源，不在此拷貝） ── */

  /* Skip navigation */
  .skip-nav {
    position: absolute;
    left: -9999px;
    top: 1rem;
    z-index: 9999;
    background: var(--brand-900);
    color: var(--bg-page);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .skip-nav:focus {
    left: 1rem;
  }

  /* Keyboard focus styles */
  :focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
  }

  /* ── Reset & Base ── */
  *, *::before, *::after { box-sizing: border-box; }

  html {
    overflow-x: hidden; /* prevent wide tables/code from expanding page width */
  }

  body {
    font-family: 'Latin Quotes', 'Noto Sans TC Local', 'PingFang TC', 'Microsoft JhengHei', system-ui, -apple-system, sans-serif;
    --page-gutter: 1.5rem;
    --ask-ai-sidebar-width: 380px; /* 與 ChatSidebar.tsx SIDEBAR_WIDTH 對齊；單一事實來源 */
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-4) var(--page-gutter);
    color: var(--text-primary);
    background: var(--bg-page);
    transition: background 0.2s, color 0.2s;
  }
  /* Ask AI 面板開啟時，body 撐滿視窗寬度，使 padding-right 讓位落在畫面右邊被固定面板精準蓋住，
     避免 body 置中導致 padding 從內容裡往內吃、出現巨大空格＋本文被壓縮。 */
  body.has-chat-sidebar { max-width: none; }
  /* Article pages widen at desktop to fit a sticky TOC/video sidebar (.post-grid) */
  @media (min-width: 1000px) {
    body.is-article { max-width: 1180px; }
  }

  /* Radix modal（DropdownMenu / Dialog）鎖捲軸時，react-remove-scroll-bar 會把 body 的
     auto margin 歸零、改寫成同寬的 padding。本站 body 是 max-width + margin:auto，
     那段 padding 會從 800px 裡往內吃，螢幕越寬內容被擠得越細；它還會把 margin-right 釘成 0。
     lib 的 style 是後注入的，同特異性會贏，所以這裡用 html body 提高特異性壓回去，
     鎖定期間只保留 overflow: hidden。 */
  html body[data-scroll-locked] {
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: var(--page-gutter) !important;
    padding-right: var(--page-gutter) !important;
  }

  /* ── Nav ── */
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--border);
    position: relative;
  }
  .logo {
    font-weight: 900;
    font-size: 1.05rem;
    letter-spacing: -0.5px;
    text-decoration: none;
    color: var(--brand-700);
  }
  .nav-link {
    font-size: 0.8rem;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text-secondary);
  }
  .nav-link:hover { color: var(--brand-700); }
  .nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Circular icon buttons (like DJ MYG) */
  .nav-icon-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .nav-icon-btn:hover {
    color: var(--brand-500);
    border-color: var(--brand-500);
    background: var(--bg-card);
  }
  .nav-search-link {
    min-height: 36px;
    padding: 0 0.8rem;
    border-radius: var(--corner-pill);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    cursor: pointer;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .nav-search-link:hover {
    color: var(--brand-500);
    border-color: var(--brand-500);
    background: var(--bg-card);
  }

  /* Dark mode toggle */
  .icon-dark { display: none; }
  [data-theme="dark"] .icon-light { display: none; }
  [data-theme="dark"] .icon-dark  { display: flex; }

  /* Language badge */
  .lang-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 0.12rem 0.45rem;
    border-radius: var(--corner-sm);
    text-decoration: none;
  }
  .lang-badge:hover { border-color: var(--brand-500); }

  /* Reading progress bar */
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--brand-500);
    transition: width 0.1s linear;
    z-index: 1000;
  }

  /* ── Floating scroll-to-top ── */
  .scroll-top {
    position: fixed;
    bottom: 5.5rem;
    right: 1.5rem;
    width: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--corner-md);
    padding: var(--space-2) 0.35rem;
    color: var(--text-muted);
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.2s, transform 0.2s, color 0.15s;
    pointer-events: none;
    z-index: 100;
    box-shadow: var(--shadow-floating);
  }
  .scroll-top.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .scroll-top:hover { color: var(--brand-500); }
  .scroll-pct {
    font-size: 0.6rem;
    font-weight: 700;
    line-height: 1;
  }

  /* ── Footer ── */
  footer {
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .rss-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--fs-xs);
  }
  .rss-link:hover { color: var(--brand-500); }

  /* ── Category badges (global, used in PostCard + slug page) ── */
  .cat-badge {
    font-size: var(--fs-2xs);
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: var(--corner-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-on-accent);
    text-decoration: none;
  }
  .cat-tech      { background: var(--cat-tech); }
  .cat-ai        { background: var(--cat-ai); }
  .cat-product   { background: var(--cat-product); }
  .cat-education { background: var(--cat-education); }
  .cat-life      { background: var(--cat-life); }
  .cat-marketing { background: var(--cat-marketing); }
  .cat-travel    { background: var(--cat-travel); }
  .cat-climbing  { background: var(--cat-climbing); }
  .cat-surf      { background: var(--cat-surf); }
  .cat-film      { background: var(--cat-film); }
  .cat-coffee    { background: var(--cat-coffee); }
  .cat-learning  { background: var(--cat-learning); }
  .cat-design    { background: var(--cat-design); }
  .cat-policy    { background: var(--cat-policy); }
  .cat-investing { background: var(--cat-investing); }
  .cat-anime     { background: var(--cat-anime); }
  .cat-career    { background: var(--cat-career); }
  .cat-weather   { background: var(--cat-weather); }

  /* ── Type badges ── */
  .type-badge {
    font-size: var(--fs-2xs);
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: var(--corner-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid currentColor;
    text-decoration: none;
  }
  .type-badge:hover { opacity: 0.75; }
  .type-debug     { color: var(--type-debug); }
  .type-deep-dive { color: var(--type-deep-dive); }
  .type-guide     { color: var(--type-guide); }
  .type-project   { color: var(--type-project); }

  /* ── Type filter tabs ── */
  .type-filter {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .filter-btn {
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--corner-sm);
    padding: var(--space-1) 0.65rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    cursor: pointer;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .filter-btn:hover { border-color: var(--brand-500); color: var(--brand-500); }
  .filter-btn.active { background: var(--brand-900); border-color: var(--brand-900); color: var(--bg-page); }

  /* ── Tags ── */
  .tag-pill {
    background: var(--bg-subtle);
    font-size: var(--fs-xs);
    padding: 0.08rem 0.45rem;
    border-radius: var(--corner-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  /* 中性灰平時、hover 才轉強調色 */
  .tag-pill:hover { background: var(--brand-100); color: var(--brand-700); }

  /* ── Prose: all MDX/markdown rendered content ── */
  .content { line-height: 1.8; margin-bottom: var(--space-12); }

  /* Headings：h2 用上方分隔線切段落（第一個 h2 不畫線）。 */
  .content h1 { font-size: var(--fs-h1); font-weight: 900; margin: var(--space-10) 0 var(--space-4); color: var(--text-primary); }
  .content h2 {
    font-size: var(--fs-h2);
    font-weight: 800;
    margin: var(--space-12) 0 var(--space-3);
    padding-top: var(--space-6);
    padding-bottom: var(--space-2);
    border-top: 1px solid var(--border);
    color: var(--text-primary);
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .content h2:first-child { margin-top: 0; padding-top: 0; border-top: none; }
  .content h3 { font-size: var(--fs-h3); font-weight: 700; margin: var(--space-6) 0 var(--space-2); color: var(--text-primary); }
  .content h4 { font-size: var(--fs-h4); font-weight: 700; margin: var(--space-5) 0 var(--space-2); color: var(--text-primary); }
  .content h5, .content h6 { font-size: var(--fs-sm); font-weight: 600; margin: var(--space-4) 0 var(--space-2); color: var(--text-secondary); }

  /* Heading anchor links */
  .content h2 .heading-anchor,
  .content h3 .heading-anchor {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 400;
    font-size: 0.85em;
    opacity: 0;
    transition: opacity 0.15s;
    margin-left: var(--space-2);
  }
  .content h2:hover .heading-anchor,
  .content h3:hover .heading-anchor { opacity: 1; }

  /* Paragraph & inline（行內元素用 em，跟著所在段落或標題的字級縮放） */
  .content p { margin-bottom: var(--space-4); }
  .content strong { font-weight: 700; color: var(--text-primary); }
  .content em { font-style: italic; }
  .content del { text-decoration: line-through; color: var(--text-muted); }
  .content mark { background: var(--mark-bg); color: var(--mark-text); padding: 0.05em 0.2em; border-radius: var(--corner-sm); }

  /* Links：深色字＋淡綠底線，hover 底線轉品牌綠 */
  .content a { color: var(--brand-700); text-decoration: underline; text-decoration-color: var(--brand-300); text-underline-offset: 3px; transition: text-decoration-color 0.15s; }
  .content a:hover { text-decoration-color: var(--brand-500); }
  /* 深色下 --brand-300 底線對頁面底太暗，平時就用 --brand-500 底線，hover 字轉 --brand-900 */
  [data-theme="dark"] .content a { text-decoration-color: var(--brand-500); }
  [data-theme="dark"] .content a:hover { color: var(--brand-900); }

  /* 比欄寬長的獨立公式在自己的區塊內橫向捲動，不撐破版面（手機上很常見）。 */
  .content .katex-display { overflow-x: auto; overflow-y: hidden; padding: var(--space-1) 0; }

  /* ── macOS-style Code Blocks ── */
  .content pre {
    position: relative;
    background: var(--bg-code);
    color: var(--code-text);
    padding: 0;
    border-radius: var(--corner-md);
    overflow: hidden;
    margin-bottom: var(--space-5);
    border: 1px solid var(--border);
  }
  .content pre::before {
    content: '';
    display: block;
    padding: 0.6rem var(--space-4);
    background: var(--code-bar);
    background-image: radial-gradient(circle at 16px 50%, var(--code-dot-red) 5px, transparent 5px),
                      radial-gradient(circle at 36px 50%, var(--code-dot-yellow) 5px, transparent 5px),
                      radial-gradient(circle at 56px 50%, var(--code-dot-green) 5px, transparent 5px);
    background-repeat: no-repeat;
    border-bottom: 1px solid var(--code-bar-divider);
  }
  .content pre code {
    display: block;
    padding: var(--space-4) var(--space-6);
    overflow-x: auto;
    font-size: var(--fs-sm);
    line-height: 1.6;
    counter-reset: line;
  }

  .content :not(pre) > code { background: var(--bg-subtle); box-shadow: inset 0 0 0 1px var(--border); color: var(--text-primary); padding: 0.1em 0.35em; border-radius: var(--corner-sm); font-size: 0.9em; }
  .content kbd { background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--corner-sm); padding: 0.1em 0.4em; font-size: 0.9em; font-family: monospace; }

  /* ── Callouts ──
     預設 blockquote＝品牌 note。src/plugins/remarkCallout.ts 依 `> [!WARNING]`／`> [!TIP]` 或
     開頭粗體（**注意**、**Warning**、**提示**、**Tip**…）加上 callout-warning／callout-tip。 */
  .content blockquote {
    background: var(--bg-subtle);
    border-left: 4px solid var(--brand-500);
    border-radius: 0 var(--corner-md) var(--corner-md) 0;
    padding: var(--space-4) var(--space-5);
    color: var(--text-primary);
    margin: var(--space-5) 0;
    font-style: normal;
  }
  /* margin-top 要歸零：瀏覽器預設 p 上方 1em，在有 padding 的框裡不會摺疊，框頂會比框底多出一行空白 */
  .content blockquote p { margin: 0 0 var(--space-2); }
  .content blockquote p:last-child { margin-bottom: 0; }
  .content blockquote.callout-warning {
    background: var(--warning-bg);
    border-left-color: var(--warning-border);
  }
  .content blockquote.callout-tip {
    background: var(--success-bg);
    border-left-color: var(--success-border);
  }
  .content blockquote .callout-title { margin-bottom: var(--space-1); }

  /* 文章開頭的語言切換（> 🌏 [English version](…)）：只有一個連結，不該套提示框，改成小膠囊。
     🌏 由 rehypeNoEmoji 換成 koboyo 地球圖示並放進連結裡當第一個子元素，所以段落裡仍然只有那個連結。
     外層 blockquote 維持一般區塊（寬版版面靠 margin-inline: auto 對齊內文欄），膠囊畫在裡面那段上。
     選擇器特異性高於上面的 callout 規則，必須維持。 */
  .content > blockquote:first-child:has(> p:only-child > a:only-child) {
    background: none;
    border: none;
    border-radius: 0;
    padding: 0;
    margin-top: 0;
    margin-bottom: var(--space-5);
  }
  .content > blockquote:first-child:has(> p:only-child > a:only-child) > p {
    /* inline-block 而不是 inline-flex：flex 會吃掉 🌏 與連結之間的空白。 */
    display: inline-block;
    margin: 0;
    padding: 0.3rem 0.9rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--corner-pill);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .content > blockquote:first-child:has(> p:only-child > a:only-child) a {
    color: var(--brand-700);
    font-weight: 600;
    text-decoration: none;
    border-bottom: none;
  }
  .content > blockquote:first-child:has(> p:only-child > a:only-child) a:hover { text-decoration: underline; }

  /* 文章裡的 emoji 由 rehypeNoEmoji 換成 koboyo 圖示（svg.inline-icon，寬高 1em），跟著文字大小與顏色走。 */
  .content .inline-icon { display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em; color: inherit; flex-shrink: 0; }
  /* ★★☆ 評分：一組星星是一個 role="img"（aria-label 如「2 / 3」），裡面每顆星 aria-hidden；不換行。 */
  .content .star-rating { display: inline-flex; gap: 0.05em; vertical-align: -0.125em; white-space: nowrap; }
  .content .star-rating .inline-icon { vertical-align: 0; }

  /* ── 摺疊區塊 details／summary ── */
  .content details {
    border: 1px solid var(--border);
    border-radius: var(--corner-md);
    background: var(--bg-card);
    padding: 0 var(--space-4);
    margin: var(--space-5) 0;
  }
  .content details > summary {
    cursor: pointer;
    font-weight: 600;
    padding: var(--space-3) 0;
    color: var(--text-primary);
  }
  .content details > summary::marker { color: var(--brand-500); }
  .content details[open] > summary {
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-3);
  }
  .content details[open] { padding-bottom: var(--space-1); }

  /* Lists */
  .content ul, .content ol { padding-left: var(--space-6); margin-bottom: var(--space-4); }
  .content ul { list-style-type: disc; }
  .content ol { list-style-type: decimal; }
  .content li { margin-bottom: var(--space-2); }
  .content li > ul, .content li > ol { margin-top: var(--space-1); margin-bottom: var(--space-1); }
  .content input[type="checkbox"] { margin-right: var(--space-2); accent-color: var(--brand-500); }

  /* Horizontal rule — dashed style */
  .content hr {
    border: none;
    border-top: 2px dashed var(--border);
    margin: var(--space-10) 0;
  }

  /* Images */
  .content img { max-width: 100%; height: auto; border-radius: var(--corner-md); margin: var(--space-4) 0; display: block; }
  .content figure { margin: var(--space-6) 0; }
  .content figcaption { font-size: var(--fs-xs); color: var(--text-muted); text-align: center; margin-top: var(--space-2); }

  /* ── Responsive: mobile ── */
  @media (max-width: 640px) {
    body { --page-gutter: 1rem; }
    nav {
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      row-gap: var(--space-3);
    }
    .nav-link {
      font-size: var(--fs-xs);
    }
    .nav-right {
      gap: var(--space-2);
    }
    .nav-icon-btn,
    .nav-search-link {
      min-height: 32px;
      height: 32px;
      width: 32px;
      padding: 0 0.6rem;
    }
    .lang-badge {
      font-size: var(--fs-2xs);
      padding: 0.1rem 0.4rem;
    }
  }
  @media (max-width: 400px) {
    body { --page-gutter: 0.75rem; }
    nav {
      gap: 0.4rem var(--space-3);
      row-gap: 0.6rem;
    }
    .logo {
      font-size: 0.95rem;
    }
    .nav-link {
      font-size: 0.7rem;
    }
    .nav-icon-btn,
    .nav-search-link {
      min-height: 30px;
      height: 30px;
      width: 30px;
      padding: 0 var(--space-2);
    }
  }

  /* ── Tables ── */
  .content .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border);
    border-radius: var(--corner-md);
    margin-bottom: var(--space-6);
  }
  /* 寬度用 100% 讓儲存格換行：之前用 max-content（儲存格不換行），一格字長就整張表超寬，連桌機都要左右滑
     （2026-11-19 日報「關鍵數字」三欄表）。真的放不下的表（欄位多、長串不能斷）仍由 .table-scroll 接手橫向捲動，
     頁面本身由 html { overflow-x: hidden } 防撐破。 */
  .content table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--fs-sm);
    border-radius: var(--corner-md);
  }
  .content th {
    background: var(--bg-subtle);
    font-weight: 700;
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 2px solid var(--border);
    color: var(--text-primary);
  }
  .content td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
  }
  .content tr:last-child td { border-bottom: none; }
  .content tbody tr:hover { background: var(--bg-subtle); }
  .content th:not(:last-child),
  .content td:not(:last-child) {
    border-right: 1px solid var(--border);
  }

  /* ── About page: two-column layout ── */
  .about-grid {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 0;
    align-items: start;
  }

  .about-sidebar {
    position: sticky;
    top: 5.5rem;
    align-self: start;
  }

  .about-sidebar-inner {
    padding-right: var(--space-8);
    border-right: 1px solid var(--border);
  }

  .about-sidebar-name {
    font-family: 'DM Serif Display', Georgia, serif;
    font-style: italic;
    font-size: 2rem;
    line-height: 1.05;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
    letter-spacing: -0.01em;
  }

  .about-sidebar-title {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
    margin: 0 0 var(--space-4);
  }

  .about-sidebar-blurb {
    margin: 0 0 var(--space-4);
    font-size: 0.84rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 16rem;
  }

  .about-sidebar-rule {
    height: 1px;
    background: var(--border);
    margin: 0.9rem 0;
  }

  .about-sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .about-sidebar-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    font-size: 0.78rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.12s;
  }

  .about-sidebar-nav a svg {
    width: 0.9rem;
    height: 0.9rem;
    flex: 0 0 auto;
    fill: currentColor;
  }

  .about-sidebar-nav a:hover {
    color: var(--brand-500);
    text-decoration: none;
  }

  .about-body {
    padding-left: var(--space-10);
    padding-right: var(--space-4);
    padding-bottom: var(--space-12);
    line-height: 1.85;
    max-width: 40rem;
  }

  .about-body p {
    margin-bottom: 1.4rem;
    line-height: 1.85;
    color: var(--text-primary);
  }

  .about-prose {
    width: 100%;
  }

  .content .about-h1 {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 2.4rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 1.4rem;
    line-height: 1.1;
  }

  .about-section-h2 {
    font-family: 'DM Serif Display', Georgia, serif !important;
    font-size: 1.4rem !important;
    font-weight: 400 !important;
    color: var(--text-primary) !important;
    margin: var(--space-10) 0 var(--space-4) !important;
    padding-top: 0 !important;
    padding-bottom: 0.35rem !important;
    border-top: none !important;
    border-bottom: 1px solid var(--border) !important;
    line-height: 1.2 !important;
    display: block !important;
    justify-content: unset !important;
  }


  .about-intro-lede {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--text-primary);
    border-left: 3px solid var(--brand-500);
    padding-left: 1.1rem;
    margin-bottom: 1.2rem;
  }

  .about-notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 1.1rem 0 1.2rem;
  }

  .about-principles {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: var(--space-4) 1.05rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .about-principles p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .about-principles strong {
    color: var(--text-primary);
    font-weight: 800;
  }

  .about-principles em {
    font-style: italic;
    color: var(--text-primary);
  }

  .about-offwork {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .about-offwork-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .about-offwork-tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.22rem 0.62rem;
    border-radius: var(--corner-pill);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--text-secondary);
  }

  .about-offwork p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .about-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
    margin: 1.35rem 0 var(--space-6);
  }

  .about-timeline::before {
    content: "";
    position: absolute;
    left: 4.75rem;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 1px;
    background: var(--border);
  }

  .about-timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    gap: 0.9rem;
    align-items: start;
  }

  .about-timeline-item:not(:last-child) {
    margin-bottom: 0.35rem;
  }

  .about-timeline-item::before {
    content: "";
    position: absolute;
    left: 4.35rem;
    top: 0.75rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: var(--corner-pill);
    background: var(--brand-500);
    border: 3px solid var(--bg-card);
    box-shadow: 0 0 0 1px var(--border);
  }

  .about-timeline-year {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-top: 0.45rem;
    margin-left: 0.1rem;
  }

  .about-timeline-content {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--corner-lg);
    margin-left: var(--space-2);
    padding: 0.85rem var(--space-4) 0.9rem;
  }

  .about-timeline-content h3 {
    margin: 0 0 0.3rem;
    font-size: 0.98rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .about-timeline-content p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .about-now-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .about-now-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 0 1.4rem !important;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .about-now-list li {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    padding: 0.55rem 0.85rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    transition: border-color 0.15s;
    margin-bottom: 0 !important;
  }

  .about-now-list li::before {
    content: "→";
    color: var(--brand-500);
    font-weight: 700;
    flex-shrink: 0;
  }

  .about-now-list li:hover { border-color: var(--brand-500); }

  .about-projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .about-page .project-card {
    padding: var(--space-4) 1.15rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border);
    border-radius: 0 var(--corner-md) var(--corner-md) 0;
    transition: border-left-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }

  .about-page .project-card:hover {
    border-left-color: var(--brand-500);
    box-shadow: var(--shadow-card-hover);
    transform: translateX(3px);
  }

  .about-page .project-header {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-bottom: 0.35rem;
  }

  .about-page .project-name {
    font-size: 0.96rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .about-page .project-badge {
    font-size: 0.59rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
  }

  .about-page .project-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0 0 0.55rem;
  }

  .about-page .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
    margin-bottom: 0.55rem;
  }

  .about-page .project-links { display: flex; gap: 0.85rem; }

  .about-page .project-link {
    font-size: 0.77rem;
    font-weight: 600;
    color: var(--brand-500);
    text-decoration: none;
  }

  .about-page .project-link:hover { color: var(--brand-900); text-decoration: none; }

  .about-page .ptag {
    font-size: 0.62rem;
    font-weight: 600;
    background: var(--bg-card);
    color: var(--text-secondary);
    padding: 0.1rem 0.42rem;
    border-radius: var(--corner-sm);
  }

  .about-skills {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: var(--space-2);
  }

  .about-page .skill-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .about-page .skill-cat {
    font-size: var(--fs-2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    min-width: 88px;
    padding-top: 0.18rem;
    flex-shrink: 0;
  }

  .about-page .skill-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }

  .about-links { display: flex; flex-wrap: wrap; gap: 0.55rem; }

  .about-page .link-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 0.36rem 0.82rem;
    border-radius: 6px;
    text-decoration: none;
    background: var(--bg-subtle);
    transition: color 0.15s, border-color 0.15s;
  }

  .about-page .link-chip:hover {
    color: var(--brand-500);
    border-color: var(--brand-500);
    text-decoration: none;
  }

  @media (max-width: 680px) {
    .about-page {
      margin-top: 0.4rem;
      padding-left: var(--space-3);
      padding-right: var(--space-3);
    }
    .about-grid {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .about-sidebar { position: static; }
    .about-page .about-sidebar-inner {
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding-right: 0;
      padding-bottom: 0;
      margin-bottom: 0;
      display: block !important;
      width: 100%;
      background: var(--bg-subtle);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.1rem var(--space-5) var(--space-4);
    }
    .about-page .about-sidebar-name { font-size: 1.4rem !important; margin-bottom: 0.15rem; }
    .about-page .about-sidebar-title { font-size: 0.62rem; margin-bottom: 0.7rem; }
    .about-page .about-sidebar-blurb {
      display: block;
      margin: 0 0 var(--space-3);
      font-size: 0.86rem;
      line-height: 1.65;
      max-width: 18rem;
    }
    .about-page .about-sidebar-rule { display: none; }
    .about-page .about-sidebar-nav {
      display: flex !important;
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0;
    }
    .about-page .about-sidebar-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 2rem;
      padding: 0.24rem 0.58rem;
      border: 1px solid var(--border);
      border-radius: var(--corner-pill);
      background: var(--bg-card);
      font-size: 0.72rem;
      line-height: 1;
    }
    .about-body {
      --about-mobile-inset-left: 1.05rem;
      --about-mobile-inset-right: 0.45rem;
      padding: var(--space-5) var(--space-6) 1.7rem;
      background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-subtle) 100%);
      border: 1px solid var(--border);
      border-radius: 16px;
    }
    .content .about-h1 {
      font-size: 2.05rem;
      margin-bottom: 1.15rem;
      padding-left: var(--about-mobile-inset-left);
      padding-right: var(--about-mobile-inset-right);
    }
    .about-prose {
      max-width: 30rem;
      margin-left: auto;
      margin-right: auto;
      padding-left: var(--about-mobile-inset-left);
      padding-right: var(--about-mobile-inset-right);
    }
    .about-body p {
      font-size: var(--fs-md);
      line-height: 2;
      margin-top: var(--space-1);
      margin-bottom: 1.15rem;
      text-wrap: pretty;
    }
    .about-timeline {
      gap: 1.1rem;
      margin-top: 1.2rem;
    }
    .about-timeline::before {
      left: 0.6rem;
      top: 0.25rem;
      bottom: 0.25rem;
    }
    .about-timeline-item {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding-left: 2.45rem;
    }

    .about-timeline-item:not(:last-child) {
      margin-bottom: 0.9rem;
    }
