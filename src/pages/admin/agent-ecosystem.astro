---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Agent 生態系統管理">
  <p class="page-desc">管理 Agent Skills、MCP Servers 與 Plugins。專案 Skills（Git 管理）與用戶 Skills（D1 資料庫）並存，執行時合併使用。</p>

  <section class="admin-panel agent-ecosystem-panel" data-api-base="/api">
    <div class="admin-panel-header">
      <div>
        <h2>Agent 生態系統</h2>
        <p class="admin-section-desc">
          <strong>Skills</strong>：定義 agent 如何執行任務（SKILL.md 格式）<br>
          <strong>MCP Servers</strong>：提供外部工具與數據源（GitHub、Notion、Slack 等）<br>
          <strong>Plugins</strong>：Skills + MCP Servers 的打包格式，可分發安裝
        </p>
      </div>
      <div class="header-actions">
        <button id="refresh-all" class="btn-secondary" type="button">全部重新整理</button>
      </div>
    </div>

    <div class="ecosystem-tabs" role="tablist" aria-label="生態系統分頁">
      <button role="tab" class="tab-btn active" data-tab="skills" aria-selected="true">
        <span class="tab-icon">📝</span>
        <span class="tab-label">Skills</span>
        <span id="skills-count" class="tab-count">0</span>
      </button>
      <button role="tab" class="tab-btn" data-tab="mcp-servers" aria-selected="false">
        <span class="tab-icon">🔌</span>
        <span class="tab-label">MCP Servers</span>
        <span id="mcp-count" class="tab-count">0</span>
      </button>
      <button role="tab" class="tab-btn" data-tab="plugins" aria-selected="false">
        <span class="tab-icon">📦</span>
        <span class="tab-label">Plugins</span>
        <span id="plugins-count" class="tab-count">0</span>
      </button>
    </div>

    <div class="tab-panels">
      <!-- Skills Tab -->
      <div role="tabpanel" class="tab-panel active" id="skills-panel" aria-labelledby="skills-tab">
        <div class="panel-header">
          <div class="panel-search">
            <input type="search" id="skills-search" class="input" placeholder="搜尋 skill 名稱、描述..." />
            <select id="skills-source-filter" class="select">
              <option value="">全部來源</option>
              <option value="project">專案</option>
              <option value="user">用戶</option>
              <option value="imported">匯入</option>
            </select>
            <button id="create-skill" class="btn" type="button">新增 Skill</button>
            <button id="import-skills" class="btn-secondary" type="button">匯入</button>
            <button id="export-skills" class="btn-secondary" type="button">匯出全部</button>
          </div>
        </div>
        <div id="skills-list" class="entity-list"></div>
      </div>

      <!-- MCP Servers Tab -->
      <div role="tabpanel" class="tab-panel" id="mcp-servers-panel" aria-labelledby="mcp-servers-tab" hidden>
        <div class="panel-header">
          <div class="panel-search">
            <input type="search" id="mcp-search" class="input" placeholder="搜尋 server 名稱、描述..." />
            <select id="mcp-enabled-filter" class="select">
              <option value="">全部狀態</option>
              <option value="true">已啟用</option>
              <option value="false">已停用</option>
            </select>
            <button id="create-mcp-server" class="btn" type="button">新增 Server</button>
          </div>
        </div>
        <div id="mcp-servers-list" class="entity-list"></div>
      </div>

      <!-- Plugins Tab -->
      <div role="tabpanel" class="tab-panel" id="plugins-panel" aria-labelledby="plugins-tab" hidden>
        <div class="panel-header">
          <div class="panel-search">
            <input type="search" id="plugins-search" class="input" placeholder="搜尋 plugin 名稱、描述..." />
            <button id="create-plugin" class="btn" type="button">安裝 Plugin</button>
          </div>
        </div>
        <div id="plugins-list" class="entity-list"></div>
      </div>
    </div>
  </section>
</AdminLayout>

<script is:inline>
  // --- 共用工具函數 ---
  const API_BASE = '/api';
  const normalize = (v) => String(v ?? '').trim();

  async function fetchJson(url, options) {
    const res = await fetch(url, {
      ...options,
      headers: { 'Content-Type': 'application/json', ...options?.headers },
      credentials: 'include',
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({ error: 'Request failed' }));
      throw new Error(err.error || 'HTTP ' + res.status);
    }
    return res.json();
  }

  function showToast(msg, type = 'success') {
    const toast = document.createElement('div');
    toast.className = 'toast ' + type;
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }

  function formatDate(ts) {
    if (!ts) return '\u2014';
    return new Date(ts * 1000).toLocaleString('zh-TW');
  }

  // --- 分頁切換 ---
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      tabBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
      tabPanels.forEach(p => { p.classList.remove('active'); p.hidden = true; });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      const panel = document.getElementById(tab + '-panel');
      panel?.classList.add('active');
      panel && (panel.hidden = false);
    });
  });

  // --- 重新整理全部 ---
  document.getElementById('refresh-all')?.addEventListener('click', () => {
    loadSkills();
    loadMcpServers();
    loadPlugins();
  });

  // ============================================
  // Skills 管理
  // ============================================
  const skillsList = document.getElementById('skills-list');
  const skillsSearch = document.getElementById('skills-search');
  const skillsSourceFilter = document.getElementById('skills-source-filter');
  const skillsCount = document.getElementById('skills-count');
  let allSkills = [];

  async function loadSkills() {
    try {
      const data = await fetchJson(API_BASE + '/skills');
      allSkills = data.skills || [];
      renderSkills();
    } catch (err) {
      skillsList.innerHTML = '<p class="error">載入失敗：' + err.message + '</p>';
    }
  }

  function renderSkills() {
    const query = normalize(skillsSearch.value).toLowerCase();
    const source = skillsSourceFilter.value;
    const visible = allSkills.filter(s => {
      if (source && s.source !== source) return false;
      if (!query) return true;
      return [s.name, s.description].some(v => normalize(v).toLowerCase().includes(query));
    });

    skillsCount.textContent = String(allSkills.length);

    if (!visible.length) {
      skillsList.innerHTML = '<p class="empty">找不到符合條件的 skill。</p>';
      return;
    }

    skillsList.innerHTML = visible.map(skill => (
      '<article class="entity-item" data-name="' + skill.name + '" data-source="' + skill.source + '">' +
        '<div class="entity-main">' +
          '<header class="entity-header">' +
            '<strong class="entity-name">' + skill.name + '</strong>' +
            '<span class="entity-source source-' + skill.source + '">' + skill.source + '</span>' +
          '</header>' +
          '<p class="entity-description">' + (skill.description || '(無描述)') + '</p>' +
          '<div class="entity-meta">' +
            '<code>' + skill.path + '</code>' +
            (skill.version ? '<span>v' + skill.version + '</span>' : '') +
          '</div>' +
        '</div>' +
        '<div class="entity-actions">' +
          '<button class="btn-icon edit-skill" data-name="' + skill.name + '" title="編輯">✏️</button>' +
          '<button class="btn-icon run-skill" data-name="' + skill.name + '" title="執行">▶️</button>' +
          '<button class="btn-icon export-skill" data-name="' + skill.name + '" title="匯出">📤</button>' +
          '<button class="btn-icon delete-skill danger" data-name="' + skill.name + '" title="刪除">🗑️</button>' +
        '</div>' +
      '</article>'
    )).join('');

    skillsList.querySelectorAll('.edit-skill').forEach(btn => {
      btn.addEventListener('click', () => openSkillModal(btn.dataset.name));
    });
    skillsList.querySelectorAll('.run-skill').forEach(btn => {
      btn.addEventListener('click', () => runSkill(btn.dataset.name));
    });
    skillsList.querySelectorAll('.export-skill').forEach(btn => {
      btn.addEventListener('click', () => exportSkill(btn.dataset.name));
    });
    skillsList.querySelectorAll('.delete-skill').forEach(btn => {
      btn.addEventListener('click', () => deleteSkill(btn.dataset.name));
    });
  }

  skillsSearch.addEventListener('input', renderSkills);
  skillsSourceFilter.addEventListener('change', renderSkills);

  // --- Skill Modal ---
  const skillModal = document.createElement('div');
  skillModal.className = 'modal';
  skillModal.innerHTML = '' +
    '<div class="modal-backdrop"></div>' +
    '<div class="modal-content">' +
      '<header class="modal-header">' +
        '<h3 id="skill-modal-title">新增 Skill</h3>' +
        '<button class="modal-close" aria-label="關閉">×</button>' +
      '</header>' +
      '<form id="skill-form" class="modal-body">' +
        '<input type="hidden" name="originalName" />' +
        '<div class="form-field">' +
          '<label>名稱 <span class="required">*</span></label>' +
          '<input type="text" name="name" required placeholder="my-skill" />' +
        '</div>' +
        '<div class="form-field">' +
          '<label>描述 <span class="required">*</span></label>' +
          '<textarea name="description" required rows="3" placeholder="說明這個 skill 的用途..."></textarea>' +
        '</div>' +
        '<div class="form-field">' +
          '<label>內容 <span class="required">*</span></label>' +
          '<textarea name="content" required rows="15" placeholder="完整的 SKILL.md 內容..."></textarea>' +
        '</div>' +
        '<div class="modal-footer">' +
          '<button type="button" class="btn-secondary modal-cancel">取消</button>' +
          '<button type="submit" class="btn">儲存</button>' +
        '</div>' +
      '</form>' +
    '</div>';
  document.body.appendChild(skillModal);

  const skillForm = skillModal.querySelector('#skill-form');
  const skillModalTitle = skillModal.querySelector('#skill-modal-title');
  let currentSkillName = null;

  function openSkillModal(name) {
    currentSkillName = name || null;
    skillModalTitle.textContent = name ? '編輯 Skill' : '新增 Skill';
    skillForm.reset();
    skillModal.querySelector('[name="originalName"]').value = name || '';

    if (name) {
      const skill = allSkills.find(s => s.name === name);
      if (skill) {
        skillForm.querySelector('[name="name"]').value = skill.name;
        skillForm.querySelector('[name="description"]').value = skill.description;
        skillForm.querySelector('[name="content"]').value = skill.content;
      }
    }
    skillModal.classList.add('open');
  }

  function closeSkillModal() {
    skillModal.classList.remove('open');
    currentSkillName = null;
  }

  skillModal.querySelector('.modal-close')?.addEventListener('click', closeSkillModal);
  skillModal.querySelector('.modal-cancel')?.addEventListener('click', closeSkillModal);
  skillModal.querySelector('.modal-backdrop')?.addEventListener('click', closeSkillModal);

  skillForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(skillForm);
    const name = normalize(formData.get('name'));
    const description = normalize(formData.get('description'));
    const content = normalize(formData.get('content'));
    const originalName = normalize(formData.get('originalName'));

    if (!name || !description || !content) {
      showToast('請填寫所有必填欄位', 'error');
      return;
    }

    try {
      if (originalName) {
        await fetchJson(API_BASE + '/skills/' + encodeURIComponent(originalName), {
          method: 'PUT',
          body: JSON.stringify({ description, content }),
        });
        showToast('Skill 已更新');
      } else {
        await fetchJson(API_BASE + '/skills', {
          method: 'POST',
          body: JSON.stringify({ name, description, content }),
        });
        showToast('Skill 已建立');
      }
      closeSkillModal();
      loadSkills();
    } catch (err) {
      showToast('操作失敗：' + err.message, 'error');
    }
  });

  async function runSkill(name) {
    showToast('執行 skill: ' + name + ' (功能待實作)');
  }

  async function exportSkill(name) {
    try {
      const data = await fetchJson(API_BASE + '/skills/export?name=' + encodeURIComponent(name));
      const blob = new Blob([JSON.stringify(data.skill, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = name + '.json';
      a.click();
      URL.revokeObjectURL(url);
      showToast('已匯出');
    } catch (err) {
      showToast('匯出失敗：' + err.message, 'error');
    }
  }

  async function deleteSkill(name) {
    if (!confirm('確定要刪除 skill "' + name + '" 嗎？')) return;
    try {
      await fetchJson(API_BASE + '/skills/' + encodeURIComponent(name), { method: 'DELETE' });
      showToast('已刪除');
      loadSkills();
    } catch (err) {
      showToast('刪除失敗：' + err.message, 'error');
    }
  }

  document.getElementById('create-skill')?.addEventListener('click', () => openSkillModal());
  document.getElementById('import-skills')?.addEventListener('click', () => openImportSkillsModal());
  document.getElementById('export-skills')?.addEventListener('click', () => exportAllSkills());

  // --- Import/Export Skills Modals ---
  const importSkillsModal = document.createElement('div');
  importSkillsModal.className = 'modal';
  importSkillsModal.innerHTML = '' +
    '<div class="modal-backdrop"></div>' +
    '<div class="modal-content">' +
      '<header class="modal-header">' +
        '<h3>匯入 Skills</h3>' +
        '<button class="modal-close" aria-label="關閉">×</button>' +
      '</header>' +
      '<form id="import-skills-form" class="modal-body">' +
        '<div class="form-field">' +
          '<label>JSON 檔案內容 <span class="required">*</span></label>' +
          '<textarea name="json" required rows="15" placeholder=\'[{"name": "skill1", "description": "desc", "content": "---..."}, ...]\'></textarea>' +
        '</div>' +
        '<div class="form-field">' +
          '<label>' +
            '<input type="checkbox" name="overwrite" /> 覆蓋同名 skill' +
          '</label>' +
        '</div>' +
        '<div class="modal-footer">' +
          '<button type="button" class="btn-secondary modal-cancel">取消</button>' +
          '<button type="submit" class="btn">匯入</button>' +
        '</div>' +
      '</form>' +
    '</div>';
  document.body.appendChild(importSkillsModal);

  const importSkillsForm = importSkillsModal.querySelector('#import-skills-form');
  importSkillsModal.querySelector('.modal-close')?.addEventListener('click', () => importSkillsModal.classList.remove('open'));
  importSkillsModal.querySelector('.modal-cancel')?.addEventListener('click', () => importSkillsModal.classList.remove('open'));
  importSkillsModal.querySelector('.modal-backdrop')?.addEventListener('click', () => importSkillsModal.classList.remove('open'));

  function openImportSkillsModal() {
    importSkillsForm.reset();
    importSkillsModal.classList.add('open');
  }

  importSkillsForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(importSkillsForm);
    let skills;
    try {
      skills = JSON.parse(formData.get('json'));
    } catch (err) {
      showToast('JSON 格式錯誤：' + err.message, 'error');
      return;
    }
    if (!Array.isArray(skills)) {
      showToast('JSON 必須是陣列格式', 'error');
      return;
    }
    const overwrite = formData.get('overwrite') === 'on';
    try {
      const data = await fetchJson(API_BASE + '/skills/import', {
        method: 'POST',
        body: JSON.stringify({ skills, overwrite }),
      });
      showToast('匯入完成：建立 ' + data.created + ' 個，更新 ' + data.updated + ' 個');
      importSkillsModal.classList.remove('open');
      loadSkills();
    } catch (err) {
      showToast('匯入失敗：' + err.message, 'error');
    }
  });

  async function exportAllSkills() {
    try {
      const data = await fetchJson(API_BASE + '/skills/export');
      const blob = new Blob([JSON.stringify(data.skills, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'skills-' + new Date().toISOString().slice(0, 10) + '.json';
      a.click();
      URL.revokeObjectURL(url);
      showToast('已匯出 ' + data.skills.length + ' 個 skills');
    } catch (err) {
      showToast('匯出失敗：' + err.message, 'error');
    }
  }

  // ============================================
  // MCP Servers 管理
  // ============================================
  const mcpList = document.getElementById('mcp-servers-list');
  const mcpSearch = document.getElementById('mcp-search');
  const mcpEnabledFilter = document.getElementById('mcp-enabled-filter');
  const mcpCount = document.getElementById('mcp-count');
  let allMcpServers = [];

  async function loadMcpServers() {
    try {
      const data = await fetchJson(API_BASE + '/mcp-servers');
      allMcpServers = data.servers || [];
      renderMcpServers();
    } catch (err) {
      mcpList.innerHTML = '<p class="error">載入失敗：' + err.message + '</p>';
    }
  }

  function renderMcpServers() {
    const query = normalize(mcpSearch.value).toLowerCase();
    const enabled = mcpEnabledFilter.value;
    const visible = allMcpServers.filter(s => {
      if (enabled && s.enabled !== (enabled === 'true')) return false;
      if (!query) return true;
      return [s.name, s.description].some(v => normalize(v).toLowerCase().includes(query));
    });

    mcpCount.textContent = String(allMcpServers.length);

    if (!visible.length) {
      mcpList.innerHTML = '<p class="empty">找不到符合條件的 MCP Server。</p>';
      return;
    }

    mcpList.innerHTML = visible.map(server => (
      '<article class="entity-item" data-name="' + server.name + '">' +
        '<div class="entity-main">' +
          '<header class="entity-header">' +
            '<strong class="entity-name">' + server.name + '</strong>' +
            '<span class="entity-status ' + (server.enabled ? 'enabled' : 'disabled') + '">' + (server.enabled ? '已啟用' : '已停用') + '</span>' +
          '</header>' +
          '<p class="entity-description">' + (server.description || '(無描述)') + '</p>' +
          '<div class="entity-meta">' +
            '<span class="badge">' + server.type + '</span>' +
            (server.command ? '<code>' + server.command + '</code>' : '') +
            (server.url ? '<code>' + server.url + '</code>' : '') +
          '</div>' +
        '</div>' +
        '<div class="entity-actions">' +
          '<button class="btn-icon edit-mcp" data-name="' + server.name + '" title="編輯">✏️</button>' +
          '<button class="btn-icon toggle-mcp" data-name="' + server.name + '" title="' + (server.enabled ? '停用' : '啟用') + '">' + (server.enabled ? '⏸️' : '▶️') + '</button>' +
          '<button class="btn-icon test-mcp" data-name="' + server.name + '" title="測試連線">🔍</button>' +
          '<button class="btn-icon delete-mcp danger" data-name="' + server.name + '" title="刪除">🗑️</button>' +
        '</div>' +
      '</article>'
    )).join('');

    mcpList.querySelectorAll('.edit-mcp').forEach(btn => btn.addEventListener('click', () => openMcpModal(btn.dataset.name)));
    mcpList.querySelectorAll('.toggle-mcp').forEach(btn => btn.addEventListener('click', () => toggleMcp(btn.dataset.name)));
    mcpList.querySelectorAll('.test-mcp').forEach(btn => btn.addEventListener('click', () => testMcp(btn.dataset.name)));
    mcpList.querySelectorAll('.delete-mcp').forEach(btn => btn.addEventListener('click', () => deleteMcp(btn.dataset.name)));
  }

  mcpSearch.addEventListener('input', renderMcpServers);
  mcpEnabledFilter.addEventListener('change', renderMcpServers);

  // --- MCP Modal ---
  const mcpModal = document.createElement('div');
  mcpModal.className = 'modal';
  mcpModal.innerHTML = '' +
    '<div class="modal-backdrop"></div>' +
    '<div class="modal-content">' +
      '<header class="modal-header">' +
        '<h3 id="mcp-modal-title">新增 MCP Server</h3>' +
        '<button class="modal-close" aria-label="關閉">×</button>' +
      '</header>' +
      '<form id="mcp-form" class="modal-body">' +
        '<input type="hidden" name="originalName" />' +
        '<div class="form-field">' +
          '<label>名稱 <span class="required">*</span></label>' +
          '<input type="text" name="name" required placeholder="github" />' +
        '</div>' +
        '<div class="form-field">' +
          '<label>描述</label>' +
          '<textarea name="description" rows="2" placeholder="GitHub 官方 MCP Server"></textarea>' +
        '</div>' +
        '<div class="form-field">' +
          '<label>類型 <span class="required">*</span></label>' +
          '<select name="type" required>' +
            '<option value="stdio">stdio (本地執行)</option>' +
            '<option value="http">HTTP (遠端)</option>' +
            '<option value="sse">SSE (遠端串流)</option>' +
          '</select>' +
        '</div>' +
        '<div class="form-field" id="mcp-command-field">' +
          '<label>執行命令</label>' +
          '<input type="text" name="command" placeholder="npx -y @modelcontextprotocol/server-github" />' +
        '</div>' +
        '<div class="form-field" id="mcp-url-field" style="display:none">' +
          '<label>URL</label>' +
          '<input type="url" name="url" placeholder="https://api.example.com/mcp" />' +
        '</div>' +
        '<div class="form-field">' +
          '<label>環境變數 (JSON)</label>' +
          '<textarea name="env" rows="4" placeholder=\'{"GITHUB_TOKEN": "xxx"}\'></textarea>' +
        '</div>' +
        '<div class="form-field">' +
          '<label>可用工具 (JSON 陣列)</label>' +
          '<textarea name="tools" rows="3" placeholder=\'["repos", "issues", "pull_requests"]\'></textarea>' +
        '</div>' +
        '<div class="modal-footer">' +
          '<button type="button" class="btn-secondary modal-cancel">取消</button>' +
          '<button type="submit" class="btn">儲存</button>' +
        '</div>' +
      '</form>' +
    '</div>';
  document.body.appendChild(mcpModal);

  const mcpForm = mcpModal.querySelector('#mcp-form');
  const mcpModalTitle = mcpModal.querySelector('#mcp-modal-title');
  let currentMcpName = null;

  const mcpTypeSelect = mcpForm.querySelector('[name="type"]');
  const mcpCommandField = mcpForm.querySelector('#mcp-command-field');
  const mcpUrlField = mcpForm.querySelector('#mcp-url-field');

  mcpTypeSelect.addEventListener('change', () => {
    const type = mcpTypeSelect.value;
    mcpCommandField.style.display = type === 'stdio' ? 'block' : 'none';
    mcpUrlField.style.display = type === 'http' || type === 'sse' ? 'block' : 'none';
  });

  function openMcpModal(name) {
    currentMcpName = name || null;
    mcpModalTitle.textContent = name ? '編輯 MCP Server' : '新增 MCP Server';
    mcpForm.reset();
    mcpForm.querySelector('[name="originalName"]').value = name || '';

    if (name) {
      const server = allMcpServers.find(s => s.name === name);
      if (server) {
        mcpForm.querySelector('[name="name"]').value = server.name;
        mcpForm.querySelector('[name="description"]').value = server.description || '';
        mcpForm.querySelector('[name="type"]').value = server.type;
        mcpForm.querySelector('[name="command"]').value = server.command || '';
        mcpForm.querySelector('[name="url"]').value = server.url || '';
        mcpForm.querySelector('[name="env"]').value = server.env || '';
        mcpForm.querySelector('[name="tools"]').value = server.tools || '';
        mcpTypeSelect.dispatchEvent(new Event('change'));
      }
    }
    mcpModal.classList.add('open');
  }

  function closeMcpModal() {
    mcpModal.classList.remove('open');
    currentMcpName = null;
  }

  mcpModal.querySelector('.modal-close')?.addEventListener('click', closeMcpModal);
  mcpModal.querySelector('.modal-cancel')?.addEventListener('click', closeMcpModal);
  mcpModal.querySelector('.modal-backdrop')?.addEventListener('click', closeMcpModal);

  mcpForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(mcpForm);
    const name = normalize(formData.get('name'));
    const originalName = normalize(formData.get('originalName'));

    const body = {
      description: normalize(formData.get('description')) || null,
      type: formData.get('type'),
      command: normalize(formData.get('command')) || null,
      url: normalize(formData.get('url')) || null,
      env: normalize(formData.get('env')) || null,
      tools: normalize(formData.get('tools')) || null,
    };

    try {
      if (originalName) {
        await fetchJson(API_BASE + '/mcp-servers/' + encodeURIComponent(originalName), {
          method: 'PUT',
          body: JSON.stringify(body),
        });
        showToast('MCP Server 已更新');
      } else {
        await fetchJson(API_BASE + '/mcp-servers', {
          method: 'POST',
          body: JSON.stringify({ name, ...body, enabled: true }),
        });
        showToast('MCP Server 已建立');
      }
      closeMcpModal();
      loadMcpServers();
    } catch (err) {
      showToast('操作失敗：' + err.message, 'error');
    }
  });

  async function toggleMcp(name) {
    try {
      await fetchJson(API_BASE + '/mcp-servers/' + encodeURIComponent(name), { method: 'PATCH' });
      showToast('狀態已切換');
      loadMcpServers();
    } catch (err) {
      showToast('切換失敗：' + err.message, 'error');
    }
  }

  async function testMcp(name) {
    showToast('測試連線: ' + name + ' (功能待實作)');
  }

  async function deleteMcp(name) {
    if (!confirm('確定要刪除 MCP Server "' + name + '" 嗎？')) return;
    try {
      await fetchJson(API_BASE + '/mcp-servers/' + encodeURIComponent(name), { method: 'DELETE' });
      showToast('已刪除');
      loadMcpServers();
    } catch (err) {
      showToast('刪除失敗：' + err.message, 'error');
    }
  }

  document.getElementById('create-mcp-server')?.addEventListener('click', () => openMcpModal());

  // ============================================
  // Plugins 管理
  // ============================================
  const pluginsList = document.getElementById('plugins-list');
  const pluginsSearch = document.getElementById('plugins-search');
  const pluginsCount = document.getElementById('plugins-count');
  let allPlugins = [];

  async function loadPlugins() {
    try {
      const data = await fetchJson(API_BASE + '/plugins');
      allPlugins = data.plugins || [];
      renderPlugins();
    } catch (err) {
      pluginsList.innerHTML = '<p class="error">載入失敗：' + err.message + '</p>';
    }
  }

  function renderPlugins() {
    const query = normalize(pluginsSearch.value).toLowerCase();
    const visible = allPlugins.filter(p => {
      if (!query) return true;
      return [p.name, p.description].some(v => normalize(v).toLowerCase().includes(query));
    });

    pluginsCount.textContent = String(allPlugins.length);

    if (!visible.length) {
      pluginsList.innerHTML = '<p class="empty">找不到符合條件的 plugin。</p>';
      return;
    }

    pluginsList.innerHTML = visible.map(plugin => (
      '<article class="entity-item" data-name="' + plugin.name + '">' +
        '<div class="entity-main">' +
          '<header class="entity-header">' +
            '<strong class="entity-name">' + plugin.name + '</strong>' +
            '<span class="entity-version">' + (plugin.version || 'v1.0') + '</span>' +
          '</header>' +
          '<p class="entity-description">' + (plugin.description || '(無描述)') + '</p>' +
          '<div class="entity-meta">' +
            (plugin.author ? '<span>作者: ' + plugin.author + '</span>' : '') +
            (plugin.source_url ? '<a href="' + plugin.source_url + '" target="_blank" class="external-link">來源</a>' : '') +
            '<span>安裝於: ' + formatDate(plugin.installed_at) + '</span>' +
          '</div>' +
        '</div>' +
        '<div class="entity-actions">' +
          '<button class="btn-icon edit-plugin" data-name="' + plugin.name + '" title="編輯">✏️</button>' +
          '<button class="btn-icon uninstall-plugin danger" data-name="' + plugin.name + '" title="卸載">🗑️</button>' +
        '</div>' +
      '</article>'
    )).join('');

    pluginsList.querySelectorAll('.edit-plugin').forEach(btn => btn.addEventListener('click', () => openPluginModal(btn.dataset.name)));
    pluginsList.querySelectorAll('.uninstall-plugin').forEach(btn => btn.addEventListener('click', () => uninstallPlugin(btn.dataset.name)));
  }

  pluginsSearch.addEventListener('input', renderPlugins);

  // --- Plugin Modal ---
  const pluginModal = document.createElement('div');
  pluginModal.className = 'modal';
  pluginModal.innerHTML = '' +
    '<div class="modal-backdrop"></div>' +
    '<div class="modal-content">' +
      '<header class="modal-header">' +
        '<h3 id="plugin-modal-title">安裝 Plugin</h3>' +
        '<button class="modal-close" aria-label="關閉">×</button>' +
      '</header>' +
      '<form id="plugin-form" class="modal-body">' +
        '<input type="hidden" name="originalName" />' +
        '<div class="form-field">' +
          '<label>名稱 <span class="required">*</span></label>' +
          '<input type="text" name="name" required placeholder="agent-skills" />' +
        '</div>' +
        '<div class="form-field">' +
          '<label>描述</label>' +
          '<textarea name="description" rows="2" placeholder="包含 24 個工程技能"></textarea>' +
        '</div>' +
        '<div class="form-field">' +
          '<label>版本</label>' +
          '<input type="text" name="version" placeholder="1.0.0" />' +
        '</div>' +
        '<div class="form-field">' +
          '<label>作者</label>' +
          '<input type="text" name="author" placeholder="addyosmani" />' +
        '</div>' +
        '<div class="form-field">' +
          '<label>來源 URL</label>' +
          '<input type="url" name="source_url" placeholder="https://github.com/..." />' +
        '</div>' +
        '<div class="form-field">' +
          '<label>包含的 Skills (JSON 陣列)</label>' +
          '<textarea name="skills" rows="3" placeholder=\'["post", "deep-research", "code-review"]\'></textarea>' +
        '</div>' +
        '<div class="form-field">' +
          '<label>包含的 MCP Servers (JSON 陣列)</label>' +
          '<textarea name="mcp_servers" rows="3" placeholder=\'["github", "notion"]\'></textarea>' +
        '</div>' +
        '<div class="modal-footer">' +
          '<button type="button" class="btn-secondary modal-cancel">取消</button>' +
          '<button type="submit" class="btn">安裝</button>' +
        '</div>' +
      '</form>' +
    '</div>';
  document.body.appendChild(pluginModal);

  const pluginForm = pluginModal.querySelector('#plugin-form');
  const pluginModalTitle = pluginModal.querySelector('#plugin-modal-title');

  function openPluginModal(name) {
    pluginModalTitle.textContent = name ? '編輯 Plugin' : '安裝 Plugin';
    pluginForm.reset();
    pluginForm.querySelector('[name="originalName"]').value = name || '';

    if (name) {
      const plugin = allPlugins.find(p => p.name === name);
      if (plugin) {
        pluginForm.querySelector('[name="name"]').value = plugin.name;
        pluginForm.querySelector('[name="description"]').value = plugin.description || '';
        pluginForm.querySelector('[name="version"]').value = plugin.version || '';
        pluginForm.querySelector('[name="author"]').value = plugin.author || '';
        pluginForm.querySelector('[name="source_url"]').value = plugin.source_url || '';
        pluginForm.querySelector('[name="skills"]').value = plugin.skills || '';
        pluginForm.querySelector('[name="mcp_servers"]').value = plugin.mcp_servers || '';
      }
    }
    pluginModal.classList.add('open');
  }

  function closePluginModal() {
    pluginModal.classList.remove('open');
  }

  pluginModal.querySelector('.modal-close')?.addEventListener('click', closePluginModal);
  pluginModal.querySelector('.modal-cancel')?.addEventListener('click', closePluginModal);
  pluginModal.querySelector('.modal-backdrop')?.addEventListener('click', closePluginModal);

  pluginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(pluginForm);
    const name = normalize(formData.get('name'));
    const originalName = normalize(formData.get('originalName'));

    const body = {
      description: normalize(formData.get('description')) || null,
      version: normalize(formData.get('version')) || null,
      author: normalize(formData.get('author')) || null,
      source_url: normalize(formData.get('source_url')) || null,
      skills: normalize(formData.get('skills')) || null,
      mcp_servers: normalize(formData.get('mcp_servers')) || null,
    };

    try {
      if (originalName) {
        await fetchJson(API_BASE + '/plugins/' + encodeURIComponent(originalName), {
          method: 'PUT',
          body: JSON.stringify(body),
        });
        showToast('Plugin 已更新');
      } else {
        await fetchJson(API_BASE + '/plugins', {
          method: 'POST',
          body: JSON.stringify({ name, ...body }),
        });
        showToast('Plugin 已安裝');
      }
      closePluginModal();
      loadPlugins();
    } catch (err) {
      showToast('操作失敗：' + err.message, 'error');
    }
  });

  async function uninstallPlugin(name) {
    if (!confirm('確定要卸載 plugin "' + name + '" 嗎？')) return;
    try {
      await fetchJson(API_BASE + '/plugins/' + encodeURIComponent(name), { method: 'DELETE' });
      showToast('已卸載');
      loadPlugins();
    } catch (err) {
      showToast('卸載失敗：' + err.message, 'error');
    }
  }

  document.getElementById('create-plugin')?.addEventListener('click', () => openPluginModal());

  // --- 初始化 ---
  loadSkills();
  loadMcpServers();
  loadPlugins();
</script>

