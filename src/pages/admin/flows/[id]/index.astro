---
// NOTE: This file is a copy of flows/[id].astro created to allow flows/[id]/edit.astro
// to coexist in Astro's routing. The original flows/[id].astro should be removed once
// this copy is confirmed working.
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import '@/styles/globals.css';
import AdminState from '@/components/admin/AdminState.astro';
import FlowVersionList from '@/components/admin/console/FlowVersionList.astro';
import FlowPresetList from '@/components/admin/console/FlowPresetList.astro';
import RunsTable from '@/components/admin/console/RunsTable.astro';
import { getEnv } from '@/lib/config/env';
import { loadFlowDetail, type FlowDetail } from '@/lib/console/flow-detail';
import { consoleHref, createConsoleTranslator, getConsoleLang } from '@/lib/console/admin/i18n';
import { ensureConsoleUmbrella } from '../../_guard';

export const prerender = false;

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const flowId = Astro.params.id ?? '';
const lang = getConsoleLang(Astro.url);
const t = createConsoleTranslator(lang);

let detail: FlowDetail | null = null;
let loadError = false;
if (flowId) {
  try {
    detail = await loadFlowDetail(getEnv().DB, flowId);
  } catch {
    loadError = true;
  }
}

const currentYaml = detail?.versions[0]?.yaml ?? '';
const breadcrumb = [
  { label: t('flows.title'), href: consoleHref('/admin/flows', lang) },
  { label: detail?.definition.name ?? flowId },
];
---

<AdminV2Layout title={t('flows.detailTitle')} section="flows" breadcrumb={breadcrumb}>
  {loadError && <AdminState tone="error">{t('flows.loadError')}</AdminState>}
  {!loadError && !detail && <AdminState tone="empty">{t('flows.notFound', { id: flowId })}</AdminState>}
  {detail && (
    <div class="grid gap-6">
      <header>
        <h2 class="text-xl font-bold">{detail.definition.name} <code class="text-sm text-muted-foreground">{detail.definition.id}</code></h2>
        {detail.definition.description && <p class="mt-1 text-sm text-muted-foreground">{detail.definition.description}</p>}
        <div class="mt-3 flex gap-2">
          <a href={consoleHref(`/admin/flows/${flowId}/edit`, lang)} class="inline-block rounded-md border border-border bg-card px-3 py-1.5 text-sm font-semibold transition-colors hover:border-primary hover:text-primary">{t('common.edit')}</a>
          <button
            type="button"
            class="inline-block rounded-md border border-destructive/40 bg-destructive/5 px-3 py-1.5 text-sm font-semibold text-destructive transition-colors hover:border-destructive hover:bg-destructive/10"
            id="archive-flow-btn"
            data-flow-id={flowId}
            data-confirm={t('flows.archiveConfirm', { id: flowId })}
          >{t('flows.archiveFlow')}</button>
        </div>
      </header>

      <section aria-label="Current definition">
        <h3 class="mb-2 text-[0.95rem] font-semibold">{t('flows.currentYaml', { version: detail.definition.version })}</h3>
        <pre class="m-0 max-h-[420px] overflow-auto rounded-lg border border-border bg-background p-3 font-mono text-[0.8rem]">{currentYaml || t('flows.noYaml')}</pre>
      </section>

      <section aria-label="Inputs">
        <h3 class="mb-2 text-[0.95rem] font-semibold">{t('flows.inputs')}</h3>
        {detail.definition.inputs.length === 0 ? (
          <p class="text-sm text-muted-foreground">{t('flows.noInputs')}</p>
        ) : (
          <ul class="m-0 grid list-none gap-1 p-0">
            {detail.definition.inputs.map((input) => (
              <li>
                <code>{input.name}</code> <span class="text-sm text-muted-foreground">{input.type}{input.required ? ` · ${t('flows.required')}` : ''}</span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section aria-label="Versions">
        <h3 class="mb-2 text-[0.95rem] font-semibold">{t('flows.versions')}</h3>
        <FlowVersionList versions={detail.versions} latestVersion={detail.definition.version} />
      </section>

      <section aria-label="Presets">
        <h3 class="mb-2 text-[0.95rem] font-semibold">{t('flows.presets')}</h3>
        <FlowPresetList presets={detail.presets} />
      </section>

      <section aria-label="Recent runs">
        <h3 class="mb-2 text-[0.95rem] font-semibold">{t('flows.recentRuns')}</h3>
        {detail.recentRuns.length === 0 ? (
          <p class="text-sm text-muted-foreground">{t('flows.noRuns')}</p>
        ) : (
          <RunsTable runs={detail.recentRuns} />
        )}
      </section>
    </div>
  )}
</AdminV2Layout>

<script define:vars={{ lang, archiveFailed: t('flows.archiveFailed') }}>
  const archiveButton = document.getElementById('archive-flow-btn');
  archiveButton?.addEventListener('click', async () => {
    const flowId = archiveButton.getAttribute('data-flow-id');
    const message = archiveButton.getAttribute('data-confirm') ?? '';
    if (!flowId || !window.confirm(message)) return;

    archiveButton.setAttribute('disabled', 'true');
    try {
      const response = await fetch(`/api/admin/flows/${encodeURIComponent(flowId)}`, {
        method: 'DELETE',
      });
      if (!response.ok) throw new Error(await response.text());
      window.location.href = lang === 'en' ? '/admin/flows?lang=en' : '/admin/flows';
    } catch (error) {
      window.alert(`${archiveFailed}: ${error instanceof Error ? error.message : String(error)}`);
      archiveButton.removeAttribute('disabled');
    }
  });
</script>

