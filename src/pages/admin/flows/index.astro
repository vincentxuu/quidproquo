---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import AdminState from '@/components/admin/AdminState.astro';
import { getEnv } from '@/lib/config/env';
import { ensureConsoleBootstrap } from '@/lib/console/bootstrap';
import { consoleHref, createConsoleTranslator, getConsoleLang } from '@/lib/console/admin/i18n';
import { ensureConsoleUmbrella } from '../_guard';
import '@/styles/globals.css';

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const PAGE_SIZE = 25;

const url = new URL(Astro.url);
const lang = getConsoleLang(url);
const t = createConsoleTranslator(lang);
const pageRaw = Number.parseInt(url.searchParams.get('page') ?? '1', 10);
const page = Number.isFinite(pageRaw) && pageRaw > 0 ? pageRaw : 1;
const offset = (page - 1) * PAGE_SIZE;
const q = url.searchParams.get('q')?.trim() ?? '';

interface FlowRow {
  flow_id: string;
  display_name: string | null;
  current_version: number | null;
  category: string;
  updated_at: number | null;
}

interface CountRow {
  total: number;
}

let flows: FlowRow[] = [];
let loadError = false;
let totalCount = 0;

try {
  const env = getEnv();
  await ensureConsoleBootstrap(env);
  const db = env.DB;
  const where = q
    ? `WHERE fd.flow_id LIKE ? OR fd.display_name LIKE ? OR CAST(fd.current_version AS TEXT) LIKE ?`
    : '';

  if (q) {
    const like = `%${q}%`;
    const countResult = await db
      .prepare(
        `SELECT COUNT(*) as total
         FROM flow_definitions fd
         ${where}`,
      )
      .bind(like, like, like)
      .first<CountRow>();
    totalCount = countResult?.total ?? 0;

    const result = await db
      .prepare(
        `SELECT fd.flow_id,
                fd.display_name,
                fd.current_version,
                fd.description,
                fd.updated_at,
                CASE
                  WHEN INSTR(fd.flow_id, '-') > 0 THEN SUBSTR(fd.flow_id, 1, INSTR(fd.flow_id, '-') - 1)
                  WHEN INSTR(fd.flow_id, '_') > 0 THEN SUBSTR(fd.flow_id, 1, INSTR(fd.flow_id, '_') - 1)
                  ELSE 'general'
                END AS category
         FROM flow_definitions fd
         ${where}
         ORDER BY updated_at DESC
         LIMIT ? OFFSET ?`,
      )
      .bind(like, like, like, PAGE_SIZE, offset)
      .all<FlowRow>();
    flows = result.results ?? [];
  } else {
    const countResult = await db
      .prepare(`SELECT COUNT(*) as total FROM flow_definitions`)
      .first<CountRow>();
    totalCount = countResult?.total ?? 0;

    const result = await db
      .prepare(
        `SELECT fd.flow_id,
                fd.display_name,
                fd.current_version,
                fd.description,
                fd.updated_at,
                CASE
                  WHEN INSTR(fd.flow_id, '-') > 0 THEN SUBSTR(fd.flow_id, 1, INSTR(fd.flow_id, '-') - 1)
                  WHEN INSTR(fd.flow_id, '_') > 0 THEN SUBSTR(fd.flow_id, 1, INSTR(fd.flow_id, '_') - 1)
                  ELSE 'general'
                END AS category
         FROM flow_definitions fd
         ORDER BY fd.updated_at DESC
         LIMIT ? OFFSET ?`,
      )
      .bind(PAGE_SIZE, offset)
      .all<FlowRow>();
    flows = result.results ?? [];
  }
} catch {
  loadError = true;
}

function formatTs(ms: number | null): string {
  if (!ms) return '—';
  return new Date(ms).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
}

const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));

function listHref(p: number): string {
  const u = new URL(Astro.url);
  if (p <= 1) {
    u.searchParams.delete('page');
  } else {
    u.searchParams.set('page', String(p));
  }
  return u.pathname + u.search;
}

function categoryLabel(category: string): string {
  if (!category) return 'general';
  return category.replace(/-/g, ' ').replace(/\b\w/g, (ch) => ch.toUpperCase());
}
---

<AdminV2Layout title={t('flows.title')} section="flows">
  {loadError && (
    <AdminState tone="error">{t('flows.loadError')}</AdminState>
  )}
  {!loadError && (
    <div class="rounded-lg border border-border bg-card p-4 shadow-sm">
      <form class="mb-4 flex flex-wrap items-center gap-2" method="GET" action={consoleHref('/admin/flows', lang)}>
        {lang === 'en' && <input type="hidden" name="lang" value="en" />}
        <label for="q" class="text-sm text-muted-foreground">{t('flows.searchLabel')}</label>
        <input
          id="q"
          name="q"
          type="search"
          value={q}
          class="min-w-[200px] rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/20"
          placeholder={t('flows.searchPlaceholder')}
        />
        <button type="submit" class="rounded-md border border-input bg-background px-3 py-1.5 text-xs font-medium hover:bg-accent">{t('common.search')}</button>
        {q && <a href={consoleHref('/admin/flows', lang)} class="rounded-md border border-input bg-background px-3 py-1.5 text-xs font-medium hover:bg-accent no-underline text-foreground">{t('common.clear')}</a>}
        <a href={consoleHref('/admin/flows/new', lang)} class="rounded-md bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground no-underline hover:bg-primary/90">{t('flows.newFlow')}</a>
      </form>
    </div>
  )}

  {!loadError && flows.length === 0 && (
    <AdminState tone="empty">
      {q ? t('flows.emptySearch', { q }) : t('flows.empty')}
    </AdminState>
  )}

  {!loadError && flows.length > 0 && (
    <div class="mt-4 overflow-x-auto rounded-lg border border-border bg-card shadow-sm">
      <table class="w-full min-w-[640px] border-collapse text-sm">
        <thead>
          <tr class="border-b border-border bg-muted/50">
            <th class="px-3 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">{t('flows.flowId')}</th>
            <th class="px-3 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">{t('common.name')}</th>
            <th class="px-3 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">{t('flows.category')}</th>
            <th class="px-3 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">{t('common.version')}</th>
            <th class="px-3 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">{t('common.updatedAt')}</th>
            <th class="px-3 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">{t('common.actions')}</th>
          </tr>
        </thead>
        <tbody>
          {flows.map((flow) => (
            <tr class="border-b border-border transition-colors hover:bg-muted/30" data-flow-row={flow.flow_id}>
              <td class="px-3 py-2.5 font-mono text-xs">
                <a href={consoleHref(`/admin/flows/${flow.flow_id}`, lang)} class="font-bold text-primary no-underline hover:underline">
                  {flow.flow_id}
                </a>
              </td>
              <td class="max-w-[180px] truncate px-3 py-2.5 text-sm">{flow.display_name ?? flow.flow_id}</td>
              <td class="px-3 py-2.5 text-xs capitalize text-muted-foreground">{categoryLabel(flow.category)}</td>
              <td class="px-3 py-2.5 font-mono text-xs">{flow.current_version ?? '—'}</td>
              <td class="px-3 py-2.5 font-mono text-xs">{formatTs(flow.updated_at)}</td>
              <td class="px-3 py-2.5">
                <div class="flex gap-2">
                  <a href={consoleHref(`/admin/flows/${flow.flow_id}`, lang)} class="text-xs text-primary no-underline hover:underline">{t('common.view')}</a>
                  <a href={consoleHref(`/admin/flows/${flow.flow_id}/edit`, lang)} class="text-xs text-primary no-underline hover:underline">{t('common.edit')}</a>
                  <button
                    type="button"
                    class="border-0 bg-transparent p-0 text-xs text-destructive cursor-pointer hover:underline"
                    data-delete-flow={flow.flow_id}
                    data-confirm={t('flows.archiveConfirm', { id: flow.flow_id })}
                  >{t('common.archive')}</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {totalPages > 1 && (
        <div class="flex flex-wrap items-center gap-2 border-t border-border px-3 py-2.5">
          {page > 1 ? (
            <a href={listHref(1)} class="rounded-md border border-input bg-background px-2.5 py-1 text-xs no-underline text-foreground hover:bg-accent">{t('common.firstPage')}</a>
          ) : (
            <span class="rounded-md border border-input bg-background px-2.5 py-1 text-xs opacity-45">{t('common.firstPage')}</span>
          )}
          {page > 1 ? (
            <a href={listHref(page - 1)} class="rounded-md border border-input bg-background px-2.5 py-1 text-xs no-underline text-foreground hover:bg-accent">{t('common.previousPage')}</a>
          ) : (
            <span class="rounded-md border border-input bg-background px-2.5 py-1 text-xs opacity-45">{t('common.previousPage')}</span>
          )}
          <span class="text-xs text-muted-foreground">{t('common.pageOf', { page, total: totalPages })}</span>
          {page < totalPages ? (
            <a href={listHref(page + 1)} class="rounded-md border border-input bg-background px-2.5 py-1 text-xs no-underline text-foreground hover:bg-accent">{t('common.nextPage')}</a>
          ) : (
            <span class="rounded-md border border-input bg-background px-2.5 py-1 text-xs opacity-45">{t('common.nextPage')}</span>
          )}
        </div>
      )}
    </div>
  )}
</AdminV2Layout>

<script define:vars={{ archiveFailed: t('flows.archiveFailed') }}>
  document.querySelectorAll('[data-delete-flow]').forEach((button) => {
    button.addEventListener('click', async () => {
      const flowId = button.getAttribute('data-delete-flow');
      const message = button.getAttribute('data-confirm') ?? '';
      if (!flowId || !window.confirm(message)) return;

      button.setAttribute('disabled', 'true');
      try {
        const response = await fetch(`/api/admin/flows/${encodeURIComponent(flowId)}`, {
          method: 'DELETE',
        });
        if (!response.ok) throw new Error(await response.text());
        const row = document.querySelector(`[data-flow-row="${CSS.escape(flowId)}"]`);
        row?.remove();
      } catch (error) {
        window.alert(`${archiveFailed}: ${error instanceof Error ? error.message : String(error)}`);
        button.removeAttribute('disabled');
      }
    });
  });
</script>
