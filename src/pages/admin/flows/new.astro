---
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import '@/styles/globals.css';
import { consoleHref, createConsoleTranslator, getConsoleLang } from '@/lib/console/admin/i18n';
import { ensureConsoleUmbrella } from '../_guard';

export const prerender = false;

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const lang = getConsoleLang(Astro.url);
const t = createConsoleTranslator(lang);

const starterYaml = `id: my-new-flow
name: New Flow
version: 1
description: Describe your flow here
inputs:
  - name: topic
    type: string
    required: true
steps:
  - id: start
    type: agent
    agent: planner
    description: Plan from the provided topic.
    input:
      topic: "{{ inputs.topic }}"
edges:
  - from: start
    to: __end__
artifacts: []
`;

const breadcrumb = [
  { label: t('flows.title'), href: consoleHref('/admin/flows', lang) },
  { label: t('flows.newTitle') },
];
---

<AdminV2Layout title={t('flows.newTitle')} section="flows" breadcrumb={breadcrumb}>
    <form id="new-form" autocomplete="off" class="grid items-start gap-4 max-lg:grid-cols-1 lg:grid-cols-[minmax(220px,280px)_minmax(420px,1fr)_minmax(210px,260px)]">
      <section class="sticky top-3 grid gap-4 rounded-lg border border-border bg-card p-4 max-lg:static" aria-labelledby="setup-title">
        <div class="grid gap-1">
          <span class="text-xs font-bold uppercase tracking-wide text-muted-foreground">{t('flows.setup')}</span>
          <h2 id="setup-title" class="m-0 text-base font-bold">{t('flows.setup')}</h2>
        </div>

        <div class="grid gap-1.5">
          <label for="template-select" class="text-sm font-semibold text-muted-foreground">{t('flows.template')}</label>
          <select id="template-select" class="w-full min-h-[34px] rounded-md border border-input bg-background px-2 py-1.5 text-sm">
            <option value="single-agent">Single agent</option>
            <option value="research">Research flow</option>
            <option value="approval">Approval gate</option>
            <option value="blank">Blank flow</option>
          </select>
        </div>

        <div class="grid gap-1.5">
          <label for="flow-id" class="text-sm font-semibold text-muted-foreground">Flow ID <span class="text-xs font-normal text-muted-foreground">{t('flows.idRequired')}</span></label>
          <input id="flow-id" class="w-full min-h-[34px] rounded-md border border-input bg-background px-2 py-1.5 font-mono text-sm" value="my-new-flow" spellcheck={false} />
        </div>

        <div class="grid gap-1.5">
          <label for="flow-name" class="text-sm font-semibold text-muted-foreground">{t('common.name')}</label>
          <input id="flow-name" class="w-full min-h-[34px] rounded-md border border-input bg-background px-2 py-1.5 text-sm" value="New Flow" />
        </div>

        <div class="grid gap-1.5">
          <label for="flow-version" class="text-sm font-semibold text-muted-foreground">{t('common.version')}</label>
          <input id="flow-version" class="w-full min-h-[34px] rounded-md border border-input bg-background px-2 py-1.5 text-sm" type="number" min="1" step="1" value="1" />
        </div>

        <div class="grid gap-1.5">
          <label for="flow-description" class="text-sm font-semibold text-muted-foreground">{t('common.description')}</label>
          <textarea id="flow-description" class="w-full min-h-[34px] resize-y rounded-md border border-input bg-background px-2 py-1.5 text-sm leading-relaxed" rows="4">Describe your flow here</textarea>
        </div>
      </section>

      <section class="grid gap-2.5" aria-labelledby="editor-title">
        <div class="sticky top-0 z-10 flex flex-wrap items-center justify-between gap-3 border-b border-border bg-background py-2.5">
          <div class="grid gap-1">
            <span class="text-xs font-bold uppercase tracking-wide text-muted-foreground">{t('flows.definition')}</span>
            <h2 id="editor-title" class="m-0 text-base font-bold">{t('flows.yamlLabel')}</h2>
          </div>
          <div class="flex flex-wrap items-center gap-2 max-sm:w-full max-sm:[&>*]:flex-1">
            <select id="snippet-select" class="min-w-[132px] rounded-md border border-input bg-card px-2 py-1.5 text-sm max-sm:w-full" aria-label={t('flows.insertSnippet')}>
              <option value="">{t('flows.insertSnippet')}</option>
              <option value="input">Input</option>
              <option value="agent">Agent step</option>
              <option value="tool_group">Tool group</option>
              <option value="approval">Approval gate</option>
              <option value="edge">Edge</option>
              <option value="artifact">Artifact</option>
            </select>
            <button type="button" id="copy-btn" class="rounded-md border border-border bg-card px-3 py-1.5 text-sm font-semibold transition-colors hover:border-primary hover:text-primary">{t('common.copy')}</button>
            <button type="button" id="validate-btn" class="rounded-md border border-border bg-card px-3 py-1.5 text-sm font-semibold transition-colors hover:border-primary hover:text-primary">{t('common.validate')}</button>
            <button type="button" id="create-btn" class="rounded-md border border-primary bg-primary px-3 py-1.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">{t('common.create')}</button>
          </div>
        </div>

        <div class="flex items-center justify-between gap-3">
          <span id="save-status" class="save-status text-sm text-muted-foreground" aria-live="polite">{t('common.unchanged')}</span>
          <span id="validation-pill" class="validation-pill unknown rounded-full border border-border bg-card px-2.5 py-0.5 text-xs font-semibold text-muted-foreground">{lang === 'en' ? 'Not validated' : '未驗證'}</span>
        </div>

        <textarea
          id="yaml-editor"
          name="yaml"
          rows={34}
          spellcheck={false}
          class="yaml-textarea w-full resize-y rounded-lg border border-border bg-card p-3 font-mono text-[13px] leading-relaxed [tab-size:2] [white-space:pre] [overflow-wrap:normal] overflow-x-auto focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20"
          style="min-height: min(72vh, 820px);"
        >{starterYaml}</textarea>

        <div id="validation-errors" class="validation-errors hidden" aria-live="polite" role="alert"></div>
      </section>

      <aside class="sticky top-3 grid gap-4 rounded-lg border border-border bg-card p-4 max-lg:static" aria-labelledby="summary-title">
        <div class="grid gap-1">
          <span class="text-xs font-bold uppercase tracking-wide text-muted-foreground">{t('flows.preview')}</span>
          <h2 id="summary-title" class="m-0 text-base font-bold">{t('flows.preview')}</h2>
        </div>
        <dl class="summary-list m-0 grid gap-3 max-lg:grid-cols-4 max-sm:grid-cols-2">
          <div class="grid gap-0.5">
            <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Flow ID</dt>
            <dd id="summary-id" class="m-0 break-all font-mono text-sm">my-new-flow</dd>
          </div>
          <div class="grid gap-0.5">
            <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">{t('common.name')}</dt>
            <dd id="summary-name" class="m-0 text-sm">New Flow</dd>
          </div>
          <div class="grid gap-0.5">
            <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">{t('common.version')}</dt>
            <dd id="summary-version" class="m-0 font-mono text-sm">1</dd>
          </div>
          <div class="grid gap-0.5">
            <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Inputs</dt>
            <dd id="summary-inputs" class="m-0 font-mono text-sm">1</dd>
          </div>
          <div class="grid gap-0.5">
            <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Steps</dt>
            <dd id="summary-steps" class="m-0 font-mono text-sm">1</dd>
          </div>
          <div class="grid gap-0.5">
            <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Edges</dt>
            <dd id="summary-edges" class="m-0 font-mono text-sm">1</dd>
          </div>
          <div class="grid gap-0.5">
            <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Artifacts</dt>
            <dd id="summary-artifacts" class="m-0 font-mono text-sm">0</dd>
          </div>
        </dl>
      </aside>
    </form>
  )}
</AdminV2Layout>

<script define:vars={{
  lang,
  messages: {
    unknown: lang === 'en' ? 'Not validated' : '未驗證',
    invalid: lang === 'en' ? 'Has errors' : '有錯誤',
    unset: lang === 'en' ? 'Not set' : '未設定',
    unchanged: t('common.unchanged'),
    unsaved: t('common.unsaved'),
    validating: `${t('common.validate')}...`,
    validationPassed: t('common.validationPassed'),
    validationFailed: t('common.validationFailed'),
    creating: t('flows.creating'),
    createdRedirect: t('flows.createdRedirect'),
    createFailed: lang === 'en' ? 'Create failed' : '建立失敗',
    copiedYaml: t('flows.copiedYaml'),
    copyFailed: t('flows.copyFailed'),
  },
}}>
  const form = /** @type {HTMLFormElement | null} */ (document.getElementById('new-form'));
  const textarea = /** @type {HTMLTextAreaElement | null} */ (document.getElementById('yaml-editor'));
  const errorsEl = document.getElementById('validation-errors');
  const saveStatus = document.getElementById('save-status');
  const validationPill = document.getElementById('validation-pill');
  const validateBtn = /** @type {HTMLButtonElement | null} */ (document.getElementById('validate-btn'));
  const createBtn = /** @type {HTMLButtonElement | null} */ (document.getElementById('create-btn'));
  const copyBtn = document.getElementById('copy-btn');
  const snippetSelect = /** @type {HTMLSelectElement | null} */ (document.getElementById('snippet-select'));
  const templateSelect = /** @type {HTMLSelectElement | null} */ (document.getElementById('template-select'));
  const idInput = /** @type {HTMLInputElement | null} */ (document.getElementById('flow-id'));
  const nameInput = /** @type {HTMLInputElement | null} */ (document.getElementById('flow-name'));
  const versionInput = /** @type {HTMLInputElement | null} */ (document.getElementById('flow-version'));
  const descriptionInput = /** @type {HTMLTextAreaElement | null} */ (document.getElementById('flow-description'));

  const summary = {
    id: document.getElementById('summary-id'),
    name: document.getElementById('summary-name'),
    version: document.getElementById('summary-version'),
    inputs: document.getElementById('summary-inputs'),
    steps: document.getElementById('summary-steps'),
    edges: document.getElementById('summary-edges'),
    artifacts: document.getElementById('summary-artifacts'),
  };

  const templates = {
    'single-agent': `id: my-new-flow
name: New Flow
version: 1
description: Describe your flow here
inputs:
  - name: topic
    type: string
    required: true
steps:
  - id: start
    type: agent
    agent: planner
    description: Plan from the provided topic.
    input:
      topic: "{{ inputs.topic }}"
edges:
  - from: start
    to: __end__
artifacts: []
`,
    research: `id: research-flow
name: Research Flow
version: 1
description: Plan, research, synthesize, and export a markdown report.
inputs:
  - name: topic
    type: string
    required: true
steps:
  - id: plan
    type: agent
    agent: planner
    description: Build the research plan.
  - id: research
    type: agent
    agent: research
    description: Collect and rank source evidence.
  - id: synthesize
    type: agent
    agent: writer
    description: Write the final report.
edges:
  - from: plan
    to: research
  - from: research
    to: synthesize
  - from: synthesize
    to: __end__
artifacts:
  - kind: markdown_report
    step: synthesize
`,
    approval: `id: approval-flow
name: Approval Flow
version: 1
description: Generate a draft and pause for human approval.
inputs:
  - name: request
    type: string
    required: true
steps:
  - id: draft
    type: agent
    agent: writer
    description: Create a draft response.
  - id: review
    type: approval
    description: Review the draft before continuing.
edges:
  - from: draft
    to: review
  - from: review
    to: __end__
artifacts: []
`,
    blank: `id: blank-flow
name: Blank Flow
version: 1
description: Start from an empty workflow definition.
inputs: []
steps:
  - id: start
    type: transform
    description: Replace this step with your first action.
edges:
  - from: start
    to: __end__
artifacts: []
`,
  };

  const snippets = {
    input: [
      '  - name: input_name',
      '    type: string',
      '    required: false',
      '',
    ].join('\n'),
    agent: [
      '  - id: new_agent_step',
      '    type: agent',
      '    agent: planner',
      '    description: Describe what this agent should do.',
      '',
    ].join('\n'),
    tool_group: [
      '  - id: new_tool_group',
      '    type: tool_group',
      '    tools: [search.tavily]',
      '    description: Describe which tools this step should call.',
      '',
    ].join('\n'),
    approval: [
      '  - id: approval_gate',
      '    type: approval',
      '    description: Review the intermediate output before continuing.',
      '',
    ].join('\n'),
    edge: [
      '  - from: previous_step',
      '    to: next_step',
      '',
    ].join('\n'),
    artifact: [
      '  - kind: markdown_report',
      '    step: step_id',
      '',
    ].join('\n'),
  };

  let lastSavedYaml = textarea?.value ?? '';
  let metadataSyncing = false;
  let debounceTimer = null;

  function escapeHtml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function setStatus(msg, tone = '') {
    if (!saveStatus) return;
    saveStatus.textContent = msg;
    saveStatus.className = tone === 'ok'
      ? 'text-sm font-semibold text-green-600'
      : tone === 'dirty'
        ? 'text-sm font-semibold text-amber-600'
        : 'text-sm text-muted-foreground';
  }

  function setValidationState(state) {
    if (!validationPill) return;
    const text = state === 'valid' ? messages.validationPassed : state === 'invalid' ? messages.invalid : messages.unknown;
    validationPill.textContent = text;
    validationPill.className = state === 'valid'
      ? 'rounded-full border border-green-500 bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-green-700'
      : state === 'invalid'
        ? 'rounded-full border border-destructive/50 bg-destructive/5 px-2.5 py-0.5 text-xs font-semibold text-destructive'
        : 'rounded-full border border-border bg-card px-2.5 py-0.5 text-xs font-semibold text-muted-foreground';
  }

  function setErrors(errors) {
    if (!errorsEl) return;
    if (!errors.length) {
      errorsEl.textContent = '';
      errorsEl.hidden = true;
      textarea?.classList.remove('!border-destructive/50');
      return;
    }
    errorsEl.hidden = false;
    errorsEl.className = 'rounded-lg border border-destructive/50 bg-destructive/5 p-3 text-sm text-destructive';
    textarea?.classList.add('!border-destructive/50');
    errorsEl.innerHTML = errors
      .map((e) => `<div class="mb-1 last:mb-0"><span class="mr-1.5 inline-block font-mono font-bold">${escapeHtml(e.path)}</span>${escapeHtml(e.message)}</div>`)
      .join('');
  }

  function refreshDirtyState() {
    if ((textarea?.value ?? '') === lastSavedYaml) {
      setStatus(messages.unchanged);
      return;
    }
    setStatus(messages.unsaved, 'dirty');
  }

  function updateSummary() {
    const yaml = textarea?.value ?? '';
    const data = extractSummary(yaml);
    if (summary.id) summary.id.textContent = data.id || messages.unset;
    if (summary.name) summary.name.textContent = data.name || messages.unset;
    if (summary.version) summary.version.textContent = data.version || '1';
    if (summary.inputs) summary.inputs.textContent = String(data.inputs);
    if (summary.steps) summary.steps.textContent = String(data.steps);
    if (summary.edges) summary.edges.textContent = String(data.edges);
    if (summary.artifacts) summary.artifacts.textContent = String(data.artifacts);
  }

  function extractSummary(yaml) {
    return {
      id: scalarValue(yaml, 'id'),
      name: scalarValue(yaml, 'name'),
      version: scalarValue(yaml, 'version'),
      inputs: listCount(yaml, 'inputs'),
      steps: listCount(yaml, 'steps'),
      edges: listCount(yaml, 'edges'),
      artifacts: listCount(yaml, 'artifacts'),
    };
  }

  function scalarValue(yaml, key) {
    const match = yaml.match(new RegExp(`^${key}:\\s*(.+)$`, 'm'));
    return match?.[1]?.replace(/^["']|["']$/g, '').trim() ?? '';
  }

  function listCount(yaml, key) {
    const section = sectionBody(yaml, key);
    if (!section.trim() || section.trim() === '[]' || section.trim() === '{}') return 0;
    return (section.match(/^  - /gm) ?? []).length || (section.match(/^  [A-Za-z0-9_-]+:/gm) ?? []).length;
  }

  function sectionBody(yaml, key) {
    const start = yaml.match(new RegExp(`^${key}:\\s*(.*)$`, 'm'));
    if (!start || start.index === undefined) return '';
    const afterHeaderStart = start.index + start[0].length;
    const rest = yaml.slice(afterHeaderStart);
    const next = rest.search(/\n[A-Za-z_][A-Za-z0-9_-]*:/);
    return start[1] && start[1].trim() ? start[1] : next >= 0 ? rest.slice(0, next) : rest;
  }

  function syncMetadataFieldsFromYaml() {
    if (!textarea || metadataSyncing) return;
    const data = extractSummary(textarea.value);
    if (idInput && data.id) idInput.value = data.id;
    if (nameInput && data.name) nameInput.value = data.name;
    if (versionInput && data.version) versionInput.value = data.version;
    if (descriptionInput) {
      const description = scalarValue(textarea.value, 'description');
      if (description) descriptionInput.value = description;
    }
  }

  function syncYamlMetadata() {
    if (!textarea) return;
    metadataSyncing = true;
    let yaml = textarea.value;
    yaml = setTopLevelScalar(yaml, 'id', idInput?.value.trim() || 'my-new-flow');
    yaml = setTopLevelScalar(yaml, 'name', nameInput?.value.trim() || 'New Flow');
    yaml = setTopLevelScalar(yaml, 'version', versionInput?.value.trim() || '1');
    yaml = setTopLevelScalar(yaml, 'description', descriptionInput?.value.trim() || 'Describe your flow here');
    textarea.value = yaml;
    metadataSyncing = false;
    textarea.dispatchEvent(new Event('input', { bubbles: true }));
  }

  function setTopLevelScalar(yaml, key, value) {
    const escaped = value.includes(':') || value.includes('#') ? JSON.stringify(value) : value;
    const line = `${key}: ${escaped}`;
    const pattern = new RegExp(`^${key}:.*$`, 'm');
    if (pattern.test(yaml)) return yaml.replace(pattern, line);
    return `${line}\n${yaml}`;
  }

  function insertAtCursor(value) {
    if (!textarea) return;
    const start = textarea.selectionStart ?? textarea.value.length;
    const end = textarea.selectionEnd ?? start;
    textarea.value = textarea.value.slice(0, start) + value + textarea.value.slice(end);
    textarea.selectionStart = start;
    textarea.selectionEnd = start + value.length;
    textarea.focus();
    textarea.dispatchEvent(new Event('input', { bubbles: true }));
  }

  async function doValidate() {
    const yaml = textarea?.value ?? '';
    setStatus(messages.validating);
    setValidationState('unknown');
    setErrors([]);
    try {
      const res = await fetch('/api/admin/flows/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ yaml }),
      });
      const data = await res.json();
      if (data.valid) {
        setValidationState('valid');
        setStatus(messages.validationPassed, 'ok');
        setErrors([]);
        return true;
      }
      setValidationState('invalid');
      setStatus('');
      setErrors(data.errors ?? [{ path: '(unknown)', message: messages.validationFailed }]);
      return false;
    } catch (err) {
      setValidationState('invalid');
      setErrors([{ path: '(network)', message: String(err) }]);
      setStatus('');
      return false;
    }
  }

  async function createFlow() {
    const yaml = textarea?.value ?? '';
    setStatus(messages.creating);
    setErrors([]);
    try {
      const res = await fetch('/api/admin/flows', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ yaml }),
      });
      const data = await res.json();
      if (res.ok && data.flowId) {
        lastSavedYaml = yaml;
        setStatus(messages.createdRedirect, 'ok');
        window.location.href = lang === 'en' ? `/admin/flows/${data.flowId}/edit?lang=en` : `/admin/flows/${data.flowId}/edit`;
        return;
      }
      setValidationState('invalid');
      if (data.errors) {
        setStatus('');
        setErrors(data.errors);
      } else {
        setStatus('');
        setErrors([{ path: '(server)', message: data.error ?? messages.createFailed }]);
      }
    } catch (err) {
      setErrors([{ path: '(network)', message: String(err) }]);
      setStatus('');
    }
  }

  textarea?.addEventListener('input', () => {
    refreshDirtyState();
    updateSummary();
    if (!metadataSyncing) syncMetadataFieldsFromYaml();
    setValidationState('unknown');
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      doValidate();
    }, 700);
  });

  textarea?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    event.preventDefault();
    insertAtCursor('  ');
  });

  for (const input of [idInput, nameInput, versionInput, descriptionInput]) {
    input?.addEventListener('input', syncYamlMetadata);
  }

  templateSelect?.addEventListener('change', () => {
    if (!textarea || !templateSelect.value) return;
    textarea.value = templates[templateSelect.value] ?? templates['single-agent'];
    lastSavedYaml = textarea.value;
    syncMetadataFieldsFromYaml();
    textarea.dispatchEvent(new Event('input', { bubbles: true }));
  });

  snippetSelect?.addEventListener('change', () => {
    const key = snippetSelect.value;
    if (key && snippets[key]) insertAtCursor(snippets[key]);
    snippetSelect.value = '';
  });

  copyBtn?.addEventListener('click', async () => {
    const yaml = textarea?.value ?? '';
    try {
      await navigator.clipboard.writeText(yaml);
      setStatus(messages.copiedYaml, 'ok');
      setTimeout(refreshDirtyState, 1000);
    } catch {
      setStatus(messages.copyFailed);
    }
  });

  validateBtn?.addEventListener('click', () => {
    doValidate();
  });

  createBtn?.addEventListener('click', async () => {
    const valid = await doValidate();
    if (valid) await createFlow();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const valid = await doValidate();
    if (valid) await createFlow();
  });

  window.addEventListener('beforeunload', (event) => {
    if ((textarea?.value ?? '') === lastSavedYaml) return;
    event.preventDefault();
    event.returnValue = '';
  });

  updateSummary();
</script>

