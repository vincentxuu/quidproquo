---
export const prerender = false;
import AdminV2Layout from '../../layouts/AdminV2Layout.astro';
---

<AdminV2Layout title="Home" section="home">
  <section id="needs-you" class="needs-you collapsed">
    <p class="needs-you-ok">✓ 一切正常</p>
    <div class="needs-you-items" hidden></div>
  </section>

  <section class="composer-section">
    <form id="composer-form" class="composer">
      <textarea
        id="composer-input"
        name="instruction"
        class="composer-input"
        placeholder="輸入指令，讓 agent 執行…"
        rows="3"
        required
      ></textarea>
      <div class="composer-controls">
        <select id="composer-mode" name="mode" class="composer-select">
          <option value="auto" selected>Auto</option>
          <option value="default">Accept edits</option>
          <option value="plan">Plan</option>
        </select>
        <select id="composer-model" name="model" class="composer-select">
          <option value="">預設模型</option>
        </select>
        <button type="submit" class="composer-submit" id="composer-submit">執行</button>
      </div>
    </form>
  </section>

  <section class="recents-section">
    <h3 class="section-title">最近 Sessions</h3>
    <div id="recents-list" class="recents-list">
      <p class="empty-text">載入中…</p>
    </div>
  </section>

  <section class="usage-section">
    <span id="usage-line" class="usage-line">用量統計載入中…</span>
  </section>
</AdminV2Layout>

<script is:inline>
  (function () {
    const form = document.getElementById('composer-form');
    const submitBtn = document.getElementById('composer-submit');
    const needsYouSection = document.getElementById('needs-you');
    const needsYouItems = needsYouSection?.querySelector('.needs-you-items');
    const needsYouOk = needsYouSection?.querySelector('.needs-you-ok');
    const recentsList = document.getElementById('recents-list');
    const usageLine = document.getElementById('usage-line');
    const modelSelect = document.getElementById('composer-model');

    async function loadModels() {
      try {
        const res = await fetch('/api/admin/settings/models');
        if (!res.ok) return;
        const data = await res.json();
        const providers = data.providers || [];
        for (const p of providers) {
          const opt = document.createElement('option');
          opt.value = p.id || p.provider_id || '';
          opt.textContent = p.display_name || p.id || '';
          modelSelect?.appendChild(opt);
        }
      } catch {}
    }

    async function loadNeedsYou() {
      try {
        const res = await fetch('/api/admin/sessions?needs_action=1&limit=10');
        if (!res.ok) return;
        const data = await res.json();
        const sessions = data.sessions || [];
        if (sessions.length === 0) {
          needsYouSection?.classList.add('collapsed');
          if (needsYouOk) needsYouOk.hidden = false;
          if (needsYouItems) needsYouItems.hidden = true;
          return;
        }
        needsYouSection?.classList.remove('collapsed');
        if (needsYouOk) needsYouOk.hidden = true;
        if (needsYouItems) {
          needsYouItems.hidden = false;
          needsYouItems.innerHTML = '';
          for (const s of sessions) {
            const item = document.createElement('a');
            item.href = '/admin/sessions/' + encodeURIComponent(s.id);
            item.className = 'needs-you-item';
            const badge = document.createElement('span');
            badge.className = 'badge badge-' + badgeClass(s.status);
            badge.textContent = s.status;
            const label = document.createElement('span');
            label.textContent = s.name || s.summary_detail || s.id.slice(0, 8);
            item.append(badge, label);
            needsYouItems.appendChild(item);
          }
        }
      } catch {}
    }

    async function loadRecents() {
      try {
        const res = await fetch('/api/admin/sessions?limit=10');
        if (!res.ok) throw new Error();
        const data = await res.json();
        const sessions = data.sessions || [];
        if (!recentsList) return;
        if (sessions.length === 0) {
          recentsList.innerHTML = '<p class="empty-text">尚無 Session</p>';
          return;
        }
        recentsList.innerHTML = '';
        for (const s of sessions) {
          const row = document.createElement('a');
          row.href = '/admin/sessions/' + encodeURIComponent(s.id);
          row.className = 'recent-row';

          const left = document.createElement('div');
          left.className = 'recent-left';
          const nameEl = document.createElement('span');
          nameEl.className = 'recent-name';
          nameEl.textContent = s.name || truncate(s.instruction || s.id, 60);
          const detail = document.createElement('span');
          detail.className = 'recent-detail';
          detail.textContent = s.summary_detail || '';
          left.append(nameEl, detail);

          const right = document.createElement('div');
          right.className = 'recent-right';
          const badge = document.createElement('span');
          badge.className = 'badge badge-' + badgeClass(s.status);
          badge.textContent = s.status;
          const time = document.createElement('span');
          time.className = 'recent-time';
          time.textContent = relativeTime(s.created_at);
          right.append(badge, time);

          row.append(left, right);
          recentsList.appendChild(row);
        }
      } catch {
        if (recentsList) recentsList.innerHTML = '<p class="empty-text">無法載入</p>';
      }
    }

    async function loadUsage() {
      try {
        const res = await fetch('/api/admin/settings/cost');
        if (!res.ok) throw new Error();
        const data = await res.json();
        const tokens = data.total_tokens ?? 0;
        const cost = data.total_cost_usd ?? 0;
        if (usageLine) usageLine.textContent = '本週 tokens: ' + tokens.toLocaleString() + ' · 費用: $' + cost.toFixed(4);
      } catch {
        if (usageLine) usageLine.textContent = '用量統計暫時無法載入';
      }
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const instruction = document.getElementById('composer-input')?.value?.trim();
      if (!instruction) return;
      submitBtn.disabled = true;
      submitBtn.textContent = '建立中…';
      try {
        const mode = document.getElementById('composer-mode')?.value || 'auto';
        const model = document.getElementById('composer-model')?.value || undefined;
        const res = await fetch('/api/admin/sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ instruction, mode, model }),
        });
        const data = await res.json();
        if (res.ok && data.id) {
          window.location.href = '/admin/sessions/' + encodeURIComponent(data.id);
        } else {
          alert(data.error || '建立失敗');
          submitBtn.disabled = false;
          submitBtn.textContent = '執行';
        }
      } catch {
        alert('網路錯誤');
        submitBtn.disabled = false;
        submitBtn.textContent = '執行';
      }
    });

    function badgeClass(status) {
      switch (status) {
        case 'done': return 'success';
        case 'failed': return 'error';
        case 'running': return 'running';
        case 'cancelled': return 'muted';
        default: return 'pending';
      }
    }

    function truncate(s, max) {
      return s.length > max ? s.slice(0, max) + '…' : s;
    }

    function relativeTime(ts) {
      if (!ts) return '';
      const diff = Date.now() - (typeof ts === 'number' ? ts : new Date(ts).getTime());
      const sec = Math.floor(diff / 1000);
      if (sec < 60) return sec + 's';
      const min = Math.floor(sec / 60);
      if (min < 60) return min + 'm';
      const hr = Math.floor(min / 60);
      if (hr < 24) return hr + 'h';
      return Math.floor(hr / 24) + 'd';
    }

    loadModels();
    loadNeedsYou();
    loadRecents();
    loadUsage();
  })();
</script>

<style>
  .needs-you {
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius, 6px);
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    background: var(--admin-surface);
  }
  .needs-you.collapsed .needs-you-ok {
    color: var(--admin-success);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .needs-you-items { display: flex; flex-direction: column; gap: 0.5rem; }
  .needs-you-item {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.75rem; border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius, 6px); text-decoration: none;
    color: var(--admin-text); background: var(--admin-color-surface-subtle);
  }
  .needs-you-item:hover { background: var(--admin-muted); }
  .composer-section { margin-bottom: 1.5rem; }
  .composer { display: flex; flex-direction: column; gap: 0.5rem; }
  .composer-input {
    width: 100%; padding: 0.75rem; border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius, 6px); background: var(--admin-surface);
    color: var(--admin-text); font: inherit; font-size: 0.95rem;
    resize: vertical; min-height: 80px;
  }
  .composer-input:focus {
    outline: none; border-color: var(--admin-accent);
    box-shadow: 0 0 0 2px var(--admin-color-primary-soft);
  }
  .composer-controls { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .composer-select {
    min-height: 2.75rem; padding: 0.45rem 0.6rem; border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius, 6px); background: var(--admin-surface);
    color: var(--admin-text); font: inherit; font-size: 0.85rem;
  }
  .composer-submit {
    min-height: 2.75rem; padding: 0.45rem 1.2rem; border: none;
    border-radius: var(--admin-radius, 6px); background: var(--admin-accent);
    color: #fff; font: inherit; font-weight: 600; font-size: 0.85rem; cursor: pointer;
  }
  .composer-submit:hover { background: var(--admin-accent-hover); }
  .composer-submit:disabled { opacity: 0.6; cursor: wait; }
  .section-title { font-size: 0.95rem; font-weight: 600; margin-bottom: 0.5rem; }
  .recents-list {
    display: flex; flex-direction: column; border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius, 6px); overflow: hidden;
  }
  .recent-row {
    display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;
    padding: 0.65rem 1rem; text-decoration: none; color: var(--admin-text);
    border-bottom: 1px solid var(--admin-border);
  }
  .recent-row:last-child { border-bottom: none; }
  .recent-row:hover { background: var(--admin-color-surface-subtle); }
  .recent-left { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; flex: 1; }
  .recent-name { font-size: 0.9rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .recent-detail { font-size: 0.8rem; color: var(--admin-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .recent-right { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .recent-time { font-size: 0.78rem; color: var(--admin-text-soft); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .badge { display: inline-block; padding: 0.15em 0.55em; border-radius: 999px; font-size: 0.75em; font-weight: 600; white-space: nowrap; }
  .badge-success { background: var(--admin-color-success-soft); color: var(--admin-color-success); }
  .badge-error { background: var(--admin-color-danger-soft); color: var(--admin-color-danger); }
  .badge-running { background: var(--admin-color-info-soft); color: var(--admin-color-info); }
  .badge-pending { background: var(--admin-color-warning-soft); color: var(--admin-color-warning); }
  .badge-muted { background: var(--admin-muted); color: var(--admin-text-muted); }
  .usage-section {
    margin-top: 1.5rem; padding: 0.65rem 1rem; border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius, 6px); background: var(--admin-color-surface-subtle);
  }
  .usage-line { font-size: 0.85rem; color: var(--admin-text-muted); }
  .empty-text { padding: 1rem; color: var(--admin-text-muted); font-size: 0.85rem; text-align: center; }
  @media (max-width: 768px) {
    .composer-controls { flex-direction: column; }
    .composer-select, .composer-submit { width: 100%; }
    .recent-row { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
    .recent-right { align-self: flex-end; }
  }
</style>
