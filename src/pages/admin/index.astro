---
export const prerender = false;
import AdminV2Layout from '../../layouts/AdminV2Layout.astro';
import AdminComposer from '../../components/admin/AdminComposer.tsx';
import '../../styles/globals.css';
---

<AdminV2Layout title="Home" section="home">
  <div class="home-center">
    <div class="greeting" id="greeting">
      <h1 class="greeting-text">What's up next?</h1>
    </div>

    <div id="needs-you" class="needs-you" hidden>
      <div class="needs-you-items" id="needs-you-items"></div>
    </div>
  </div>

  <AdminComposer client:load />
</AdminV2Layout>

<script is:inline>
  (function () {
    const needsYou = document.getElementById('needs-you');
    const needsYouItems = document.getElementById('needs-you-items');
    const greeting = document.getElementById('greeting');

    function truncate(s, n) { return s.length > n ? s.slice(0, n) + '…' : s; }

    async function loadNeedsYou() {
      try {
        const res = await fetch('/api/admin/home/needs-you');
        if (!res.ok) return;
        const data = await res.json();
        const total = data.totalItems || 0;
        if (total === 0) {
          if (needsYou) needsYou.hidden = true;
          return;
        }
        if (needsYou) needsYou.hidden = false;
        if (greeting) greeting.hidden = true;
        if (!needsYouItems) return;
        needsYouItems.innerHTML = '';
        for (const a of (data.pendingApprovals || [])) {
          const el = document.createElement('div');
          el.className = 'ny-item ny-approval';
          el.innerHTML = '<span>⚠ ' + (a.display_name || 'Tool') + ': ' + truncate(a.reason || '', 50) + '</span>'
            + '<span class="ny-actions">'
            + '<button class="ny-btn ny-allow" data-id="' + a.approval_id + '" data-sid="' + a.run_id + '">Allow</button>'
            + '<button class="ny-btn ny-deny" data-id="' + a.approval_id + '" data-sid="' + a.run_id + '">Deny</button>'
            + '</span>';
          needsYouItems.appendChild(el);
        }
        for (const s of (data.failedSessions || [])) {
          const el = document.createElement('a');
          el.href = '/admin/sessions/' + encodeURIComponent(s.id);
          el.className = 'ny-item ny-failed';
          el.textContent = '✗ ' + (s.name || s.id.slice(0, 8)) + ': ' + (s.summary_detail || 'failed');
          needsYouItems.appendChild(el);
        }
        for (const s of (data.needsActionSessions || [])) {
          const el = document.createElement('a');
          el.href = '/admin/sessions/' + encodeURIComponent(s.id);
          el.className = 'ny-item';
          el.textContent = '📋 ' + (s.name || s.id.slice(0, 8)) + ': ' + (s.summary_detail || '');
          needsYouItems.appendChild(el);
        }
        needsYouItems.addEventListener('click', async (e) => {
          const btn = e.target.closest('.ny-btn');
          if (!btn) return;
          const behavior = btn.classList.contains('ny-allow') ? 'allow' : 'deny';
          const sid = btn.dataset.sid;
          const aid = btn.dataset.id;
          try {
            await fetch('/api/admin/sessions/' + sid + '/approve', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ approval_id: aid, behavior }),
            });
            btn.closest('.ny-item')?.remove();
            loadNeedsYou();
          } catch {}
        });
      } catch {}
    }

    loadNeedsYou();
  })();
</script>

<style>
  .home-center {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem 1rem;
    min-height: 0;
  }

  .greeting {
    text-align: center;
  }

  .greeting-text {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--admin-text);
  }

  .needs-you {
    width: 100%;
    max-width: 680px;
    margin-top: 1rem;
  }

  .needs-you-items {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  :global(.ny-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius);
    background: var(--admin-surface);
    text-decoration: none;
    color: var(--admin-text);
    font-size: 0.85rem;
  }

  :global(.ny-item:hover) { background: var(--admin-muted); }
  :global(.ny-actions) { display: flex; gap: 0.3rem; flex-shrink: 0; }

  :global(.ny-btn) {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--admin-border);
    border-radius: 4px;
    background: var(--admin-surface);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }

  :global(.ny-allow) { color: var(--brand-700); }
  :global(.ny-allow:hover) { background: var(--brand-100); }
  :global(.ny-deny) { color: #c44; }
  :global(.ny-deny:hover) { background: #fde; }
  :global(.ny-failed) { border-left: 3px solid #c44; }
</style>
