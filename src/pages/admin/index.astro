---
export const prerender = false;
import AdminV2Layout from '../../layouts/AdminV2Layout.astro';
---

<AdminV2Layout title="Home" section="home">
  <div class="home-center">
    <div class="greeting" id="greeting">
      <h1 class="greeting-text">What's up next?</h1>
    </div>

    <div id="needs-you" class="needs-you" hidden>
      <div class="needs-you-items" id="needs-you-items"></div>
    </div>
  </div>

  <div class="home-composer">
    <div class="composer-top-row">
      <div class="composer-pills">
        <div class="composer-pill env-pill">
          <span class="pill-icon">◇</span>
          <select id="composer-env" name="runner_provider" class="pill-select">
            <option value="sandbox" selected>Sandbox</option>
            <option value="mac">Mac</option>
          </select>
        </div>
        <div class="composer-pill repo-pill" id="repo-pill">
          <span class="pill-icon">+</span>
          <select id="composer-repo" name="repo" class="pill-select">
            <option value="" selected>Select repo…</option>
          </select>
        </div>
        <input
          type="text"
          id="composer-custom-repo"
          name="custom_repo"
          class="repo-input"
          placeholder="owner/repo or GitHub URL"
          hidden
        />
        <input
          type="text"
          id="composer-branch"
          name="branch"
          class="branch-input"
          placeholder="branch"
          hidden
        />
      </div>
    </div>

    <form id="composer-form" class="composer-input-area">
      <textarea
        id="composer-input"
        name="instruction"
        class="chat-input"
        placeholder="Describe a task or ask a question"
        rows="1"
        required
      ></textarea>
      <button type="submit" class="send-btn" id="composer-submit" aria-label="送出">
        <span class="send-arrow">↑</span>
      </button>
    </form>

    <div class="composer-bottom-row">
      <div class="bottom-left">
        <select id="composer-mode" name="mode" class="bottom-select">
          <option value="auto" selected>Auto</option>
          <option value="default">Accept edits</option>
          <option value="plan">Plan</option>
        </select>
        <label class="bottom-toggle" title="Fast mode">
          <input type="checkbox" id="composer-fast" name="fast_mode" />
          <span>Fast</span>
        </label>
      </div>
      <div class="bottom-right">
        <select id="composer-provider" name="provider" class="bottom-select provider-select">
          <option value="">Provider</option>
        </select>
        <select id="composer-model" name="model" class="bottom-select model-select">
          <option value="">Model</option>
        </select>
        <select id="composer-effort" name="effort" class="bottom-select effort-select">
          <option value="high" selected>High</option>
          <option value="auto">Auto</option>
          <option value="low">Low</option>
          <option value="medium">Medium</option>
        </select>
      </div>
    </div>

    <div class="usage-bar" id="usage-bar">
      <span id="usage-line"></span>
    </div>
  </div>
</AdminV2Layout>

<script is:inline>
  (function () {
    const form = document.getElementById('composer-form');
    const submitBtn = document.getElementById('composer-submit');
    const input = document.getElementById('composer-input');
    const providerSelect = document.getElementById('composer-provider');
    const modelSelect = document.getElementById('composer-model');
    const repoSelect = document.getElementById('composer-repo');
    const customRepoInput = document.getElementById('composer-custom-repo');
    const branchInput = document.getElementById('composer-branch');
    const needsYou = document.getElementById('needs-you');
    const needsYouItems = document.getElementById('needs-you-items');
    const greeting = document.getElementById('greeting');
    const usageLine = document.getElementById('usage-line');
    const modelPrefsKey = 'qp.admin.composer.modelPrefs';
    const providerState = { providers: [], catalog: [] };
    const repoPrefsKey = 'qp.admin.composer.repoPrefs';

    function readModelPrefs() {
      try {
        return JSON.parse(localStorage.getItem(modelPrefsKey) || '{}') || {};
      } catch {
        return {};
      }
    }

    function saveModelPrefs() {
      if (!providerSelect || !modelSelect) return;
      const provider = providerSelect.value || '';
      const model = modelSelect.value || '';
      const prefs = readModelPrefs();
      prefs.provider = provider;
      prefs.model = model;
      prefs.modelsByProvider = prefs.modelsByProvider || {};
      if (provider && model) prefs.modelsByProvider[provider] = model;
      localStorage.setItem(modelPrefsKey, JSON.stringify(prefs));
    }

    function createOption(value, label) {
      const opt = document.createElement('option');
      opt.value = value;
      opt.textContent = label;
      return opt;
    }

    function readRepoPrefs() {
      try {
        return JSON.parse(localStorage.getItem(repoPrefsKey) || '{}') || {};
      } catch {
        return {};
      }
    }

    function saveRepoPrefs() {
      if (!repoSelect || !branchInput || !customRepoInput) return;
      localStorage.setItem(repoPrefsKey, JSON.stringify({
        repo: repoSelect.value || '',
        customRepo: customRepoInput.value.trim() || '',
        branch: branchInput.value.trim() || '',
      }));
    }

    // Auto-grow textarea
    input?.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 200) + 'px';
    });

    // Enter to submit (Shift+Enter for newline)
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form?.requestSubmit();
      }
    });

    repoSelect?.addEventListener('change', () => {
      if (customRepoInput) customRepoInput.hidden = repoSelect.value !== '__custom__';
      if (branchInput) branchInput.hidden = !repoSelect.value;
      saveRepoPrefs();
    });

    customRepoInput?.addEventListener('input', () => {
      saveRepoPrefs();
    });

    branchInput?.addEventListener('input', () => {
      saveRepoPrefs();
    });

    async function loadModels() {
      try {
        const res = await fetch('/api/admin/settings/models');
        if (!res.ok) return;
        const data = await res.json();
        const catalog = Array.isArray(data.catalog?.models) ? data.catalog.models : [];
        const providerSet = new Set(Array.isArray(data.providers) ? data.providers : []);
        for (const item of catalog) {
          if (item?.provider) providerSet.add(String(item.provider));
        }
        providerState.catalog = catalog;
        providerState.providers = Array.from(providerSet).filter(Boolean).sort();
        syncProviders();
      } catch {}
    }

    async function loadRepos() {
      if (!repoSelect) return;
      try {
        const res = await fetch('/api/admin/repos');
        if (!res.ok) return;
        const data = await res.json();
        const repos = Array.isArray(data.repos) ? data.repos : [];
        const prefs = readRepoPrefs();
        repoSelect.replaceChildren();
        repoSelect.appendChild(createOption('', 'Select repo…'));
        for (const repo of repos) {
          if (repo?.fullName) {
            const suffix = repo.private ? ' (private)' : '';
            repoSelect.appendChild(createOption(repo.fullName, repo.fullName + suffix));
          }
        }
        repoSelect.appendChild(createOption('__custom__', 'Custom repo…'));
        if (prefs.repo && Array.from(repoSelect.options).some((opt) => opt.value === prefs.repo)) {
          repoSelect.value = prefs.repo;
        } else if (repos.length === 1 && repos[0]?.fullName) {
          repoSelect.value = repos[0].fullName;
        }
        if (customRepoInput) {
          customRepoInput.value = prefs.customRepo || '';
          customRepoInput.hidden = repoSelect.value !== '__custom__';
        }
        if (branchInput) {
          branchInput.value = prefs.branch || '';
          branchInput.hidden = !repoSelect.value;
        }
      } catch {}
    }

    function syncProviders() {
      if (!providerSelect) return;
      const prefs = readModelPrefs();
      providerSelect.replaceChildren();
      for (const provider of providerState.providers) {
        providerSelect.appendChild(createOption(provider, provider));
      }
      if (!providerSelect.options.length) {
        providerSelect.appendChild(createOption('', 'Provider'));
      }
      const options = Array.from(providerSelect.options);
      if (prefs.provider && options.some((opt) => opt.value === prefs.provider)) {
        providerSelect.value = prefs.provider;
      } else if (options.some((opt) => opt.value === 'groq')) {
        providerSelect.value = 'groq';
      } else if (providerSelect.options.length > 0) {
        providerSelect.value = providerSelect.options[0].value;
      }
      syncModels();
    }

    function syncModels() {
      if (!providerSelect || !modelSelect) return;
      const provider = providerSelect.value;
      const prefs = readModelPrefs();
      const savedModel = prefs.modelsByProvider?.[provider] || prefs.model || '';
      const entries = providerState.catalog
        .filter((item) => item?.provider === provider && item?.enabled !== false && typeof item?.model === 'string' && item.model.trim())
        .map((item) => ({
          value: item.model.trim(),
          label: item.displayName || item.model.trim(),
        }));

      modelSelect.replaceChildren();
      if (!entries.length) {
        modelSelect.appendChild(createOption('', 'No models'));
        modelSelect.disabled = true;
        saveModelPrefs();
        return;
      }

      modelSelect.disabled = false;
      for (const entry of entries) {
        modelSelect.appendChild(createOption(entry.value, entry.label));
      }
      if (savedModel && entries.some((entry) => entry.value === savedModel)) {
        modelSelect.value = savedModel;
      } else {
        modelSelect.value = entries[0].value;
      }
      saveModelPrefs();
    }

    async function loadNeedsYou() {
      try {
        const res = await fetch('/api/admin/home/needs-you');
        if (!res.ok) return;
        const data = await res.json();
        const total = data.totalItems || 0;
        if (total === 0) {
          if (needsYou) needsYou.hidden = true;
          return;
        }
        if (needsYou) needsYou.hidden = false;
        if (greeting) greeting.hidden = true;
        if (!needsYouItems) return;
        needsYouItems.innerHTML = '';
        for (const a of (data.pendingApprovals || [])) {
          const el = document.createElement('div');
          el.className = 'ny-item ny-approval';
          el.innerHTML = '<span>⚠ ' + (a.display_name || 'Tool') + ': ' + truncate(a.reason || '', 50) + '</span>'
            + '<span class="ny-actions">'
            + '<button class="ny-btn ny-allow" data-id="' + a.approval_id + '" data-sid="' + a.run_id + '">Allow</button>'
            + '<button class="ny-btn ny-deny" data-id="' + a.approval_id + '" data-sid="' + a.run_id + '">Deny</button>'
            + '</span>';
          needsYouItems.appendChild(el);
        }
        for (const s of (data.failedSessions || [])) {
          const el = document.createElement('a');
          el.href = '/admin/sessions/' + encodeURIComponent(s.id);
          el.className = 'ny-item ny-failed';
          el.textContent = '✗ ' + (s.name || s.id.slice(0, 8)) + ': ' + (s.summary_detail || 'failed');
          needsYouItems.appendChild(el);
        }
        for (const s of (data.needsActionSessions || [])) {
          const el = document.createElement('a');
          el.href = '/admin/sessions/' + encodeURIComponent(s.id);
          el.className = 'ny-item';
          el.textContent = '📋 ' + (s.name || s.id.slice(0, 8)) + ': ' + (s.summary_detail || '');
          needsYouItems.appendChild(el);
        }
        needsYouItems.addEventListener('click', async (e) => {
          const btn = e.target.closest('.ny-btn');
          if (!btn) return;
          const behavior = btn.classList.contains('ny-allow') ? 'allow' : 'deny';
          const sid = btn.dataset.sid;
          const aid = btn.dataset.id;
          try {
            await fetch('/api/admin/sessions/' + sid + '/approve', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ approval_id: aid, behavior }),
            });
            btn.closest('.ny-item')?.remove();
            loadNeedsYou();
          } catch {}
        });
      } catch {}
    }

    async function loadUsage() {
      try {
        const res = await fetch('/api/admin/settings/cost');
        if (!res.ok) return;
        const data = await res.json();
        if (usageLine) usageLine.textContent = (data.total_tokens ?? 0).toLocaleString() + ' tokens · $' + (data.total_cost_usd ?? 0).toFixed(4);
      } catch {}
    }

    function truncate(s, n) { return s.length > n ? s.slice(0, n) + '…' : s; }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const instruction = input?.value?.trim();
      if (!instruction) return;
      saveModelPrefs();
      saveRepoPrefs();
      const provider = providerSelect?.value || '';
      const model = modelSelect?.value || '';
      const selectedRepo = repoSelect?.value === '__custom__'
        ? customRepoInput?.value?.trim()
        : repoSelect?.value;
      submitBtn.disabled = true;
      try {
        const body = {
          instruction,
          mode: document.getElementById('composer-mode')?.value || 'auto',
          model: provider && model ? provider + ':' + model : undefined,
          repo: selectedRepo || undefined,
          branch: branchInput?.value?.trim() || undefined,
          effort: document.getElementById('composer-effort')?.value || 'high',
          fast_mode: document.getElementById('composer-fast')?.checked || false,
          runner_provider: document.getElementById('composer-env')?.value || 'sandbox',
        };
        const res = await fetch('/api/admin/sessions', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const contentType = res.headers.get('content-type') || '';
        const data = contentType.includes('application/json')
          ? await res.json()
          : { error: await res.text() };
        if (res.ok && data.id) {
          window.location.href = '/admin/sessions/' + encodeURIComponent(data.id);
        } else {
          alert(data.error || ('建立失敗（HTTP ' + res.status + '）'));
          submitBtn.disabled = false;
        }
      } catch {
        alert('網路錯誤');
        submitBtn.disabled = false;
      }
    });

    providerSelect?.addEventListener('change', () => {
      syncModels();
    });

    modelSelect?.addEventListener('change', () => {
      saveModelPrefs();
    });

    loadModels();
    loadRepos();
    loadNeedsYou();
    loadUsage();
  })();
</script>

<style>
  /* ── Home center (greeting + needs-you) ── */
  .home-center {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: clamp(4rem, 14vh, 8rem) 1.5rem 1.25rem;
    min-height: 0;
  }

  .greeting {
    text-align: center;
  }

  .greeting-text {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--admin-text);
  }

  .needs-you {
    width: 100%;
    max-width: 680px;
    margin-top: 1rem;
  }

  .needs-you-items {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  :global(.ny-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius);
    background: var(--admin-surface);
    text-decoration: none;
    color: var(--admin-text);
    font-size: 0.85rem;
  }

  :global(.ny-item:hover) { background: var(--admin-muted); }

  :global(.ny-actions) { display: flex; gap: 0.3rem; flex-shrink: 0; }

  :global(.ny-btn) {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--admin-border);
    border-radius: 4px;
    background: var(--admin-surface);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }

  :global(.ny-allow) { color: var(--brand-700); }
  :global(.ny-allow:hover) { background: var(--brand-100); }
  :global(.ny-deny) { color: #c44; }
  :global(.ny-deny:hover) { background: #fde; }
  :global(.ny-failed) { border-left: 3px solid #c44; }

  /* ── Bottom composer ── */
  .home-composer {
    position: relative;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem 1.25rem;
  }

  .composer-top-row {
    margin-bottom: 0.5rem;
  }

  .composer-pills {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .composer-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
    max-width: 100%;
    padding: 0.3rem 0.15rem 0.3rem 0.5rem;
    border: 1px solid var(--admin-border);
    border-radius: 999px;
    background: var(--admin-surface);
    font-size: 0.8rem;
    color: var(--admin-text-muted);
  }

  .pill-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  .pill-select {
    border: none;
    background: transparent;
    color: var(--admin-text);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    min-width: 0;
    max-width: 100%;
    padding-right: 0.3rem;
    appearance: none;
    -webkit-appearance: none;
    text-overflow: ellipsis;
  }

  .pill-select:focus {
    outline: none;
    box-shadow: none;
  }

  .repo-input,
  .branch-input {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--admin-border);
    border-radius: 999px;
    font-size: 0.8rem;
    width: 120px;
    max-width: 100%;
  }

  .repo-input {
    width: 220px;
  }

  /* ── Chat input ── */
  .composer-input-area {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    border: 1px solid var(--admin-border);
    border-radius: 12px;
    background: var(--admin-surface);
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .composer-input-area:focus-within {
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 2px var(--admin-color-primary-soft);
  }

  .chat-input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--admin-text);
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.5;
    resize: none;
    min-height: 24px;
    max-height: 200px;
    overflow-y: auto;
  }

  .chat-input:focus {
    outline: none;
    box-shadow: none;
  }

  .chat-input::placeholder {
    color: var(--admin-text-muted);
  }

  .send-btn {
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 8px;
    background: var(--brand-900);
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: background 0.12s;
  }

  .send-btn:hover { background: var(--brand-700); }
  .send-btn:disabled { opacity: 0.4; cursor: wait; }

  .send-arrow {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
  }

  /* ── Bottom controls ── */
  .composer-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.25rem 0;
    gap: 0.5rem;
  }

  .bottom-left,
  .bottom-right {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }

  .bottom-select {
    border: none;
    background: transparent;
    color: var(--admin-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    min-width: 0;
    max-width: 100%;
    padding: 0.2rem 0.1rem;
    text-overflow: ellipsis;
  }

  .bottom-select:focus { outline: none; box-shadow: none; }

  .bottom-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--admin-text-muted);
    cursor: pointer;
  }

  .bottom-toggle input { width: 13px; height: 13px; accent-color: var(--brand-700); }

  .provider-select,
  .model-select { font-weight: 600; color: var(--admin-text); }
  .provider-select { max-width: 8.5rem; }
  .model-select { max-width: 17rem; }
  .effort-select { font-weight: 600; }

  /* ── Usage bar ── */
  .usage-bar {
    text-align: center;
    padding: 0.35rem 0 0;
    font-size: 0.72rem;
    color: var(--admin-text-muted);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .home-composer {
      max-width: none;
      padding: 0 0.875rem 1rem;
    }

    .composer-pills {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 0.4rem;
    }

    .composer-pill {
      width: 100%;
      border-radius: 10px;
      padding: 0.45rem 0.55rem;
    }

    .pill-select {
      flex: 1;
    }

    .repo-input,
    .branch-input {
      grid-column: 1 / -1;
      width: 100%;
      border-radius: 10px;
    }

    .composer-bottom-row {
      flex-wrap: wrap;
      align-items: stretch;
      gap: 0.45rem;
      padding-top: 0.5rem;
    }

    .bottom-left,
    .bottom-right {
      width: 100%;
      justify-content: space-between;
    }

    .bottom-right {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.35fr) minmax(4rem, 0.65fr);
      gap: 0.45rem;
    }

    .bottom-select {
      width: 100%;
      min-height: 32px;
      border: 1px solid var(--admin-border);
      border-radius: 8px;
      background: var(--admin-surface);
      padding: 0.35rem 0.45rem;
    }

    .provider-select,
    .model-select {
      max-width: none;
    }
  }

  @media (max-width: 430px) {
    .composer-pills,
    .bottom-right {
      grid-template-columns: 1fr;
    }

    .bottom-left {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
</style>
