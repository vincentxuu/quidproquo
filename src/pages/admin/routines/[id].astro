---
export const prerender = false
import AdminV2Layout from '@/layouts/AdminV2Layout.astro'
const { id } = Astro.params
---

<AdminV2Layout title="Routine" section="routines">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h2>⚡ Routines / <span id="rname"></span></h2>
    <div style="display:flex; gap:8px;"><button id="edit" class="btn-secondary">Edit</button><button id="runnow" class="btn">▶ Run now</button></div>
  </div>
  <div style="display:grid; grid-template-columns: 1fr 1.2fr; gap:16px; margin-top:12px;">
    <div class="admin-panel" style="padding:12px;">
      <h3>Configuration</h3>
      <div id="config"></div>
      <h3 style="margin-top:12px;">Instructions</h3><pre id="instr" style="white-space:pre-wrap; background:var(--admin-surface-subtle); padding:12px; border-radius:6px;"></pre>
      <h3>Runs</h3>
      <div style="display:flex; gap:8px; margin:8px 0;"><input id="runFilter" class="input" placeholder="Filter" style="width:100px;" /><input id="runSearch" class="input" placeholder="Search runs" style="flex:1;" /></div>
      <div id="runs"></div>
    </div>
    <div class="admin-panel" style="padding:12px;">
      <h3>Session</h3><p class="page-desc">Continues in the same session across runs.</p>
      <pre id="transcript" style="min-height:300px; max-height:50vh; overflow:auto; background:var(--admin-surface-subtle); padding:12px;"></pre>
    </div>
  </div>
</AdminV2Layout>
<script is:inline define:vars={{ id }}>
  async function load() {
    const res = await fetch(`/api/admin/routines/${id}`)
    const data = await res.json()
    if (!res.ok) { document.getElementById('config').textContent = data.error || 'not found'; return }
    const r = data.routine
    document.getElementById('rname').textContent = r.name
    document.getElementById('config').innerHTML = `
      <div>Enabled: ${r.enabled ? 'On' : 'Off'}</div>
      <div>Triggers: ${r.trigger_type} ${r.cron ? '· ' + r.cron : ''}</div>
      <div>Repo: ${r.repo ?? '—'}</div>
      <div>Model: ${r.model ?? '—'}</div>
      <div>Connectors: ${(JSON.parse(r.connectors || '[]')).join(', ') || '—'}</div>
    `
    document.getElementById('instr').textContent = r.instructions || '(none)'
    const runsEl = document.getElementById('runs')
    let allRuns = data.runs ?? []
    function renderRuns() {
      const f = document.getElementById('runFilter').value
      const q = document.getElementById('runSearch').value.toLowerCase()
      let filtered = allRuns
      if (f) filtered = filtered.filter(r => r.status === f)
      if (q) filtered = filtered.filter(r => r.id.toLowerCase().includes(q))
      runsEl.innerHTML = filtered.length ? filtered.map(x => `<div class="run-row" data-id="${x.id}" style="border:1px solid var(--admin-border); padding:8px; margin:6px 0; border-radius:6px; cursor:pointer;">${x.id} · ${x.status} · ${new Date(x.created_at).toLocaleString()} <span style="float:right;">›</span></div>`).join('') : '<p class="empty">No fires yet</p>'
      runsEl.querySelectorAll('.run-row').forEach(el => el.addEventListener('click', () => loadTranscript(el.dataset.id)))
    }
    document.getElementById('runFilter').addEventListener('input', renderRuns)
    document.getElementById('runSearch').addEventListener('input', renderRuns)
    renderRuns()
    async function loadTranscript(sid) {
      const r = await fetch(`/api/admin/agents/sessions/${sid}`)
      const d = await r.json()
      if (!r.ok) { document.getElementById('transcript').textContent = d.error || 'not found'; return }
      const msgs = d.messages ?? []
      document.getElementById('transcript').textContent = msgs.map(m => `[${m.role}] ${JSON.parse(m.content_json)}${m.tool_name ? ' ('+m.tool_name+')' : ''}`).join('\n\n') || '(no messages)'
    }
  }
  document.getElementById('runnow').onclick = async () => {
    const res = await fetch(`/api/admin/routines/${id}`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({action:'run'}) })
    const data = await res.json()
    if (!res.ok) alert(data.error || 'failed'); else document.getElementById('transcript').textContent = 'Started session ' + data.sessionId + ' — open /admin/agents/console to view WS'
  }
  load()
</script>
