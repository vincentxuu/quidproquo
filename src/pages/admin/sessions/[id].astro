---
export const prerender = false;
import { AdminSessionChat } from '@/components/admin/session/AdminSessionChat';
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import { ensureConsoleUmbrella } from '../_guard';
import '@/styles/globals.css';

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const sessionId = Astro.params.id;
if (!sessionId) return Astro.redirect('/admin/sessions');
---

<AdminV2Layout
  title="Session"
  section="sessions"
  breadcrumb={[{ label: 'Sessions', href: '/admin/sessions' }, { label: sessionId.slice(0, 8) }]}
>
  <div class="session-standalone">
    <AdminSessionChat sessionId={sessionId} client:load />
  </div>


<style>
  .session-standalone {
    height: calc(100vh - 8rem);
    overflow: hidden;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius);
  }
</style>
</AdminV2Layout>
