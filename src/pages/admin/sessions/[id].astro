---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import { ensureConsoleUmbrella } from '../_guard';

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const sessionId = Astro.params.id;
if (!sessionId) return Astro.redirect('/admin/sessions');
---

<AdminV2Layout
  title="Session"
  section="sessions"
  breadcrumb={[{ label: 'Sessions', href: '/admin/sessions' }, { label: sessionId.slice(0, 8) }]}
>
  <div class="session-header">
    <div class="session-meta">
      <h2 id="session-name" class="session-name">載入中…</h2>
      <span id="session-status" class="badge badge-muted">—</span>
      <span id="status-indicator" class="status-indicator" hidden></span>
    </div>
    <div class="session-actions">
      <button type="button" class="action-btn" id="btn-stop" hidden>停止</button>
      <button type="button" class="action-btn" id="btn-resume" hidden>續聊</button>
      <button type="button" class="action-btn" id="btn-diff">Diff</button>
      <button type="button" class="action-btn" id="btn-rename">重新命名</button>
      <button type="button" class="action-btn" id="btn-archive" hidden>封存</button>
      <button type="button" class="action-btn" id="btn-share">分享</button>
      <button type="button" class="action-btn danger" id="btn-delete">刪除</button>
    </div>
  </div>

  <!-- Provisioning progress indicator -->
  <div id="provision-bar" class="provision-bar" hidden>
    <div class="prov-step pending" data-pstep="provision"><span class="prov-icon">○</span> Allocating sandbox</div>
    <div class="prov-conn"></div>
    <div class="prov-step pending" data-pstep="clone"><span class="prov-icon">○</span> Cloning repository</div>
    <div class="prov-conn"></div>
    <div class="prov-step pending" data-pstep="setup_script"><span class="prov-icon">○</span> Running setup</div>
    <div class="prov-conn"></div>
    <div class="prov-step pending" data-pstep="start_agent"><span class="prov-icon">○</span> Starting agent</div>
  </div>

  <div class="event-stream" id="event-stream">
    <p class="empty-text">連線中…</p>
  </div>

  <div id="resume-panel" class="resume-panel" hidden>
    <form id="resume-form" class="resume-form">
      <textarea id="resume-input" class="composer-input" rows="2" placeholder="輸入續聊訊息…" required></textarea>
      <button type="submit" class="composer-submit">送出</button>
    </form>
  </div>

  <!-- Diff slide-in panel -->
  <div id="diff-overlay" class="diff-overlay" hidden></div>
  <div id="diff-panel" class="diff-panel" hidden>
    <div class="diff-panel-header">
      <h3>Diff</h3>
      <button type="button" class="diff-close" id="diff-close" aria-label="關閉">&times;</button>
    </div>
    <div id="diff-content" class="diff-content">
      <p class="empty-text">載入中…</p>
    </div>
  </div>
</AdminV2Layout>

<script is:inline define:vars={{ sessionId }}>
  (function () {
    const streamEl = document.getElementById('event-stream');
    const nameEl = document.getElementById('session-name');
    const statusEl = document.getElementById('session-status');
    const btnStop = document.getElementById('btn-stop');
    const btnResume = document.getElementById('btn-resume');
    const btnArchive = document.getElementById('btn-archive');
    const btnShare = document.getElementById('btn-share');
    const btnDelete = document.getElementById('btn-delete');
    const btnRename = document.getElementById('btn-rename');
    const resumePanel = document.getElementById('resume-panel');
    const resumeForm = document.getElementById('resume-form');

    const btnDiff = document.getElementById('btn-diff');
    const diffPanel = document.getElementById('diff-panel');
    const diffOverlay = document.getElementById('diff-overlay');
    const diffContent = document.getElementById('diff-content');
    const diffClose = document.getElementById('diff-close');
    const provisionBar = document.getElementById('provision-bar');

    let eventSource = null;
    let lastEventId = null;
    let sessionStatus = 'unknown';
    const seenEvents = new Set();

    // --- Provision bar ---
    const PROV_STEPS = ['provision', 'clone', 'setup_script', 'start_agent'];
    const provState = {};
    PROV_STEPS.forEach(function (s) { provState[s] = 'pending'; });

    function updateProvBar(step, status) {
      provisionBar.hidden = false;
      provState[step] = status;
      PROV_STEPS.forEach(function (s) {
        var el = provisionBar.querySelector('[data-pstep="' + s + '"]');
        if (!el) return;
        var icon = el.querySelector('.prov-icon');
        el.className = 'prov-step ' + provState[s];
        if (provState[s] === 'completed') icon.textContent = '✓';
        else if (provState[s] === 'started') icon.textContent = '⟳';
        else if (provState[s] === 'failed') icon.textContent = '✗';
        else if (provState[s] === 'skipped') icon.textContent = '—';
        else icon.textContent = '○';
      });
    }

    // --- Diff panel ---
    function closeDiff() {
      diffPanel.hidden = true;
      diffOverlay.hidden = true;
      diffContent.innerHTML = '<p class="empty-text">載入中…</p>';
    }
    btnDiff?.addEventListener('click', async function () {
      diffPanel.hidden = false; diffOverlay.hidden = false;
      diffContent.innerHTML = '<p class="empty-text">載入中…</p>';
      const controller = new AbortController();
      const timeout = setTimeout(function () { controller.abort(); }, 10_000);
      try {
        var res = await fetch('/api/admin/sessions/' + encodeURIComponent(sessionId) + '/diff', { signal: controller.signal });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        var data = await res.json();
        if (!data.available) { diffContent.innerHTML = '<p class="empty-text">' + esc(data.reason || '尚無 Diff') + '</p>'; return; }
        var html = '<div class="diff-summary">' + esc(data.summary || '') + '</div>';
        if (data.files && data.files.length) {
          html += '<div class="diff-files">';
          data.files.forEach(function (f) {
            html += '<div class="diff-file"><span class="diff-fname">' + esc(f.name) + '</span>'
              + '<span class="diff-adds">+' + (f.additions || 0) + '</span>'
              + '<span class="diff-dels">-' + (f.deletions || 0) + '</span></div>';
          });
          html += '</div>';
        }
        diffContent.innerHTML = html || '<p class="empty-text">No changes</p>';
      } catch (error) {
        diffContent.innerHTML = '<div class="diff-empty"><p>Diff 載入失敗</p><small>' + esc(error?.name === 'AbortError' ? '請求逾時，可以關閉後重試。' : String(error?.message || error || 'Unknown error')) + '</small></div>';
      } finally {
        clearTimeout(timeout);
      }
    });
    diffClose?.addEventListener('click', closeDiff);
    diffOverlay?.addEventListener('click', closeDiff);

    async function loadSession() {
      try {
        const res = await fetch('/api/admin/sessions/' + encodeURIComponent(sessionId));
        if (!res.ok) return;
        const data = await res.json();
        const s = data.session || data;
        nameEl.textContent = s.name || s.instruction?.slice(0, 80) || sessionId.slice(0, 8);
        updateStatus(s.status);
        renderHistory(data.events || []);
      } catch {}
    }

    function renderHistory(events) {
      if (!Array.isArray(events) || events.length === 0) return;
      if (streamEl.querySelector('.empty-text')) streamEl.innerHTML = '';
      for (const row of events) {
        try {
          const type = String(row.type || '');
          const key = row.event_id ? String(row.event_id) : type + ':' + String(row.seq ?? '');
          if (seenEvents.has(key)) continue;
          seenEvents.add(key);
          lastEventId = row.event_id ? String(row.event_id) : lastEventId;
          renderEvent(type, JSON.parse(String(row.payload_json || '{}')), key);
        } catch {}
      }
      streamEl.scrollTop = streamEl.scrollHeight;
    }

    function updateStatus(status) {
      sessionStatus = status;
      statusEl.textContent = status;
      statusEl.className = 'badge badge-' + badgeClass(status);
      const running = status === 'running' || status === 'queued' || status === 'paused';
      btnStop.hidden = !running;
      btnResume.hidden = running;
      btnArchive.hidden = running;
      resumePanel.hidden = running;
      if (status === 'done' || status === 'failed' || status === 'cancelled') {
        resumePanel.hidden = false;
      }
    }

    function connectSSE() {
      const url = '/api/admin/sessions/' + encodeURIComponent(sessionId) + '/watch'
        + (lastEventId ? '?resume_token=' + lastEventId : '');
      eventSource = new EventSource(url);
      eventSource.onopen = function () {
        if (streamEl.querySelector('.empty-text')) streamEl.innerHTML = '';
      };
      const types = [
        'system/init', 'system/status', 'system/post_turn_summary',
        'user', 'assistant', 'tool_use', 'result',
        'control_request', 'control_response', 'env_manager_log',
        'prompt_suggestion',
        'vcs_state_changed', 'compact_boundary', 'tool_progress', 'rate_limit_event'
      ];
      for (const type of types) {
        eventSource.addEventListener(type, function (e) {
          const key = e.lastEventId || type + ':' + e.timeStamp + ':' + e.data;
          lastEventId = e.lastEventId || lastEventId;
          if (seenEvents.has(key)) return;
          seenEvents.add(key);
          renderEvent(type, JSON.parse(e.data), key);
          streamEl.scrollTop = streamEl.scrollHeight;
        });
      }
      eventSource.onerror = function () {
        eventSource?.close();
        if (sessionStatus === 'running' || sessionStatus === 'queued') {
          setTimeout(connectSSE, 2000);
        }
      };
    }

    const statusIndicator = document.getElementById('status-indicator');

    function setStatusIndicator(state, message) {
      if (!statusIndicator) return;
      statusIndicator.hidden = false;
      statusIndicator.className = 'status-indicator status-' + state;
      switch (state) {
        case 'working':
          statusIndicator.innerHTML = '<span class="status-dot pulse"></span>' + esc(message || 'Agent is working…');
          break;
        case 'finished':
          statusIndicator.innerHTML = '<span class="status-check">✓</span>' + esc(message || 'Agent finished');
          break;
        case 'waiting_approval':
          statusIndicator.innerHTML = '<span class="status-dot waiting"></span>' + esc(message || 'Waiting for approval');
          break;
        case 'error':
          statusIndicator.innerHTML = '<span class="status-dot error-dot"></span>' + esc(message || 'Error');
          break;
        default:
          statusIndicator.hidden = true;
      }
    }

    function renderToolLabel(toolName) {
      var labels = {
        'Bash': 'Ran a command',
        'Read': 'Read a file',
        'Write': 'Wrote a file',
        'Edit': 'Edited a file',
        'Glob': 'Listed files',
        'Grep': 'Searched files',
        'WebSearch': 'Searched the web',
        'WebFetch': 'Fetched a URL',
      };
      return labels[toolName] || toolName;
    }

    function renderTextBlock(text) {
      const value = String(text || '');
      if (!value.trim()) return '<div class="event-content muted">空訊息</div>';
      return '<div class="event-content">' + esc(value) + '</div>';
    }

    function renderEvent(type, payload, key) {
      const card = document.createElement('div');
      card.className = 'event-card event-' + type.replace('/', '-');
      if (key) card.dataset.eventKey = key;
      switch (type) {
        case 'user':
          card.className += ' message-card message-user';
          card.innerHTML = '<div class="event-role">User</div>' + renderTextBlock(payload.content || '');
          break;
        case 'assistant': {
          card.className += ' message-card message-assistant';
          var html = '<div class="event-role">Assistant</div>';
          var content = payload.content || '';
          var contentBlocks = payload.contentBlocks || payload.content_blocks;
          if (Array.isArray(contentBlocks)) {
            for (var i = 0; i < contentBlocks.length; i++) {
              var block = contentBlocks[i];
              if (block.type === 'thinking') {
                html += '<details class="thinking-block"><summary>Thinking…</summary>'
                  + '<div class="thinking-content">' + esc(block.thinking || block.text || '') + '</div></details>';
              } else if (block.type === 'text') {
                html += renderTextBlock(block.text || '');
              }
            }
          } else {
            html += renderTextBlock(content);
          }
          card.innerHTML = html;
          break;
        }
        case 'tool_use': {
          var toolName = payload.toolName || payload.name || payload.tool || 'tool';
          var hasResult = payload.result !== undefined && payload.result !== null;
          var hasError = !!payload.error;
          var borderClass = hasError ? ' tool-error' : hasResult ? ' tool-success' : '';
          var inputStr = JSON.stringify(payload.input || {}, null, 2);
          if (inputStr.length > 500) inputStr = inputStr.slice(0, 500) + '…';
          var resultHtml = '';
          if (hasError) {
            resultHtml = '<div class="tool-result-label">Error</div><pre class="event-pre tool-error-output">' + esc(String(payload.error).slice(0, 2000)) + '</pre>';
          } else if (hasResult) {
            var resStr = typeof payload.result === 'string' ? payload.result : JSON.stringify(payload.result, null, 2);
            if (resStr.length > 2000) resStr = resStr.slice(0, 2000) + '…';
            resultHtml = '<div class="tool-result-label">Output</div><pre class="event-pre">' + esc(resStr) + '</pre>';
          }
          card.innerHTML = '<details class="tool-card' + borderClass + '">'
            + '<summary class="tool-summary"><span class="tool-icon">🔧</span> <strong>' + esc(toolName) + '</strong> — ' + esc(renderToolLabel(toolName))
            + (payload.durationMs ? ' <span class="tool-duration">(' + (payload.durationMs / 1000).toFixed(1) + 's)</span>' : '')
            + '</summary>'
            + '<div class="tool-body">'
            + '<div class="tool-result-label">Input</div><pre class="event-pre">' + esc(inputStr) + '</pre>'
            + resultHtml
            + '</div></details>';
          break;
        }
        case 'result': {
          var out = typeof payload.content === 'string' ? payload.content : JSON.stringify(payload.content || payload.output || '');
          card.innerHTML = '<details class="tool-card result-card"><summary class="tool-summary"><span class="tool-icon">📋</span> <strong>Result</strong>'
            + (payload.totalTokens ? ' · ' + payload.totalTokens + ' tokens' : '')
            + '</summary><pre class="event-pre">' + esc(out.slice(0, 2000)) + '</pre></details>';
          break;
        }
        case 'control_request': {
          card.className += ' event-approval';
          var p = payload.payload || payload;
          var reqId = p.requestId || p.id || '';
          var isExitPlan = (payload.subtype === 'exit_plan_mode');
          var buttonsHtml;
          if (isExitPlan) {
            buttonsHtml = '<button class="action-btn" data-approve="accept">接受</button>'
              + '<button class="action-btn" data-approve="accept_auto">接受 + Auto mode</button>'
              + '<button class="action-btn danger" data-approve="reject">拒絕</button>';
          } else {
            buttonsHtml = '<button class="action-btn" data-approve="allow">允許</button>'
              + '<button class="action-btn danger" data-approve="deny">拒絕</button>';
          }
          var displayName = p.displayName || p.display_name || p.toolName || '';
          var reason = p.decisionReason || p.decision_reason || 'Permission request';
          card.innerHTML = '<div class="event-role">⚠️ ' + esc(displayName) + ' — ' + esc(reason) + '</div>'
            + (isExitPlan && p.input?.plan ? '<pre class="event-pre plan-preview">' + esc(String(p.input.plan).slice(0, 2000)) + '</pre>' : '')
            + '<div class="approval-buttons">' + buttonsHtml + '</div>';
          card.querySelectorAll('[data-approve]').forEach(function (btn) {
            btn.addEventListener('click', function () { handleApproval(reqId, btn.dataset.approve); });
          });
          setStatusIndicator('waiting_approval', displayName);
          break;
        }
        case 'control_response':
          card.innerHTML = '<div class="event-log">✅ ' + esc(payload.behavior || '') + (payload.requestId ? ' (' + esc(payload.requestId.slice(0, 8)) + ')' : '') + '</div>';
          setStatusIndicator('working');
          break;
        case 'system/status':
          setStatusIndicator(payload.state, payload.message);
          return;
        case 'system/post_turn_summary':
          updateStatus(payload.statusCategory || payload.status_category || sessionStatus);
          card.innerHTML = '<div class="event-log">📊 ' + esc(payload.statusDetail || payload.status_detail || 'Turn complete') + '</div>';
          setStatusIndicator('finished', payload.statusDetail || payload.status_detail);
          break;
        case 'system/init':
          card.innerHTML = '<div class="event-log">🚀 Session started · model: ' + esc(payload.model || '—') + ' · mode: ' + esc(payload.mode || '—') + '</div>';
          setStatusIndicator('working', 'Starting…');
          break;
        case 'env_manager_log': {
          updateProvBar(payload.step, payload.status);
          var stepLabels = { provision: 'Allocating sandbox', clone: 'Cloning repository', setup_script: 'Running setup script', start_agent: 'Starting agent' };
          var stepLabel = stepLabels[payload.step] || payload.step;
          var statusIcon = payload.status === 'completed' ? '✓' : payload.status === 'failed' ? '✗' : '⏳';
          var statusClass = payload.status === 'completed' ? 'step-done' : payload.status === 'failed' ? 'step-fail' : 'step-running';
          card.className += ' event-env-step';
          card.innerHTML = '<div class="env-step ' + statusClass + '"><span class="env-step-icon">' + statusIcon + '</span> ' + esc(stepLabel)
            + (payload.durationMs ? ' <span class="tool-duration">(' + (payload.durationMs / 1000).toFixed(1) + 's)</span>' : '')
            + (payload.message ? ' — ' + esc(payload.message) : '') + '</div>';
          break;
        }
        case 'prompt_suggestion': {
          var suggestions = payload.suggestions || [];
          if (!suggestions.length) return;
          card.className += ' event-suggestions';
          var chipsHtml = suggestions.map(function (s) {
            return '<button class="suggestion-chip">' + esc(s) + '</button>';
          }).join('');
          card.innerHTML = '<div class="prompt-suggestions">' + chipsHtml + '</div>';
          card.querySelectorAll('.suggestion-chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
              var input = document.getElementById('resume-input');
              if (input) { input.value = chip.textContent; input.focus(); resumePanel.hidden = false; }
            });
          });
          break;
        }
        case 'tool_progress':
          card.innerHTML = '<div class="event-log">⏳ ' + esc(payload.toolName || '') + ': ' + esc(payload.progress || '') + '</div>';
          break;
        case 'vcs_state_changed':
          card.innerHTML = '<div class="event-log">🔀 Branch: ' + esc(payload.branch || '') + (payload.commitSha ? ' · ' + esc(payload.commitSha.slice(0, 7)) : '') + (payload.diffStat ? ' · ' + esc(payload.diffStat) : '') + '</div>';
          break;
        case 'rate_limit_event':
          card.innerHTML = '<div class="event-log">⏱️ Rate limited' + (payload.provider ? ' (' + esc(payload.provider) + ')' : '') + ' — retry in ' + ((payload.retryAfterMs || 0) / 1000).toFixed(0) + 's</div>';
          break;
        default:
          card.innerHTML = '<div class="event-log">' + esc(type) + ': ' + esc(JSON.stringify(payload).slice(0, 200)) + '</div>';
      }
      streamEl.appendChild(card);
    }

    async function handleApproval(approvalId, behavior) {
      try {
        await fetch('/api/admin/sessions/' + encodeURIComponent(sessionId) + '/approve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ approval_id: approvalId, behavior }),
        });
      } catch {}
    }

    btnStop?.addEventListener('click', async function () {
      btnStop.disabled = true;
      try { await fetch('/api/admin/sessions/' + encodeURIComponent(sessionId) + '/stop', { method: 'POST' }); updateStatus('cancelled'); } catch {} finally { btnStop.disabled = false; }
    });
    btnRename?.addEventListener('click', async function () {
      const name = prompt('新名稱：'); if (!name) return;
      try { await fetch('/api/admin/sessions/' + encodeURIComponent(sessionId), { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) }); nameEl.textContent = name; } catch {}
    });
    btnArchive?.addEventListener('click', async function () {
      try { await fetch('/api/admin/sessions/' + encodeURIComponent(sessionId), { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ archived: true }) }); alert('已封存'); } catch {}
    });
    btnShare?.addEventListener('click', async function () {
      try { const res = await fetch('/api/admin/sessions/' + encodeURIComponent(sessionId) + '/share', { method: 'POST' }); const data = await res.json(); if (data.url) { await navigator.clipboard?.writeText(data.url).catch(function () {}); alert('分享連結已複製：' + data.url); } } catch {}
    });
    btnDelete?.addEventListener('click', async function () {
      if (!confirm('確定刪除此 Session？')) return;
      try { await fetch('/api/admin/sessions/' + encodeURIComponent(sessionId), { method: 'DELETE' }); window.location.href = '/admin/sessions'; } catch {}
    });
    resumeForm?.addEventListener('submit', async function (e) {
      e.preventDefault();
      const msg = document.getElementById('resume-input')?.value?.trim(); if (!msg) return;
      try { await fetch('/api/admin/sessions/' + encodeURIComponent(sessionId) + '/resume', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message: msg }) }); document.getElementById('resume-input').value = ''; updateStatus('running'); connectSSE(); } catch {}
    });

    function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
    function badgeClass(status) { switch (status) { case 'done': return 'success'; case 'failed': return 'error'; case 'running': return 'running'; case 'cancelled': return 'muted'; default: return 'pending'; } }

    loadSession().finally(connectSSE);
  })();
</script>

<style>
  .session-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .session-meta { display: flex; align-items: center; gap: 0.75rem; min-width: 0; flex: 1; }
  .session-name { font-size: 1.15rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .session-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .action-btn { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; border: 1px solid var(--admin-border); border-radius: var(--admin-radius, 6px); background: var(--admin-surface); color: var(--admin-text); cursor: pointer; font: inherit; font-size: 0.82rem; padding: 0.45rem 0.7rem; }
  .action-btn:hover { background: var(--admin-muted); }
  .action-btn.danger { border-color: var(--admin-color-danger-soft); color: var(--admin-color-danger); }
  .action-btn:disabled { opacity: 0.5; cursor: wait; }
  .event-stream {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius, 6px);
    background: var(--admin-surface);
    max-height: calc(100vh - 230px);
    min-height: 280px;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.8rem;
  }
  .event-card {
    min-width: 0;
    max-width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 7px;
    overflow: hidden;
  }
  .event-card:last-child { border-bottom: none; }
  .message-card {
    width: min(100%, 980px);
    border-color: var(--admin-border);
    background: #fff;
  }
  .message-user {
    align-self: flex-end;
    max-width: min(82%, 720px);
    background: var(--brand-50, #f0f7ef);
    border-color: var(--brand-200, var(--admin-border));
  }
  .message-assistant {
    align-self: flex-start;
    background: #fff;
  }
  .event-system-init,
  .event-system-post_turn_summary,
  .event-control_response,
  .event-tool_progress,
  .event-vcs_state_changed,
  .event-rate_limit_event,
  .event-env_manager_log {
    align-self: stretch;
    padding: 0.25rem 0.4rem;
  }
  .event-role { font-size: 0.72rem; font-weight: 750; color: var(--admin-text-muted); margin-bottom: 0.35rem; }
  .event-content {
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
    white-space: pre-wrap;
    color: var(--admin-text);
    font-size: 0.92rem;
    line-height: 1.7;
  }
