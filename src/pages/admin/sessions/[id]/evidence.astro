---
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import AdminState from '@/components/admin/AdminState.astro';
import { getEnv } from '@/lib/config/env';
import { readFlags } from '@/lib/config/flags';
import { ensureConsoleUmbrella } from '../../_guard';
import { D1SourceStoreBackend } from '@/lib/evidence/storage/d1/source-store';
import { D1ExcerptStoreBackend } from '@/lib/evidence/storage/d1/excerpt-store';
import { D1ClaimStoreBackend } from '@/lib/evidence/storage/d1/claim-store';
import { D1CitationStoreBackend } from '@/lib/evidence/storage/d1/citation-store';
import { D1ConflictStoreBackend } from '@/lib/evidence/storage/d1/conflict-store';
import { D1ClaimFtsBackend } from '@/lib/evidence/storage/d1/claim-fts';
import type {
  SourceRecord,
  ExcerptRecord,
  ClaimRecord,
  CitationRecord,
  ConflictRecord,
} from '@/lib/evidence/storage/types';
import '@/styles/globals.css';

export const prerender = false;

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const flowRunId = Astro.params.id ?? '';
const selectedSourceId = Astro.url.searchParams.get('source');
const selectedClaimId = Number(Astro.url.searchParams.get('claim') ?? '');
const claimSearchQuery = Astro.url.searchParams.get('q')?.trim() ?? '';

// Gate: evidence flag
const env = getEnv();
const flags = readFlags(env);
const evidenceEnabled = flags.agentEvidence.enabled;

// ---- data loading ----
interface SourceWithMeta extends SourceRecord {
  domain: string
  excerptCount: number
  conflictCount: number
}

let sources: SourceWithMeta[] = [];
let excerpts: ExcerptRecord[] = [];
let claims: ClaimRecord[] = [];
let citations: CitationRecord[] = [];
let conflicts: ConflictRecord[] = [];
let searchedClaimIds: number[] | null = null;
let loadError = false;
const CONFLICT_STATUSES = ['pending', 'approved', 'rejected', 'expired'] as const;

if (evidenceEnabled && flowRunId) {
  try {
    const db = env.DB;
    const sourceStore = new D1SourceStoreBackend(db);
    const excerptStore = new D1ExcerptStoreBackend(db);
    const claimStore = new D1ClaimStoreBackend(db);
    const citationStore = new D1CitationStoreBackend(db);
    const conflictStore = new D1ConflictStoreBackend(db);
    const ftsStore = new D1ClaimFtsBackend(db);

    const [rawSources, rawClaims] = await Promise.all([
      sourceStore.listForFlowRun(flowRunId),
      claimStore.listForFlowRun(flowRunId),
    ]);

    claims = rawClaims;

    if (claimSearchQuery) {
      const searchResults = await ftsStore.search(claimSearchQuery, flowRunId, 50);
      searchedClaimIds = searchResults.map((item) => item.claimId);
    }

    const excerptsBySource = await Promise.all(
      rawSources.map((s) => excerptStore.listForSource(s.sourceId)),
    );
    excerpts = excerptsBySource.flat();

    const citationsByClaim = await Promise.all(
      rawClaims.map((c) => citationStore.listForClaim(c.claimId)),
    );
    citations = citationsByClaim.flat();

    const claimIds = new Set(rawClaims.map((c) => c.claimId));
    const conflictsByStatus = await Promise.all(
      CONFLICT_STATUSES.map((status) => conflictStore.listByStatus(status, { limit: 100 })),
    );
    conflicts = conflictsByStatus
      .flatMap((result) => result.conflicts)
      .filter((cf) => claimIds.has(cf.claimAId) || claimIds.has(cf.claimBId))
      .sort((a, b) => {
        if (a.status === 'pending' && b.status !== 'pending') return -1;
        if (a.status !== 'pending' && b.status === 'pending') return 1;
        return b.updatedAt - a.updatedAt;
      });

    const excerptCountBySource = new Map<number, number>();
    for (const e of excerpts) {
      excerptCountBySource.set(e.sourceId, (excerptCountBySource.get(e.sourceId) ?? 0) + 1);
    }

    const excerptToSource = new Map<number, number>();
    for (const e of excerpts) {
      excerptToSource.set(e.excerptId, e.sourceId);
    }
    const claimToExcerpts = new Map<number, number[]>();
    for (const cit of citations) {
      if (!claimToExcerpts.has(cit.claimId)) claimToExcerpts.set(cit.claimId, []);
      claimToExcerpts.get(cit.claimId)!.push(cit.excerptId);
    }
    const conflictCountBySource = new Map<number, number>();
    for (const cf of conflicts) {
      for (const claimId of [cf.claimAId, cf.claimBId]) {
        for (const excerptId of (claimToExcerpts.get(claimId) ?? [])) {
          const sourceId = excerptToSource.get(excerptId);
          if (sourceId !== undefined) {
            conflictCountBySource.set(sourceId, (conflictCountBySource.get(sourceId) ?? 0) + 1);
          }
        }
      }
    }

    sources = rawSources.map((s) => {
      let domain = '';
      try {
        domain = new URL(s.url).hostname;
      } catch {
        domain = s.url;
      }
      return {
        ...s,
        domain,
        excerptCount: excerptCountBySource.get(s.sourceId) ?? 0,
        conflictCount: conflictCountBySource.get(s.sourceId) ?? 0,
      };
    });
  } catch {
    loadError = true;
  }
}

const sourcesByDomain = sources.reduce<Record<string, SourceWithMeta[]>>((acc, s) => {
  acc[s.domain] ??= [];
  acc[s.domain].push(s);
  return acc;
}, {});

const selectedSource = selectedSourceId
  ? sources.find((s) => String(s.sourceId) === selectedSourceId) ?? null
  : null;

const selectedExcerpts = selectedSource
  ? excerpts.filter((e) => e.sourceId === selectedSource.sourceId)
  : [];

const claimById = new Map(claims.map((c) => [c.claimId, c]));
const sourceById = new Map(sources.map((s) => [s.sourceId, s]));
const excerptById = new Map(excerpts.map((e) => [e.excerptId, e]));
const citationsByExcerpt = new Map<number, CitationRecord[]>();
const citationsByClaimMap = new Map<number, CitationRecord[]>();
for (const cit of citations) {
  if (!citationsByExcerpt.has(cit.excerptId)) citationsByExcerpt.set(cit.excerptId, []);
  citationsByExcerpt.get(cit.excerptId)!.push(cit);
  if (!citationsByClaimMap.has(cit.claimId)) citationsByClaimMap.set(cit.claimId, []);
  citationsByClaimMap.get(cit.claimId)!.push(cit);
}

const visibleClaims = (searchedClaimIds
  ? searchedClaimIds.map((claimId) => claimById.get(claimId)).filter((claim): claim is ClaimRecord => Boolean(claim))
  : [...claims].sort((a, b) => b.confidence - a.confidence)
).slice(0, 25);

const selectedClaim = Number.isFinite(selectedClaimId) ? claimById.get(selectedClaimId) ?? null : null;
const selectedClaimCitations = selectedClaim ? citationsByClaimMap.get(selectedClaim.claimId) ?? [] : [];
const selectedClaimExcerptDetails = selectedClaimCitations.map((citation) => {
  const excerpt = excerptById.get(citation.excerptId) ?? null;
  const source = excerpt ? sourceById.get(excerpt.sourceId) ?? null : null;
  return { citation, excerpt, source };
});

const conflictDetails = conflicts.map((cf) => ({
  ...cf,
  claimA: claimById.get(cf.claimAId) ?? null,
  claimB: claimById.get(cf.claimBId) ?? null,
}));
const pendingConflictCount = conflicts.filter((cf) => cf.status === 'pending').length;
const resolvedConflictCount = conflicts.length - pendingConflictCount;

function truncateUrl(url: string, max = 60): string {
  if (url.length <= max) return url;
  return url.slice(0, max) + '…';
}

function claimHref(claimId: number): string {
  const u = new URL(Astro.url);
  u.searchParams.set('claim', String(claimId));
  u.searchParams.delete('source');
  return u.pathname + u.search;
}

function sourceHref(sourceId: number): string {
  const u = new URL(Astro.url);
  u.searchParams.set('source', String(sourceId));
  u.searchParams.delete('claim');
  return u.pathname + u.search;
}

function confidenceClass(confidence: number): string {
  if (confidence < 0.4) return 'bg-red-100 text-red-800';
  if (confidence <= 0.7) return 'bg-amber-100 text-amber-800';
  return 'bg-green-100 text-green-800';
}

function relationClass(relation: string): string {
  if (relation === 'supports') return 'bg-green-100 text-green-800';
  if (relation === 'refutes') return 'bg-red-100 text-red-800';
  return 'bg-sky-100 text-sky-800';
}

function verdictClass(status: string): string {
  if (status === 'pending') return 'bg-yellow-100 text-yellow-800';
  if (status === 'approved') return 'bg-green-100 text-green-800';
  if (status === 'rejected') return 'bg-red-100 text-red-800';
  return 'bg-muted text-muted-foreground';
}

function conflictStatusLabel(status: string): string {
  switch (status) {
    case 'pending': return '待處理';
    case 'approved': return '已採用';
    case 'rejected': return '已排除';
    case 'expired': return '已逾期';
    default: return status;
  }
}

function resolutionLabel(resolution: string | null): string {
  switch (resolution) {
    case 'accepted_a': return '採用左側';
    case 'accepted_b': return '採用右側';
    case 'dismissed': return '標記不處理';
    default: return resolution ?? '—';
  }
}

const breadcrumb = [
  { label: '執行記錄', href: '/admin/runs' },
  { label: flowRunId.slice(0, 8) + '…', href: `/admin/sessions/${flowRunId}` },
  { label: '來源證據' },
];
---

<AdminV2Layout title="來源證據檢視器" section="sessions" breadcrumb={breadcrumb}>
  {!evidenceEnabled && (
    <AdminState tone="empty">代理程式證據功能已停用。請設定 <code>AGENT_EVIDENCE_ENABLED=true</code> 以啟用。</AdminState>
  )}
  {evidenceEnabled && loadError && (
    <AdminState tone="error">無法載入此執行的來源證據。</AdminState>
  )}
  {evidenceEnabled && !loadError && (
    <div class="grid grid-cols-[240px_1fr_260px] items-start gap-4 max-lg:grid-cols-[200px_1fr_220px] max-md:grid-cols-1">

      {/* Left rail — source list */}
      <aside class="overflow-hidden rounded-lg border border-border bg-card shadow-sm" aria-label="來源">
        <div class="border-b border-border bg-background px-3 py-2.5">
          <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-muted-foreground">
            來源
            <span class="inline-flex min-w-5 items-center justify-center rounded-full bg-muted px-1.5 font-mono text-[0.78em] font-bold text-muted-foreground">{sources.length}</span>
          </h3>
        </div>
        {sources.length === 0 ? (
          <p class="px-3 py-4 text-sm text-muted-foreground">此執行尚無來源。</p>
        ) : (
          <div class="max-h-[calc(100vh-200px)] overflow-y-auto">
            {Object.entries(sourcesByDomain).map(([domain, domainSources]) => (
              <div class="border-b border-border py-2 last:border-b-0">
                <div class="px-3 font-mono text-[0.7rem] font-bold uppercase tracking-wide text-muted-foreground">{domain}</div>
                {domainSources.map((src) => (
                  <a
                    id={`source-${src.sourceId}`}
                    href={`?source=${src.sourceId}`}
                    class:list={[
                      'flex flex-col gap-1 border-l-[3px] px-3 py-2 text-foreground no-underline transition-colors hover:bg-accent',
                      String(src.sourceId) === selectedSourceId ? 'border-l-primary bg-accent' : 'border-l-transparent',
                    ]}
                    aria-current={String(src.sourceId) === selectedSourceId ? 'true' : undefined}
                    title={src.url}
                  >
                    <span class="break-all font-mono text-xs text-muted-foreground">{truncateUrl(src.url)}</span>
                    <div class="flex gap-1.5">
                      <span class="inline-flex items-center rounded-full bg-muted px-1.5 font-mono text-[0.68rem] font-semibold text-muted-foreground" title="Excerpts">{src.excerptCount} exc</span>
                      {src.conflictCount > 0 && (
                        <span class="inline-flex items-center rounded-full bg-red-50 px-1.5 font-mono text-[0.68rem] font-semibold text-red-800" title="Conflicts">{src.conflictCount} !</span>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            ))}
          </div>
        )}
      </aside>

      {/* Main panel — excerpts + claims */}
      <main class="overflow-hidden rounded-lg border border-border bg-card shadow-sm" aria-label="摘錄與聲明">
        <form class="flex flex-wrap items-center gap-2 border-b border-border p-3" method="GET" action={`/admin/sessions/${flowRunId}/evidence`}>
          <label for="claim-q" class="text-sm text-muted-foreground">搜尋聲明</label>
          <input id="claim-q" name="q" type="search" value={claimSearchQuery} placeholder="cosine similarity" class="min-w-60 flex-1 rounded-md border border-input px-2.5 py-1.5 text-sm" />
          <button type="submit" class="inline-flex h-8 items-center rounded-md border border-input bg-card px-2.5 text-sm hover:bg-accent">搜尋</button>
          {claimSearchQuery && <a href={`/admin/sessions/${flowRunId}/evidence`} class="inline-flex h-8 items-center rounded-md border border-input bg-card px-2.5 text-sm hover:bg-accent">清除</a>}
        </form>

        {selectedClaim ? (
          <section class="grid gap-3 p-3" aria-label="Claim detail">
            <header class="flex items-start justify-between gap-4 rounded-lg border border-border bg-card p-3">
              <div>
                <h3 class="mb-1 text-[0.95rem] font-bold">Claim #{selectedClaim.claimId}</h3>
                <p class="text-sm leading-relaxed">{selectedClaim.claimText}</p>
              </div>
              <span class={`inline-flex min-w-[42px] items-center justify-center rounded-full font-mono text-xs font-bold px-2 py-0.5 ${confidenceClass(selectedClaim.confidence)}`}>
                {selectedClaim.confidence.toFixed(2)}
              </span>
            </header>
            {selectedClaimExcerptDetails.length === 0 ? (
              <AdminState tone="empty">此聲明尚無引用。</AdminState>
            ) : (
              <div class="grid gap-3">
                {selectedClaimExcerptDetails.map(({ citation, excerpt, source }) => (
                  <article class="rounded-lg border border-border bg-card p-3" data-excerpt-id={excerpt?.excerptId}>
                    <div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                      <span class={`shrink-0 rounded-full px-1.5 py-0.5 text-[0.68rem] font-bold uppercase tracking-wider ${relationClass(citation.relation)}`}>{citation.relation}</span>
                      {source && <a href={sourceHref(source.sourceId)}>{source.domain}</a>}
                      {source && <span>{new Date(source.retrievedAt).toLocaleString('zh-TW')}</span>}
                    </div>
                    {excerpt ? (
                      <Fragment>
                        <p class="mb-1 text-sm leading-relaxed">{excerpt.text}</p>
                        <div class="mt-2 rounded-lg border border-border bg-background p-2.5">
                          <span class="mb-1 block text-xs font-bold uppercase text-muted-foreground">來源預覽</span>
                          <p class="text-sm text-muted-foreground">{source?.bodyText ?? excerpt.surroundingContext ?? excerpt.text}</p>
                        </div>
                      </Fragment>
                    ) : (
                      <p class="text-sm text-muted-foreground">找不到摘錄。</p>
                    )}
                  </article>
                ))}
              </div>
            )}
          </section>
        ) : !selectedSource ? (
          <section class="grid gap-3 p-3" aria-label="聲明">
            <h3 class="text-[0.95rem] font-bold">
              聲明
              <span class="ml-1 inline-flex min-w-5 items-center justify-center rounded-full bg-muted px-1.5 font-mono text-[0.78em] font-bold text-muted-foreground">{claimSearchQuery ? visibleClaims.length : claims.length}</span>
            </h3>
            {visibleClaims.length === 0 ? (
              <AdminState tone="empty">{claimSearchQuery ? '無符合搜尋的聲明。' : '此執行尚無聲明。'}</AdminState>
            ) : (
              <div class="grid gap-2">
                {visibleClaims.map((claim) => {
                  const cited = (citationsByClaimMap.get(claim.claimId) ?? []).length > 0;
                  return (
                    <a href={claimHref(claim.claimId)} class="grid grid-cols-[auto_1fr_auto] items-center gap-2 rounded-lg border border-border bg-card p-2.5 text-foreground no-underline hover:bg-accent/50">
                      <span class={`inline-flex min-w-[42px] items-center justify-center rounded-full font-mono text-xs font-bold px-2 py-0.5 ${confidenceClass(claim.confidence)}`}>{claim.confidence.toFixed(2)}</span>
                      <span class="text-sm leading-relaxed">{claim.claimText}</span>
                      {!cited && <span class="text-xs text-amber-800">uncited</span>}
                      <span class="col-span-full h-[5px] overflow-hidden rounded-full bg-muted"><span style={`width: ${Math.max(0, Math.min(100, claim.confidence * 100))}%`} class="block h-full bg-primary"></span></span>
                    </a>
                  );
                })}
              </div>
            )}
          </section>
        ) : (
          <Fragment>
            <div class="border-b border-border bg-background px-4 py-3">
              <h3 class="mb-1 text-sm font-bold">
                <a href={selectedSource.url} target="_blank" rel="noopener noreferrer" class="break-all font-mono text-xs text-primary hover:underline">
                  {truncateUrl(selectedSource.url, 80)}
                </a>
              </h3>
              <p class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                <span>新鮮度：{selectedSource.freshnessScore.toFixed(2)}</span>
                {selectedSource.domain && <span class="rounded-full border border-border px-1.5 font-mono text-[0.7rem]">{selectedSource.domain}</span>}
              </p>
            </div>

            {selectedExcerpts.length === 0 ? (
              <AdminState tone="empty">此來源尚無摘錄。</AdminState>
            ) : (
              <div class="grid max-h-[calc(100vh-200px)] gap-3 overflow-y-auto p-4">
                {selectedExcerpts.map((exc) => {
                  const excCitations = citationsByExcerpt.get(exc.excerptId) ?? [];
                  return (
                    <div class="rounded-md border border-border bg-background p-2.5">
                      <p class="mb-1 text-sm leading-relaxed">{exc.text}</p>
                      {exc.surroundingContext && (
                        <p class="mb-1 text-xs italic text-muted-foreground">{exc.surroundingContext}</p>
                      )}
                      {excCitations.length > 0 && (
                        <div class="mt-2 grid gap-1.5 border-t border-border pt-2">
                          {excCitations.map((cit) => {
                            const claim = claimById.get(cit.claimId);
                            return claim ? (
                              <div class="flex flex-wrap items-start gap-1.5 text-xs">
                                <span class={`shrink-0 rounded-full px-1.5 py-0.5 text-[0.68rem] font-bold uppercase tracking-wider ${relationClass(cit.relation)}`}>
                                  {cit.relation}
                                </span>
                                <span class="min-w-0 flex-1 leading-snug">{claim.claimText}</span>
                                <a
                                  href={claimHref(claim.claimId)}
                                  class="shrink-0 rounded border border-primary/50 px-1 text-[0.68rem] text-primary opacity-75 hover:opacity-100"
                                  title="開啟聲明詳情"
                                >
                                  詳情
                                </a>
                                <span class="shrink-0 font-mono text-[0.68rem] text-muted-foreground" title="Confidence">
                                  {(claim.confidence * 100).toFixed(0)}%
                                </span>
                              </div>
                            ) : null;
                          })}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </Fragment>
        )}
      </main>

      {/* Right rail — conflicts */}
      <aside id="conflicts" class="conflicts-rail overflow-hidden rounded-lg border border-border bg-card shadow-sm" aria-label="衝突">
        <div class="border-b border-border bg-background px-3 py-2.5">
          <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-muted-foreground">
            衝突
            <span class="inline-flex min-w-5 items-center justify-center rounded-full bg-muted px-1.5 font-mono text-[0.78em] font-bold text-muted-foreground">{conflicts.length}</span>
          </h3>
          <p class="rail-subtitle mt-1 text-xs text-muted-foreground">待處理 {pendingConflictCount} / 已處理 {resolvedConflictCount}</p>
          {conflicts.length > 0 && (
            <div class="mt-2 grid gap-2" aria-label="衝突檢視與批次操作">
              <div class="flex w-fit overflow-hidden rounded-md border border-border" role="group" aria-label="衝突檢視">
                <button type="button" data-conflict-filter="pending" class="active min-h-8 border-0 bg-primary px-2.5 text-xs font-bold text-primary-foreground" aria-pressed="true">待處理</button>
                <button type="button" data-conflict-filter="all" class="min-h-8 border-0 border-l border-border bg-card px-2.5 text-xs font-bold text-muted-foreground" aria-pressed="false">全部</button>
              </div>
              {pendingConflictCount > 0 && (
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-xs font-bold text-muted-foreground" data-conflict-selection-count>已選 0</span>
                  <button type="button" class="min-h-8 w-fit rounded-md border border-red-200 bg-red-50 px-2.5 text-xs font-bold text-red-800 disabled:cursor-not-allowed disabled:opacity-65" data-bulk-selected-resolution="dismissed" disabled>
                    標記所選不處理
                  </button>
                  <button type="button" class="min-h-8 w-fit rounded-md border border-red-200 bg-red-50 px-2.5 text-xs font-bold text-red-800" data-bulk-resolution="dismissed">
                    全部標記不處理
                  </button>
                </div>
              )}
              <p class="m-0 rounded-md border border-border bg-muted px-2.5 py-2 text-xs leading-relaxed text-muted-foreground" data-conflict-operation-preview role="status" aria-live="polite">
                選取衝突後可批次標記不處理；單筆可採用左側、採用右側或標記不處理。
              </p>
            </div>
          )}
        </div>
        {conflicts.length === 0 ? (
          <p class="px-3 py-4 text-sm text-muted-foreground">目前無衝突。</p>
        ) : (
          <div class="grid max-h-[calc(100vh-200px)] gap-2 overflow-y-auto p-2">
            {conflictDetails.map((cf) => (
              <div class="rounded-md border border-border bg-background p-2.5 data-[conflict-status=approved]:opacity-80 data-[conflict-status=rejected]:opacity-80 data-[conflict-status=expired]:opacity-80" data-conflict-card data-conflict-status={cf.status} hidden={cf.status !== 'pending'}>
                {cf.status === 'pending' && (
                  <label class="conflict-select mb-2 inline-flex cursor-pointer items-center gap-1.5 text-xs font-bold text-muted-foreground">
                    <input type="checkbox" data-conflict-select value={String(cf.conflictId)} class="size-4" />
                    <span>加入批次處理</span>
                  </label>
                )}
                <div class="mb-2 grid grid-cols-[1fr_auto_1fr] items-start gap-1.5">
                  <div class="rounded border border-border bg-card p-1.5">
                    <p class="text-xs leading-snug">{cf.claimA?.claimText ?? `Claim #${cf.claimAId}`}</p>
                  </div>
                  <div class="flex items-center justify-center pt-1.5 text-[0.68rem] font-bold uppercase text-muted-foreground" aria-hidden="true">vs</div>
                  <div class="rounded border border-border bg-card p-1.5">
                    <p class="text-xs leading-snug">{cf.claimB?.claimText ?? `Claim #${cf.claimBId}`}</p>
                  </div>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-1.5">
                  <span class="max-w-[120px] truncate font-mono text-[0.68rem] text-muted-foreground" title="Detected by">{cf.detectedBy}</span>
                  <span class={`verdict-badge shrink-0 rounded-full px-2 py-0.5 text-[0.68rem] font-bold capitalize ${verdictClass(cf.status)}`}>{conflictStatusLabel(cf.status)}</span>
                </div>
                {cf.status === 'pending' && (
                  <div class="mt-2 flex flex-wrap gap-1.5" data-conflict-id={cf.conflictId}>
                    <button type="button" data-resolution="accepted_a" class="inline-flex h-8 items-center rounded-md border border-input bg-card px-2.5 text-xs hover:bg-accent">採用左側</button>
                    <button type="button" data-resolution="accepted_b" class="inline-flex h-8 items-center rounded-md border border-input bg-card px-2.5 text-xs hover:bg-accent">採用右側</button>
                    <button type="button" data-resolution="dismissed" class="inline-flex h-8 items-center rounded-md border border-input bg-card px-2.5 text-xs hover:bg-accent">標記不處理</button>
                  </div>
                )}
                {cf.status !== 'pending' && (
                  <div class="mt-2 inline-flex rounded-md border border-green-300 bg-green-50 px-2 py-1 text-xs font-bold text-green-800">
                    已處理：{resolutionLabel(cf.resolvedBy) || conflictStatusLabel(cf.status)}
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
        <p id="conflict-action-status" class="conflict-action-status m-0 border-t border-border px-3 py-2.5 text-sm text-muted-foreground" role="status" aria-live="polite" hidden></p>
      </aside>

    </div>
  )}
</AdminV2Layout>

<script is:inline>
  const conflictsRail = document.querySelector('.conflicts-rail');
  const conflictStatus = document.getElementById('conflict-action-status');
  const operationPreview = document.querySelector('[data-conflict-operation-preview]');
  let activeConflictFilter = 'pending';

  const resolutionLabels = {
    accepted_a: '採用左側',
    accepted_b: '採用右側',
    dismissed: '標記不處理',
  };

  const statusLabels = {
    pending: '待處理',
    approved: '已採用',
    rejected: '已排除',
    expired: '已逾期',
  };

  function setConflictStatus(message, tone) {
    if (!conflictStatus) return;
    conflictStatus.hidden = false;
    conflictStatus.textContent = message;
    conflictStatus.style.color = tone === 'success' ? '#15803d' : tone === 'error' ? '#b91c1c' : '';
  }

  function updateConflictCounts() {
    if (!conflictsRail) return;
    const headerSubtitle = conflictsRail.querySelector('.rail-subtitle');
    const pendingCards = conflictsRail.querySelectorAll('[data-conflict-status="pending"]').length;
    const allCards = conflictsRail.querySelectorAll('[data-conflict-card]').length;
    if (headerSubtitle) {
      headerSubtitle.textContent = '待處理 ' + pendingCards + ' / 已處理 ' + Math.max(0, allCards - pendingCards);
    }

    const bulkButton = conflictsRail.querySelector('[data-bulk-resolution]');
    if (bulkButton instanceof HTMLButtonElement) {
      bulkButton.hidden = pendingCards === 0;
    }
    updateConflictSelection();
  }

  function selectedConflictRoots() {
    if (!conflictsRail) return [];
    return Array.from(conflictsRail.querySelectorAll('[data-conflict-select]:checked'))
      .map(function(input) {
        if (!(input instanceof HTMLInputElement)) return null;
        var card = input.closest('[data-conflict-card]');
        return card?.querySelector('[data-conflict-id]') ?? null;
      })
      .filter(function(root) { return root instanceof HTMLElement && root.closest('[data-conflict-status="pending"]'); });
  }

  function updateConflictSelection() {
    var selected = selectedConflictRoots();
    var label = conflictsRail?.querySelector('[data-conflict-selection-count]');
    if (label) label.textContent = '已選 ' + selected.length;
    var pendingCount = conflictsRail?.querySelectorAll('[data-conflict-status="pending"]').length ?? 0;
    var selectedBulk = conflictsRail?.querySelector('[data-bulk-selected-resolution]');
    if (selectedBulk instanceof HTMLButtonElement) {
      selectedBulk.disabled = selected.length === 0;
      selectedBulk.hidden = pendingCount === 0;
    }
    if (operationPreview) {
      operationPreview.textContent = selected.length > 0
        ? '已選 ' + selected.length + ' 個衝突；按「標記所選不處理」會把它們更新為已排除。'
        : pendingCount > 0
          ? '目前有 ' + pendingCount + ' 個待處理衝突；可逐筆處理或先勾選再批次處理。'
          : '目前沒有待處理衝突；切到「全部」可檢視已處理紀錄。';
    }
  }

  function markConflictResolved(root, data) {
    var card = root.closest('[data-conflict-card]');
    var status = String(data.status || 'resolved');
    if (card instanceof HTMLElement) {
      card.dataset.conflictStatus = status;
      card.hidden = activeConflictFilter === 'pending';
    }
    var selector = card?.querySelector('[data-conflict-select]');
    if (selector instanceof HTMLInputElement) {
      selector.checked = false;
      selector.disabled = true;
    }
    var selectLabel = selector?.closest('.conflict-select');
    if (selectLabel) selectLabel.remove();
    var badge = card?.querySelector('.verdict-badge');
    if (badge) {
      badge.textContent = statusLabels[status] || status;
      badge.className = 'verdict-badge shrink-0 rounded-full px-2 py-0.5 text-[0.68rem] font-bold capitalize'
        + (status === 'pending' ? ' bg-yellow-100 text-yellow-800'
          : status === 'approved' ? ' bg-green-100 text-green-800'
            : status === 'rejected' ? ' bg-red-100 text-red-800'
              : ' bg-muted text-muted-foreground');
    }
    var note = document.createElement('div');
    note.className = 'mt-2 inline-flex rounded-md border border-green-300 bg-green-50 px-2 py-1 text-xs font-bold text-green-800';
    note.textContent = '已處理：' + (resolutionLabels[data.resolution] || data.resolution || statusLabels[status] || status);
    root.replaceChildren(note);
    updateConflictCounts();
  }

  function applyConflictFilter(filter) {
    activeConflictFilter = filter;
    conflictsRail?.querySelectorAll('[data-conflict-filter]').forEach(function(button) {
      if (!(button instanceof HTMLButtonElement)) return;
      var active = button.dataset.conflictFilter === filter;
      if (active) {
        button.className = 'active min-h-8 border-0 bg-primary px-2.5 text-xs font-bold text-primary-foreground';
      } else {
        button.className = 'min-h-8 border-0 border-l border-border bg-card px-2.5 text-xs font-bold text-muted-foreground';
      }
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    conflictsRail?.querySelectorAll('[data-conflict-card]').forEach(function(card) {
      if (!(card instanceof HTMLElement)) return;
      card.hidden = filter === 'pending' && card.dataset.conflictStatus !== 'pending';
    });
    updateConflictSelection();
  }

  async function resolveConflict(root, conflictId, resolution, trigger, opts) {
    opts = opts || {};
    var label = resolutionLabels[resolution] || resolution;
    if (!opts.skipConfirm && !window.confirm('確定要「' + label + '」 conflict #' + conflictId + '？此動作會寫入處理結果。')) {
      return false;
    }

    if (trigger instanceof HTMLButtonElement) {
      trigger.disabled = true;
      trigger.dataset.originalText = trigger.textContent || '';
      trigger.textContent = '處理中';
    }
    root.querySelectorAll('button').forEach(function(button) {
      button.disabled = true;
    });
    setConflictStatus('正在處理 conflict #' + conflictId + '...');

    try {
      var res = await fetch('/api/admin/evidence/conflicts/' + encodeURIComponent(conflictId) + '/resolve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ resolution: resolution }),
      });
      var data = await res.json().catch(function() { return {}; });
      if (!res.ok) {
        if (res.status === 409 && data.status) {
          markConflictResolved(root, data);
        }
        root.querySelectorAll('button').forEach(function(button) {
          button.disabled = false;
        });
        if (trigger instanceof HTMLButtonElement) {
          trigger.textContent = trigger.dataset.originalText || label;
          delete trigger.dataset.originalText;
        }
        setConflictStatus(data.error || '無法處理此衝突。', 'error');
        return false;
      }

      markConflictResolved(root, data);
      setConflictStatus('Conflict #' + conflictId + ' 已更新為 ' + data.status + '。', 'success');
      return true;
    } catch (e) {
      root.querySelectorAll('button').forEach(function(button) {
        button.disabled = false;
      });
      if (trigger instanceof HTMLButtonElement) {
        trigger.textContent = trigger.dataset.originalText || label;
        delete trigger.dataset.originalText;
      }
      setConflictStatus('無法處理此衝突。', 'error');
      return false;
    }
  }

  conflictsRail?.addEventListener('click', async function(event) {
    var target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    event.preventDefault();
    event.stopPropagation();
    var filter = target.dataset.conflictFilter;
    if (filter) {
      applyConflictFilter(filter);
      return;
    }

    var bulkResolution = target.dataset.bulkResolution;
    if (bulkResolution) {
      var pendingRoots = Array.from(conflictsRail.querySelectorAll('[data-conflict-id]'))
        .filter(function(root) { return root instanceof HTMLElement && root.closest('[data-conflict-status="pending"]'); });
      if (pendingRoots.length === 0) {
        setConflictStatus('目前沒有待處理衝突。');
        return;
      }
      if (!window.confirm('確定要將 ' + pendingRoots.length + ' 個待處理衝突全部標記不處理？')) return;
      target.disabled = true;
      target.dataset.originalText = target.textContent || '';
      target.textContent = '批次處理中';
      var resolved = 0;
      for (var i = 0; i < pendingRoots.length; i++) {
        var root = pendingRoots[i];
        if (!(root instanceof HTMLElement)) continue;
        var conflictId = root.dataset.conflictId;
        if (!conflictId) continue;
        var ok = await resolveConflict(root, conflictId, bulkResolution, target, { skipConfirm: true });
        if (ok) resolved += 1;
      }
      target.disabled = false;
      target.textContent = target.dataset.originalText || '全部標記不處理';
      delete target.dataset.originalText;
      setConflictStatus('批次處理完成：' + resolved + ' / ' + pendingRoots.length + ' 個衝突。', resolved === pendingRoots.length ? 'success' : 'error');
      return;
    }

    var selectedBulkResolution = target.dataset.bulkSelectedResolution;
    if (selectedBulkResolution) {
      var selectedRoots = selectedConflictRoots();
      if (selectedRoots.length === 0) {
        setConflictStatus('請先選擇要批次處理的衝突。');
        return;
      }
      if (!window.confirm('確定要將 ' + selectedRoots.length + ' 個所選衝突標記不處理？')) return;
      target.disabled = true;
      target.dataset.originalText = target.textContent || '';
      target.textContent = '批次處理中';
      var resolved2 = 0;
      for (var j = 0; j < selectedRoots.length; j++) {
        var selRoot = selectedRoots[j];
        if (!(selRoot instanceof HTMLElement)) continue;
        var selConflictId = selRoot.dataset.conflictId;
        if (!selConflictId) continue;
        var selOk = await resolveConflict(selRoot, selConflictId, selectedBulkResolution, target, { skipConfirm: true });
        if (selOk) resolved2 += 1;
      }
      target.disabled = false;
      target.textContent = target.dataset.originalText || '標記所選不處理';
      delete target.dataset.originalText;
      updateConflictSelection();
      setConflictStatus('所選批次處理完成：' + resolved2 + ' / ' + selectedRoots.length + ' 個衝突。', resolved2 === selectedRoots.length ? 'success' : 'error');
      return;
    }

    var resolution = target.dataset.resolution;
    if (!resolution) return;
    var actionRoot = target.closest('[data-conflict-id]');
    if (!(actionRoot instanceof HTMLElement)) return;
    var actionConflictId = actionRoot.dataset.conflictId;
    if (!actionConflictId) return;

    await resolveConflict(actionRoot, actionConflictId, resolution, target);
  });

  conflictsRail?.addEventListener('change', function(event) {
    var target = event.target;
    if (!(target instanceof HTMLInputElement) || !target.matches('[data-conflict-select]')) return;
    updateConflictSelection();
  });

  updateConflictSelection();
</script>
