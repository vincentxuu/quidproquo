---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import BehaviorManager from '@/components/admin/BehaviorManager.tsx';
import { ensureConsoleUmbrella } from '../_guard';
import '@/styles/globals.css';

const gate = ensureConsoleUmbrella();
if (gate) return gate;


const breadcrumb = [{ label: 'Settings', href: '/admin/settings' }];
---

<AdminV2Layout title="Behavior" section="settings" breadcrumb={breadcrumb}>
  <p class="mb-4 text-sm text-muted-foreground">每個 routine 的全域行為預設（auto-fix／auto-create PR）。Branch prefix 待後端確認後再加。</p>
  <BehaviorManager client:load />
</AdminV2Layout>
