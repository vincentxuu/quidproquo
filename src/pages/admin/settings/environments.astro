---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import AdminPanel from '@/components/admin/AdminPanel.astro';
import '@/styles/globals.css';

const breadcrumb = [{ label: 'Settings', href: '/admin/settings' }];
---

<AdminV2Layout title="Environments" section="settings" breadcrumb={breadcrumb}>
  <form id="env-form" class="admin-grid">
    <AdminPanel title="Runner 後端">
      <div class="admin-field">
        <label class="admin-field-label">Provider</label>
        <div class="flex flex-col gap-2">
          <label class="flex items-center gap-2 cursor-pointer text-sm"><input type="radio" name="runner_provider" value="sandbox" checked class="accent-primary" /> Cloudflare Sandbox（預設）</label>
          <label class="flex items-center gap-2 cursor-pointer text-sm"><input type="radio" name="runner_provider" value="mac" class="accent-primary" /> Mac（本機）</label>
          <label class="flex items-center gap-2 cursor-pointer text-sm text-muted-foreground"><input type="radio" name="runner_provider" value="vps" disabled class="accent-primary" /> VPS（未實作）</label>
        </div>
      </div>
    </AdminPanel>

    <AdminPanel title="Network">
      <div class="admin-field">
        <label class="admin-field-label">Mode</label>
        <div class="flex flex-col gap-2">
          <label class="flex items-center gap-2 cursor-pointer text-sm"><input type="radio" name="network_mode" value="none" class="accent-primary" /> None（離線）</label>
          <label class="flex items-center gap-2 cursor-pointer text-sm"><input type="radio" name="network_mode" value="trusted" checked class="accent-primary" /> Trusted（git + 套件源）</label>
          <label class="flex items-center gap-2 cursor-pointer text-sm"><input type="radio" name="network_mode" value="full" class="accent-primary" /> Full（完全開放）</label>
          <label class="flex items-center gap-2 cursor-pointer text-sm"><input type="radio" name="network_mode" value="custom" class="accent-primary" /> Custom</label>
        </div>
      </div>
      <div id="custom-hosts" class="admin-field" hidden>
        <label class="admin-field-label">Allowed Hosts（每行一個 glob）</label>
        <textarea id="allowed-hosts" class="rounded-md border border-input bg-background px-3 py-1.5 text-sm resize-y" rows="4" placeholder="github.com&#10;*.npmjs.org"></textarea>
      </div>
    </AdminPanel>

    <AdminPanel title="Environment Variables">
      <div id="env-vars-list" class="flex flex-col gap-2"></div>
      <div class="mt-3">
        <button type="button" id="add-env-var" class="rounded-md border border-border bg-card px-3 py-1.5 text-sm font-medium text-foreground hover:border-primary hover:bg-accent">+ Add Variable</button>
      </div>
      <p class="text-xs text-muted-foreground mt-2">Values are encrypted at rest. Injected into sandbox via Outbound Worker.</p>
    </AdminPanel>

    <AdminPanel title="Setup Script">
      <div class="admin-field">
        <label class="admin-field-label">Runs after clone, before agent starts</label>
        <textarea id="setup-script" name="setup_script" class="rounded-md border border-input bg-background px-3 py-1.5 text-sm font-mono resize-y" rows="6" placeholder="npm install&#10;# custom setup commands"></textarea>
      </div>
    </AdminPanel>

    <div class="flex items-center gap-3">
      <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">Save</button>
      <span id="save-status" class="text-sm text-muted-foreground"></span>
    </div>
  </form>
</AdminV2Layout>

<script>
  const form = document.getElementById('env-form') as HTMLFormElement;
  const status = document.getElementById('save-status') as HTMLElement;
  const customHosts = document.getElementById('custom-hosts') as HTMLElement;
  const envVarsList = document.getElementById('env-vars-list') as HTMLElement;
  const addBtn = document.getElementById('add-env-var') as HTMLButtonElement;

  document.querySelectorAll('input[name="network_mode"]').forEach(radio => {
    radio.addEventListener('change', () => {
      customHosts.hidden = (radio as HTMLInputElement).value !== 'custom';
    });
  });

  function addEnvVarRow(name = '', masked = false) {
    const row = document.createElement('div');
    row.className = 'flex items-center gap-2';
    row.innerHTML = `
      <input type="text" placeholder="KEY" value="${name}" class="flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-sm env-key" />
      <input type="${masked ? 'password' : 'text'}" placeholder="VALUE" class="flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-sm env-value" />
      <button type="button" class="text-destructive text-lg px-1 hover:opacity-70 remove-btn" title="Remove">&times;</button>
    `;
    row.querySelector('.remove-btn')?.addEventListener('click', () => row.remove());
    envVarsList.appendChild(row);
  }

  addBtn.addEventListener('click', () => addEnvVarRow());

  async function loadConfig() {
    try {
      const res = await fetch('/api/admin/settings/environments');
      const data = await res.json() as Record<string, unknown>;
      if (!data.ok) return;

      const config = (data.config || {}) as Record<string, string>;
      const provider = config.runner_provider || 'sandbox';
      const mode = config.network_mode || 'trusted';

      const providerRadio = form.querySelector(`input[name="runner_provider"][value="${provider}"]`) as HTMLInputElement;
      if (providerRadio) providerRadio.checked = true;

      const modeRadio = form.querySelector(`input[name="network_mode"][value="${mode}"]`) as HTMLInputElement;
      if (modeRadio) { modeRadio.checked = true; customHosts.hidden = mode !== 'custom'; }

      if (config.allowed_hosts) {
        (document.getElementById('allowed-hosts') as HTMLTextAreaElement).value = config.allowed_hosts;
      }
      if (config.setup_script) {
        (document.getElementById('setup-script') as HTMLTextAreaElement).value = config.setup_script;
      }

      for (const v of (data.variables || []) as Array<{ name: string }>) addEnvVarRow(v.name, true);
    } catch {}
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = 'Saving...';

    const config: Record<string, string> = {
      runner_provider: (form.querySelector('input[name="runner_provider"]:checked') as HTMLInputElement)?.value ?? 'sandbox',
      network_mode: (form.querySelector('input[name="network_mode"]:checked') as HTMLInputElement)?.value ?? 'trusted',
      allowed_hosts: (document.getElementById('allowed-hosts') as HTMLTextAreaElement)?.value ?? '',
      setup_script: (document.getElementById('setup-script') as HTMLTextAreaElement)?.value ?? '',
    };

    try {
      const res = await fetch('/api/admin/settings/environments', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ config }),
      });
      const data = await res.json() as Record<string, unknown>;
      status.textContent = data.ok ? 'Saved' : 'Error';
    } catch {
      status.textContent = 'Failed';
    }
  });

  loadConfig();
</script>
