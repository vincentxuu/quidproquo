---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import { ensureConsoleUmbrella } from '../../_guard';
import '@/styles/globals.css';

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const breadcrumb = [{ label: 'Settings', href: '/admin/settings' }];
const tabs = [
  { href: '/admin/settings/extensions/skills', label: 'Skills' },
  { href: '/admin/settings/extensions/mcp-servers', label: 'MCP Servers' },
  { href: '/admin/settings/extensions/plugins', label: 'Plugins' },
  { href: '/admin/settings/extensions/marketplace', label: 'Marketplace' },
];
---

<AdminV2Layout title="Extensions" section="settings" breadcrumb={breadcrumb}>
  <nav class="flex flex-wrap gap-2 mb-4">
    {tabs.map(t => (
      <a href={t.href} class="px-4 py-2 rounded-md border border-border bg-card text-foreground no-underline text-sm font-medium transition-colors hover:border-primary hover:bg-accent">{t.label}</a>
    ))}
  </nav>
  <div class="admin-panel">
    <p class="admin-section-desc">管理 Skills、MCP Servers、Plugins 與 Marketplace。選擇上方分頁。</p>
  </div>
</AdminV2Layout>
