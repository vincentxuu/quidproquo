---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import '@/styles/globals.css';

const breadcrumb = [
  { label: 'Settings', href: '/admin/settings' },
  { label: 'Extensions', href: '/admin/settings/extensions' },
];
---

<AdminV2Layout title="Marketplace" section="settings" breadcrumb={breadcrumb}>
  <div class="rounded-lg border border-border bg-card p-4 shadow-sm">
    <div class="mb-4">
      <h3 class="text-base font-semibold text-foreground">Marketplace</h3>
      <p class="text-sm text-muted-foreground mt-0.5">從 GitHub repo 瀏覽並安裝擴充套件。</p>
    </div>

    <section class="mb-6">
      <h4 class="text-sm font-semibold text-foreground mb-2">來源清單</h4>
      <div class="flex gap-2 mb-3 max-sm:flex-col">
        <input id="source-url" type="url" class="flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-sm" placeholder="https://github.com/owner/repo" />
        <button id="add-source-btn" class="shrink-0 rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">新增來源</button>
      </div>
      <div id="sources-list"></div>
    </section>

    <section>
      <h4 class="text-sm font-semibold text-foreground mb-2">可安裝套件</h4>
      <div id="packages-list"></div>
    </section>
  </div>
</AdminV2Layout>

<script>
  interface ManifestData { name: string; version: string; author?: string; description?: string; skills?: Array<{ name: string }>; mcp_servers?: Array<{ name: string }> }
  interface PackageItem { sourceId: string; sourceUrl: string; manifest: ManifestData | null; installed: boolean; error?: string }
  interface SourceItem { id: string; url: string; name: string | null }

  const API = '/api/admin/settings/extensions/marketplace';
  const sourcesList = document.getElementById('sources-list') as HTMLDivElement;
  const packagesList = document.getElementById('packages-list') as HTMLDivElement;
  const sourceUrlInput = document.getElementById('source-url') as HTMLInputElement;

  async function load() {
    const res = await fetch(API);
    const data = await res.json() as { sources?: SourceItem[]; packages?: PackageItem[] };
    renderSources(data.sources || []);
    renderPackages(data.packages || []);
  }

  function renderSources(sources: SourceItem[]) {
    sourcesList.innerHTML = sources.length === 0
      ? '<p class="text-sm text-muted-foreground py-2">尚無來源。新增 GitHub repo URL 開始。</p>'
      : sources.map(s => `
        <div class="flex items-center justify-between gap-3 py-3 border-b border-border last:border-b-0">
          <span class="text-sm text-foreground truncate">${s.name || s.url}</span>
          <button class="shrink-0 rounded-md border border-destructive/30 bg-destructive/5 px-2 py-1 text-xs font-medium text-destructive hover:bg-destructive/10 remove-source-btn" data-id="${s.id}">移除</button>
        </div>`).join('');
  }

  function renderPackages(packages: PackageItem[]) {
    packagesList.innerHTML = packages.length === 0
      ? '<p class="text-sm text-muted-foreground py-2">尚無可安裝套件。</p>'
      : packages.map(p => {
        if (!p.manifest) return `<div class="py-3 border-b border-border last:border-b-0"><span class="text-sm text-muted-foreground">${p.sourceUrl}: ${p.error || '無法讀取 manifest'}</span></div>`;
        const m = p.manifest;
        return `
          <div class="flex items-center justify-between gap-3 py-3 border-b border-border last:border-b-0">
            <div class="min-w-0">
              <strong class="text-sm font-semibold text-foreground">${m.name}</strong>
              <span class="ml-1.5 inline-flex items-center rounded-sm border border-border bg-muted px-1.5 py-0.5 text-xs font-medium text-muted-foreground">${m.version}</span>
              ${m.author ? `<span class="ml-1.5 text-xs text-muted-foreground">by ${m.author}</span>` : ''}
              ${m.description ? `<p class="text-xs text-muted-foreground mt-0.5">${m.description}</p>` : ''}
              <p class="text-xs text-muted-foreground mt-0.5">${(m.skills || []).length} skills, ${(m.mcp_servers || []).length} MCP servers</p>
            </div>
            <div class="flex shrink-0 gap-1.5">
              ${p.installed
                ? `<button class="rounded-md border border-border bg-card px-2 py-1 text-xs font-medium text-foreground hover:border-primary hover:bg-accent update-btn" data-id="${p.sourceId}">更新</button>
                   <button class="rounded-md border border-destructive/30 bg-destructive/5 px-2 py-1 text-xs font-medium text-destructive hover:bg-destructive/10 remove-pkg-btn" data-id="${p.sourceId}">移除</button>`
                : `<button class="rounded-md bg-primary px-2 py-1 text-xs font-medium text-primary-foreground hover:bg-primary/90 install-btn" data-id="${p.sourceId}">安裝</button>`}
            </div>
          </div>`;
      }).join('');
  }

  document.getElementById('add-source-btn')!.addEventListener('click', async () => {
    const url = sourceUrlInput.value.trim();
    if (!url) return;
    await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ url }) });
    sourceUrlInput.value = '';
    await load();
  });

  sourcesList.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList.contains('remove-source-btn')) return;
    const id = target.dataset.id;
    if (!id) return;
    await fetch(`${API}/${encodeURIComponent(id)}/remove`, { method: 'DELETE' });
    await load();
  });

  packagesList.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const id = target.dataset.id;
    if (!id) return;
    if (target.classList.contains('install-btn')) {
      target.textContent = '安裝中…';
      target.setAttribute('disabled', '');
      await fetch(`${API}/${encodeURIComponent(id)}/install`, { method: 'POST' });
      await load();
    } else if (target.classList.contains('update-btn')) {
      target.textContent = '更新中…';
      await fetch(`${API}/${encodeURIComponent(id)}/update`, { method: 'POST' });
      await load();
    } else if (target.classList.contains('remove-pkg-btn')) {
      if (!confirm('確定移除此套件？')) return;
      await fetch(`${API}/${encodeURIComponent(id)}/remove`, { method: 'DELETE' });
      await load();
    }
  });

  load();
</script>
