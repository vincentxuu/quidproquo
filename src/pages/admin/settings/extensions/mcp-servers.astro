---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import '@/styles/globals.css';

const breadcrumb = [
  { label: 'Settings', href: '/admin/settings' },
  { label: 'Extensions', href: '/admin/settings/extensions' },
];
---

<AdminV2Layout title="MCP Servers" section="settings" breadcrumb={breadcrumb}>
  <div class="rounded-lg border border-border bg-card p-4 shadow-sm">
    <div class="flex items-start justify-between gap-4 mb-3 max-sm:flex-col">
      <div>
        <h3 class="text-base font-semibold text-foreground">MCP Servers</h3>
        <p class="text-sm text-muted-foreground mt-0.5">管理 MCP Server 連線、工具級權限。</p>
      </div>
      <button id="add-server-btn" class="shrink-0 rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90">新增 Server</button>
    </div>
    <div id="servers-list"></div>
  </div>

  <dialog id="server-dialog" class="rounded-lg border border-border p-6 shadow-lg backdrop:bg-black/40 max-w-[640px] w-[90vw]">
    <form id="server-form" method="dialog" class="flex flex-col gap-3">
      <h3 id="dialog-title" class="text-lg font-semibold text-foreground">新增 MCP Server</h3>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold text-muted-foreground">名稱</span>
        <input id="server-name" name="name" class="rounded-md border border-input bg-background px-3 py-1.5 text-sm" required />
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold text-muted-foreground">類型</span>
        <select id="server-type" name="type" class="rounded-md border border-input bg-background px-3 py-1.5 text-sm">
          <option value="http">HTTP</option>
          <option value="sse">SSE</option>
        </select>
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold text-muted-foreground">URL</span>
        <input id="server-url" name="url" class="rounded-md border border-input bg-background px-3 py-1.5 text-sm" placeholder="https://..." />
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold text-muted-foreground">描述</span>
        <input id="server-desc" name="description" class="rounded-md border border-input bg-background px-3 py-1.5 text-sm" />
      </label>
      <div class="flex justify-end gap-2 mt-2">
        <button type="button" id="cancel-btn" class="rounded-md border border-border bg-card px-3 py-1.5 text-sm font-medium text-foreground hover:border-primary hover:bg-accent">取消</button>
        <button type="submit" class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90">儲存</button>
      </div>
    </form>
  </dialog>

  <dialog id="permissions-dialog" class="rounded-lg border border-border p-6 shadow-lg backdrop:bg-black/40 max-w-[640px] w-[90vw]">
    <h3 class="text-lg font-semibold text-foreground mb-3">工具權限 — <span id="perm-server-name"></span></h3>
    <div id="tools-permissions-list"></div>
    <div class="flex justify-end gap-2 mt-4">
      <button id="perm-close-btn" class="rounded-md border border-border bg-card px-3 py-1.5 text-sm font-medium text-foreground hover:border-primary hover:bg-accent">關閉</button>
      <button id="perm-save-btn" class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90">儲存</button>
    </div>
  </dialog>
</AdminV2Layout>

<script>
  interface ServerItem { id: string; name: string; description: string | null; type: string; url: string | null; enabled: boolean; tools: string | null; tool_permissions: string | null }
  interface ToolDef { name: string }

  const API = '/api/admin/settings/extensions/mcp-servers';
  const serversList = document.getElementById('servers-list') as HTMLDivElement;
  const dialog = document.getElementById('server-dialog') as HTMLDialogElement;
  const form = document.getElementById('server-form') as HTMLFormElement;
  const permDialog = document.getElementById('permissions-dialog') as HTMLDialogElement;

  let servers: ServerItem[] = [];
  let currentPermServerId = '';

  async function load() {
    const res = await fetch(API);
    const data = await res.json() as { servers?: ServerItem[] };
    servers = data.servers || [];
    render();
  }

  function render() {
    serversList.innerHTML = servers.length === 0
      ? '<p class="text-sm text-muted-foreground py-2">尚無 MCP Server。</p>'
      : servers.map(s => `
        <div class="flex items-center justify-between gap-3 py-3 border-b border-border last:border-b-0 max-sm:flex-col max-sm:items-start">
          <div class="min-w-0">
            <strong class="text-sm font-semibold text-foreground">${s.name}</strong>
            <span class="ml-1.5 inline-flex items-center rounded-sm border border-border bg-muted px-1.5 py-0.5 text-xs font-medium text-muted-foreground">${s.type}</span>
            <span class="ml-1 inline-flex items-center rounded-sm px-1.5 py-0.5 text-xs font-medium ${s.enabled ? 'bg-primary text-primary-foreground' : 'bg-muted text-muted-foreground'}">${s.enabled ? '啟用' : '停用'}</span>
            <p class="text-xs text-muted-foreground mt-0.5">${s.description || s.url || ''}</p>
          </div>
          <div class="flex shrink-0 gap-1.5">
            <button class="rounded-md border border-border bg-card px-2 py-1 text-xs font-medium text-foreground hover:border-primary hover:bg-accent toggle-btn" data-id="${s.id}" data-enabled="${s.enabled ? '1' : '0'}">${s.enabled ? '停用' : '啟用'}</button>
            <button class="rounded-md border border-border bg-card px-2 py-1 text-xs font-medium text-foreground hover:border-primary hover:bg-accent perm-btn" data-id="${s.id}" data-name="${s.name}">權限</button>
            <button class="rounded-md border border-destructive/30 bg-destructive/5 px-2 py-1 text-xs font-medium text-destructive hover:bg-destructive/10 delete-btn" data-id="${s.id}" data-name="${s.name}">刪除</button>
          </div>
        </div>`).join('');
  }

  document.getElementById('add-server-btn')!.addEventListener('click', () => {
    (document.getElementById('dialog-title') as HTMLElement).textContent = '新增 MCP Server';
    form.reset();
    dialog.showModal();
  });

  document.getElementById('cancel-btn')!.addEventListener('click', () => dialog.close());

  serversList.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const id = target.dataset.id;
    if (!id) return;
    if (target.classList.contains('toggle-btn')) {
      const enabled = target.dataset.enabled !== '1';
      await fetch(`${API}/${encodeURIComponent(id)}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ enabled }) });
      await load();
    } else if (target.classList.contains('delete-btn')) {
      if (!confirm(`確定刪除 ${target.dataset.name}？`)) return;
      await fetch(`${API}/${encodeURIComponent(id)}`, { method: 'DELETE' });
      await load();
    } else if (target.classList.contains('perm-btn')) {
      currentPermServerId = id;
      (document.getElementById('perm-server-name') as HTMLElement).textContent = target.dataset.name || '';
      const server = servers.find(s => s.id === id);
      const tools: ToolDef[] = server?.tools ? JSON.parse(server.tools) : [];
      const perms: Record<string, string> = server?.tool_permissions ? JSON.parse(server.tool_permissions) : {};
      const permList = document.getElementById('tools-permissions-list') as HTMLElement;
      permList.innerHTML = tools.length === 0
        ? '<p class="text-sm text-muted-foreground py-2">此 server 尚無已發現的工具。</p>'
        : tools.map(t => `
          <div class="flex items-center justify-between gap-3 py-2 border-b border-border last:border-b-0">
            <span class="text-sm text-foreground">${t.name}</span>
            <select data-tool="${t.name}" class="w-[120px] rounded-md border border-input bg-background px-2 py-1 text-sm perm-select">
              <option value="always_allow" ${perms[t.name] === 'always_allow' || !perms[t.name] ? 'selected' : ''}>Allow</option>
              <option value="always_ask" ${perms[t.name] === 'always_ask' ? 'selected' : ''}>Ask</option>
              <option value="always_deny" ${perms[t.name] === 'always_deny' ? 'selected' : ''}>Deny</option>
            </select>
          </div>`).join('');
      permDialog.showModal();
    }
  });

  document.getElementById('perm-close-btn')!.addEventListener('click', () => permDialog.close());
  document.getElementById('perm-save-btn')!.addEventListener('click', async () => {
    const selects = permDialog.querySelectorAll('.perm-select') as unknown as NodeListOf<HTMLSelectElement>;
    const perms: Record<string, string> = {};
    selects.forEach(s => { perms[s.dataset.tool!] = s.value; });
    await fetch(`${API}/${encodeURIComponent(currentPermServerId)}`, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tool_permissions: JSON.stringify(perms) }),
    });
    permDialog.close();
    await load();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = {
      name: (document.getElementById('server-name') as HTMLInputElement).value,
      type: (document.getElementById('server-type') as unknown as HTMLSelectElement).value,
      url: (document.getElementById('server-url') as HTMLInputElement).value || null,
      description: (document.getElementById('server-desc') as HTMLInputElement).value || null,
    };
    await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    dialog.close();
    await load();
  });

  load();
</script>
