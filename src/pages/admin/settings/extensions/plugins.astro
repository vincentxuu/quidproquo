---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import '@/styles/globals.css';

const breadcrumb = [
  { label: 'Settings', href: '/admin/settings' },
  { label: 'Extensions', href: '/admin/settings/extensions' },
];
---

<AdminV2Layout title="Plugins" section="settings" breadcrumb={breadcrumb}>
  <div class="rounded-lg border border-border bg-card p-4 shadow-sm">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h3 class="text-base font-semibold text-foreground">已安裝 Plugins</h3>
        <p class="text-sm text-muted-foreground mt-0.5">管理已安裝的 plugin 套件。</p>
      </div>
      <button id="check-updates-btn" class="inline-flex items-center gap-1.5 rounded-md border border-border bg-card px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:border-primary hover:bg-accent">檢查更新</button>
    </div>
    <div id="plugins-list"></div>
    <p id="status-msg" class="text-sm text-muted-foreground mt-2"></p>
  </div>
</AdminV2Layout>

<script>
  interface PluginItem { id: string; name: string; description: string | null; version: string | null; author: string | null; source_url: string | null; update_available: number }

  const API = '/api/admin/settings/extensions/plugins';
  const list = document.getElementById('plugins-list') as HTMLDivElement;
  const statusMsg = document.getElementById('status-msg') as HTMLElement;

  async function load() {
    const res = await fetch(API);
    const data = await res.json() as { plugins?: PluginItem[] };
    const plugins = data.plugins || [];
    list.innerHTML = plugins.length === 0
      ? '<p class="text-sm text-muted-foreground py-2">尚無已安裝的 plugin。前往 Marketplace 安裝。</p>'
      : plugins.map(p => `
        <div class="flex items-center justify-between gap-3 py-3 border-b border-border last:border-b-0">
          <div class="min-w-0">
            <strong class="text-sm font-semibold text-foreground">${p.name}</strong>
            <span class="ml-1.5 inline-flex items-center rounded-sm border border-border bg-muted px-1.5 py-0.5 text-xs font-medium text-muted-foreground">${p.version || '?'}</span>
            ${p.update_available ? '<span class="ml-1 inline-flex items-center rounded-sm bg-amber-500 px-1.5 py-0.5 text-xs font-medium text-white">有更新</span>' : ''}
            ${p.author ? `<span class="ml-1.5 text-xs text-muted-foreground">by ${p.author}</span>` : ''}
            ${p.description ? `<p class="text-xs text-muted-foreground mt-0.5">${p.description}</p>` : ''}
          </div>
          <button class="shrink-0 rounded-md border border-destructive/30 bg-destructive/5 px-2 py-1 text-xs font-medium text-destructive transition-colors hover:bg-destructive/10 uninstall-btn" data-id="${p.id}" data-name="${p.name}">解除安裝</button>
        </div>`).join('');
  }

  list.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList.contains('uninstall-btn')) return;
    const id = target.dataset.id;
    if (!id || !confirm(`確定解除安裝 ${target.dataset.name}？`)) return;
    await fetch(`${API}/${encodeURIComponent(id)}`, { method: 'DELETE' });
    await load();
  });

  document.getElementById('check-updates-btn')!.addEventListener('click', async () => {
    statusMsg.textContent = '檢查更新中…';
    const res = await fetch('/api/admin/settings/extensions/marketplace', { method: 'GET' });
    const data = await res.json() as { packages?: Array<{ manifest?: { name: string }; installed: boolean }> };
    statusMsg.textContent = `檢查完成。${(data.packages || []).filter(p => p.installed).length} 個已安裝套件。`;
    await load();
  });

  load();
</script>
