---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import { ensureConsoleUmbrella } from '../../_guard';

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const breadcrumb = [
  { label: 'Settings', href: '/admin/settings' },
  { label: 'Extensions', href: '/admin/settings/extensions' },
];
---

<AdminV2Layout title="Plugins" section="settings" breadcrumb={breadcrumb}>
  <div class="admin-panel">
    <p class="admin-section-desc">管理 Plugins。</p>
  </div>
</AdminV2Layout>
