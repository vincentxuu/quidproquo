---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import '@/styles/globals.css';

const breadcrumb = [
  { label: 'Settings', href: '/admin/settings' },
  { label: 'Extensions', href: '/admin/settings/extensions' },
];
---

<AdminV2Layout title="Skills" section="settings" breadcrumb={breadcrumb}>
  <div class="rounded-lg border border-border bg-card p-4 shadow-sm">
    <div class="flex items-start justify-between gap-4 mb-3 max-sm:flex-col">
      <div>
        <h3 class="text-base font-semibold text-foreground">Skills</h3>
        <p class="text-sm text-muted-foreground mt-0.5">建立、編輯、匯入、匯出 agent skills。</p>
      </div>
      <div class="flex gap-2 shrink-0">
        <button id="import-btn" class="rounded-md border border-border bg-card px-3 py-1.5 text-sm font-medium text-foreground hover:border-primary hover:bg-accent">匯入</button>
        <button id="create-btn" class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90">新增 Skill</button>
      </div>
    </div>

    <div class="flex gap-2 mb-3 max-sm:flex-col">
      <input id="search-input" type="text" class="flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-sm" placeholder="搜尋 skill…" />
      <select id="source-filter" class="rounded-md border border-input bg-background px-3 py-1.5 text-sm">
        <option value="">全部來源</option>
        <option value="user">使用者</option>
        <option value="project">專案</option>
        <option value="imported">匯入</option>
      </select>
    </div>

    <div id="skills-list"></div>
  </div>

  <dialog id="skill-dialog" class="rounded-lg border border-border p-6 shadow-lg backdrop:bg-black/40 max-w-[640px] w-[90vw]">
    <form id="skill-form" method="dialog" class="flex flex-col gap-3">
      <h3 id="dialog-title" class="text-lg font-semibold text-foreground">新增 Skill</h3>
      <input type="hidden" id="edit-skill-name" />
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold text-muted-foreground">名稱</span>
        <input id="skill-name" name="name" class="rounded-md border border-input bg-background px-3 py-1.5 text-sm" required />
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold text-muted-foreground">描述</span>
        <input id="skill-desc" name="description" class="rounded-md border border-input bg-background px-3 py-1.5 text-sm" />
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold text-muted-foreground">內容</span>
        <textarea id="skill-content" name="content" class="rounded-md border border-input bg-background px-3 py-1.5 text-sm resize-y" rows="12" required></textarea>
      </label>
      <div class="flex justify-end gap-2 mt-2">
        <button type="button" id="cancel-btn" class="rounded-md border border-border bg-card px-3 py-1.5 text-sm font-medium text-foreground hover:border-primary hover:bg-accent">取消</button>
        <button type="submit" class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90">儲存</button>
      </div>
    </form>
  </dialog>
</AdminV2Layout>

<script>
  interface SkillItem { name: string; description: string; source: string }

  const API = '/api/admin/settings/extensions/skills';
  const list = document.getElementById('skills-list') as HTMLDivElement;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const sourceFilter = document.getElementById('source-filter') as unknown as HTMLSelectElement;
  const dialog = document.getElementById('skill-dialog') as HTMLDialogElement;
  const form = document.getElementById('skill-form') as HTMLFormElement;
  const editName = document.getElementById('edit-skill-name') as HTMLInputElement;
  const nameInput = document.getElementById('skill-name') as HTMLInputElement;
  const descInput = document.getElementById('skill-desc') as HTMLInputElement;
  const contentInput = document.getElementById('skill-content') as HTMLTextAreaElement;
  const dialogTitle = document.getElementById('dialog-title') as HTMLElement;

  let skills: SkillItem[] = [];

  async function load() {
    const res = await fetch(API);
    const data = await res.json() as { skills?: SkillItem[] };
    skills = data.skills || [];
    render();
  }

  function render() {
    const q = searchInput.value.toLowerCase();
    const src = sourceFilter.value;
    const filtered = skills.filter(s =>
      (!q || s.name.toLowerCase().includes(q) || (s.description || '').toLowerCase().includes(q)) &&
      (!src || s.source === src)
    );
    list.innerHTML = filtered.length === 0
      ? '<p class="text-sm text-muted-foreground py-2">沒有找到 skill。</p>'
      : filtered.map(s => `
        <div class="flex items-center justify-between gap-3 py-3 border-b border-border last:border-b-0" data-name="${s.name}">
          <div class="min-w-0">
            <strong class="text-sm font-semibold text-foreground">${s.name}</strong>
            <span class="ml-1.5 inline-flex items-center rounded-sm border border-border bg-muted px-1.5 py-0.5 text-xs font-medium text-muted-foreground">${s.source}</span>
            <p class="text-xs text-muted-foreground mt-0.5">${s.description || ''}</p>
          </div>
          <div class="flex shrink-0 gap-1.5">
            <button class="rounded-md border border-border bg-card px-2 py-1 text-xs font-medium text-foreground hover:border-primary hover:bg-accent edit-btn" data-name="${s.name}">編輯</button>
            <button class="rounded-md border border-destructive/30 bg-destructive/5 px-2 py-1 text-xs font-medium text-destructive hover:bg-destructive/10 delete-btn" data-name="${s.name}">刪除</button>
          </div>
        </div>`).join('');
  }

  searchInput.addEventListener('input', render);
  sourceFilter.addEventListener('change', render);

  document.getElementById('create-btn')!.addEventListener('click', () => {
    dialogTitle.textContent = '新增 Skill';
    editName.value = '';
    nameInput.value = '';
    nameInput.disabled = false;
    descInput.value = '';
    contentInput.value = '';
    dialog.showModal();
  });

  document.getElementById('cancel-btn')!.addEventListener('click', () => dialog.close());

  list.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const name = target.dataset.name;
    if (!name) return;
    if (target.classList.contains('edit-btn')) {
      const res = await fetch(`${API}/${encodeURIComponent(name)}`);
      const data = await res.json() as { skill?: { description?: string; content?: string } };
      dialogTitle.textContent = '編輯 Skill';
      editName.value = name;
      nameInput.value = name;
      nameInput.disabled = true;
      descInput.value = data.skill?.description || '';
      contentInput.value = data.skill?.content || '';
      dialog.showModal();
    } else if (target.classList.contains('delete-btn')) {
      if (!confirm(`確定刪除 ${name}？`)) return;
      await fetch(`${API}/${encodeURIComponent(name)}`, { method: 'DELETE' });
      await load();
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const editing = editName.value;
    const body = { name: nameInput.value, description: descInput.value, content: contentInput.value };
    if (editing) {
      await fetch(`${API}/${encodeURIComponent(editing)}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    } else {
      await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    }
    dialog.close();
    await load();
  });

  document.getElementById('import-btn')!.addEventListener('click', async () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    input.onchange = async () => {
      const file = input.files?.[0];
      if (!file) return;
      const text = await file.text();
      await fetch(`${API}/import`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: text });
      await load();
    };
    input.click();
  });

  load();
</script>
