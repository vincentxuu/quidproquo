---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import { ensureConsoleUmbrella } from '../_guard';

const gate = ensureConsoleUmbrella();
if (gate) return gate;
---

<AdminV2Layout title="GitHub" section="settings">
  <section class="panel">
    <div class="panel-head">
      <div>
        <h2>GitHub App</h2>
        <p>連接 GitHub repo 給 admin agent 使用。</p>
      </div>
      <div class="actions">
        <a href="/admin" class="btn secondary">Back to admin</a>
        <button id="sync-btn" class="btn" type="button">Sync repos</button>
      </div>
    </div>

    <div id="install-return" class="notice" hidden>
      <strong>GitHub App installed.</strong>
      <span>Syncing repositories…</span>
    </div>

    <dl class="status-list">
      <div>
        <dt>Status</dt>
        <dd id="status">Loading…</dd>
      </div>
      <div>
        <dt>Repos</dt>
        <dd id="repo-count">-</dd>
      </div>
    </dl>

    <a id="install-link" class="install-link" href="#" rel="noopener noreferrer" hidden>
      Install GitHub App
    </a>
    <p id="message" class="message"></p>
  </section>
</AdminV2Layout>

<script is:inline>
  (function () {
    const statusEl = document.getElementById('status');
    const repoCountEl = document.getElementById('repo-count');
    const installLink = document.getElementById('install-link');
    const syncBtn = document.getElementById('sync-btn');
    const messageEl = document.getElementById('message');
    const installReturn = document.getElementById('install-return');

    function setMessage(text) {
      if (messageEl) messageEl.textContent = text || '';
    }

    function readInstallReturn() {
      const params = new URLSearchParams(window.location.search);
      const installationId = params.get('installation_id');
      const setupAction = params.get('setup_action');
      return {
        installationId,
        setupAction,
        shouldSync: Boolean(installationId && (setupAction === 'install' || setupAction === 'update')),
      };
    }

    function clearInstallParams() {
      const url = new URL(window.location.href);
      url.searchParams.delete('installation_id');
      url.searchParams.delete('setup_action');
      history.replaceState({}, '', url.pathname + url.search + url.hash);
    }

    async function loadStatus() {
      const res = await fetch('/api/admin/github-app/status');
      const data = await res.json();
      if (statusEl) statusEl.textContent = data.configured ? 'Configured' : 'Missing env secrets';
      if (repoCountEl) repoCountEl.textContent = String(data.repositoryCount ?? 0);
      if (installLink && data.installUrl) {
        installLink.href = data.installUrl;
        installLink.hidden = false;
      }
      if (!data.configured) {
        setMessage('Set GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, and GITHUB_APP_SLUG before syncing.');
      }
    }

    async function syncRepos(source) {
      if (!syncBtn) return;
      syncBtn.disabled = true;
      if (source === 'install-return' && installReturn) {
        installReturn.hidden = false;
        installReturn.querySelector('span').textContent = 'Syncing repositories…';
      }
      setMessage('Syncing…');
      try {
        const res = await fetch('/api/admin/github-app/sync', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          setMessage(data.error || ('Sync failed (HTTP ' + res.status + ')'));
          if (source === 'install-return' && installReturn) {
            installReturn.querySelector('span').textContent = 'Sync failed. Use the button to retry.';
          }
          return;
        }
        setMessage('Synced ' + data.repositories + ' repos from ' + data.installations + ' installation(s).');
        if (source === 'install-return') {
          clearInstallParams();
          if (installReturn) {
            installReturn.querySelector('span').textContent = 'Repositories synced. You can return to admin.';
          }
        }
        await loadStatus();
      } catch {
        setMessage('Sync failed.');
        if (source === 'install-return' && installReturn) {
          installReturn.querySelector('span').textContent = 'Sync failed. Use the button to retry.';
        }
      } finally {
        syncBtn.disabled = false;
      }
    }

    syncBtn?.addEventListener('click', async () => {
      await syncRepos('manual');
    });

    loadStatus()
      .then(async () => {
        const install = readInstallReturn();
        if (install.shouldSync) await syncRepos('install-return');
      })
      .catch(() => setMessage('Unable to load GitHub App status.'));
  })();
</script>

<style>
  .panel {
    max-width: 720px;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius);
    background: var(--admin-surface);
    padding: 1rem;
  }

  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  h2 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
  }

  p {
    margin: 0;
    color: var(--admin-text-muted);
    font-size: 0.85rem;
  }

  .btn,
  .install-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--admin-border);
    border-radius: 8px;
    background: var(--brand-900);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }

  .btn.secondary {
    background: var(--admin-surface);
    color: var(--admin-text);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .notice {
    margin-top: 1rem;
    border: 1px solid color-mix(in srgb, var(--brand-700), transparent 45%);
    border-radius: 8px;
    background: color-mix(in srgb, var(--brand-900), transparent 88%);
    padding: 0.75rem;
    color: var(--admin-text);
    font-size: 0.85rem;
  }

  .notice strong {
    margin-right: 0.35rem;
  }

  .status-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1rem 0;
  }

  .status-list div {
    border: 1px solid var(--admin-border);
    border-radius: 8px;
    padding: 0.75rem;
  }

  dt {
    color: var(--admin-text-muted);
    font-size: 0.75rem;
    margin-bottom: 0.2rem;
  }

  dd {
    margin: 0;
    font-weight: 700;
  }

  .message {
    margin-top: 0.75rem;
  }

  @media (max-width: 560px) {
    .panel-head {
      flex-direction: column;
    }

    .actions {
      width: 100%;
      flex-direction: column-reverse;
    }

    .btn,
    .install-link {
      width: 100%;
      text-align: center;
    }

    .status-list {
      grid-template-columns: 1fr;
    }
  }
</style>
