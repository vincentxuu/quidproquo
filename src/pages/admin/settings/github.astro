---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import { ensureConsoleUmbrella } from '../_guard';
import '@/styles/globals.css';

const gate = ensureConsoleUmbrella();
if (gate) return gate;
---

<AdminV2Layout title="GitHub" section="settings">
  <section class="max-w-[720px] rounded-lg border border-border bg-card p-4 shadow-sm">
    <div class="flex items-start justify-between gap-4 max-sm:flex-col">
      <div>
        <h2 class="text-base font-semibold text-foreground mb-1">GitHub App</h2>
        <p class="text-sm text-muted-foreground">連接 GitHub repo 給 admin agent 使用。</p>
      </div>
      <div class="flex items-center gap-2 max-sm:w-full max-sm:flex-col-reverse">
        <a href="/admin" class="inline-flex items-center justify-center rounded-md border border-border bg-card px-3 py-2 text-sm font-semibold text-foreground no-underline hover:border-primary hover:bg-accent max-sm:w-full max-sm:text-center">Back to admin</a>
        <button id="sync-btn" class="inline-flex items-center justify-center rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 disabled:opacity-50 disabled:cursor-wait max-sm:w-full" type="button">Sync repos</button>
      </div>
    </div>

    <div id="install-return" class="mt-4 rounded-md border border-primary/40 bg-primary/10 px-3 py-2.5 text-sm text-foreground" hidden>
      <strong class="mr-1.5">GitHub App installed.</strong>
      <span>Syncing repositories…</span>
    </div>

    <dl class="grid grid-cols-2 gap-3 my-4 max-sm:grid-cols-1">
      <div class="rounded-md border border-border p-3">
        <dt class="text-xs text-muted-foreground mb-0.5">Status</dt>
        <dd id="status" class="font-bold text-foreground">Loading…</dd>
      </div>
      <div class="rounded-md border border-border p-3">
        <dt class="text-xs text-muted-foreground mb-0.5">Repos</dt>
        <dd id="repo-count" class="font-bold text-foreground">-</dd>
      </div>
    </dl>

    <a id="install-link" class="inline-flex items-center justify-center rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90 max-sm:w-full max-sm:text-center" href="#" rel="noopener noreferrer" hidden>
      Install GitHub App
    </a>
    <p id="message" class="text-sm text-muted-foreground mt-3"></p>
  </section>
</AdminV2Layout>

<script is:inline>
  (function () {
    const statusEl = document.getElementById('status');
    const repoCountEl = document.getElementById('repo-count');
    const installLink = document.getElementById('install-link');
    const syncBtn = document.getElementById('sync-btn');
    const messageEl = document.getElementById('message');
    const installReturn = document.getElementById('install-return');

    function setMessage(text) {
      if (messageEl) messageEl.textContent = text || '';
    }

    function readInstallReturn() {
      const params = new URLSearchParams(window.location.search);
      const installationId = params.get('installation_id');
      const setupAction = params.get('setup_action');
      return {
        installationId,
        setupAction,
        shouldSync: Boolean(installationId && (setupAction === 'install' || setupAction === 'update')),
      };
    }

    function clearInstallParams() {
      const url = new URL(window.location.href);
      url.searchParams.delete('installation_id');
      url.searchParams.delete('setup_action');
      history.replaceState({}, '', url.pathname + url.search + url.hash);
    }

    async function loadStatus() {
      const res = await fetch('/api/admin/github-app/status');
      const data = await res.json();
      if (statusEl) statusEl.textContent = data.configured ? 'Configured' : 'Missing env secrets';
      if (repoCountEl) repoCountEl.textContent = String(data.repositoryCount ?? 0);
      if (installLink && data.installUrl) {
        installLink.href = data.installUrl;
        installLink.hidden = false;
      }
      if (!data.configured) {
        setMessage('Set GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, and GITHUB_APP_SLUG before syncing.');
      }
    }

    async function syncRepos(source) {
      if (!syncBtn) return;
      syncBtn.disabled = true;
      if (source === 'install-return' && installReturn) {
        installReturn.hidden = false;
        installReturn.querySelector('span').textContent = 'Syncing repositories…';
      }
      setMessage('Syncing…');
      try {
        const res = await fetch('/api/admin/github-app/sync', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          setMessage(data.error || ('Sync failed (HTTP ' + res.status + ')'));
          if (source === 'install-return' && installReturn) {
            installReturn.querySelector('span').textContent = 'Sync failed. Use the button to retry.';
          }
          return;
        }
        setMessage('Synced ' + data.repositories + ' repos from ' + data.installations + ' installation(s).');
        if (source === 'install-return') {
          clearInstallParams();
          if (installReturn) {
            installReturn.querySelector('span').textContent = 'Repositories synced. You can return to admin.';
          }
        }
        await loadStatus();
      } catch {
        setMessage('Sync failed.');
        if (source === 'install-return' && installReturn) {
          installReturn.querySelector('span').textContent = 'Sync failed. Use the button to retry.';
        }
      } finally {
        syncBtn.disabled = false;
      }
    }

    syncBtn?.addEventListener('click', async () => {
      await syncRepos('manual');
    });

    loadStatus()
      .then(async () => {
        const install = readInstallReturn();
        if (install.shouldSync) await syncRepos('install-return');
      })
      .catch(() => setMessage('Unable to load GitHub App status.'));
  })();
</script>
