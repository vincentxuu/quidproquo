---
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import AdminState from '@/components/admin/AdminState.astro';
import AdminPanel from '@/components/admin/AdminPanel.astro';
import { getEnv } from '@/lib/config/env';
import { consoleHref, createConsoleTranslator, getConsoleLang } from '@/lib/console/admin/i18n';
import { ensureConsoleUmbrella } from '../../_guard';
import '@/styles/globals.css';

export const prerender = false;

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const providerId = Astro.params.id ?? '';
const lang = getConsoleLang(Astro.url);
const t = createConsoleTranslator(lang);

const breadcrumb = [
  { label: t('providers.title'), href: consoleHref('/admin/providers', lang) },
  { label: providerId },
];

interface HealthRow {
  id: number;
  provider_id: string;
  status: string;
  p95_latency_ms: number | null;
  error_rate: number | null;
  checked_at: number;
}

interface KeyRow {
  env_key: string;
  last_rotated_at: number | null;
  masked_value: string | null;
}

let healthRows: HealthRow[] = [];
let keyRow: KeyRow | null = null;
let healthAvailable = false;
let loadError = false;

if (providerId) {
  const db = getEnv().DB;

  try {
    const result = await db
      .prepare(
        `SELECT id, provider_id, status, p95_latency_ms, error_rate, checked_at
         FROM provider_health
         WHERE provider_id = ?
         ORDER BY checked_at DESC
         LIMIT 100`
      )
      .bind(providerId)
      .all<HealthRow>();
    healthRows = result.results ?? [];
    healthAvailable = true;
  } catch {
    healthAvailable = false;
  }

  try {
    const row = await db
      .prepare(
        `SELECT env_key, last_rotated_at, masked_value
         FROM provider_keys
         WHERE provider_id = ?
         LIMIT 1`
      )
      .bind(providerId)
      .first<KeyRow>();
    keyRow = row ?? null;
  } catch {
    keyRow = null;
  }
}

interface DaySummary {
  date: string;
  p95: number | null;
  errorRate: number | null;
  samples: number;
}

function msToDateLabel(ms: number): string {
  return new Date(ms).toISOString().slice(0, 10);
}

const sevenDaysSummary: DaySummary[] = [];
if (healthAvailable && healthRows.length > 0) {
  const nowMs = Date.now();
  const msPerDay = 86_400_000;

  const buckets = new Map<string, HealthRow[]>();
  for (let i = 6; i >= 0; i--) {
    const label = msToDateLabel(nowMs - i * msPerDay);
    buckets.set(label, []);
  }

  for (const row of healthRows) {
    const label = msToDateLabel(row.checked_at);
    if (buckets.has(label)) {
      buckets.get(label)!.push(row);
    }
  }

  for (const [date, rows] of buckets) {
    if (rows.length === 0) {
      sevenDaysSummary.push({ date, p95: null, errorRate: null, samples: 0 });
    } else {
      const p95Values = rows
        .map((r) => r.p95_latency_ms)
        .filter((v): v is number => v !== null);
      const errorValues = rows
        .map((r) => r.error_rate)
        .filter((v): v is number => v !== null);
      const avgP95 =
        p95Values.length > 0
          ? p95Values.reduce((a, b) => a + b, 0) / p95Values.length
          : null;
      const avgError =
        errorValues.length > 0
          ? errorValues.reduce((a, b) => a + b, 0) / errorValues.length
          : null;
      sevenDaysSummary.push({ date, p95: avgP95, errorRate: avgError, samples: rows.length });
    }
  }
}

const failureEvents = healthRows
  .filter(
    (r) =>
      (r.error_rate !== null && r.error_rate > 0.1) ||
      r.status === 'degraded' ||
      r.status === 'error' ||
      r.status === 'down'
  )
  .slice(0, 10);

function formatTs(ms: number | null): string {
  if (!ms) return '—';
  return new Date(ms).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
}

function pct(v: number | null): string {
  if (v === null) return '—';
  return (v * 100).toFixed(1) + '%';
}

function ms(v: number | null): string {
  if (v === null) return '—';
  return Math.round(v) + ' ms';
}

function maskKey(masked: string | null): string {
  if (!masked) return '—';
  return masked;
}
---

<AdminV2Layout title={t('providers.detailTitle', { id: providerId })} section="settings" breadcrumb={breadcrumb}>

  {!providerId && (
    <AdminState tone="error">{t('providers.missingId')}</AdminState>
  )}

  {providerId && (
    <div class="grid gap-5">

      <AdminPanel title={t('providers.healthTrend')} eyebrow={t('providers.latencyError')}>
        {!healthAvailable ? (
          <p class="text-sm text-muted-foreground px-4 py-3">{t('providers.healthNotReady')}</p>
        ) : sevenDaysSummary.length === 0 ? (
          <p class="text-sm text-muted-foreground px-4 py-3">{t('providers.noHealth')}</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr>
                  <th scope="col" class="text-left px-3 py-2 text-xs uppercase tracking-wide font-semibold text-muted-foreground border-b border-border">{t('providers.date')}</th>
                  <th scope="col" class="text-left px-3 py-2 text-xs uppercase tracking-wide font-semibold text-muted-foreground border-b border-border">{t('providers.p95Latency')}</th>
                  <th scope="col" class="text-left px-3 py-2 text-xs uppercase tracking-wide font-semibold text-muted-foreground border-b border-border">{t('providers.errorRate')}</th>
                  <th scope="col" class="text-left px-3 py-2 text-xs uppercase tracking-wide font-semibold text-muted-foreground border-b border-border">{t('providers.samples')}</th>
                  <th scope="col" class="text-left px-3 py-2 text-xs uppercase tracking-wide font-semibold text-muted-foreground border-b border-border">{t('providers.trend')}</th>
                </tr>
              </thead>
              <tbody>
                {sevenDaysSummary.map((day) => (
                  <tr>
                    <td class="px-3 py-2 border-b border-border font-mono text-xs">{day.date}</td>
                    <td class="px-3 py-2 border-b border-border">{ms(day.p95)}</td>
                    <td class:list={[
                      'px-3 py-2 border-b border-border',
                      day.errorRate !== null && day.errorRate > 0.1 ? 'text-red-600 font-semibold' : '',
                    ]}>{pct(day.errorRate)}</td>
                    <td class="px-3 py-2 border-b border-border">{day.samples === 0 ? '—' : day.samples}</td>
                    <td class="px-3 py-2 border-b border-border w-[120px]">
                      {day.p95 !== null ? (
                        <span
                          class="inline-block h-2 rounded-sm bg-primary opacity-75"
                          style={`width: ${Math.min(100, (day.p95 / 2000) * 100)}%; min-width: 2px`}
                          title={`p95: ${ms(day.p95)}`}
                        />
                      ) : (
                        <span class="text-xs text-muted-foreground">{t('providers.noData')}</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </AdminPanel>

      <AdminPanel title={t('providers.recentFailures')} eyebrow={t('providers.recentFailuresEyebrow')}>
        {!healthAvailable ? (
          <p class="text-sm text-muted-foreground px-4 py-3">{t('providers.healthNotReady')}</p>
        ) : failureEvents.length === 0 ? (
          <p class="text-sm text-muted-foreground px-4 py-3">{t('providers.noFailures')}</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr>
                  <th scope="col" class="text-left px-3 py-2 text-xs uppercase tracking-wide font-semibold text-muted-foreground border-b border-border">{t('providers.checkTime')}</th>
                  <th scope="col" class="text-left px-3 py-2 text-xs uppercase tracking-wide font-semibold text-muted-foreground border-b border-border">{t('common.status')}</th>
                  <th scope="col" class="text-left px-3 py-2 text-xs uppercase tracking-wide font-semibold text-muted-foreground border-b border-border">{t('providers.p95Latency')}</th>
                  <th scope="col" class="text-left px-3 py-2 text-xs uppercase tracking-wide font-semibold text-muted-foreground border-b border-border">{t('providers.errorRate')}</th>
                </tr>
              </thead>
              <tbody>
                {failureEvents.map((evt) => (
                  <tr>
                    <td class="px-3 py-2 border-b border-border font-mono text-xs">{formatTs(evt.checked_at)}</td>
                    <td class="px-3 py-2 border-b border-border">
                      <span class:list={[
                        'inline-block px-2 py-0.5 rounded-full border text-xs capitalize',
                        evt.status === 'healthy' ? 'text-green-600 border-green-600' :
                        evt.status === 'degraded' ? 'text-yellow-600 border-yellow-600' :
                        'text-red-600 border-red-600',
                      ]}>{evt.status}</span>
                    </td>
                    <td class="px-3 py-2 border-b border-border">{ms(evt.p95_latency_ms)}</td>
                    <td class="px-3 py-2 border-b border-border text-red-600 font-semibold">{pct(evt.error_rate)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </AdminPanel>

      <AdminPanel title={t('providers.apiKeyStatus')} eyebrow={t('providers.keyMetadata')}>
        <div class="grid gap-2 px-4 py-3">
          <div class="flex gap-4 items-baseline text-sm">
            <span class="min-w-[120px] text-xs text-muted-foreground">{t('providers.providerId')}</span>
            <code class="font-mono text-xs">{providerId}</code>
          </div>
          {keyRow ? (
            <>
              <div class="flex gap-4 items-baseline text-sm">
                <span class="min-w-[120px] text-xs text-muted-foreground">{t('providers.envKey')}</span>
                <code class="font-mono text-xs">{keyRow.env_key}</code>
              </div>
              <div class="flex gap-4 items-baseline text-sm">
                <span class="min-w-[120px] text-xs text-muted-foreground">{t('providers.maskedValue')}</span>
                <code class="font-mono text-xs">{maskKey(keyRow.masked_value)}</code>
              </div>
              <div class="flex gap-4 items-baseline text-sm">
                <span class="min-w-[120px] text-xs text-muted-foreground">{t('providers.lastRotated')}</span>
                <span>{formatTs(keyRow.last_rotated_at)}</span>
              </div>
            </>
          ) : (
            <p class="text-sm text-muted-foreground">{t('providers.noKeyMetadata')}</p>
          )}
        </div>
      </AdminPanel>

      <AdminPanel title={t('providers.rotateKey')} eyebrow={t('providers.operation')}>
        <p class="text-sm text-muted-foreground px-4 py-3">
          {t('providers.rotateNote', { id: providerId })}
        </p>
        <form method="POST" action={`/api/admin/settings/models/${providerId}/rotate-key`} class="flex items-center gap-4 px-4 py-3 flex-wrap">
          <button type="submit" class="px-4 py-2 border border-border rounded-md bg-card text-sm cursor-pointer transition-colors hover:border-red-600 hover:bg-red-50 hover:text-red-600">{t('providers.rotateButton')}</button>
          <span class="text-xs text-muted-foreground">{t('providers.irreversible')}</span>
        </form>
      </AdminPanel>

    </div>
  )}
</AdminV2Layout>
