---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import NotificationsManager from '@/components/admin/NotificationsManager.tsx';
import { ensureConsoleUmbrella } from '../_guard';
import '@/styles/globals.css';

const gate = ensureConsoleUmbrella();
if (gate) return gate;


const breadcrumb = [{ label: 'Settings', href: '/admin/settings' }];
---

<AdminV2Layout title="Notifications" section="settings" breadcrumb={breadcrumb}>
  <p class="mb-4 text-sm text-muted-foreground">每個 routine 的通知開關與 channel 設定。Branch prefix 等全域預設待後端確認後再加。</p>
  <NotificationsManager client:load />
</AdminV2Layout>
