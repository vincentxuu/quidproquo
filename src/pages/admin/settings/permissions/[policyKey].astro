---
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import AdminState from '@/components/admin/AdminState.astro';
import PolicyAssignmentList from '@/components/admin/console/PolicyAssignmentList.astro';
import { FlowAssignIsland } from '@/components/admin/console/FlowAssignModal';
import { fetchPolicyDetail } from '@/lib/console/management';
import { consoleHref, createConsoleTranslator, getConsoleLang } from '@/lib/console/admin/i18n';
import { ensureConsoleUmbrella } from '../../_guard';
import '@/styles/globals.css';

export const prerender = false;

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const policyKey = Astro.params.policyKey ?? '';
const lang = getConsoleLang(Astro.url);
const t = createConsoleTranslator(lang);

const result = await fetchPolicyDetail(Astro.request, policyKey);

const breadcrumb = [
  { label: t('policies.title'), href: consoleHref('/admin/policies', lang) },
  { label: result.detail?.label ?? policyKey },
];
---

<AdminV2Layout title={t('policies.detailTitle')} section="settings" breadcrumb={breadcrumb}>
  {!result.ok && (
    <AdminState tone="error">{t('policies.featureDisabled')}</AdminState>
  )}
  {result.ok && !result.detail && (
    <AdminState tone="empty">{t('policies.notFound', { key: policyKey })}</AdminState>
  )}
  {result.detail && (
    <div class="grid gap-6">
      <header>
        <h2 class="text-xl">{result.detail.label} <code class="text-[0.82rem] text-muted-foreground">{result.detail.policyKey}</code></h2>
        <p class="mt-1 flex items-center gap-2.5 text-sm text-muted-foreground">
          <span class="rounded-full border border-border px-2 py-0.5 text-xs capitalize">{result.detail.category}</span>
          <span>v{result.detail.version}</span>
        </p>
        <div class="mt-3">
          <button
            type="button"
            id="archive-policy-btn"
            class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-sm font-semibold text-red-700"
            data-policy-key={result.detail.policyKey}
            data-confirm={t('policies.archiveConfirm', { key: result.detail.policyKey })}
          >{t('policies.archivePolicy')}</button>
        </div>
      </header>

      <section aria-label="定義">
        <div class="mb-2 flex items-center justify-between">
          <h3 class="text-[0.95rem]">{t('policies.definition')}</h3>
          <button type="button" id="save-policy-btn" class="rounded-lg border border-primary bg-primary px-3 py-1.5 text-sm font-semibold text-primary-foreground">{t('policies.saveDefinition')}</button>
        </div>
        <form id="policy-edit-form" class="grid gap-3">
          <label class="grid gap-1 text-[0.82rem] font-semibold text-muted-foreground">
            {t('policies.label')}
            <input id="policy-label" value={result.detail.label} class="w-full rounded-lg border border-border bg-card px-2.5 py-2 text-sm font-normal text-foreground" />
          </label>
          <label class="grid gap-1 text-[0.82rem] font-semibold text-muted-foreground">
            {t('policies.bodyJson')}
            <textarea id="policy-body" rows="16" spellcheck={false} class="w-full rounded-lg border border-border bg-card px-2.5 py-2 font-mono text-[0.82rem] leading-relaxed text-foreground">{result.detail.body}</textarea>
          </label>
          <span id="policy-save-status" class="text-[0.82rem] text-muted-foreground" aria-live="polite"></span>
        </form>
      </section>

      <section aria-label="指派">
        <div class="mb-2 flex items-center justify-between">
          <h3 class="text-[0.95rem]">{t('policies.assignments')}</h3>
          <FlowAssignIsland client:only="react" policyId={result.detail.policyKey} />
        </div>
        <PolicyAssignmentList assignments={result.assignments} />
      </section>

      <section aria-label="近期決策">
        <h3 class="mb-2 text-[0.95rem]">{t('policies.recentDecisions')}</h3>
        <p class="text-sm text-muted-foreground">{t('policies.decisionsUnavailable')}</p>
      </section>
    </div>
  )}
</AdminV2Layout>

<script define:vars={{
  policyKey,
  lang,
  messages: {
    saved: t('policies.saved'),
    saveFailed: t('policies.saveFailed'),
    archiveFailed: t('policies.archiveFailed'),
  },
}}>
  const saveButton = document.getElementById('save-policy-btn');
  const archiveButton = document.getElementById('archive-policy-btn');
  const status = document.getElementById('policy-save-status');

  saveButton?.addEventListener('click', async () => {
    const label = /** @type {HTMLInputElement | null} */ (document.getElementById('policy-label'))?.value?.trim();
    const rawBody = /** @type {HTMLTextAreaElement | null} */ (document.getElementById('policy-body'))?.value?.trim() || '{}';
    if (status) status.textContent = '';
    saveButton.setAttribute('disabled', 'true');
    try {
      const policyBody = JSON.parse(rawBody);
      const response = await fetch(`/api/admin/settings/permissions/${encodeURIComponent(policyKey)}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ label, policy_body: policyBody }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || messages.saveFailed);
      if (status) status.textContent = messages.saved.replace('{version}', data.version);
      window.setTimeout(() => window.location.reload(), 700);
    } catch (error) {
      if (status) status.textContent = `${messages.saveFailed}: ${error instanceof Error ? error.message : String(error)}`;
    } finally {
      saveButton.removeAttribute('disabled');
    }
  });

  archiveButton?.addEventListener('click', async () => {
    const key = archiveButton.getAttribute('data-policy-key');
    const message = archiveButton.getAttribute('data-confirm') ?? '';
    if (!key || !window.confirm(message)) return;
    archiveButton.setAttribute('disabled', 'true');
    try {
      const response = await fetch(`/api/admin/settings/permissions/${encodeURIComponent(key)}`, { method: 'DELETE' });
      if (!response.ok) throw new Error(await response.text());
      window.location.href = lang === 'en' ? '/admin/policies?lang=en' : '/admin/policies';
    } catch (error) {
      window.alert(`${messages.archiveFailed}: ${error instanceof Error ? error.message : String(error)}`);
      archiveButton.removeAttribute('disabled');
    }
  });
</script>

