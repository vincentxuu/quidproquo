---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import AdminState from '@/components/admin/AdminState.astro';
import AdminPanel from '@/components/admin/AdminPanel.astro';
import AdminTable from '@/components/admin/AdminTable.astro';
import { getEnv } from '@/lib/config/env';
import { consoleHref, createConsoleTranslator, getConsoleLang } from '@/lib/console/admin/i18n';
import { ensureConsoleUmbrella } from '../../_guard';
import '@/styles/globals.css';

const gate = ensureConsoleUmbrella();
if (gate) return gate;

const PAGE_SIZE = 25;

const url = new URL(Astro.url);
const lang = getConsoleLang(url);
const t = createConsoleTranslator(lang);
const pageRaw = Number.parseInt(url.searchParams.get('page') ?? '1', 10);
const page = Number.isFinite(pageRaw) && pageRaw > 0 ? pageRaw : 1;
const offset = (page - 1) * PAGE_SIZE;
const q = url.searchParams.get('q')?.trim() ?? '';

interface PolicyRow {
  policy_id: number;
  policy_key: string;
  version: number;
  label: string | null;
  created_at: number | null;
}

let policies: PolicyRow[] = [];
let loadError = false;
let totalCount = 0;

try {
  const db = getEnv().DB;
  const where = q ? `WHERE archived_at IS NULL AND (policy_key LIKE ? OR label LIKE ? OR CAST(version AS TEXT) LIKE ?)` : 'WHERE archived_at IS NULL';

  if (q) {
    const like = `%${q}%`;
    const totalResult = await db
      .prepare(`SELECT COUNT(*) as total FROM policy_definitions ${where}`)
      .bind(like, like, like)
      .first<{ total: number }>();
    totalCount = totalResult?.total ?? 0;

    const result = await db
      .prepare(
        `SELECT policy_id, policy_key, version, label, created_at
         FROM policy_definitions
         ${where}
         ORDER BY policy_key ASC, version DESC
         LIMIT ? OFFSET ?`,
      )
      .bind(like, like, like, PAGE_SIZE, offset)
      .all<PolicyRow>();
    policies = result.results ?? [];
  } else {
    const totalResult = await db
      .prepare(`SELECT COUNT(*) as total FROM policy_definitions WHERE archived_at IS NULL`)
      .first<{ total: number }>();
    totalCount = totalResult?.total ?? 0;

    const result = await db
      .prepare(
        `SELECT policy_id, policy_key, version, label, created_at
         FROM policy_definitions
         WHERE archived_at IS NULL
         ORDER BY policy_key ASC, version DESC
         LIMIT ? OFFSET ?`,
      )
      .bind(PAGE_SIZE, offset)
      .all<PolicyRow>();
    policies = result.results ?? [];
  }
} catch {
  loadError = true;
}

const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));

const referencePolicyKeys = new Set([
  'research-quick',
  'research-standard',
  'research-enterprise',
]);

function listHref(p: number): string {
  const u = new URL(Astro.url);
  if (p <= 1) {
    u.searchParams.delete('page');
  } else {
    u.searchParams.set('page', String(p));
  }
  return u.pathname + u.search;
}

function isReferencePolicy(policyKey: string): boolean {
  return referencePolicyKeys.has(policyKey);
}

function formatTs(ms: number | null): string {
  if (!ms) return '—';
  return new Date(ms).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
}
---

<AdminV2Layout title={t('policies.title')} section="settings">
  {loadError && (
    <AdminState tone="error">{t('policies.loadError')}</AdminState>
  )}
  {!loadError && (
    <AdminPanel title={t('policies.library')} eyebrow={t('policies.libraryEyebrow')}>
      <form class="mb-3 flex flex-wrap items-center gap-2" method="GET" action={consoleHref('/admin/policies', lang)}>
        {lang === 'en' && <input type="hidden" name="lang" value="en" />}
        <label for="q" class="text-sm text-muted-foreground">{t('policies.searchLabel')}</label>
        <input
          id="q"
          name="q"
          type="search"
          value={q}
          class="min-w-[220px] rounded-lg border border-border bg-card px-2.5 py-2 text-sm"
          placeholder={t('policies.searchPlaceholder')}
        />
        <button type="submit" class="rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold hover:bg-muted">{t('common.search')}</button>
        {q && <a href={consoleHref('/admin/policies', lang)} class="rounded-lg border border-border bg-card px-3 py-1.5 text-xs no-underline hover:bg-muted">{t('common.clear')}</a>}
      </form>
    </AdminPanel>
  )}
  {!loadError && (
    <AdminPanel title={t('policies.createPolicy')} eyebrow={t('policies.createEyebrow')}>
      <form id="policy-create-form" class="grid gap-3">
        <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1">
          <label class="grid gap-1 text-[0.82rem] font-semibold text-muted-foreground">
            {t('policies.policyKey')}
            <input id="policy-key" name="policy_key" type="text" required placeholder="research-custom" class="w-full rounded-lg border border-border bg-card px-2.5 py-2 text-sm font-normal text-foreground" />
          </label>
          <label class="grid gap-1 text-[0.82rem] font-semibold text-muted-foreground">
            {t('policies.label')}
            <input id="policy-label" name="label" type="text" required placeholder="Research Custom" class="w-full rounded-lg border border-border bg-card px-2.5 py-2 text-sm font-normal text-foreground" />
          </label>
        </div>
        <label class="grid gap-1 text-[0.82rem] font-semibold text-muted-foreground">
          {t('policies.bodyJson')}
          <textarea id="policy-body" name="policy_body" rows="7" spellcheck={false} placeholder={t('policies.bodyPlaceholder')} class="w-full rounded-lg border border-border bg-card px-2.5 py-2 font-mono text-[0.82rem] leading-relaxed text-foreground"></textarea>
        </label>
        <div class="flex flex-wrap items-center gap-2.5">
          <button type="submit" class="rounded-lg border border-primary bg-primary px-3 py-1.5 text-sm font-bold text-primary-foreground">{t('common.create')}</button>
          <span id="policy-create-status" class="text-[0.82rem] text-muted-foreground" aria-live="polite"></span>
        </div>
      </form>
    </AdminPanel>
  )}
  {!loadError && policies.length === 0 && (
    <AdminState tone="empty">
      {q ? t('policies.emptySearch', { q }) : t('policies.empty')}
    </AdminState>
  )}
  {!loadError && policies.length > 0 && (
    <AdminPanel title={t('policies.library')}>
      <AdminTable minWidth="560px" flush>
        <thead>
          <tr>
            <th>{t('policies.policyKey')}</th>
            <th>{t('policies.label')}</th>
            <th>{t('common.version')}</th>
            <th>{t('policies.referencePolicy')}</th>
            <th>{t('common.createdAt')}</th>
            <th>{t('common.actions')}</th>
          </tr>
        </thead>
        <tbody>
          {policies.map((p) => (
            <tr data-policy-row={p.policy_key}>
              <td class="font-mono text-[0.85em]">
                <a href={consoleHref(`/admin/settings/permissions/${p.policy_key}`, lang)} class="text-primary no-underline hover:underline">
                  {p.policy_key}
                </a>
              </td>
              <td class="max-w-[240px] truncate text-[0.9em]">{p.label ?? t('common.none')}</td>
              <td class="font-mono text-[0.85em]">{p.version}</td>
              <td>{isReferencePolicy(p.policy_key) ? <span class="inline-block rounded-full border border-teal-700 bg-teal-100 px-2 py-0.5 text-xs font-medium text-teal-700">{t('policies.reference')}</span> : <span class="text-sm text-muted-foreground">{t('common.none')}</span>}</td>
              <td class="font-mono text-[0.85em]">{formatTs(p.created_at)}</td>
              <td>
                <div class="flex gap-2">
                  <a href={consoleHref(`/admin/settings/permissions/${p.policy_key}`, lang)} class="border-0 bg-transparent p-0 text-xs text-primary no-underline hover:underline">{t('common.view')}</a>
                  <button
                    type="button"
                    class="border-0 bg-transparent p-0 text-xs text-red-700 hover:underline"
                    data-delete-policy={p.policy_key}
                    data-confirm={t('policies.archiveConfirm', { key: p.policy_key })}
                  >{t('common.archive')}</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </AdminTable>

      {totalPages > 1 && (
        <div class="mt-3 flex flex-wrap items-center gap-2">
          {page > 1 ? <a href={listHref(1)} class="rounded-lg border border-border bg-card px-3 py-1.5 text-xs no-underline hover:bg-muted">{t('common.firstPage')}</a> : <span class="rounded-lg border border-border bg-card px-3 py-1.5 text-xs opacity-45">{t('common.firstPage')}</span>}
          {page > 1 ? <a href={listHref(page - 1)} class="rounded-lg border border-border bg-card px-3 py-1.5 text-xs no-underline hover:bg-muted">{t('common.previousPage')}</a> : <span class="rounded-lg border border-border bg-card px-3 py-1.5 text-xs opacity-45">{t('common.previousPage')}</span>}
          <span class="text-sm text-muted-foreground">{t('common.pageOf', { page, total: totalPages })}</span>
          {page < totalPages ? <a href={listHref(page + 1)} class="rounded-lg border border-border bg-card px-3 py-1.5 text-xs no-underline hover:bg-muted">{t('common.nextPage')}</a> : <span class="rounded-lg border border-border bg-card px-3 py-1.5 text-xs opacity-45">{t('common.nextPage')}</span>}
        </div>
      )}
    </AdminPanel>
  )}
</AdminV2Layout>

<script define:vars={{
  lang,
  messages: {
    created: t('policies.created'),
    createFailed: t('policies.createFailed'),
    archiveFailed: t('policies.archiveFailed'),
  },
}}>
  const form = document.getElementById('policy-create-form');
  const status = document.getElementById('policy-create-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const key = document.getElementById('policy-key')?.value?.trim();
    const label = document.getElementById('policy-label')?.value?.trim();
    const rawBody = document.getElementById('policy-body')?.value?.trim() || '{}';
    if (status) status.textContent = '';
    try {
      const policyBody = JSON.parse(rawBody);
      const response = await fetch('/api/admin/settings/permissions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ policy_key: key, label, policy_body: policyBody }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || messages.createFailed);
      if (status) status.textContent = messages.created;
      window.location.href = lang === 'en'
        ? `/admin/settings/permissions/${encodeURIComponent(key)}?lang=en`
        : `/admin/settings/permissions/${encodeURIComponent(key)}`;
    } catch (error) {
      if (status) status.textContent = `${messages.createFailed}: ${error instanceof Error ? error.message : String(error)}`;
    }
  });

  document.querySelectorAll('[data-delete-policy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const policyKey = button.getAttribute('data-delete-policy');
      const message = button.getAttribute('data-confirm') ?? '';
      if (!policyKey || !window.confirm(message)) return;
      button.setAttribute('disabled', 'true');
      try {
        const response = await fetch(`/api/admin/settings/permissions/${encodeURIComponent(policyKey)}`, {
          method: 'DELETE',
        });
        if (!response.ok) throw new Error(await response.text());
        document.querySelector(`[data-policy-row="${CSS.escape(policyKey)}"]`)?.remove();
      } catch (error) {
        window.alert(`${messages.archiveFailed}: ${error instanceof Error ? error.message : String(error)}`);
        button.removeAttribute('disabled');
      }
    });
  });
</script>

