---
export const prerender = false;
import AdminV2Layout from '@/layouts/AdminV2Layout.astro';
import '@/styles/globals.css';

const pages = [
  { href: '/admin/settings/site/content', label: '內容' },
  { href: '/admin/settings/site/pipelines', label: '流程' },
  { href: '/admin/settings/site/jobs', label: '任務' },
  { href: '/admin/settings/site/stats', label: '統計' },
  { href: '/admin/settings/site/rag', label: 'RAG' },
  { href: '/admin/settings/site/traces', label: 'RAG 追蹤' },
  { href: '/admin/settings/site/deep-research', label: 'Deep Research' },
  { href: '/admin/settings/site/ops', label: '維運' },
  { href: '/admin/settings/site/system', label: '系統設定' },
];

const breadcrumb = [{ label: 'Settings', href: '/admin/settings' }];
---

<AdminV2Layout title="Site" section="settings" breadcrumb={breadcrumb}>
  <ul class="grid list-none gap-2 p-0">
    {pages.map(p => (
      <li>
        <a
          href={p.href}
          class="block rounded-lg border border-border bg-card px-4 py-3 text-foreground no-underline transition-colors hover:border-primary"
        >
          {p.label}
        </a>
      </li>
    ))}
  </ul>
</AdminV2Layout>
