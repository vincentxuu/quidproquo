---
// src/pages/categories/[...path].astro
export const prerender = true;

import PostLayout from '../../layouts/PostLayout.astro';
import PostList from '../../components/PostList.astro';
import Icons from '../../components/Icons.astro';
import { useTranslations } from '../../i18n/utils';
import { getPublishedPosts, sortPostsByDateDesc } from '../../utils/content';
import { categoryHref, categoryPath, getPage, pageCount } from '../../utils/pagination';

const t = useTranslations('zh-TW');

export async function getStaticPaths() {
  const posts = sortPostsByDateDesc(await getPublishedPosts('zh-TW'));
  // 只在英文版真的有同分類文章時才給語言切換連結，否則退回站台預設。
  const enCategories = new Set((await getPublishedPosts('en')).map(p => p.data.category));
  return [...new Set(posts.map(p => p.data.category))].flatMap(category => {
    const inCategory = posts.filter(p => p.data.category === category);
    const types = [...new Set(inCategory.map(p => p.data.type).filter(Boolean))] as string[];
    const switchHref = enCategories.has(category) ? categoryHref('en', category) : undefined;
    return [undefined, ...types].flatMap(type => {
      const filtered = type ? inCategory.filter(p => p.data.type === type) : inCategory;
      return Array.from({ length: pageCount(filtered.length) }, (_, i) => i + 1).map(current => ({
        params: { path: categoryPath(category, type, current) },
        props: { category, type, types, count: inCategory.length, page: getPage(filtered, current), switchHref },
      }));
    });
  });
}

const { category, type, types, count, page, switchHref } = Astro.props;
---
<PostLayout title={`${[category, type].filter(Boolean).join(' / ')}${page.current > 1 ? `・第 ${page.current} 頁` : ''} — quidproquo`} lang="zh-TW" description={`quidproquo ${category} 分類文章，共 ${count} 篇。`} switchHref={switchHref}>
  <a href="/categories" class="back-link"><Icons name="chevron-left" size={14} />{t('post.backtocategories')}</a>
  <div class={`cat-header cat-header-${category}`}>
    <h1>{category}</h1>
    <span class="post-count">{count} {t('post.articles')}</span>
  </div>
  {types.length > 1 && (
    <nav class="type-filter" aria-label="依類型篩選">
      <a href={categoryHref('zh-TW', category)} class:list={['filter-btn', { active: !type }]} aria-current={!type ? 'page' : undefined}>全部</a>
      {types.map(name => (
        <a href={categoryHref('zh-TW', category, name)} class:list={['filter-btn', `filter-type-${name}`, { active: type === name }]} aria-current={type === name ? 'page' : undefined}>{name}</a>
      ))}
    </nav>
  )}
  <PostList page={page} hrefFor={n => categoryHref('zh-TW', category, type, n)} lang="zh-TW" showPinned={false} />
</PostLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 1.75rem;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--text-secondary); }

  .cat-header {
    border-left: 4px solid var(--brand-500);
    padding-left: 0.85rem;
    margin-bottom: 1.75rem;
  }
  .cat-header h1 {
    margin: 0 0 0.2rem;
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: -0.5px;
    color: var(--text-primary);
  }
  .post-count {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
</style>

<script is:inline>
  (function () {
    const type = new URLSearchParams(location.search).get('type');
    if (type && /^[a-z-]+$/.test(type) && location.pathname.split('/').filter(Boolean).length === 2) location.replace(location.pathname.replace(/\/$/, '') + '/' + type);
  })();
</script>
