---
import { requireAdmin } from '../lib/auth/admin'
import { ChatWidget } from '../components/Chat/ChatWidget'
import '../styles/tokens.css'
import '../styles/chat.css'
const isAdmin = (await requireAdmin(Astro.cookies, Astro.request)).ok
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ask AI — quidproquo</title>
  <style>
    /* 全站 token 見 src/styles/tokens.css（單一來源，不在此拷貝） */
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, sans-serif; background: var(--bg-page); color: var(--text-primary); min-height: 100vh; }
    .page { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
    nav { margin-bottom: 1.5rem; font-size: 0.9rem; display: flex; justify-content: space-between; }
    nav a { color: var(--text-secondary); text-decoration: none; }
    nav a:hover { color: var(--brand-900); }
  </style>
  <script is:inline>
    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (stored === 'dark' || (!stored && prefersDark)) {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  </script>
</head>
<body>
  <div class="page">
    <nav>
      <a href="/">← 首頁</a>
      {isAdmin && <form method="POST" action="/api/auth/logout"><button type="submit">登出</button></form>}
    </nav>
    <ChatWidget client:load />
  </div>

</body>
</html>
