---
export const prerender = true;
import "../styles/collection.css";

import PostLayout from '../layouts/PostLayout.astro';
import {
  getCollection,
  getTopWorks,
  getWorksByType,
  getGradientFor,
  getStatusLabel,
  type MediaType,
} from '../lib/collection';

const all = getCollection();
const top = getTopWorks(5);
const sections: { type: MediaType; works: typeof all }[] = [
  { type: 'anime', works: getWorksByType('anime') },
  { type: 'film', works: getWorksByType('film') },
  { type: 'drama', works: getWorksByType('drama') },
];
const sectionLabels: Record<MediaType, string> = {
  anime: '動漫',
  film: '電影',
  drama: '戲劇',
};
const count = (type: MediaType) => all.filter((w) => w.type === type).length;
const favoriteCount = all.filter((w) => w.tier === 'favorite').length;
const mosaic = [...top, ...all.filter((w) => !top.includes(w))];
---

<PostLayout title="收藏館 — quidproquo" lang="zh-TW" description="動漫、電影與戲劇的個人收藏館：評分、最愛場景與真愛作品。" bodyClass="is-collection">
  <div class="collection-scope">
    <header class="collection-hero">
      <p class="collection-eyebrow">Quidproquo Collection</p>
      <h1>我的收藏館</h1>
      <p class="collection-tagline">
        看過的作品沉澱在這裡。評分是我的，感受是我的，真愛作品單獨開一間房。
      </p>
      <div class="collection-stats">
        <div class="collection-stat"><b>{all.length}</b><span>收藏</span></div>
        <div class="collection-stat"><b>{favoriteCount}</b><span>真愛</span></div>
        <div class="collection-stat"><b>{count('anime')}</b><span>動漫</span></div>
        <div class="collection-stat"><b>{count('film')}</b><span>電影</span></div>
        <div class="collection-stat"><b>{count('drama')}</b><span>戲劇</span></div>
      </div>
    </header>

    <div class="collection-mosaic" aria-label="收藏牆">
      {mosaic.map((w) => (
        <div class:list={['mosaic-tile', w.tier === 'favorite' && 'mosaic-tile--hero']}>
          <a
            href={`/collection/${w.slug}`}
            style={`background:${getGradientFor(w.slug)}`}
            aria-label={w.title}
          >
            <b>{w.title}</b>
            <span>{w.year} · {sectionLabels[w.type]}</span>
          </a>
        </div>
      ))}
    </div>

    <section class="collection-section">
      <div class="collection-section-header">
        <span class="collection-section-no">01</span>
        <h2>真愛 TOP {top.length}</h2>
        <span class="collection-section-count">FAVORITES</span>
      </div>
      <div class="collection-grid">
        {top.map((w) => (
          <a class="work-card" href={`/collection/${w.slug}`}>
            <div class="work-card-poster" style={`background:${getGradientFor(w.slug)}`}>
              {w.poster && <img src={w.poster} alt={`${w.title} 海報`} loading="lazy" />}
              <span class="work-card-year">{w.year}</span>
              {w.rating > 0 && <span class="work-card-rating">★ {w.rating}</span>}
            </div>
            <div class="work-card-body">
              <span class="work-card-title">{w.title}</span>
              <span class="work-card-meta">{sectionLabels[w.type]} · {getStatusLabel(w.status, 'zh-TW')}</span>
              {w.oneLiner && <span class="work-card-oneliner">{w.oneLiner}</span>}
            </div>
          </a>
        ))}
      </div>
    </section>

    {sections.map((s, i) => (
      <section class="collection-section">
        <div class="collection-section-header">
          <span class="collection-section-no">{String(i + 2).padStart(2, '0')}</span>
          <h2>{sectionLabels[s.type]}</h2>
          <span class="collection-section-count">{s.works.length} 部</span>
        </div>
        {s.works.length === 0 ? (
          <p class="collection-empty">這個分類還沒有收藏。</p>
        ) : (
          <div class="collection-grid">
            {s.works.map((w) => (
              <a class="work-card" href={`/collection/${w.slug}`}>
                <div class="work-card-poster" style={`background:${getGradientFor(w.slug)}`}>
                  {w.poster && <img src={w.poster} alt={`${w.title} 海報`} loading="lazy" />}
                  <span class="work-card-year">{w.year}</span>
                  {w.rating > 0 && <span class="work-card-rating">★ {w.rating}</span>}
                </div>
                <div class="work-card-body">
                  <span class="work-card-title">{w.title}</span>
                  <span class="work-card-meta">{w.year} · {getStatusLabel(w.status, 'zh-TW')}</span>
                  {w.oneLiner && <span class="work-card-oneliner">{w.oneLiner}</span>}
                </div>
              </a>
            ))}
          </div>
        )}
      </section>
    ))}
  </div>
</PostLayout>
