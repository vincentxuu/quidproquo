---
export const prerender = true;
import "../../styles/collection.css";

import PostLayout from '../../layouts/PostLayout.astro';
import {
  getCollection,
  getGradientFor,
  getStatusLabel,
  type CollectionWork,
} from '../../lib/collection';

export function getStaticPaths() {
  return getCollection().map((work) => ({
    params: { slug: work.slug },
    props: { work: work as CollectionWork },
  }));
}

const { work } = Astro.props;

const typeLabels = { anime: '動漫', film: '電影', drama: '戲劇' } as const;
const tierLabels = { favorite: '真愛', loved: '很喜歡', watched: '看過' } as const;
---

<PostLayout
  title={`${work.title} — 收藏館 — quidproquo`}
  lang="zh-TW"
  description={work.oneLiner || work.synopsis}
>
  <article>
    <div class="work-hero">
      <div class="work-hero-poster" style={`background:${getGradientFor(work.slug)}`}>
        {work.poster && <img src={work.poster} alt={`${work.title} 海報`} />}
        {!work.poster && <span>{work.title}</span>}
      </div>
      <div>
        <h1>{work.title}</h1>
        {work.originalTitle !== work.title && <p class="work-hero-original">{work.originalTitle}</p>}
        <div class="work-badges">
          <span class:list={['work-badge', `work-badge--${work.type}`]}>{typeLabels[work.type]}</span>
          <span class="work-badge">{work.year}</span>
          <span class="work-badge">{getStatusLabel(work.status, 'zh-TW')}</span>
          <span class="work-badge">{tierLabels[work.tier]}</span>
          {work.rating > 0 && <span class="work-badge">★ {work.rating} / 10</span>}
        </div>
        <div class="work-badges">
          {work.genres.map((g) => <span class="work-badge">{g}</span>)}
        </div>
        {work.oneLiner && <blockquote class="work-oneliner">{work.oneLiner}</blockquote>}
        <p class="work-hero-synopsis">{work.synopsis}</p>
      </div>
    </div>

    {work.favoriteScenes.length > 0 && (
      <section class="work-section">
        <h2>最愛場景</h2>
        <ul>
          {work.favoriteScenes.map((scene) => <li>{scene}</li>)}
        </ul>
      </section>
    )}

    {work.review && (
      <section class="work-section">
        <h2>心得</h2>
        <p>{work.review}</p>
      </section>
    )}

    {work.deep.meaning && (
      <section class="work-section">
        <h2>這部對我的意義</h2>
        <p>{work.deep.meaning}</p>
      </section>
    )}

    {work.postSlugs.length > 0 && (
      <section class="work-section work-posts">
        <h2>延伸文章</h2>
        <ul>
          {work.postSlugs.map((post) => (
            <li><a href={`/posts/${post}`}>{post}</a></li>
          ))}
        </ul>
      </section>
    )}

    <a class="work-backlink" href="/collection">← 回收藏館</a>
  </article>
</PostLayout>
