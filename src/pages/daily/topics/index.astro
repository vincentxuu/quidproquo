---
export const prerender = true;

import PostLayout from '../../../layouts/PostLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { TOPIC_TAXONOMY } from '../../../data/topic-taxonomy';
import paperIndex from '../../../data/paper-index.json';

const t = useTranslations('zh-TW');

const topicsWithCounts = TOPIC_TAXONOMY.map(topic => {
  const count = (paperIndex as any).papers.filter(
    (p: any) => p.topics?.includes(topic.slug)
  ).length;
  return { ...topic, count };
}).sort((a, b) => b.count - a.count);
---
<PostLayout title="論文主題索引 — Daily Digest" lang="zh-TW" description="AI Agent 論文按主題分類瀏覽" switchHref="/en/daily/topics">
  <header class="page-header">
    <a href="/daily" class="back-link">&larr; Daily Digest</a>
    <h1>論文主題索引</h1>
    <p class="subtitle">依主題瀏覽所有收錄的 AI Agent 論文</p>
  </header>

  <div class="topics-grid">
    {topicsWithCounts.map(topic => (
      <a href={`/daily/topics/${topic.slug}`} class="topic-card">
        <h2>{topic.label}</h2>
        <p class="topic-en">{topic.labelEn}</p>
        <p class="topic-desc">{topic.description}</p>
        <div class="topic-meta">
          <span class="paper-count">{topic.count} 篇論文</span>
          <span class="related">
            {topic.relatedTopics.slice(0, 2).map(slug => {
              const rt = TOPIC_TAXONOMY.find(t => t.slug === slug);
              return rt ? rt.label : slug;
            }).join('、')}
          </span>
        </div>
      </a>
    ))}
  </div>
</PostLayout>

<style>
  .page-header { margin-bottom: 2rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--border); }
  .back-link { font-size: 0.8rem; color: var(--text-secondary); text-decoration: none; }
  .back-link:hover { color: var(--brand-500); }
  h1 { margin: 0.5rem 0 0.15rem; }
  .subtitle { color: var(--text-secondary); font-size: 0.88rem; }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .topic-card {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .topic-card:hover {
    border-color: var(--brand-500);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }
  .topic-card h2 { font-size: 1rem; margin: 0 0 0.15rem; }
  .topic-en { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.5rem; }
  .topic-desc { font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 0.75rem; line-height: 1.5; }
  .topic-meta { display: flex; justify-content: space-between; align-items: center; font-size: 0.72rem; color: var(--text-muted); }
  .paper-count {
    background: var(--brand-50, var(--surface-raised));
    color: var(--brand-700);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    font-weight: 500;
  }
</style>
