---
// src/pages/en/categories/[...path].astro
export const prerender = true;

import PostLayout from '../../../layouts/PostLayout.astro';
import PostList from '../../../components/PostList.astro';
import Icons from '../../../components/Icons.astro';
import { useTranslations } from '../../../i18n/utils';
import { getPublishedPosts, sortPostsByDateDesc } from '../../../utils/content';
import { categoryHref, categoryPath, getPage, pageCount } from '../../../utils/pagination';

const t = useTranslations('en');

export async function getStaticPaths() {
  const posts = sortPostsByDateDesc(await getPublishedPosts('en'));
  // 只在中文版真的有同分類文章時才給語言切換連結，否則退回站台預設。
  const zhCategories = new Set((await getPublishedPosts('zh-TW')).map(p => p.data.category));
  return [...new Set(posts.map(p => p.data.category))].flatMap(category => {
    const inCategory = posts.filter(p => p.data.category === category);
    const types = [...new Set(inCategory.map(p => p.data.type).filter(Boolean))] as string[];
    const switchHref = zhCategories.has(category) ? categoryHref('zh-TW', category) : undefined;
    return [undefined, ...types].flatMap(type => {
      const filtered = type ? inCategory.filter(p => p.data.type === type) : inCategory;
      return Array.from({ length: pageCount(filtered.length) }, (_, i) => i + 1).map(current => ({
        params: { path: categoryPath(category, type, current) },
        props: { category, type, types, count: inCategory.length, page: getPage(filtered, current), switchHref },
      }));
    });
  });
}

const { category, type, types, count, page, switchHref } = Astro.props;
---
<PostLayout title={`${[category, type].filter(Boolean).join(' / ')}${page.current > 1 ? ` · page ${page.current}` : ''} — quidproquo`} lang="en" description={`quidproquo ${category} category — ${count} articles.`} switchHref={switchHref}>
  <a href="/en/categories" class="back-link"><Icons name="chevron-left" size={14} />{t('post.backtocategories')}</a>
  <div class={`cat-header cat-header-${category}`}>
    <h1>{category}</h1>
    <span class="post-count">{count} {t('post.articles')}</span>
  </div>
  {types.length > 1 && (
    <nav class="type-filter" aria-label="Filter by type">
      <a href={categoryHref('en', category)} class:list={['filter-btn', { active: !type }]} aria-current={!type ? 'page' : undefined}>all</a>
      {types.map(name => (
        <a href={categoryHref('en', category, name)} class:list={['filter-btn', `filter-type-${name}`, { active: type === name }]} aria-current={type === name ? 'page' : undefined}>{name}</a>
      ))}
    </nav>
  )}
  <PostList page={page} hrefFor={n => categoryHref('en', category, type, n)} lang="en" showPinned={false} />
</PostLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 1.75rem;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--text-secondary); }

  .cat-header {
    border-left: 4px solid var(--accent-color, var(--brand-500));
    padding-left: 0.85rem;
    margin-bottom: 1.75rem;
  }
  .cat-header h1 {
    margin: 0 0 0.2rem;
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: -0.5px;
    color: var(--accent-color, var(--brand-900));
  }
  .post-count {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .cat-header-tech      { --accent-color: var(--cat-tech); }
  .cat-header-ai        { --accent-color: var(--cat-ai); }
  .cat-header-product   { --accent-color: var(--cat-product); }
  .cat-header-education { --accent-color: var(--cat-education); }
  .cat-header-life      { --accent-color: var(--cat-life); }
  .cat-header-marketing { --accent-color: var(--cat-marketing); }
  .cat-header-travel    { --accent-color: var(--cat-travel); }
  .cat-header-climbing  { --accent-color: var(--cat-climbing); }
  .cat-header-surf      { --accent-color: var(--cat-surf); }
  .cat-header-film      { --accent-color: var(--cat-film); }
  .cat-header-coffee    { --accent-color: var(--cat-coffee); }
  .cat-header-learning  { --accent-color: var(--cat-learning); }
  .cat-header-design    { --accent-color: var(--cat-design); }
  .cat-header-policy    { --accent-color: var(--cat-policy); }
  .cat-header-anime     { --accent-color: var(--cat-anime); }
  .cat-header-career    { --accent-color: var(--cat-career); }
  .cat-header-investing { --accent-color: var(--cat-investing, #047857); }
  .cat-header-weather   { --accent-color: var(--cat-weather, #2563eb); }

  .filter-type-debug.active     { background: #d97706; border-color: #d97706; color: #fff; }
  .filter-type-deep-dive.active { background: #4f46e5; border-color: #4f46e5; color: #fff; }
  .filter-type-guide.active     { background: #0d9488; border-color: #0d9488; color: #fff; }
  .filter-type-project.active   { background: #64748b; border-color: #64748b; color: #fff; }
</style>

<script is:inline>
  (function () {
    const type = new URLSearchParams(location.search).get('type');
    if (type && /^[a-z-]+$/.test(type) && location.pathname.split('/').filter(Boolean).length === 3) location.replace(location.pathname.replace(/\/$/, '') + '/' + type);
  })();
</script>
