---
export const prerender = true;

import PostLayout from '../../layouts/PostLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { useTranslations } from '../../i18n/utils';
import { getSeriesHref } from '../../utils/series';
import { getDailyPosts } from '../../utils/content';
import { TOPIC_TAXONOMY } from '../../data/topic-taxonomy';
import { DAILY_CHANNELS, getDailyChannelId } from '../../data/daily-content-types';

const t = useTranslations('en');
const posts = await getDailyPosts('en');

const grouped = new Map<string, typeof posts>();
for (const post of posts) {
  const key = post.data.date.toISOString().slice(0, 10);
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(post);
}

const weekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
---
<PostLayout title="Daily Digest — quidproquo" lang="en" description={t('daily.description')} switchHref="/daily">
  <link slot="head" rel="alternate" type="application/rss+xml" title="quidproquo Daily Digest RSS" href="/en/daily/rss.xml" />
  <header class="page-header">
    <h1>{t('daily.title')} <a href="/en/daily/rss.xml" class="rss-badge" aria-label="Daily RSS">RSS</a></h1>
    <p class="subtitle">{t('daily.description')}</p>
    <div class="filter-row">
      <button class="filter-btn active" data-filter="all">All</button>
      {DAILY_CHANNELS.map(ch => (
        <button class="filter-btn" data-filter={ch.id}>{ch.labelEn}</button>
      ))}
    </div>
    <div class="topic-row">
      <span class="topic-label">Topics:</span>
      {TOPIC_TAXONOMY.map(topic => (
        <a href={`/en/daily/topics/${topic.slug}`} class="topic-chip">{topic.labelEn}</a>
      ))}
      <a href="/en/daily/topics" class="topic-chip topic-all">All Topics →</a>
    </div>
  </header>

  {posts.length === 0 && <p class="empty">{t('daily.empty')}</p>}

  {[...grouped.entries()].map(([dateStr, dayPosts]) => {
    const date = new Date(dateStr + 'T00:00:00');
    const weekday = weekdays[date.getUTCDay()];
    return (
      <div class="day-group">
        <div class="day-header">
          <span class="day-date">{dateStr}</span>
          <span class="day-weekday">{weekday}</span>
          <div class="day-line" />
        </div>
        <div class="day-cards">
          {dayPosts.map(post => {
            const channelId = getDailyChannelId(post.data.series?.name, post.data.tags);
            return (
              <div class="daily-card-wrap" data-type={channelId}>
                <PostCard
                  slug={post.id}
                  title={post.data.title}
                  date={post.data.date}
                  category={post.data.category}
                  tags={post.data.tags}
                  description={post.data.description}
                  tldr={post.data.tldr}
                  readingTime={post.data.readingTime}
                  lang="en"
                  type={post.data.type}
                  pinned={post.data.pinned}
                  seriesName={post.data.series?.name}
                  seriesHref={post.data.series ? getSeriesHref(post.data.series.name, 'en') : undefined}
                />
              </div>
            );
          })}
        </div>
      </div>
    );
  })}
</PostLayout>

<script is:inline>
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      document.querySelectorAll('.daily-card-wrap').forEach(card => {
        card.style.display = (filter === 'all' || card.dataset.type === filter) ? '' : 'none';
      });
      document.querySelectorAll('.day-group').forEach(group => {
        const visible = group.querySelectorAll('.daily-card-wrap:not([style*="display: none"])');
        group.style.display = visible.length > 0 ? '' : 'none';
      });
    });
  });
</script>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  h1 { margin-bottom: 0.25rem; }
  .subtitle { color: var(--text-secondary); margin-bottom: 0.75rem; font-size: 0.88rem; }
  .filter-row { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .filter-btn {
    font-size: 0.76rem;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }
  .filter-btn:hover { border-color: var(--brand-500); color: var(--brand-500); }
  .filter-btn.active { background: var(--brand-500); color: #fff; border-color: var(--brand-500); }
  .topic-row { display: flex; gap: 0.35rem; flex-wrap: wrap; align-items: center; }
  .topic-label { font-size: 0.72rem; color: var(--text-muted); margin-right: 0.15rem; }
  .topic-chip {
    font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 100px;
    border: 1px solid var(--border); color: var(--text-muted);
    text-decoration: none; transition: all 0.15s; font-family: inherit;
  }
  .topic-chip:hover { border-color: var(--brand-500); color: var(--brand-500); }
  .topic-all { font-weight: 500; }
  .day-group { margin-bottom: 1.5rem; }
  .day-header { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem; }
  .day-date {
    font-family: var(--font-mono, 'SF Mono', 'Fira Code', monospace);
    font-size: 0.8rem; font-weight: 600; color: var(--brand-700);
    background: var(--brand-50, var(--surface-raised));
    padding: 0.15rem 0.55rem; border-radius: 4px;
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .day-weekday { font-size: 0.75rem; color: var(--text-muted); }
  .day-line { flex: 1; height: 1px; background: var(--border); }
  .day-cards { display: flex; flex-direction: column; gap: 0.4rem; padding-left: 0.4rem; }
  .empty { color: var(--text-muted); font-size: 0.9rem; text-align: center; padding: 3rem 0; }
  .rss-badge {
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.04em;
    padding: 0.15rem 0.45rem; border-radius: 4px; vertical-align: middle;
    background: var(--brand-500); color: #fff; text-decoration: none;
    margin-left: 0.3rem; transition: opacity 0.15s;
  }
  .rss-badge:hover { opacity: 0.8; }
</style>
