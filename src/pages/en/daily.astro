---
export const prerender = true;

import PostLayout from '../../layouts/PostLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { useTranslations } from '../../i18n/utils';
import { getSeriesHref } from '../../utils/series';
import { getDailyPosts } from '../../utils/content';

const t = useTranslations('en');
const posts = await getDailyPosts('en');

// Group posts by date
const grouped = new Map<string, typeof posts>();
for (const post of posts) {
  const key = post.data.date.toISOString().slice(0, 10);
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(post);
}

const weekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

function getSeriesType(seriesName?: string): string {
  if (!seriesName) return 'daily';
  if (seriesName.includes('Arxiv')) return 'arxiv';
  if (seriesName.includes('GitHub')) return 'github';
  if (seriesName.includes('Weekly')) return 'weekly';
  return 'daily';
}
---
<PostLayout title="Daily Digest — quidproquo" lang="en" description={t('daily.description')} switchHref="/daily">
  <header class="page-header">
    <h1>{t('daily.title')}</h1>
    <p class="subtitle">{t('daily.description')}</p>
    <div class="filter-row">
      <button class="filter-btn active" data-filter="all">{t('daily.filter.all')}</button>
      <button class="filter-btn" data-filter="daily">{t('daily.filter.daily')}</button>
      <button class="filter-btn" data-filter="arxiv">{t('daily.filter.arxiv')}</button>
      <button class="filter-btn" data-filter="github">{t('daily.filter.github')}</button>
      <button class="filter-btn" data-filter="weekly">{t('daily.filter.weekly')}</button>
    </div>
  </header>

  {posts.length === 0 && <p class="empty">{t('daily.empty')}</p>}

  {[...grouped.entries()].map(([dateStr, dayPosts]) => {
    const date = new Date(dateStr + 'T00:00:00');
    const weekday = weekdays[date.getUTCDay()];
    return (
      <div class="day-group">
        <div class="day-header">
          <span class="day-date">{dateStr}</span>
          <span class="day-weekday">{weekday}</span>
          <div class="day-line" />
        </div>
        <div class="day-cards">
          {dayPosts.map(post => {
            const seriesType = getSeriesType(post.data.series?.name);
            return (
              <div class="daily-card-wrap" data-type={seriesType}>
                <PostCard
                  slug={post.id}
                  title={post.data.title}
                  date={post.data.date}
                  category={post.data.category}
                  tags={post.data.tags}
                  description={post.data.description}
                  tldr={post.data.tldr}
                  readingTime={post.data.readingTime}
                  lang="en"
                  type={post.data.type}
                  pinned={post.data.pinned}
                  seriesName={post.data.series?.name}
                  seriesHref={post.data.series ? getSeriesHref(post.data.series.name, 'en') : undefined}
                />
              </div>
            );
          })}
        </div>
      </div>
    );
  })}
</PostLayout>

<script is:inline>
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      document.querySelectorAll('.daily-card-wrap').forEach(card => {
        if (filter === 'all' || card.dataset.type === filter) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
      document.querySelectorAll('.day-group').forEach(group => {
        const visibleCards = group.querySelectorAll('.daily-card-wrap:not([style*="display: none"])');
        group.style.display = visibleCards.length > 0 ? '' : 'none';
      });
    });
  });
</script>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  h1 { margin-bottom: 0.25rem; }
  .subtitle { color: var(--text-secondary); margin-bottom: 0.75rem; font-size: 0.88rem; }
  .filter-row { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .filter-btn {
    font-size: 0.78rem;
    padding: 0.25rem 0.65rem;
    border-radius: 100px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }
  .filter-btn:hover { border-color: var(--brand-500); color: var(--brand-500); }
  .filter-btn.active { background: var(--brand-500); color: #fff; border-color: var(--brand-500); }
  .day-group { margin-bottom: 1.5rem; }
  .day-header { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem; }
  .day-date {
    font-family: var(--font-mono, 'SF Mono', 'Fira Code', monospace);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--brand-700);
    background: var(--brand-50, var(--surface-raised));
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .day-weekday { font-size: 0.75rem; color: var(--text-muted); }
  .day-line { flex: 1; height: 1px; background: var(--border); }
  .day-cards { display: flex; flex-direction: column; gap: 0.4rem; padding-left: 0.4rem; }
  .empty { color: var(--text-muted); font-size: 0.9rem; text-align: center; padding: 3rem 0; }
</style>
