---
export const prerender = true;

import PostLayout from '../../../layouts/PostLayout.astro';
import SeriesDirectory from '../../../components/SeriesDirectory.astro';
import { useTranslations } from '../../../i18n/utils';
import { getPublishedPosts } from '../../../utils/content';
import { getSeriesSummaries } from '../../../utils/series';

const t = useTranslations('en');
const posts = await getPublishedPosts('en');
const seriesList = getSeriesSummaries(posts, 'en');
---
<PostLayout title={`${t('nav.series')} — quidproquo`} lang="en" description="Published post series on quidproquo." switchHref="/series">
  <SeriesDirectory lang="en" seriesList={seriesList} />
</PostLayout>
