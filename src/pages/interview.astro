---
export const prerender = true;

import PostLayout from '../layouts/PostLayout.astro';
import PostCard from '../components/PostCard.astro';
import { useTranslations } from '../i18n/utils';
import { getSeriesHref, getSeriesSummaries } from '../utils/series';
import { getPublishedPosts, sortPostsByDateDesc } from '../utils/content';

const t = useTranslations('zh-TW');
const allPosts = sortPostsByDateDesc(await getPublishedPosts('zh-TW'));

const interviewTags = new Set(['ai-engineer-interview', 'product-builder-interview']);
const interviewSeriesNames = new Set([
  'AI Engineer 面試準備',
  'Product Builder 面試準備',
  'AI Engineer 面試日練',
  'Product Builder 面試日練',
]);

const posts = allPosts.filter(
  p => p.data.tags.some(tag => interviewTags.has(tag)) ||
       (p.data.series && interviewSeriesNames.has(p.data.series.name))
);

const seriesSummaries = getSeriesSummaries(allPosts, 'zh-TW').filter(
  s => interviewSeriesNames.has(s.name)
);

const dailyPosts = posts.filter(p => p.data.category === 'daily');
const seriesPosts = posts.filter(p => p.data.category !== 'daily');
---
<PostLayout title="面試準備 — quidproquo" lang="zh-TW" description="AI Engineer 與 Product Builder 面試準備：深度系列 + 每日練習" switchHref="/en/interview">
  <header class="page-header">
    <h1>面試準備</h1>
    <p class="subtitle">AI Engineer 與 Product Builder 兩條 track，各有深度系列和每日練習。</p>
  </header>

  {seriesSummaries.length > 0 && (
    <section class="track-section">
      <h2>系列文章</h2>
      <div class="series-grid">
        {seriesSummaries.map(series => (
          <a href={getSeriesHref(series.name, 'zh-TW')} class="series-card">
            <h3>{series.name}</h3>
            <p>{series.description}</p>
            <span class="series-count">{series.count} 篇</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="track-section" id="progress-tracker">
    <h2>學習進度</h2>
    <div class="progress-tracks">
      <div class="progress-track" data-track="ai-engineer">
        <h3>AI Engineer</h3>
        <div class="progress-bar-wrap">
          <div class="progress-bar-fill" data-progress-bar="ai-engineer"></div>
        </div>
        <span class="progress-label" data-progress-label="ai-engineer">0 / 10</span>
        <div class="checklist">
          {['全景圖', 'ML Fundamentals', 'Deep Learning', 'NLP & LLM', 'ML System Design', 'LLM Application', 'Coding', 'Paper Reading', 'MLOps', 'Behavioral'].map((topic, i) => (
            <label class="check-item">
              <input type="checkbox" data-check={`ai-${i}`} />
              <span>{topic}</span>
            </label>
          ))}
        </div>
      </div>
      <div class="progress-track" data-track="product-builder">
        <h3>Product Builder</h3>
        <div class="progress-bar-wrap">
          <div class="progress-bar-fill" data-progress-bar="product-builder"></div>
        </div>
        <span class="progress-label" data-progress-label="product-builder">0 / 10</span>
        <div class="checklist">
          {['全景圖', 'Product Sense', 'Product Design', 'Metrics', 'Strategy', 'Execution', 'Technical PM', 'Growth', 'AI Product', 'Behavioral'].map((topic, i) => (
            <label class="check-item">
              <input type="checkbox" data-check={`pb-${i}`} />
              <span>{topic}</span>
            </label>
          ))}
        </div>
      </div>
    </div>
  </section>

  {dailyPosts.length > 0 && (
    <section class="track-section">
      <h2>每日練習 <span class="section-count">（最近 {Math.min(dailyPosts.length, 14)} 篇）</span></h2>
      <div class="daily-list">
        {dailyPosts.slice(0, 14).map(post => (
          <PostCard
            slug={post.id}
            title={post.data.title}
            date={post.data.date}
            category={post.data.category}
            tags={post.data.tags}
            description={post.data.description}
            tldr={post.data.tldr}
            readingTime={post.data.readingTime}
            lang="zh-TW"
            type={post.data.type}
            seriesName={post.data.series?.name}
            seriesHref={post.data.series ? getSeriesHref(post.data.series.name, 'zh-TW') : undefined}
          />
        ))}
      </div>
      {dailyPosts.length > 14 && (
        <p class="more-link"><a href="/daily?type=ai-interview">查看全部日練 →</a></p>
      )}
    </section>
  )}

  {seriesPosts.length > 0 && (
    <section class="track-section">
      <h2>深度文章</h2>
      <div class="daily-list">
        {seriesPosts.map(post => (
          <PostCard
            slug={post.id}
            title={post.data.title}
            date={post.data.date}
            category={post.data.category}
            tags={post.data.tags}
            description={post.data.description}
            tldr={post.data.tldr}
            readingTime={post.data.readingTime}
            lang="zh-TW"
            type={post.data.type}
            seriesName={post.data.series?.name}
            seriesHref={post.data.series ? getSeriesHref(post.data.series.name, 'zh-TW') : undefined}
          />
        ))}
      </div>
    </section>
  )}
</PostLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  h1 { margin-bottom: 0.25rem; }
  .subtitle { color: var(--text-secondary); font-size: 0.88rem; }
  .track-section { margin-bottom: 2.5rem; }
  .track-section h2 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .section-count { font-size: 0.8rem; font-weight: 400; color: var(--text-muted); }
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .series-card {
    display: block;
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .series-card:hover {
    border-color: var(--brand-500);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .series-card h3 { margin: 0 0 0.4rem; font-size: 0.95rem; }
  .series-card p { margin: 0 0 0.6rem; font-size: 0.78rem; color: var(--text-secondary); line-height: 1.5; }
  .series-count {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--brand-500);
  }
  .daily-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .more-link {
    margin-top: 0.75rem;
    font-size: 0.82rem;
  }
  .more-link a {
    color: var(--brand-500);
    text-decoration: none;
  }
  .more-link a:hover { text-decoration: underline; }
  .progress-tracks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .progress-track h3 { margin: 0 0 0.5rem; font-size: 0.9rem; }
  .progress-bar-wrap {
    height: 6px;
    background: var(--border);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 0.3rem;
  }
  .progress-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--brand-500);
    border-radius: 3px;
    transition: width 0.3s;
  }
  .progress-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .checklist {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.25rem 1rem;
    margin-top: 0.6rem;
  }
  .check-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .check-item input { accent-color: var(--brand-500); }
  .check-item input:checked + span { color: var(--brand-700); text-decoration: line-through; }
  @media (max-width: 500px) {
    .checklist { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'interview-prep-progress';
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');

    document.querySelectorAll('[data-check]').forEach(cb => {
      const key = cb.dataset.check;
      cb.checked = !!saved[key];
      cb.addEventListener('change', () => {
        saved[key] = cb.checked;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
        updateBars();
      });
    });

    function updateBars() {
      ['ai-engineer', 'product-builder'].forEach(track => {
        const prefix = track === 'ai-engineer' ? 'ai-' : 'pb-';
        let done = 0;
        for (let i = 0; i < 10; i++) if (saved[prefix + i]) done++;
        const bar = document.querySelector(`[data-progress-bar="${track}"]`);
        const label = document.querySelector(`[data-progress-label="${track}"]`);
        if (bar) bar.style.width = (done / 10 * 100) + '%';
        if (label) label.textContent = `${done} / 10`;
      });
    }
    updateBars();
  })();
</script>
