</style>

<script>
  // Mermaid: Shiki syntax-highlights ```mermaid fences as plain code by default.
  // Swap them for real rendered diagrams (skip entirely if the post has none).
  // Source text is kept on the container so a later dark/light toggle can re-render.
  const mermaidBlocks = document.querySelectorAll<HTMLPreElement>('.content pre[data-language="mermaid"]');
  if (mermaidBlocks.length > 0) {
    void (async () => {
      const { default: mermaid } = await import('mermaid');

      // Mermaid's themeVariables only accept literal colors, not var(...), so read the
      // resolved token values from src/styles/tokens.css at render time. renderAll() runs
      // again on every data-theme change, so light/dark both come from the same tokens.
      const themeTokenMap = {
        background: '--bg-page',
        primaryColor: '--brand-100',
        primaryTextColor: '--text-primary',
        primaryBorderColor: '--brand-500',
        secondaryColor: '--info-bg',
        secondaryBorderColor: '--info-border',
        secondaryTextColor: '--text-primary',
        tertiaryColor: '--warning-bg',
        tertiaryBorderColor: '--warning-border',
        tertiaryTextColor: '--text-primary',
        lineColor: '--text-muted',
        textColor: '--text-primary',
        noteBkgColor: '--warning-bg',
        noteBorderColor: '--warning-border',
        noteTextColor: '--text-primary',
        edgeLabelBackground: '--bg-page',
        clusterBkg: '--bg-subtle',
        clusterBorder: '--border',
      } as const;
      const fontFamily = "'Noto Sans TC Local', 'PingFang TC', 'Microsoft JhengHei', system-ui, -apple-system, sans-serif";
      const readThemeVariables = (isDark: boolean) => {
        const styles = getComputedStyle(document.documentElement);
        const vars: Record<string, string | boolean> = { darkMode: isDark, fontFamily };
        for (const [key, token] of Object.entries(themeTokenMap)) {
          const value = styles.getPropertyValue(token).trim();
          if (value) vars[key] = value;
          else console.warn(`[mermaid] token ${token} is empty; mermaid default used for ${key}`);
        }
        return vars;
      };

      const narrowQuery = window.matchMedia('(max-width: 640px)');
      const renderAll = async () => {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const isNarrow = narrowQuery.matches;
        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: readThemeVariables(isDark),
          securityLevel: 'strict',
        });
        const containers = document.querySelectorAll<HTMLElement>('.mermaid-diagram');
        for (const [i, container] of Array.from(containers).entries()) {
          const rawSource = container.dataset.mermaidSource ?? '';
          // 手機窄螢幕：橫向流程圖改由上往下排，才放得進寬度而不必縮小或橫滑
          const source = isNarrow
            ? rawSource.replace(/^(\s*(?:flowchart|graph))\s+(?:LR|RL)\b/, '$1 TD')
            : rawSource;
          try {
            const { svg } = await mermaid.render(`mermaid-diagram-${i}`, source);
            container.innerHTML = svg;
            // 手機上寬圖不縮小，保留原尺寸讓容器橫向捲動（CSS 讀 --natural-w）
            const el = container.querySelector('svg');
            const naturalW = el?.viewBox.baseVal?.width;
            if (el && naturalW) el.style.setProperty('--natural-w', `${Math.ceil(naturalW)}px`);
          } catch (err) {
            console.error('[mermaid] failed to render diagram', err);
          }
        }
      };

      for (const pre of Array.from(mermaidBlocks)) {
        const container = document.createElement('div');
        container.className = 'mermaid-diagram';
        container.dataset.mermaidSource = pre.textContent ?? '';
        pre.replaceWith(container);
      }
      await renderAll();

      narrowQuery.addEventListener('change', () => { void renderAll(); });
      const themeObserver = new MutationObserver(() => { void renderAll(); });
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    })();
  }

  // Wrap tables in scrollable container for mobile
  document.querySelectorAll('.content table:not(.route-videos__table)').forEach(table => {
    const wrapper = document.createElement('div');
    wrapper.className = 'table-scroll';
    table.parentNode!.insertBefore(wrapper, table);
    wrapper.appendChild(table);
  });

  // Attach copy buttons to all pre blocks (macOS-style, positioned in the header bar)
  document.querySelectorAll('.content pre:not([data-language="mermaid"])').forEach(pre => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.setAttribute('aria-label', 'Copy code');
    btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    btn.addEventListener('click', async () => {
      const code = (pre.querySelector('code') as HTMLElement)?.innerText ?? (pre as HTMLElement).innerText;
      await navigator.clipboard.writeText(code);
      btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
      setTimeout(() => {
        btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
      }, 2000);
    });
    pre.appendChild(btn);
  });

  // Fetch the shared dictionary; keep full terms.ts out of the browser bundle.
  import { loadGlossaryEntries } from '../../lib/glossary/client';
  import { markGlossaryTerms, resetGlossaryTerms } from '../../lib/glossary/mark';
  const glossaryData = document.getElementById('glossary-data') as HTMLScriptElement | null;
  const glossaryPopover = document.getElementById('glossary-popover') as HTMLElement | null;
  const glossaryTitle = document.getElementById('glossary-title');
  const glossaryDefinition = document.getElementById('glossary-definition');
  const glossaryContext = document.getElementById('glossary-context');
  const glossaryReading = document.getElementById('glossary-reading') as HTMLElement | null;

  type GlossaryEntry = {
    term: string;
    aliases?: string[];
    definition?: string;
    advanced?: string;
    context?: string;
    links?: Array<{ label: string; url: string }>;
  };

  type GlossaryResponse = {
    term: string;
    level: 'beginner' | 'advanced';
    definition: string;
    context: string;
    reading: Array<{ label: string; url: string }>;
    source: 'ai' | 'local';
  };

  const glossaryOverrides: GlossaryEntry[] = glossaryData?.textContent
    ? JSON.parse(glossaryData.textContent)
    : [];
  let glossaryEntries: GlossaryEntry[] = glossaryOverrides;
  let sharedGlossaryLoaded = false;
  let glossaryLoading = false;
  let glossaryFallbackMarked = false;
  const glossaryBoundButtons = new WeakSet<HTMLElement>();
  const glossarySlug = glossaryData?.dataset.postSlug ?? '';
  const glossaryLang = glossaryData?.dataset.lang ?? 'zh-TW';
  const glossarySave = document.getElementById('glossary-save') as HTMLButtonElement | null;
  const glossarySaveStatus = document.getElementById('glossary-save-status');
  let saveResponse: GlossaryResponse | null = null;
  let glossaryRequest = 0;
  const glossaryCache = new Map<string, GlossaryResponse>();
  const glossaryPending = new Map<string, Promise<GlossaryResponse>>();
  let glossaryLevel = (localStorage.getItem('glossary-level') === 'advanced' ? 'advanced' : 'beginner') as 'beginner' | 'advanced';
  let glossaryHideTimer: number | undefined;
  let activeGlossaryButton: HTMLElement | null = null;

  function sentenceAround(node: HTMLElement) {
    const text = node.closest('p, li, td, blockquote')?.textContent?.replace(/\s+/g, ' ').trim() ?? '';
    return text.length > 420 ? `${text.slice(0, 419)}…` : text;
  }

  function glossaryEntryFor(value: string) {
    const key = value.toLowerCase();
    return glossaryEntries.find(entry => {
      if (entry.term.toLowerCase() === key) return true;
      return entry.aliases?.some(alias => alias.toLowerCase() === key);
    });
  }

  function setGlossaryLevel(level: 'beginner' | 'advanced') {
    glossaryLevel = level;
    localStorage.setItem('glossary-level', level);
    glossaryPopover?.querySelectorAll<HTMLButtonElement>('[data-glossary-level]').forEach(button => {
      button.classList.toggle('active', button.dataset.glossaryLevel === level);
    });
  }

  function positionGlossaryPopover(anchor: HTMLElement) {
    if (!glossaryPopover) return;
    const rect = anchor.getBoundingClientRect();
    const gap = 8;
    const width = Math.min(360, window.innerWidth - 32);
    const left = Math.max(16, Math.min(rect.left, window.innerWidth - width - 16));
    const top = rect.bottom + gap + 220 > window.innerHeight
      ? Math.max(16, rect.top - gap - 220)
      : rect.bottom + gap;
    glossaryPopover.style.left = `${left}px`;
    glossaryPopover.style.top = `${Math.max(16, Math.min(top, window.innerHeight - glossaryPopover.offsetHeight - 16))}px`;
  }

  function renderGlossary(data: GlossaryResponse) {
    if (!glossaryTitle || !glossaryDefinition || !glossaryContext || !glossaryReading) return;
    saveResponse = data.definition === 'Loading...' ? null : data;
    if (glossarySave) glossarySave.disabled = !saveResponse;
    if (glossarySaveStatus) glossarySaveStatus.textContent = '';
    glossaryTitle.textContent = data.term;
    glossaryDefinition.textContent = data.definition;
    glossaryContext.textContent = data.context;
    glossaryReading.textContent = '';
    data.reading.slice(0, 3).forEach(link => {
      const anchor = document.createElement('a');
      anchor.href = link.url;
      anchor.textContent = link.label;
      glossaryReading.appendChild(anchor);
    });
  }

  function localGlossaryResponse(term: string, level: 'beginner' | 'advanced', context: string, seed?: GlossaryEntry): GlossaryResponse {
    const definition = level === 'advanced'
      ? seed?.advanced ?? seed?.definition
      : seed?.definition ?? seed?.advanced;

    return {
      term,
      level,
      definition: definition ?? (glossaryLang === 'en' ? `${term} is a technical term used in this article.` : `${term} 是本文中的技術名詞。`),
      context: seed?.context ?? context,
      reading: seed?.links?.length
        ? seed.links
        : (() => {
            const searchTerm = seed?.aliases?.find(a => a.length > term.length) ?? term;
            return [{ label: glossaryLang === 'en' ? `Search ${term}` : `搜尋 ${term}`, url: `/search?q=${encodeURIComponent(searchTerm)}&mode=rag` }];
          })(),
      source: 'local',
    };
  }

  async function loadGlossary(button: HTMLElement) {
    if (!glossaryPopover) return;
    window.clearTimeout(glossaryHideTimer);
    activeGlossaryButton = button;
    const request = ++glossaryRequest;
    const term = button.dataset.term ?? button.textContent?.trim() ?? '';
    const seed = glossaryEntryFor(term);
    const context = sentenceAround(button);
    const cacheKey = `${term}:${glossaryLevel}:${context}`;
    setGlossaryLevel(glossaryLevel);
    glossaryPopover.hidden = false;
    positionGlossaryPopover(button);

    if (glossaryCache.has(cacheKey)) {
      renderGlossary(glossaryCache.get(cacheKey)!);
      return;
    }

    const localResponse = localGlossaryResponse(term, glossaryLevel, context, seed);
    renderGlossary({
      term,
      level: glossaryLevel,
      definition: 'Loading...',
      context: '正在整理本文脈絡中的說明。',
      reading: [],
      source: 'local',
    });

    let pending = glossaryPending.get(cacheKey);
    if (!pending) {
      pending = fetch('/api/glossary/explain', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ term, level: glossaryLevel, context, slug: glossarySlug, seed }),
      })
        .then(res => res.ok ? res.json() : localResponse)
        .catch(() => localResponse) as Promise<GlossaryResponse>;
      glossaryPending.set(cacheKey, pending);
    }

    const response = await pending;
    glossaryPending.delete(cacheKey);
    glossaryCache.set(cacheKey, response);
    if (activeGlossaryButton === button && request === glossaryRequest) {
      renderGlossary(response);
      positionGlossaryPopover(button);
    }
  }

  function hideGlossarySoon() {
    glossaryHideTimer = window.setTimeout(() => {
      if (glossaryPopover?.contains(document.activeElement)) return;
      if (glossaryPopover) glossaryPopover.hidden = true;
      activeGlossaryButton = null;
      ++glossaryRequest;
    }, 180);
  }

  function markAndBindGlossary() {
    const content = document.querySelector<HTMLElement>('.content');
    if (!content) return;
    markGlossaryTerms(content, glossaryEntries);
    document.querySelectorAll<HTMLElement>('.glossary-term').forEach(button => {
      if (glossaryBoundButtons.has(button)) return;
      glossaryBoundButtons.add(button);
      button.addEventListener('mouseenter', () => loadGlossary(button));
      button.addEventListener('focus', () => loadGlossary(button));
      button.addEventListener('mouseleave', hideGlossarySoon);
      button.addEventListener('blur', hideGlossarySoon);
      button.addEventListener('click', () => loadGlossary(button));
      button.setAttribute('aria-controls', 'glossary-popover');
      button.setAttribute('aria-haspopup', 'dialog');
      button.addEventListener('keydown', event => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          void loadGlossary(button);
          glossaryPopover?.querySelector<HTMLButtonElement>('button')?.focus();
        }
        if (event.key === 'Escape') {
          if (glossaryPopover) glossaryPopover.hidden = true;
          activeGlossaryButton = null;
          ++glossaryRequest;
        }
      });
    });
  }
  async function initializeGlossary() {
    if (glossaryLoading || sharedGlossaryLoaded) return;
    glossaryLoading = true;
    try {
      const result = await loadGlossaryEntries(glossaryData?.dataset.sharedSrc, glossaryOverrides);
      const content = document.querySelector<HTMLElement>('.content');
      let restoreGlossaryFocus: (() => void) | undefined;
      if (result.sharedLoaded && glossaryFallbackMarked && content) {
        restoreGlossaryFocus = resetGlossaryTerms(content);
        activeGlossaryButton = null;
        if (glossaryPopover) glossaryPopover.hidden = true;
      }
      glossaryFallbackMarked = !result.sharedLoaded;
      glossaryEntries = result.entries;
      sharedGlossaryLoaded = result.sharedLoaded;
      markAndBindGlossary();
      restoreGlossaryFocus?.();
    } finally {
      glossaryLoading = false;
    }
  }
  void initializeGlossary();
  // A transient asset failure keeps custom entries usable and can recover later.
  window.addEventListener('online', () => { void initializeGlossary(); });
  window.addEventListener('focus', () => { void initializeGlossary(); });
  glossarySave?.addEventListener('click', () => {
    if (!saveResponse) return;
    const detail = {
      term: saveResponse.term,
      context: activeGlossaryButton ? sentenceAround(activeGlossaryButton) : saveResponse.context,
      sourcePath: location.pathname,
      sourceTitle: document.querySelector('h1')?.textContent?.trim() ?? '',
    };
    window.clearTimeout(glossaryHideTimer);
    // Restore focus to the article term before opening the native dialog, so
    // closing it can return to the same word rather than a hidden popover.
    activeGlossaryButton?.focus({ preventScroll: true });
    if (glossaryPopover) glossaryPopover.hidden = true;
    window.dispatchEvent(new CustomEvent('qp:vocabulary-open', { detail }));
  });
  glossaryPopover?.addEventListener('focusin', () => window.clearTimeout(glossaryHideTimer));
  glossaryPopover?.addEventListener('focusout', hideGlossarySoon);
  glossaryPopover?.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    activeGlossaryButton?.focus();
    if (glossaryPopover) glossaryPopover.hidden = true;
    activeGlossaryButton = null;
    ++glossaryRequest;
  });
  glossaryPopover?.addEventListener('mouseenter', () => window.clearTimeout(glossaryHideTimer));
  glossaryPopover?.addEventListener('mouseleave', hideGlossarySoon);
  glossaryPopover?.querySelectorAll<HTMLButtonElement>('[data-glossary-level]').forEach(button => {
    button.addEventListener('click', () => {
      setGlossaryLevel(button.dataset.glossaryLevel === 'advanced' ? 'advanced' : 'beginner');
      if (activeGlossaryButton) loadGlossary(activeGlossaryButton);
    });
  });
  setGlossaryLevel(glossaryLevel);
</script>

