---
// src/pages/posts/[...slug].astro
export const prerender = true;

import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import Icons from '../../components/Icons.astro';
import { getRelatedPosts } from '../../utils/relatedPosts';
import { getSeriesNavs } from '../../utils/seriesNav';
import { useTranslations, type Lang } from '../../i18n/utils';
import { getPublishedPosts, type Post } from '../../utils/content';
import { getTranslation } from '../../utils/i18n-pairing';
import { getSeriesHref, getSeriesTitle } from '../../utils/series';
import { normalizeGlossaryTerms, resolveGlossaryForLang } from '../../lib/glossary/entries';
import { getSharedGlossaryAsset } from '../../lib/glossary/assets';
import RelatedPosts from '../../components/RelatedPosts';
import VocabularyCapture from '../../components/VocabularyCapture.astro';
import EnglishPostNav from '../../components/EnglishPostNav.astro';

import { getYouTubeEmbedId } from '../../utils/youtube';
import { stripEmojiText, INLINE_ICONS_KEY, INLINE_ICON_SPRITE_PX } from '../../plugins/rehypeNoEmoji';
import { renderIconSprite } from '../../components/icons/render';
import type { IconName } from '../../components/icons/koboyo';
import { getReadingTime, getWordCount } from '../../utils/readingTime';
import { createPostIndex, type PostIndex } from '../../utils/post-index';
import { appendFileSync } from 'node:fs';

// TEMP CI PROFILING — reverted after measurement; rendered HTML is unchanged.
const PROFILE_FILE = 'dist/build-profile.jsonl';
function profileSince(name: string, startedAt: number): void {
  try {
    appendFileSync(PROFILE_FILE, `${JSON.stringify({ name, ms: performance.now() - startedAt, pid: process.pid })}\n`);
  } catch { /* profiling must never break the build */ }
}

// One index per allPosts array (per rendering worker), not one per page.
const INDEX_CACHE = new WeakMap<Post[], PostIndex>();
function getPostIndex(allPosts: Post[]): PostIndex {
  let index = INDEX_CACHE.get(allPosts);
  if (!index) {
    index = createPostIndex(allPosts);
    INDEX_CACHE.set(allPosts, index);
  }
  return index;
}

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  return allPosts.map(post => ({
    params: { slug: post.id },
    props: { post, allPosts },
  }));
}

const { post, allPosts } = Astro.props;
// Only src/pages/styleguide.astro passes `noindex`, when it reuses this template for its fixture.
// Props are inferred from getStaticPaths, so the extra prop is read untyped.
const noindex = (Astro.props as { noindex?: boolean }).noindex === true;
const _tRender = performance.now();
const { Content, headings, remarkPluginFrontmatter } = await render(post);
profileSince('render.post', _tRender);
// rehypeNoEmoji turns emoji into `<use href="#ki-…">` references and lists the icons here; the symbols
// are rendered once below, after <Content />, so the path data stays out of the content store.
const inlineIcons = (remarkPluginFrontmatter?.[INLINE_ICONS_KEY] ?? []) as IconName[];
const lang = post.data.lang as Lang;
const t = useTranslations(lang);
const _tIndex = performance.now();
const index = getPostIndex(allPosts);
profileSince('postIndex.get', _tIndex);

// allPosts is already published + date-sorted (getPublishedPosts), so the
// index lookup is equivalent to the old per-page filter/sort.
const sortedPosts = index.byLang.get(lang) ?? [];
const currentIndex = index.indexByIdByLang.get(lang)?.get(post.id) ?? -1;
const chronologicalPrev = currentIndex >= 0 ? sortedPosts[currentIndex + 1] : undefined;
const chronologicalNext = currentIndex > 0 ? sortedPosts[currentIndex - 1] : undefined;

const _tRelated = performance.now();
const relatedPosts = getRelatedPosts(post, allPosts, 3, index);
profileSince('relatedPosts', _tRelated);
const _tSeries = performance.now();
const seriesNavs = getSeriesNavs(post, allPosts, index).map(nav => ({
  nav,
  href: getSeriesHref(nav.name, lang),
}));
profileSince('seriesNavs', _tSeries);
// Series boundaries stay within the primary series, including its first/last post.
const primarySeriesNav = seriesNavs[0]?.nav;
const prevPost = primarySeriesNav ? primarySeriesNav.prev : chronologicalPrev
  ? { slug: chronologicalPrev.id, title: chronologicalPrev.data.title } : undefined;
const nextPost = primarySeriesNav ? primarySeriesNav.next : chronologicalNext
  ? { slug: chronologicalNext.id, title: chronologicalNext.data.title } : undefined;
const _tReading = performance.now();
const readingTime = getReadingTime(post);
profileSince('readingTime', _tReading);
const isDailyBrief = /(?:^|\/)\d{4}-\d{2}-\d{2}-ai-agent-daily(?:-en)?$/.test(post.id);
const categoriesBase = lang === 'en' ? '/en/categories' : '/categories';
const tagsBase = lang === 'en' ? '/en/tags' : '/tags';
const dateStr = post.data.date.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
const relatedVideoId = post.data.relatedVideo ? getYouTubeEmbedId(post.data.relatedVideo.url) : undefined;
const glossaryOverrides = resolveGlossaryForLang(normalizeGlossaryTerms(post.data.glossary ?? []), lang);
const sharedGlossaryAsset = getSharedGlossaryAsset(lang);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://quidproquo.cc';
// D1／Vectorize 的 slug 是檔案路徑去掉 .md；post.id 經過 slugify 會吃掉版號裡的點
//（…-pydantic-ai-2.36.0 → …-2360），兩者不能混用。
const d1Slug = post.filePath?.replace(/^.*src\/content\/posts\//, '').replace(/\.md$/, '') ?? post.id;
const ogImage = `${siteUrl}/og/${post.id}.png`;
const postUrl = `${siteUrl}/posts/${post.id}/`;

// Translation pairing: link to the counterpart if it exists, else fall back to
// the other language's home with an `untranslated` hint for the fallback banner.
const _tTranslation = performance.now();
const counterpart = getTranslation(post.id, allPosts, index);
profileSince('translation', _tTranslation);
const hasTranslation = counterpart !== null;
const switchHref = counterpart
  ? `/posts/${counterpart.id}`
  : lang === 'en'
    ? `/?untranslated=${encodeURIComponent(post.id)}`
    : `/en?untranslated=${encodeURIComponent(post.id)}`;
// hreflang alternates: emit only when the pair exists. x-default points at zh-TW.
const enId = lang === 'en' ? post.id : counterpart?.id;
const zhId = lang === 'en' ? counterpart?.id : post.id;
const enHref = enId ? `${siteUrl}/posts/${enId}/` : undefined;
const zhHref = zhId ? `${siteUrl}/posts/${zhId}/` : undefined;

const modifiedDate = post.data.updated ?? post.data.date;

const blogPostingLD = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description ?? post.data.tldr ?? '',
  image: ogImage,
  datePublished: post.data.date.toISOString(),
  dateModified: modifiedDate.toISOString(),
  inLanguage: lang === 'en' ? 'en' : 'zh-TW',
  articleSection: post.data.category,
  wordCount: post.body ? getWordCount(post) : undefined,
  author: {
    '@type': 'Person',
    name: 'xiaoxu',
    url: `${siteUrl}/about`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'quidproquo',
    url: siteUrl,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  keywords: post.data.tags.join(', '),
};

// FAQPage is emitted only when the post renders a matching visible FAQ section —
// structured data without on-page content is a manual-action risk.
const faq = post.data.faq ?? [];
const faqLD = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : undefined;

const breadcrumbLD = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: lang === 'en' ? 'Home' : '首頁',
      item: lang === 'en' ? `${siteUrl}/en` : siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: post.data.category,
      item: `${siteUrl}${categoriesBase}/${post.data.category}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: postUrl,
    },
  ],
};
---
<PostLayout
  title={post.data.title}
  description={post.data.description ?? post.data.tldr}
  lang={lang}
  ogImage={ogImage}
  articleDate={post.data.date}
  articleUpdated={post.data.updated}
  articleTags={post.data.tags}
  articleSlug={d1Slug}
  articleTerm={post.data.glossary?.[0]?.term}
  switchHref={switchHref}
  hasTranslation={hasTranslation}
  hreflangEn={enHref}
  hreflangZh={zhHref}
>
  <Fragment slot="head">
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingLD).replace(/</g, '\\u003c')} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLD).replace(/</g, '\\u003c')} />
    {faqLD && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLD).replace(/</g, '\\u003c')} />}
  </Fragment>

  <!-- Hero Section -->
  <div class="hero">
    <div class="hero-content">
      <h1>{post.data.title}</h1>
      <div class="hero-meta">
        <span class="hero-meta-item">
          <Icons name="clock" size={14} />
          {dateStr}
        </span>
        <span class="hero-meta-item">
          <Icons name="clock" size={14} />
          {readingTime} {t('post.reading-time')}
        </span>
      </div>
    </div>
    <div class="hero-wave">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,60 C200,100 400,20 600,60 C800,100 1000,20 1200,60 L1200,120 L0,120 Z" fill="var(--bg-page)"/>
      </svg>
    </div>
  </div>

  <article data-category={post.data.category} data-layout={isDailyBrief ? 'daily-brief' : undefined}>
    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href={lang === 'en' ? '/en' : '/'} class="breadcrumb-link">
        <Icons name="chevron-left" size={14} />
        {t('nav.home')}
      </a>
      <span class="breadcrumb-sep">&rsaquo;</span>
      <a href={`${categoriesBase}/${post.data.category}`} class="breadcrumb-cat">
        {post.data.category}
      </a>
    </div>

    <!-- TL;DR -->
    {post.data.tldr && (
      <div class="tldr">
        <span class="tldr-label">TL;DR</span>
        {stripEmojiText(post.data.tldr)}
      </div>
    )}

    <!-- Tags -->
    {post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map(tag => (
          <a href={`${tagsBase}/${tag}`} class="tag-pill">#{tag}</a>
        ))}
      </div>
    )}

    <div class="post-grid">
      {/* Sidebar: sticky TOC + optional related video — only rendered when there is
          actual content, so an empty column never steals width from the article. */}
      {(headings.length > 0 || relatedVideoId) && (
        <aside class="post-sidebar">
          {headings.length > 0 && (
          <details class="toc" open={isDailyBrief || post.data.category !== 'daily'}>
            <summary class="toc-header">
              <Icons name="list" size={14} />
              <span>{isDailyBrief ? (lang === 'en' ? 'In this issue' : '本期目錄') : t('post.toc')}</span>
            </summary>
            <ol>
              {headings.filter(h => h.depth === 2).map(h => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                  {headings.filter(sub => {
                    if (sub.depth !== 3) return false;
                    const h2idx = headings.findIndex(x => x.slug === h.slug);
                    const subidx = headings.findIndex(x => x.slug === sub.slug);
                    if (subidx < h2idx) return false;
                    const nextH2 = headings.findIndex((x, i) => x.depth === 2 && i > h2idx);
                    return nextH2 === -1 || subidx < nextH2;
                  }).length > 0 && (
                    <ol>
                      {headings.filter(sub => {
                        if (sub.depth !== 3) return false;
                        const h2idx = headings.findIndex(x => x.slug === h.slug);
                        const subidx = headings.findIndex(x => x.slug === sub.slug);
                        if (subidx < h2idx) return false;
                        const nextH2 = headings.findIndex((x, i) => x.depth === 2 && i > h2idx);
                        return nextH2 === -1 || subidx < nextH2;
                      }).map(sub => (
                        <li><a href={`#${sub.slug}`}>{sub.text}</a></li>
                      ))}
                    </ol>
                  )}
                </li>
              ))}
            </ol>
          </details>
        )}

        {relatedVideoId && (
          <div class="video-card">
            <div class="video-embed">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${relatedVideoId}`}
                title={post.data.relatedVideo?.title ?? post.data.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
            {(post.data.relatedVideo?.title || post.data.relatedVideo?.source) && (
              <div class="video-card-meta">
                {post.data.relatedVideo?.title && <span class="video-card-title">{post.data.relatedVideo.title}</span>}
                {post.data.relatedVideo?.source && <span class="video-card-source">{post.data.relatedVideo.source}</span>}
              </div>
            )}
          </div>
        )}
      </aside>
)}

      <div class="post-main">
    <!-- Series nav -->
    {seriesNavs.map(({ nav, href }) => (
      <div class="series-box">
        <div class="series-header">
          <Icons name="book-open" size={14} />
          <span>
            {t('post.series')}:
            {' '}
            <a href={href} class="series-link">{getSeriesTitle(nav.name, lang)}</a>
            {' '}
            ({nav.current} / {nav.total})
          </span>
        </div>
        <div class="series-nav">
          {nav.prev ? (
            <a href={`/posts/${nav.prev.slug}`} class="series-prev">
              <Icons name="chevron-left" size={14} />
              {nav.prev.title}
            </a>
          ) : <span />}
          {nav.next && (
            <a href={`/posts/${nav.next.slug}`} class="series-next">
              {nav.next.title}
              <Icons name="chevron-right" size={14} />
            </a>
          )}
        </div>
      </div>
    ))}

    <EnglishPostNav postId={post.id} lang={lang} />

    <VocabularyCapture lang={lang} title={post.data.title} />

    <!-- Content -->
    <div class="content">
      <Content />
      {inlineIcons.length > 0 && <Fragment set:html={renderIconSprite(inlineIcons, { size: INLINE_ICON_SPRITE_PX })} />}
    </div>

    {faq.length > 0 && (
      <section class="faq">
        <h2>{t('post.faq')}</h2>
        {faq.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    )}

    <script
      is:inline
      id="glossary-data"
      type="application/json"
      data-post-slug={post.id}
      data-lang={lang}
      data-shared-src={sharedGlossaryAsset.url}
      set:html={JSON.stringify(glossaryOverrides).replace(/</g, '\\u003c')}
    />

    <div class="glossary-popover" id="glossary-popover" role="dialog" aria-labelledby="glossary-title" aria-live="polite" hidden>
      <div class="glossary-popover-head">
        <div>
          <div class="glossary-eyebrow">Glossary</div>
          <div class="glossary-title" id="glossary-title"></div>
        </div>
        <div class="glossary-level" role="group" aria-label="Explanation depth">
          <button type="button" data-glossary-level="beginner">{t('glossary.beginner')}</button>
          <button type="button" data-glossary-level="advanced">{t('glossary.advanced')}</button>
        </div>
      </div>
      <p class="glossary-definition" id="glossary-definition">Loading...</p>
      <p class="glossary-context" id="glossary-context"></p>
      <div class="glossary-reading" id="glossary-reading"></div>
      <div class="glossary-save-actions">
        <button type="button" id="glossary-save" disabled>{lang === 'en' ? 'Look up & save' : '查詞與收藏'}</button>
        <a href={lang === 'en' ? '/en/vocabulary' : '/vocabulary'}>{lang === 'en' ? 'Review words' : '前往複習'}</a>
      </div>
      <p id="glossary-save-status" role="status"></p>
    </div>

    <!-- Prev / Next -->
    {(prevPost || nextPost) && (
      <nav class="post-nav">
        {prevPost ? (
          <a href={`/posts/${prevPost.slug}`} class="post-nav-prev">
            <span class="post-nav-label">
              <Icons name="chevron-left" size={14} />
              {t('post.prev')}
            </span>
            <span class="post-nav-title">{prevPost.title}</span>
          </a>
        ) : <span />}
        {nextPost && (
          <a href={`/posts/${nextPost.slug}`} class="post-nav-next">
            <span class="post-nav-label">
              {t('post.next')}
              <Icons name="chevron-right" size={14} />
            </span>
            <span class="post-nav-title">{nextPost.title}</span>
          </a>
        )}
      </nav>
    )}

    <!-- Related digests (cross-referenced by topic) -->
    {post.data.relatedDigests && post.data.relatedDigests.length > 0 && (
      <section class="related-digests">
        <h3>
          <Icons name="link" size={14} />
          {lang === 'en' ? 'Related Digests' : '相關導讀'}
        </h3>
        <div class="related-digests-list">
          {post.data.relatedDigests.map((rd: { slug: string; reason: string }) => (
            <a href={`/posts/${rd.slug}`} class="related-digest-item">
              <span class="rd-title">{rd.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/-/g, ' ')}</span>
              <span class="rd-reason">{rd.reason}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related articles -->
    <section class="related">
      <h3>
        <Icons name="link" size={14} />
        {t('post.related')}
      </h3>
      <RelatedPosts client:idle slug={post.id} />
      <div class="related-list related-fallback">
        {relatedPosts.map(p => (
          <a href={`/posts/${p.id}`} class="related-item">
            <span class="related-title">{p.data.title}</span>
            <span class="related-time">
              <Icons name="clock" size={14} />
              {getReadingTime(p)} min
            </span>
          </a>
        ))}
      </div>
    </section>
      </div>
      <!-- /post-main -->
    </div>
    <!-- /post-grid -->
  </article>
</PostLayout>

<style>
  /* 內文連結與 h2 分隔線由 PostLayout 的 .content 規則統一提供，文章頁不再覆寫。 */

  /* ── Hero Section ── */
  .hero {
    position: relative;
    /* 淺色：品牌深綠面；深色：沿用卡片／頁面底。字兩種主題都是 --text-on-accent。 */
    background: linear-gradient(135deg, var(--brand-700) 0%, var(--brand-900) 50%, var(--brand-700) 100%);
    color: var(--text-on-accent);
    /* 往外吃掉 body 的上內距與左右 --page-gutter（PostLayout body），斷點跟著 gutter 走 */
    margin: calc(-1 * var(--space-4)) calc(-1 * var(--page-gutter)) 0;
    padding: var(--space-12) var(--page-gutter) 4rem;
    text-align: center;
    overflow: hidden;
  }
  :global([data-theme="dark"]) .hero {
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-page) 50%, var(--bg-card) 100%);
  }
  .hero-content { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; }
  .hero h1 {
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: -0.5px;
    line-height: 1.25;
    margin: 0 0 var(--space-4);
    color: inherit;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    font-size: 0.82rem;
    color: color-mix(in srgb, currentColor 60%, transparent);
  }
  .hero-meta-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    line-height: 0;
  }
  .hero-wave svg {
    width: 100%;
    height: 40px;
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    margin-top: var(--space-6);
    font-size: 0.82rem;
  }
  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .breadcrumb-link:hover { color: var(--text-secondary); }
  .breadcrumb-sep { color: var(--text-muted); }
  .breadcrumb-cat {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
  }
  .breadcrumb-cat:hover { color: var(--brand-700); }

  /* ── TL;DR ── */
  .tldr {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--corner-md);
    margin-bottom: var(--space-4);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--text-primary);
  }
  .tldr-label {
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 700;
    display: block;
    margin-bottom: 0.3rem;
  }

  /* ── Tags ── */
  .tags { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: var(--space-5); }

  /* ── TOC (collapsible via details/summary) ── */
  .toc {
    border: 1px solid var(--border);
    border-radius: var(--corner-md);
    padding: var(--space-4);
    background: var(--bg-subtle);
    margin-bottom: var(--space-6);
  }
  .toc:not([open]) { padding: 0.7rem var(--space-4); }
  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 0.6rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .toc-header::-webkit-details-marker { display: none; }
  .toc-header::after {
    content: '▾';
    margin-left: auto;
    font-size: 0.6rem;
    color: var(--text-muted);
    transition: transform 0.15s;
  }
  .toc:not([open]) > .toc-header { margin-bottom: 0; }
  .toc:not([open]) > .toc-header::after { content: '▸'; }
  .toc ol { padding-left: 1.2rem; margin: 0; font-size: 0.83rem; line-height: 1.9; color: var(--text-secondary); }
