---
// src/pages/posts/[...slug].astro
export const prerender = true;

import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import Icons from '../../components/Icons.astro';
import { getRelatedPosts } from '../../utils/relatedPosts';
import { getSeriesNavs } from '../../utils/seriesNav';
import { useTranslations, type Lang } from '../../i18n/utils';
import { getPublishedPosts, isPublishedPost, sortPostsByDateDesc } from '../../utils/content';
import { getTranslation } from '../../utils/i18n-pairing';
import { getSeriesHref } from '../../utils/series';
import { DEFAULT_GLOSSARY_TERMS, normalizeGlossaryTerms, resolveGlossaryForLang } from '../../lib/glossary/terms';
import RelatedPosts from '../../components/RelatedPosts';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  return allPosts.map(post => ({
    params: { slug: post.id },
    props: { post, allPosts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const lang = post.data.lang as Lang;
const t = useTranslations(lang);

const sortedPosts = sortPostsByDateDesc(
  allPosts.filter(p => isPublishedPost(p) && p.data.lang === lang)
);
const currentIndex = sortedPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : undefined;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : undefined;

const relatedPosts = getRelatedPosts(post, allPosts);
const seriesNavs = getSeriesNavs(post, allPosts).map(nav => ({
  nav,
  href: getSeriesHref(nav.name, lang),
}));
const readingTime = post.data.readingTime ?? 1;
const categoriesBase = lang === 'en' ? '/en/categories' : '/categories';
const tagsBase = lang === 'en' ? '/en/tags' : '/tags';
const dateStr = post.data.date.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
const glossaryEntries = resolveGlossaryForLang(
  normalizeGlossaryTerms([
    ...(post.data.glossary ?? []),
    ...DEFAULT_GLOSSARY_TERMS,
  ]),
  lang,
);

const ogImage = `${Astro.site ?? 'https://quidproquo.cc'}/og/${post.id}.png`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://quidproquo.cc';
const postUrl = `${siteUrl}/posts/${post.id}`;

// Translation pairing: link to the counterpart if it exists, else fall back to
// the other language's home with an `untranslated` hint for the fallback banner.
const counterpart = getTranslation(post.id, allPosts);
const hasTranslation = counterpart !== null;
const switchHref = counterpart
  ? `/posts/${counterpart.id}`
  : lang === 'en'
    ? `/?untranslated=${encodeURIComponent(post.id)}`
    : `/en?untranslated=${encodeURIComponent(post.id)}`;
// hreflang alternates: emit only when the pair exists. x-default points at zh-TW.
const enId = lang === 'en' ? post.id : counterpart?.id;
const zhId = lang === 'en' ? counterpart?.id : post.id;
const enHref = enId ? `${siteUrl}/posts/${enId}` : undefined;
const zhHref = zhId ? `${siteUrl}/posts/${zhId}` : undefined;

const modifiedDate = post.data.updated ?? post.data.date;

const blogPostingLD = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description ?? post.data.tldr ?? '',
  image: ogImage,
  datePublished: post.data.date.toISOString(),
  dateModified: modifiedDate.toISOString(),
  inLanguage: lang === 'en' ? 'en' : 'zh-TW',
  articleSection: post.data.category,
  wordCount: post.body?.trim().split(/\s+/).length ?? undefined,
  author: {
    '@type': 'Person',
    name: 'xiaoxu',
    url: `${siteUrl}/about`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'quidproquo',
    url: siteUrl,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  keywords: post.data.tags.join(', '),
};

// FAQPage is emitted only when the post renders a matching visible FAQ section —
// structured data without on-page content is a manual-action risk.
const faq = post.data.faq ?? [];
const faqLD = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : undefined;

const breadcrumbLD = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: lang === 'en' ? 'Home' : '首頁',
      item: lang === 'en' ? `${siteUrl}/en` : siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: post.data.category,
      item: `${siteUrl}${categoriesBase}/${post.data.category}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: postUrl,
    },
  ],
};
---
<PostLayout
  title={post.data.title}
  description={post.data.description ?? post.data.tldr}
  lang={lang}
  ogImage={ogImage}
  articleDate={post.data.date}
  articleUpdated={post.data.updated}
  articleTags={post.data.tags}
  switchHref={switchHref}
  hasTranslation={hasTranslation}
  hreflangEn={enHref}
  hreflangZh={zhHref}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingLD).replace(/</g, '\\u003c')} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLD).replace(/</g, '\\u003c')} />
    {faqLD && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLD).replace(/</g, '\\u003c')} />}
  </Fragment>

  <!-- Hero Section -->
  <div class="hero">
    <div class="hero-content">
      <h1>{post.data.title}</h1>
      <div class="hero-meta">
        <span class="hero-meta-item">
          <Icons name="clock" size={14} />
          {dateStr}
        </span>
        <span class="hero-meta-item">
          <Icons name="clock" size={14} />
          {readingTime} {t('post.reading-time')}
        </span>
      </div>
    </div>
    <div class="hero-wave">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,60 C200,100 400,20 600,60 C800,100 1000,20 1200,60 L1200,120 L0,120 Z" fill="var(--bg-page)"/>
      </svg>
    </div>
  </div>

  <article data-category={post.data.category}>
    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href={lang === 'en' ? '/en' : '/'} class="breadcrumb-link">
        <Icons name="chevron-left" size={14} />
        {t('nav.home')}
      </a>
      <span class="breadcrumb-sep">&rsaquo;</span>
      <a href={`${categoriesBase}/${post.data.category}`} class="breadcrumb-cat">
        {post.data.category}
      </a>
    </div>

    <!-- TL;DR -->
    {post.data.tldr && (
      <div class="tldr">
        <span class="tldr-label">TL;DR</span>
        {post.data.tldr}
      </div>
    )}

    <!-- Tags -->
    {post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map(tag => (
          <a href={`${tagsBase}/${tag}`} class="tag-pill">#{tag}</a>
        ))}
      </div>
    )}

    <!-- TOC -->
    {headings.length > 0 && (
      <details class="toc" open={post.data.category !== 'daily'}>
        <summary class="toc-header">
          <Icons name="list" size={14} />
          <span>{t('post.toc')}</span>
        </summary>
        <ol>
          {headings.filter(h => h.depth === 2).map(h => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
              {headings.filter(sub => {
                if (sub.depth !== 3) return false;
                const h2idx = headings.findIndex(x => x.slug === h.slug);
                const subidx = headings.findIndex(x => x.slug === sub.slug);
                if (subidx < h2idx) return false;
                const nextH2 = headings.findIndex((x, i) => x.depth === 2 && i > h2idx);
                return nextH2 === -1 || subidx < nextH2;
              }).length > 0 && (
                <ol>
                  {headings.filter(sub => {
                    if (sub.depth !== 3) return false;
                    const h2idx = headings.findIndex(x => x.slug === h.slug);
                    const subidx = headings.findIndex(x => x.slug === sub.slug);
                    if (subidx < h2idx) return false;
                    const nextH2 = headings.findIndex((x, i) => x.depth === 2 && i > h2idx);
                    return nextH2 === -1 || subidx < nextH2;
                  }).map(sub => (
                    <li><a href={`#${sub.slug}`}>{sub.text}</a></li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>
    )}

    <!-- Series nav -->
    {seriesNavs.map(({ nav, href }) => (
      <div class="series-box">
        <div class="series-header">
          <Icons name="book-open" size={14} />
          <span>
            {t('post.series')}:
            {' '}
            <a href={href} class="series-link">{nav.name}</a>
            {' '}
            ({nav.current} / {nav.total})
          </span>
        </div>
        <div class="series-nav">
          {nav.prev ? (
            <a href={`/posts/${nav.prev.slug}`} class="series-prev">
              <Icons name="chevron-left" size={14} />
              {nav.prev.title}
            </a>
          ) : <span />}
          {nav.next && (
            <a href={`/posts/${nav.next.slug}`} class="series-next">
              {nav.next.title}
              <Icons name="chevron-right" size={14} />
            </a>
          )}
        </div>
      </div>
    ))}

    <!-- Content -->
    <div class="content">
      <Content />
    </div>

    {faq.length > 0 && (
      <section class="faq">
        <h2>{t('post.faq')}</h2>
        {faq.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    )}

    <script
      is:inline
      id="glossary-data"
      type="application/json"
      data-post-slug={post.id}
      data-lang={lang}
      set:html={JSON.stringify(glossaryEntries).replace(/</g, '\\u003c')}
    />

    <div class="glossary-popover" id="glossary-popover" role="dialog" aria-live="polite" hidden>
      <div class="glossary-popover-head">
        <div>
          <div class="glossary-eyebrow">Glossary</div>
          <div class="glossary-title" id="glossary-title"></div>
        </div>
        <div class="glossary-level" role="group" aria-label="Explanation depth">
          <button type="button" data-glossary-level="beginner">{t('glossary.beginner')}</button>
          <button type="button" data-glossary-level="advanced">{t('glossary.advanced')}</button>
        </div>
      </div>
      <p class="glossary-definition" id="glossary-definition">Loading...</p>
      <p class="glossary-context" id="glossary-context"></p>
      <div class="glossary-reading" id="glossary-reading"></div>
    </div>

    <!-- Prev / Next -->
    {(prevPost || nextPost) && (
      <nav class="post-nav">
        {prevPost ? (
          <a href={`/posts/${prevPost.id}`} class="post-nav-prev">
            <span class="post-nav-label">
              <Icons name="chevron-left" size={14} />
              {t('post.prev')}
            </span>
            <span class="post-nav-title">{prevPost.data.title}</span>
          </a>
        ) : <span />}
        {nextPost && (
          <a href={`/posts/${nextPost.id}`} class="post-nav-next">
            <span class="post-nav-label">
              {t('post.next')}
              <Icons name="chevron-right" size={14} />
            </span>
            <span class="post-nav-title">{nextPost.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <!-- Related digests (cross-referenced by topic) -->
    {post.data.relatedDigests && post.data.relatedDigests.length > 0 && (
      <section class="related-digests">
        <h3>
          <Icons name="link" size={14} />
          {lang === 'en' ? 'Related Digests' : '相關導讀'}
        </h3>
        <div class="related-digests-list">
          {post.data.relatedDigests.map((rd: { slug: string; reason: string }) => (
            <a href={`/posts/${rd.slug}`} class="related-digest-item">
              <span class="rd-title">{rd.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/-/g, ' ')}</span>
              <span class="rd-reason">{rd.reason}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related articles -->
    <section class="related">
      <h3>
        <Icons name="link" size={14} />
        {t('post.related')}
      </h3>
      <RelatedPosts client:idle slug={post.id} />
      <div class="related-list related-fallback">
        {relatedPosts.map(p => (
          <a href={`/posts/${p.id}`} class="related-item">
            <span class="related-title">{p.data.title}</span>
            <span class="related-time">
              <Icons name="clock" size={14} />
              {p.data.readingTime ?? 1} min
            </span>
          </a>
        ))}
      </div>
    </section>
  </article>
</PostLayout>

<style>
  /* ── 文章內文：覆蓋綠色文字為可讀色 ── */
  article {
    --text-secondary: #555;
    --brand-700: #374151;
  }
  :global([data-theme="dark"]) article {
    --text-secondary: #9ca3af;
    --brand-700: #d1d5db;
  }
  /* 內文連結：深色文字 + 底線 */
  article .content :global(a) {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }
  article .content :global(a:hover) {
    text-decoration-color: var(--text-primary);
  }
  /* h2 底線裝飾移除 */
  article .content :global(h2)::after {
    display: none;
  }
  /* 系列導覽連結 */
  .series-prev, .series-next { color: var(--text-primary); }
  .series-prev:hover, .series-next:hover { color: #1d4ed8; }
  /* TOC 連結色 */
  .toc ol { color: var(--text-primary); }
  .toc a:hover { color: #1d4ed8; }
  /* Glossary 術語：中性底線 */
  :global(.glossary-term) {
    border-bottom-color: var(--border);
    background: var(--bg-subtle);
  }

  /* ── Hero Section ── */
  .hero {
    position: relative;
    background: linear-gradient(135deg, #1a2332 0%, #0f1419 50%, #1a2332 100%);
    margin: -1rem -1.5rem 0;
    padding: 3rem 1.5rem 4rem;
    text-align: center;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .hero { margin-left: -1rem; margin-right: -1rem; padding-left: 1rem; padding-right: 1rem; }
  }
  @media (max-width: 400px) {
    .hero { margin-left: -0.75rem; margin-right: -0.75rem; padding-left: 0.75rem; padding-right: 0.75rem; }
  }
  :global(:root:not([data-theme="dark"])) .hero {
    background: linear-gradient(135deg, #2d4a2d 0%, #1a2e1a 50%, #2d4a2d 100%);
  }
  .hero-content { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; }
  .hero h1 {
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: -0.5px;
    line-height: 1.25;
    margin: 0 0 1rem;
    color: #ffffff;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
  }
  .hero-meta-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    line-height: 0;
  }
  .hero-wave svg {
    width: 100%;
    height: 40px;
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    margin-top: 1.5rem;
    font-size: 0.82rem;
  }
  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .breadcrumb-link:hover { color: var(--text-secondary); }
  .breadcrumb-sep { color: var(--text-muted); }
  .breadcrumb-cat {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
  }
  .breadcrumb-cat:hover { color: var(--brand-900); }

  /* ── TL;DR ── */
  .tldr {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-primary);
  }
  .tldr-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 700;
    display: block;
    margin-bottom: 0.3rem;
  }

  /* ── Tags ── */
  .tags { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 1.25rem; }

  /* ── TOC (collapsible via details/summary) ── */
  .toc {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    background: var(--bg-subtle);
    margin-bottom: 1.5rem;
  }
  .toc:not([open]) { padding: 0.7rem 1rem; }
  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 0.6rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .toc-header::-webkit-details-marker { display: none; }
  .toc-header::after {
    content: '▾';
    margin-left: auto;
    font-size: 0.6rem;
    color: var(--text-muted);
    transition: transform 0.15s;
  }
  .toc:not([open]) > .toc-header { margin-bottom: 0; }
  .toc:not([open]) > .toc-header::after { content: '▸'; }
  .toc ol { padding-left: 1.2rem; margin: 0; font-size: 0.83rem; line-height: 1.9; color: var(--brand-700); }
  .toc ol ol { font-size: 0.78rem; color: var(--text-secondary); }
  .toc a { color: inherit; text-decoration: none; }
  .toc a:hover { color: var(--brand-500); }

  /* ── Series box ── */
  .series-box { border: 1px solid var(--border); border-radius: 8px; padding: 0.85rem 1rem; background: var(--bg-subtle); margin-bottom: 1.5rem; }
  .series-header { display: flex; align-items: center; gap: 0.4rem; font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 0.5rem; }
  .series-link { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; }
  .series-link:hover { border-bottom-color: currentColor; }
  .series-nav { display: flex; justify-content: space-between; font-size: 0.8rem; }
  .series-prev, .series-next { display: flex; align-items: center; gap: 0.25rem; color: var(--brand-500); text-decoration: none; }
  .series-prev:hover, .series-next:hover { color: var(--brand-900); }

  /* ── Post nav ── */
  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  @media (max-width: 480px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav-next { text-align: left; }
    .post-nav-next .post-nav-label { justify-content: flex-start; }
  }
  .post-nav-prev, .post-nav-next { border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem; text-decoration: none; color: var(--text-primary); transition: border-color 0.15s, background 0.15s; }
  .post-nav-prev:hover, .post-nav-next:hover { border-color: var(--brand-500); background: var(--bg-subtle); }
  .post-nav-next { text-align: right; }
  .post-nav-label { display: flex; align-items: center; gap: 0.25rem; font-size: 0.68rem; color: var(--text-muted); margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .post-nav-next .post-nav-label { justify-content: flex-end; }
  .post-nav-title { font-size: 0.85rem; font-weight: 600; line-height: 1.3; display: block; }

  /* ── FAQ ── */
  .faq { margin: 2.5rem 0 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .faq h2 { font-size: 1.15rem; font-weight: 700; margin-bottom: 0.9rem; }
  .faq-item { border: 1px solid var(--border); border-radius: 8px; padding: 0.7rem 0.9rem; margin-bottom: 0.6rem; }
  .faq-item summary { cursor: pointer; font-weight: 600; font-size: 0.95rem; line-height: 1.5; }
  .faq-item p { margin: 0.6rem 0 0; font-size: 0.92rem; line-height: 1.75; color: var(--text-secondary); }

  /* ── Related digests ── */
  .related-digests { margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
  .related-digests h3 { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.85rem; }
  .related-digests-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .related-digest-item { display: flex; flex-direction: column; padding: 0.65rem 0.8rem; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: var(--text-primary); transition: border-color 0.15s; }
  .related-digest-item:hover { border-color: var(--brand-500); }
  .rd-title { font-size: 0.85rem; font-weight: 500; text-transform: capitalize; }
  .rd-reason { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem; }

  /* ── Related posts ── */
  .related h3 { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.85rem; }
  .related :global(.related-list) { display: flex; flex-direction: column; gap: 0.5rem; }
