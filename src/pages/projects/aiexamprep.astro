---
// src/pages/projects/aiexamprep.astro
export const prerender = true;
import PostLayout from '../../layouts/PostLayout.astro';
import '../../styles/project-page.css';
---

<PostLayout
  title="aiexamprep"
  lang="zh-TW"
  description="AI 認證考試準備平台——涵蓋 AWS、Google、NVIDIA、Microsoft 四家認證題庫，四種學習模式讓考試準備不再枯燥。"
  switchHref="/en/projects/aiexamprep"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="content project-page">

    <!-- ── Hero ── -->
    <section class="project-hero">
      <div class="project-hero-badge">AI Exam Platform</div>
      <h1 class="project-hero-title">aiexamprep</h1>
      <p class="project-hero-tagline">
        AI 認證考試準備平台<br />
        <span class="project-hero-sub">涵蓋 AWS、Google、NVIDIA、Microsoft 四家認證題庫，用四種學習模式——練習、模擬考、知識網路、RPG 闖關——讓考試準備不再枯燥。</span>
      </p>
      <div class="project-hero-links">
        <a href="https://aiexamprep.io/" class="hero-link hero-link--primary" target="_blank" rel="noopener noreferrer">
          網站
        </a>
        <a href="https://github.com/vincentxuu/aiexamprep" class="hero-link" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
          GitHub →
        </a>
      </div>
    </section>

    <!-- ── Highlights ── -->
    <section class="project-highlights">

      <!-- Highlight 1 -->
      <div class="highlight">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="認證題庫">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>影片待錄</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">01</span>
          <h2 class="highlight-title">四家認證，一站搞定</h2>
          <p class="highlight-desc">
            涵蓋 AWS、Google、NVIDIA、Microsoft 四家 AI 認證的題庫，不用到處找資源。每家認證的考試範圍、題型風格都不同，aiexamprep 把它們整合在同一個平台，統一介面、統一進度追蹤。
          </p>
          <div class="highlight-tags">
            <span class="htag">AWS</span>
            <span class="htag">Google</span>
            <span class="htag">NVIDIA</span>
            <span class="htag">Microsoft</span>
          </div>
        </div>
      </div>

      <!-- Highlight 2 -->
      <div class="highlight highlight--reverse">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="學習模式">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>影片待錄</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">02</span>
          <h2 class="highlight-title">四種學習模式</h2>
          <p class="highlight-desc">
            練習模式隨選隨做，想練哪個主題就練哪個。模擬考完整計時，還原真實考試體驗。學習模式串連相關概念，幫你建立知識網路。RPG 模式用像素風冒險闖關答題，讓準備過程不再枯燥。
          </p>
          <div class="highlight-tags">
            <span class="htag">練習</span>
            <span class="htag">模擬考</span>
            <span class="htag">知識網路</span>
            <span class="htag">RPG 闖關</span>
          </div>
        </div>
      </div>

      <!-- Highlight 3 -->
      <div class="highlight">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="知識圖譜">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <span>截圖待補</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">03</span>
          <h2 class="highlight-title">知識網路學習</h2>
          <p class="highlight-desc">
            不只是刷題。學習模式會把相關概念串在一起，幫你建立知識圖譜，看見概念之間的關聯。
          </p>
          <div class="highlight-tags">
            <span class="htag">Knowledge Graph</span>
            <span class="htag">Concept Linking</span>
            <span class="htag">Adaptive</span>
          </div>
        </div>
      </div>

      <!-- Highlight 4 -->
      <div class="highlight highlight--reverse">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="RPG Demo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>影片待錄</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">04</span>
          <h2 class="highlight-title">RPG 像素風冒險</h2>
          <p class="highlight-desc">
            用像素風冒險遊戲的方式答題闖關，把枯燥的考試準備變成有成就感的遊戲體驗。每答對一題就推進劇情、解鎖新區域，讓學習動力從「我必須讀完」變成「我想看下一關」。
          </p>
          <div class="highlight-tags">
            <span class="htag">Pixel Art</span>
            <span class="htag">RPG</span>
            <span class="htag">Gamification</span>
            <span class="htag">Achievement</span>
          </div>
        </div>
      </div>

    </section>

    <!-- ── Tech Stack ── -->
    <section class="project-stack">
      <h2 class="project-section-title">技術</h2>
      <div class="stack-grid">
        <div class="stack-item">
          <span class="stack-label">Frontend</span>
          <span class="stack-value">React / TypeScript</span>
        </div>
        <div class="stack-item">
          <span class="stack-label">Focus</span>
          <span class="stack-value">AI Education / Gamification</span>
        </div>
        <div class="stack-item">
          <span class="stack-label">Certifications</span>
          <span class="stack-value">AWS / Google / NVIDIA / Microsoft</span>
        </div>
        <div class="stack-item">
          <span class="stack-label">License</span>
          <span class="stack-value">MIT</span>
        </div>
      </div>
    </section>

    <!-- ── Back ── -->
    <div class="project-back">
      <a href="/about" class="project-back-link">← 回到關於我</a>
    </div>

  </div>
</PostLayout>
