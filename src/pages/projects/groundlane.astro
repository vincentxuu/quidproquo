---
// src/pages/projects/groundlane.astro
export const prerender = true;
import PostLayout from '../../layouts/PostLayout.astro';
import '../../styles/project-page.css';
---

<PostLayout
  title="groundlane"
  lang="zh-TW"
  description="AI 代理的可信 Web 存取層——一個中立的 MCP server，把 14 個搜尋服務收斂成單一介面。"
  switchHref="/en/projects/groundlane"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="content project-page">

    <!-- ── Hero ── -->
    <section class="project-hero">
      <div class="project-hero-badge">MCP Server</div>
      <h1 class="project-hero-title">groundlane</h1>
      <p class="project-hero-tagline">
        AI 代理的可信 Web 存取層<br />
        <span class="project-hero-sub">一個中立的 MCP server，讓 agent 只需要呼叫一份統一介面，背後自動在 14 個搜尋服務之間選擇與切換。</span>
      </p>
      <div class="project-hero-links">
        <a href="https://github.com/lanefoundry/groundlane" class="hero-link hero-link--primary" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
          GitHub
        </a>
        <a href="https://github.com/lanefoundry/groundlane#documentation" class="hero-link" target="_blank" rel="noopener noreferrer">文件 →</a>
      </div>
    </section>

    <!-- ── Highlights ── -->
    <section class="project-highlights">

      <!-- Highlight 1 -->
      <div class="highlight">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="搜尋 Demo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>影片待錄</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">01</span>
          <h2 class="highlight-title">一個介面，14 個 Provider</h2>
          <p class="highlight-desc">
            每家搜尋服務的 API 都不一樣——Tavily、Exa、Firecrawl、Brave、Bing……groundlane 讓 agent 只需要呼叫一份統一介面，背後自動挑選最適合的 provider。不用管各家的參數格式、認證方式、回傳結構。
          </p>
          <div class="highlight-tags">
            <span class="htag">Tavily</span>
            <span class="htag">Exa</span>
            <span class="htag">Firecrawl</span>
            <span class="htag">Brave</span>
            <span class="htag">+10 more</span>
          </div>
        </div>
      </div>

      <!-- Highlight 2 -->
      <div class="highlight highlight--reverse">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="Fallback Demo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>影片待錄</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">02</span>
          <h2 class="highlight-title">智慧降級，不中斷</h2>
          <p class="highlight-desc">
            某個 provider 掛了？超時？額度用完？groundlane 自動切換到下一個可用的 provider，agent 完全不需要處理錯誤。降級過程有完整 trace，你可以事後看到每一步選了誰、為什麼。
          </p>
          <div class="highlight-tags">
            <span class="htag">Auto-failover</span>
            <span class="htag">Rate Limiting</span>
            <span class="htag">Trace</span>
          </div>
        </div>
      </div>

      <!-- Highlight 3 -->
      <div class="highlight">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="解析 Demo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>影片待錄</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">03</span>
          <h2 class="highlight-title">不只搜尋——抓取、解析、研究</h2>
          <p class="highlight-desc">
            搜尋只是起點。groundlane 還能抓取完整網頁、做問答式研究（deep research）、解析 PDF / DOCX / XLSX 文件、找新聞圖片、長時間爬站。一個 server 涵蓋 agent 上網的常見需求。
          </p>
          <div class="highlight-tags">
            <span class="htag">Scrape</span>
            <span class="htag">PDF Parse</span>
            <span class="htag">Deep Research</span>
            <span class="htag">Image Search</span>
          </div>
        </div>
      </div>

      <!-- Highlight 4 -->
      <div class="highlight highlight--reverse">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="MCP 設定">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <span>截圖待補</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">04</span>
          <h2 class="highlight-title">MCP 原生，即插即用</h2>
          <p class="highlight-desc">
            groundlane 就是一個標準的 MCP server。Claude Code、Cursor、任何支援 MCP 的工具都可以直接接上。有輕量跟完整兩種模式——輕量模式不需要額外安裝，部分服務連 API key 都不用。
          </p>
          <div class="highlight-code">
            <code set:html={`"groundlane": { "command": "npx", "args": ["-y", "groundlane"] }`} />
          </div>
        </div>
      </div>

      <!-- Highlight 5 -->
      <div class="highlight">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="安全設定">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>截圖待補</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">05</span>
          <h2 class="highlight-title">安全邊界，全程可追蹤</h2>
          <p class="highlight-desc">
            Agent 不能存取不該碰的東西。所有 web 存取都有安全限制——URL 過濾、domain 白名單、request rate limiting。每一次存取的資料來源、執行路徑、選擇的 provider 都有完整 trace，可以事後審計。
          </p>
          <div class="highlight-tags">
            <span class="htag">URL Filter</span>
            <span class="htag">Domain Allowlist</span>
            <span class="htag">Audit Trail</span>
          </div>
        </div>
      </div>

    </section>

    <!-- ── Tech Stack ── -->
    <section class="project-stack">
      <h2 class="project-section-title">技術</h2>
      <div class="stack-grid">
        <div class="stack-item">
          <span class="stack-label">Runtime</span>
          <span class="stack-value">Node.js / Cloudflare Workers</span>
        </div>
        <div class="stack-item">
          <span class="stack-label">Protocol</span>
          <span class="stack-value">MCP (Model Context Protocol)</span>
        </div>
        <div class="stack-item">
          <span class="stack-label">Providers</span>
          <span class="stack-value">14 個搜尋 / 擷取服務</span>
        </div>
        <div class="stack-item">
          <span class="stack-label">License</span>
          <span class="stack-value">Apache 2.0</span>
        </div>
      </div>
    </section>

    <!-- ── Back ── -->
    <div class="project-back">
      <a href="/about" class="project-back-link">← 回到關於我</a>
    </div>

  </div>
</PostLayout>

