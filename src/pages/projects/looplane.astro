---
// src/pages/projects/looplane.astro
export const prerender = true;
import PostLayout from '../../layouts/PostLayout.astro';
---

<PostLayout
  title="looplane"
  lang="zh-TW"
  description="Python 優先的本地 coding agent，在拋棄式 clone 裡執行任務，把模型改動限制在可驗證的範圍內。"
  switchHref="/en/projects/looplane"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="content project-page">

    <!-- ── Hero ── -->
    <section class="project-hero">
      <div class="project-hero-badge">Coding Agent</div>
      <h1 class="project-hero-title">looplane</h1>
      <p class="project-hero-tagline">
        Python 優先的本地 Coding Agent<br />
        <span class="project-hero-sub">在拋棄式 clone 裡執行任務，用驗證閘門、可稽核的事件記錄與 SDD 驅動的 run，把模型改動限制在可驗證的範圍內。</span>
      </p>
      <div class="project-hero-links">
        <a href="https://github.com/lanefoundry/looplane" class="hero-link hero-link--primary" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
          GitHub
        </a>
        <a href="https://github.com/lanefoundry/looplane#documentation" class="hero-link" target="_blank" rel="noopener noreferrer">文件 →</a>
      </div>
    </section>

    <!-- ── Highlights ── -->
    <section class="project-highlights">

      <!-- Highlight 1 -->
      <div class="highlight">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="Clone Demo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>影片待錄</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">01</span>
          <h2 class="highlight-title">拋棄式 Clone，改壞不怕</h2>
          <p class="highlight-desc">
            looplane 不會直接動到你的原始程式碼。每次執行任務，它會在一個獨立的副本裡工作。改壞了？一鍵退回，原始 repo 完全不受影響。你可以放心讓 AI 大膽嘗試，因為風險是零。
          </p>
          <div class="highlight-tags">
            <span class="htag">Disposable Clone</span>
            <span class="htag">One-click Rollback</span>
            <span class="htag">Zero Risk</span>
          </div>
        </div>
      </div>

      <!-- Highlight 2 -->
      <div class="highlight highlight--reverse">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="ACL Demo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>影片待錄</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">02</span>
          <h2 class="highlight-title">檔案存取限制，AI 繞不過</h2>
          <p class="highlight-desc">
            不是靠 prompt 說「不准碰」——那太容易被繞過。looplane 在系統層級實作存取控制，模型只能讀寫被允許的檔案與目錄。不管 AI 怎麼嘗試，它就是碰不到不該碰的東西。
          </p>
          <div class="highlight-tags">
            <span class="htag">System-level ACL</span>
            <span class="htag">File Isolation</span>
            <span class="htag">Tamper-proof</span>
          </div>
        </div>
      </div>

      <!-- Highlight 3 -->
      <div class="highlight">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="多模型 Demo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>影片待錄</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">03</span>
          <h2 class="highlight-title">多模型支援</h2>
          <p class="highlight-desc">
            不綁定單一 AI 模型。你可以根據任務特性選擇最合適的模型——需要精確推理用 Claude，需要速度用更輕量的模型。切換模型只要改一個設定，不需要改程式碼。
          </p>
          <div class="highlight-tags">
            <span class="htag">Claude</span>
            <span class="htag">GPT</span>
            <span class="htag">Gemini</span>
            <span class="htag">Local Models</span>
          </div>
        </div>
      </div>

      <!-- Highlight 4 -->
      <div class="highlight highlight--reverse">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="整合 Demo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <span>截圖待補</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">04</span>
          <h2 class="highlight-title">外接 Claude Code / Codex</h2>
          <p class="highlight-desc">
            looplane 不只是獨立工具。它可以當成 Claude Code 或 Codex 的延伸，互相搭配——用 Claude Code 做高層決策，用 looplane 在安全沙箱裡跑實際的程式碼修改，兩者各司其職。
          </p>
          <div class="highlight-tags">
            <span class="htag">Claude Code</span>
            <span class="htag">Codex</span>
            <span class="htag">Composable</span>
          </div>
        </div>
      </div>

      <!-- Highlight 5 -->
      <div class="highlight">
        <div class="highlight-media">
          <div class="highlight-media-placeholder" data-label="SDK Demo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <span>截圖待補</span>
          </div>
        </div>
        <div class="highlight-content">
          <span class="highlight-number">05</span>
          <h2 class="highlight-title">SDK 嵌入其他應用</h2>
          <p class="highlight-desc">
            除了命令列 CLI，looplane 還提供 Python SDK，可以直接嵌入你的應用程式。把 coding agent 的能力變成你產品的一部分——自動修 bug、自動生成程式碼、自動跑重構，全部透過 API 呼叫。
          </p>
          <div class="highlight-tags">
            <span class="htag">Python SDK</span>
            <span class="htag">CLI</span>
            <span class="htag">Embeddable</span>
          </div>
        </div>
      </div>

    </section>

    <!-- ── Tech Stack ── -->
    <section class="project-stack">
      <h2 class="project-section-title">技術</h2>
      <div class="stack-grid">
        <div class="stack-item">
          <span class="stack-label">Runtime</span>
          <span class="stack-value">Python</span>
        </div>
        <div class="stack-item">
          <span class="stack-label">Focus</span>
          <span class="stack-value">AI-assisted Development</span>
        </div>
        <div class="stack-item">
          <span class="stack-label">Features</span>
          <span class="stack-value">Disposable Clone / File ACL / Multi-model</span>
        </div>
        <div class="stack-item">
          <span class="stack-label">License</span>
          <span class="stack-value">MIT</span>
        </div>
      </div>
    </section>

    <!-- ── Back ── -->
    <div class="project-back">
      <a href="/about" class="project-back-link">← 回到關於我</a>
    </div>

  </div>
</PostLayout>
