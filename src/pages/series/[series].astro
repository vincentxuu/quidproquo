---
export const prerender = true;

import PostLayout from '../../layouts/PostLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Icons from '../../components/Icons.astro';
import { useTranslations } from '../../i18n/utils';
import { getPublishedPosts } from '../../utils/content';
import { getSeriesHref, getSeriesSummaries } from '../../utils/series';

const t = useTranslations('zh-TW');

export async function getStaticPaths() {
  const posts = await getPublishedPosts('zh-TW');
  const seriesList = getSeriesSummaries(posts, 'zh-TW');
  // 系列的 zh/en 版共用 slug；對照頁真的存在才給切換連結，否則退回站台預設。
  const enSlugs = new Set(getSeriesSummaries(await getPublishedPosts('en'), 'en').map(s => s.slug));

  return seriesList.map(series => ({
    params: { series: series.slug },
    props: { series, switchHref: enSlugs.has(series.slug) ? `/en/series/${series.slug}` : undefined },
  }));
}

const { series, switchHref } = Astro.props;

// series.posts 已依 series.order 排序，第 0 篇為系列導讀。
const introPost = series.posts[0];
const otherPosts = series.posts.slice(1);
---
<PostLayout title={`${series.title} — quidproquo`} lang="zh-TW" description={series.description} switchHref={switchHref}>
  <a href="/series" class="back-link"><Icons name="chevron-left" size={14} />{t('nav.series')}</a>
  <div class="series-header">
    <span class="series-count">{series.count} {t('series.posts')}</span>
    <h1>{series.title}</h1>
    <p>{series.description}</p>
  </div>

  {introPost && (
    <div class="series-intro">
      <span class="series-intro-label">{t('series.intro')}</span>
      <PostCard
        slug={introPost.id}
        title={introPost.data.title}
        date={introPost.data.date}
        category={introPost.data.category}
        tags={introPost.data.tags}
        description={introPost.data.description}
        tldr={introPost.data.tldr}
        readingTime={introPost.data.readingTime}
        lang="zh-TW"
        type={introPost.data.type}
        pinned={introPost.data.pinned}
        seriesName={introPost.data.series?.name}
        seriesHref={introPost.data.series ? getSeriesHref(introPost.data.series.name, 'zh-TW') : undefined}
      />
    </div>
  )}

  {otherPosts.length > 0 && (
    <div class="series-posts">
      {otherPosts.map(post => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          date={post.data.date}
          category={post.data.category}
          tags={post.data.tags}
          description={post.data.description}
          tldr={post.data.tldr}
          readingTime={post.data.readingTime}
          lang="zh-TW"
          type={post.data.type}
          pinned={post.data.pinned}
          seriesName={post.data.series?.name}
          seriesHref={post.data.series ? getSeriesHref(post.data.series.name, 'zh-TW') : undefined}
        />
      ))}
    </div>
  )}
</PostLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 1.25rem;
  }
  .series-header {
    border-left: 4px solid var(--brand-500);
    padding-left: 0.9rem;
    margin-bottom: 1.6rem;
  }
  .series-count {
    display: inline-block;
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }
  h1 {
    margin: 0 0 0.35rem;
    color: var(--brand-900);
  }
  p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .series-intro {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.6rem;
    background: var(--bg-card);
  }
  .series-intro-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--brand-500);
    background: var(--brand-50);
    border: 1px solid var(--brand-300);
    border-radius: 3px;
    padding: 0.15rem 0.55rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .series-posts {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>
