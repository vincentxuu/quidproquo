---
export const prerender = true;

import PostLayout from '../../layouts/PostLayout.astro';
import SeriesDirectory from '../../components/SeriesDirectory.astro';
import { useTranslations } from '../../i18n/utils';
import { getPublishedPosts } from '../../utils/content';
import { getSeriesSummaries } from '../../utils/series';

const t = useTranslations('zh-TW');
const posts = await getPublishedPosts('zh-TW');
const seriesList = getSeriesSummaries(posts, 'zh-TW');
---
<PostLayout title={`${t('nav.series')} — quidproquo`} lang="zh-TW" description="quidproquo 上已整理好的系列文章。" switchHref="/en/series">
  <SeriesDirectory lang="zh-TW" seriesList={seriesList} />
</PostLayout>
